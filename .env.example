# Copy to .env next to docker-compose.yml. Compose reads it automatically.
#
# There is deliberately very little here. NAS credentials, API keys, service URLs and
# dashboard layout are all added from the web interface and stored in the data volume —
# none of it belongs in a file you might commit.

# The port LabbyTwo listens on. Change it if something else already has 5150.
LABBY_PORT=5150

# Your timezone (IANA name). Without it the container runs on UTC.
TZ=America/New_York

# Login. Leave the password empty to run without a login screen (trusted LAN only).
LABBY_AUTH_USERNAME=labby
LABBY_AUTH_PASSWORD=

# Seconds between probes of every connection.
LABBY_PROBE_SECONDS=30

# Days of metric history to keep before pruning.
LABBY_RETENTION_DAYS=30
