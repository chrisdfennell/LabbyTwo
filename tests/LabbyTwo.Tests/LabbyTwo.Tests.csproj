<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LabbyTwo.csproj" />

    <!-- The network scan plugin, for SubnetTests. Its address arithmetic is the one part of
         that plugin that can do damage, so it is tested here rather than left to the plugin
         being loaded at runtime and hoped about. -->
    <ProjectReference Include="..\..\examples\LabbyTwo.LanScanPlugin\LabbyTwo.LanScanPlugin.csproj" />

    <!-- The Docker label importer, for DockerLabelsImporterTests. An importer is a pure
         function of a file, which is exactly the thing worth testing without a running app —
         and this one reads two different Docker output shapes, which is two ways to be
         wrong about somebody's real containers. -->
    <ProjectReference Include="..\..\examples\LabbyTwo.DockerLabelsPlugin\LabbyTwo.DockerLabelsPlugin.csproj" />
  </ItemGroup>

</Project>