@inject Registry Registry
@inject ConfigStore Config

<Modal Title="@(PageBlocks ? "Add a block" : "Add a widget")" Size="xl" OnClose="OnClose">
    @* A flat list of twenty-seven cards is a wall. Grouped, and with the ones you can
       actually use first, it is a menu — the connections picker has worked this way for
       ages and there was no reason this one did not. *@
    <input class="form-control mb-3" placeholder="Search widgets…" autofocus
           @bind="_search" @bind:event="oninput" />

    @if (PageBlocks)
    {
        @* A custom page's own pieces first: they are what makes it a page rather than a
           dashboard. Each page kind is its own button, so adding the weather as a section
           is one click and not a section followed by a dropdown. *@
        var layout = Registry.Widgets.Where(t => t.Type is Core.PageBlocks.Heading or Core.PageBlocks.Divider)
            .Where(Matches).ToList();
        var pages = Core.PageBlocks.Embeddable(Registry).Where(MatchesKind).ToList();

        @if (layout.Count > 0)
        {
            <h6 class="text-uppercase tile-meta mt-3 mb-2">Layout</h6>
            <div class="card-picker">
                @foreach (var type in layout)
                {
                    <button type="button" @onclick="() => AddAsync(type)">
                        <span class="picker-title">@type.Icon @type.DisplayName</span>
                        <span class="picker-desc">@type.Description</span>
                    </button>
                }
            </div>
        }

        @if (pages.Count > 0 && Registry.WidgetType(Core.PageBlocks.Section) is { } section)
        {
            <h6 class="text-uppercase tile-meta mt-3 mb-2">A whole page, as a section</h6>
            <div class="card-picker">
                @foreach (var kind in pages)
                {
                    <button type="button" @onclick="() => AddSectionAsync(section, kind)">
                        <span class="picker-title">@kind.Icon @kind.DisplayName</span>
                        <span class="picker-desc">@kind.Description</span>
                    </button>
                }
            </div>
        }
    }

    @foreach (var group in Groups)
    {
        <h6 class="text-uppercase tile-meta mt-3 mb-2">@group.Key</h6>
        <div class="card-picker">
            @foreach (var type in group)
            {
                var usable = !type.NeedsConnection || CompatibleCount(type) > 0;
                <button type="button" disabled="@(!usable)" @onclick="() => AddAsync(type)">
                    <span class="picker-title">@type.Icon @type.DisplayName</span>
                    <span class="picker-desc">@type.Description</span>
                    @if (!usable)
                    {
                        <span class="picker-desc text-warning">
                            Needs a @Needs(type) connection first.
                        </span>
                    }
                </button>
            }
        </div>
    }

    @if (!Groups.Any() && !PageBlocks)
    {
        <p class="tile-meta">Nothing matches “@_search”.</p>
    }
</Modal>

@code {
    [Parameter, EditorRequired] public string TabId { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Widget> OnPicked { get; set; }

    /// <summary>
    /// Offer a custom page's sections, headings and dividers too. Off on a dashboard, where
    /// a section would be a page squeezed into a tile and a heading a card with nothing in it.
    /// </summary>
    [Parameter] public bool PageBlocks { get; set; }

    private IReadOnlyList<Connection> _connections = [];
    private string _search = "";

    protected override async Task OnInitializedAsync() => _connections = await Config.ConnectionsAsync();

    private int CompatibleCount(IWidgetType type) =>
        _connections.Count(c => Registry.Accepts(type, c.Provider));

    /// <summary>
    /// Grouped, with everything usable ahead of everything that needs a connection you do
    /// not have — so the list starts with what you can actually add today.
    /// </summary>
    private IEnumerable<IGrouping<string, IWidgetType>> Groups =>
        Registry.Widgets
            .Where(type => !Core.PageBlocks.IsBlock(type.Type))
            .Where(Matches)
            .OrderBy(type => !type.NeedsConnection || CompatibleCount(type) > 0 ? 0 : 1)
            .ThenBy(type => type.DisplayName)
            .GroupBy(Group);

    private bool Matches(IWidgetType type) =>
        _search.Trim() is not { Length: > 0 } needle
        || type.DisplayName.Contains(needle, StringComparison.OrdinalIgnoreCase)
        || type.Description.Contains(needle, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Grouped by what the card is *for*, worked out from what it binds to — a widget
    /// describes itself already, and asking every existing one to declare a category would
    /// be churn for no gain.
    /// </summary>
    private string Group(IWidgetType type) =>
        !type.NeedsConnection ? "Needs nothing — text, links, clocks"
        : type.ProviderTypes.Contains(AnyProvider.Wildcard) ? "Works with anything you have connected"
        : "For one particular service";

    /// <summary>Provider keys are internal; a person needs the names they saw in the picker.</summary>
    private string Needs(IWidgetType type) =>
        string.Join(" or ", type.ProviderTypes
            .Select(key => Registry.Provider(key)?.DisplayName ?? key));

    private bool MatchesKind(ITabKind kind) =>
        _search.Trim() is not { Length: > 0 } needle
        || kind.DisplayName.Contains(needle, StringComparison.OrdinalIgnoreCase)
        || kind.Description.Contains(needle, StringComparison.OrdinalIgnoreCase);

    /// <summary>A section already pointed at the page chosen, so the editor opens on that page's settings.</summary>
    private Task AddSectionAsync(IWidgetType section, ITabKind kind) =>
        AddAsync(section, new SettingsBag { [Core.PageBlocks.KindKey] = kind.Kind });

    private async Task AddAsync(IWidgetType type, SettingsBag? settings = null)
    {
        // Bind straight to the only candidate when there is exactly one — the editor still
        // opens, so the choice stays visible and changeable.
        var candidates = _connections.Where(c => Registry.Accepts(type, c.Provider)).ToList();
        var widget = new Widget
        {
            TabId = TabId,
            Type = type.Type,
            // No title by default — most widgets already say what they are (a tile shows
            // the service name), and a redundant header just costs a row of height.
            Title = "",
            Width = type.DefaultWidth,
            Sort = await Config.NextWidgetSortAsync(TabId),
            ConnectionId = type.NeedsConnection && candidates.Count == 1 ? candidates[0].Id : null,
            Settings = settings ?? new SettingsBag(),
        };
        await Config.SaveWidgetAsync(widget);
        await OnPicked.InvokeAsync(widget);
    }
}
