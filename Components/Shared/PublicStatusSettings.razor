@inject AppSettingsStore AppSettings
@inject NavigationManager Nav

@* The "Public status page" card from the old single Settings page, moved to
   Settings → Integrations unchanged. *@

<div class="widget" id="public-status">
    <div class="widget-head"><h2 class="widget-title">Public status page</h2></div>
    <div class="widget-body">
        <p class="tile-meta">
            A read-only page anyone with the link can open without signing in — names,
            uptime percentages and the daily bars. Deliberately not the probe messages,
            which carry internal hostnames and API errors.
        </p>

        @if (_statusToken is { Length: > 0 })
        {
            <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                <input class="form-control font-monospace" readonly value="@StatusUrl" style="max-width: 34rem"
                       aria-label="Public status page link" />
                <a class="btn btn-sm btn-outline-secondary" href="@StatusUrl" target="_blank" rel="noreferrer">Open</a>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="RotateStatusTokenAsync">
                    Rotate link
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="DisableStatusPageAsync">
                    Turn off
                </button>
            </div>
            <div class="form-text">
                Anyone with the link can read it — that is the point, so treat it as public.
                Rotating breaks the old link immediately.
            </div>
        }
        else
        {
            <button class="btn btn-sm btn-primary" @onclick="RotateStatusTokenAsync">
                Create a share link
            </button>
        }
    </div>
</div>

@code {
    private string _statusToken = "";

    private string StatusUrl => $"{Nav.BaseUri.TrimEnd('/')}/status/{_statusToken}";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _statusToken = await AppSettings.GetAsync(LabbyTwo.Components.Pages.PublicStatus.PublicStatusToken);

    /// <summary>
    /// A fresh random token. Url-safe base64 of 24 bytes — long enough that guessing it
    /// is not a strategy, short enough to paste into a chat.
    /// </summary>
    private async Task RotateStatusTokenAsync()
    {
        var bytes = System.Security.Cryptography.RandomNumberGenerator.GetBytes(24);
        var token = Convert.ToBase64String(bytes).Replace('+', '-').Replace('/', '_').TrimEnd('=');
        await AppSettings.SaveAsync(LabbyTwo.Components.Pages.PublicStatus.PublicStatusToken, token);
        await LoadAsync();
    }

    private async Task DisableStatusPageAsync()
    {
        await AppSettings.SaveAsync(LabbyTwo.Components.Pages.PublicStatus.PublicStatusToken, "");
        await LoadAsync();
    }
}
