@* Named secrets, one row each: a name anybody may read and a value nobody gets back.
   The whole list is one settings value — a JSON object — which ConfigStore encrypts as a
   single secret, so it needs no storage of its own. A saved value is never put into the
   page: its box is empty with a "saved" placeholder, and leaving it empty keeps it. *@

<div class="secret-list">
    @for (var i = 0; i < _rows.Count; i++)
    {
        var index = i;
        var row = _rows[index];
        <div class="d-flex gap-2 mb-2 align-items-center">
            <input id="secret-@index-name" class="form-control font-monospace" placeholder="name" style="max-width: 12rem"
                   aria-label="Secret name" value="@row.Name" @onchange="e => Rename(index, e.Value)" />
            <input id="secret-@index-value" type="password" class="form-control" autocomplete="new-password"
                   aria-label="Secret value"
                   placeholder="@(row.Saved ? "•••••••• saved — type to replace" : "value")"
                   @onchange="e => SetValue(index, e.Value)" />
            <button type="button" class="btn btn-sm btn-outline-danger" title="Remove this secret"
                    @onclick="() => Remove(index)">Remove secret</button>
        </div>
        @if (row.Name.Trim().Length > 0)
        {
            <div class="form-text mt-n1 mb-2">Use it as <code>@("${secret:" + row.Name.Trim() + "}")</code></div>
        }
    }
</div>
<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Add">+ Add a secret</button>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private sealed class Row
    {
        public string Name { get; set; } = "";
        public string Secret { get; set; } = "";

        /// <summary>Had a value when the form opened — only ever shown as a placeholder.</summary>
        public bool Saved { get; set; }
    }

    private List<Row> _rows = [];
    private string? _lastValue;

    protected override void OnParametersSet()
    {
        // Only re-read when the parent hands over something new, or typing in a row would
        // be overwritten by the round trip it just caused.
        if (Value == _lastValue)
            return;
        _lastValue = Value;
        _rows = [.. StepCheck.ParseSecrets(Value).Select(s => new Row { Name = s.Key, Secret = s.Value, Saved = s.Value.Length > 0 })];
    }

    private async Task Push()
    {
        var secrets = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in _rows.Where(r => r.Name.Trim().Length > 0))
            secrets[row.Name.Trim()] = row.Secret;
        _lastValue = StepCheck.SerializeSecrets(secrets);
        await ValueChanged.InvokeAsync(_lastValue);
    }

    private async Task Add()
    {
        _rows.Add(new Row());
        await Push();
    }

    private async Task Rename(int index, object? value)
    {
        _rows[index].Name = (value?.ToString() ?? "").Trim();
        await Push();
    }

    private async Task SetValue(int index, object? value)
    {
        // Blank means "keep the saved one", the same rule as every other password box.
        var text = value?.ToString() ?? "";
        if (text.Length == 0)
            return;
        _rows[index].Secret = text;
        await Push();
    }

    private async Task Remove(int index)
    {
        _rows.RemoveAt(index);
        await Push();
    }
}
