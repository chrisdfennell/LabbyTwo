@inject ConfigStore Config
@inject Registry Registry
@inject ActionRunner Runner
@inject NoteDirectory NoteDirectory

@* Sits under a Markdown box and points at lines that will not render the way they look.
   Shown wherever Markdown is edited, so the notes page and a Markdown widget behave the
   same. It suggests; the button applies. Nothing is rewritten as you type.

   It is also where live values are discovered: a line saying they exist, a warning for a
   shortcode with a misspelt kind, and a small form that writes one for you — because the
   syntax is easy to use and impossible to guess. *@

@if (_hints.Count > 0)
{
    <div class="md-hint mt-2">
        <div>
            <div>
                @(_hints.Count == 1 ? "One line looks like a heading" : $"{_hints.Count} lines look like headings")
                but will render as plain text — Markdown needs a space after the <code>#</code>.
            </div>
            <div class="tile-meta mt-1">
                @foreach (var hint in _hints.Take(3))
                {
                    <div class="text-truncate">
                        Line @hint.Line: <code>@hint.Text</code> → <code>@hint.Suggestion</code>
                    </div>
                }
                @if (_hints.Count > 3)
                {
                    <div>…and @(_hints.Count - 3) more.</div>
                }
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary flex-none" @onclick="ApplyAsync">
            Add the spaces
        </button>
    </div>
}

@if (_unknown.Count > 0)
{
    <div class="md-hint mt-2">
        <div>
            <div>
                <code>@_unknown[0].Source</code>@(_unknown.Count > 1 ? $" and {_unknown.Count - 1} more" : "")
                will show as a question mark: “@_unknown[0].Kind” is not a live value.
            </div>
            <div class="tile-meta mt-1">
                Inline: @string.Join(", ", Shortcodes.InlineKinds). On a line of its own: @string.Join(", ", Shortcodes.BlockKinds).
            </div>
        </div>
    </div>
}

<div class="md-insert mt-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="tile-meta">
            Live values: <code>{{status: NAS}}</code>, <code>{{metric: NAS / cpu_percent}}</code>, <code>{{widget: card title}}</code>.
            Runbooks: <code>{{down}}</code>, <code>{{if down: NAS}}</code> … <code>{{end}}</code>, <code>{{button: NAS / restart}}</code>, <code>{{details: Title}}</code> … <code>{{end}}</code>, <code>&gt; [!WARNING]</code>.
            Lists: <code>{{alerts}}</code>, <code>{{containers: stopped}}</code>, <code>{{renewals}}</code>.
            History: <code>{{chart: NAS / cpu_percent last=7d}}</code>, <code>{{changes: last=24h}}</code>, <code>{{incidents: open}}</code>, <code>{{backups: late}}</code>.
            Power: <code>{{power}}</code>, <code>{{power: "NAS plug" period=today}}</code>.
        </span>
        <button type="button" class="btn btn-sm btn-link p-0" @onclick="ToggleAsync" aria-expanded="@(_open ? "true" : "false")">
            @(_open ? "Close" : "Insert live value…")
        </button>
    </div>

    @if (_open)
    {
        <div class="md-insert-form mt-2">
            @if (_connections is null)
            {
                <span class="tile-meta">Loading…</span>
            }
            else
            {
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4">
                        <label class="form-label small mb-1" for="@Id("kind")">Show</label>
                        <select id="@Id("kind")" class="form-select form-select-sm" @bind="_kind">
                            <option value="status">Status (up / down)</option>
                            <option value="metric">A metric’s value</option>
                            <option value="forecast">When it fills up</option>
                            <option value="uptime">Uptime, last 30 days</option>
                            <option value="since">Time since it changed</option>
                            <option value="gauge">A gauge card</option>
                            <option value="widget">An existing card</option>
                            <option value="down">What’s down right now</option>
                            <option value="if-down">A section shown while it’s down</option>
                            <option value="button">One of its action buttons</option>
                            <option value="sparkline">A tiny trend line</option>
                            <option value="chart">A full-size history chart</option>
                            <option value="uptimebar">A daily uptime strip</option>
                            <option value="link">A link to its web page</option>
                            <option value="ago">When it was last checked</option>
                            <option value="alerts">Alerts firing now</option>
                            <option value="containers">Docker containers</option>
                            <option value="updates">Containers with an update</option>
                            <option value="renewals">What’s due to expire</option>
                            <option value="changes">What changed recently</option>
                            <option value="incidents">Recent incidents</option>
                            <option value="backups">Backups and whether they are on time</option>
                            <option value="today">Today’s date</option>
                            <option value="countdown">Days until a date</option>
                            <option value="power">What electricity costs</option>
                            <option value="details">A fold that opens (details)</option>
                            <option value="callout">A callout box</option>
                            <option value="note-link">A link to another note</option>
                        </select>
                    </div>

                    @if (_kind == "down")
                    {
                        <div class="col-sm-8 tile-meta">
                            Every monitored connection that is down, with how long and why — or “Everything’s up”.
                        </div>
                    }
                    else if (_kind == "alerts")
                    {
                        <div class="col-sm-8 tile-meta">
                            Every alert rule firing now, with its reading and how long — or “No alerts firing”.
                        </div>
                    }
                    else if (_kind == "updates")
                    {
                        <div class="col-sm-8 tile-meta">
                            Containers whose registry has a newer image, from the last Check for updates — this never
                            asks a registry itself.
                        </div>
                    }
                    else if (_kind == "renewals")
                    {
                        <div class="col-sm-8 tile-meta">
                            Certificates and renewals due in the next 60 days, soonest first; overdue ones in red.
                        </div>
                    }
                    else if (_kind == "changes")
                    {
                        <div class="col-sm-3">
                            <label class="form-label small mb-1" for="@Id("change-kind")">What</label>
                            <select id="@Id("change-kind")" class="form-select form-select-sm" @bind="_changeKind">
                                <option value="">Everything</option>
                                <option value="services">Services up and down</option>
                                <option value="containers">Containers</option>
                                <option value="alerts">Alerts</option>
                                <option value="certificates">Certificates</option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label small mb-1" for="@Id("change-last")">Over</label>
                            <select id="@Id("change-last")" class="form-select form-select-sm" @bind="_window">
                                <option value="1h">1 hour</option>
                                <option value="24h">24 hours</option>
                                <option value="7d">7 days</option>
                                <option value="30d">30 days</option>
                            </select>
                        </div>
                        <div class="col-sm-3 tile-meta">Newest first, ten at most; <code>limit=</code> for more.</div>
                    }
                    else if (_kind == "incidents")
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("incident-show")">Which</label>
                            <select id="@Id("incident-show")" class="form-select form-select-sm" @bind="_incidentShow">
                                <option value="">The last five</option>
                                <option value="open">Only ones still open</option>
                            </select>
                        </div>
                        <div class="col-sm-4 tile-meta">Each links to its timeline on the Incidents page.</div>
                    }
                    else if (_kind == "power")
                    {
                        <div class="col-sm-3">
                            <label class="form-label small mb-1" for="@Id("power-source")">Source or service</label>
                            <input id="@Id("power-source")" class="form-control form-control-sm" placeholder="everything" @bind="_powerSource" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small mb-1" for="@Id("power-period")">Over</label>
                            <select id="@Id("power-period")" class="form-select form-select-sm" @bind="_powerPeriod">
                                <option value="month">This month so far</option>
                                <option value="today">Today</option>
                                <option value="week">Last 7 days</option>
                                <option value="30d">Last 30 days</option>
                                <option value="projected">This month, projected</option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label small mb-1" for="@Id("power-show")">Show</label>
                            <select id="@Id("power-show")" class="form-select form-select-sm" @bind="_powerShow">
                                <option value="cost">Cost</option>
                                <option value="kwh">kWh</option>
                                <option value="watts">Average watts</option>
                            </select>
                        </div>
                    }
                    else if (_kind == "backups")
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("backup-show")">Which</label>
                            <select id="@Id("backup-show")" class="form-select form-select-sm" @bind="_backupShow">
                                <option value="">All of them</option>
                                <option value="late">Only late ones, and restore tests due</option>
                            </select>
                        </div>
                        <div class="col-sm-4 tile-meta">From the Backups page: when each last was, late ones first. Ten at most; <code>limit=</code> for more.</div>
                    }
                    else if (_kind == "today")
                    {
                        <div class="col-sm-8 tile-meta">
                            The date, like “@LiveTime.Today(DateTimeOffset.Now, LiveTime.DefaultFormat)”. Add <code>format=short</code>, <code>iso</code> or <code>time</code> for others.
                        </div>
                    }
                    else if (_kind == "containers")
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("state")">Which</label>
                            <select id="@Id("state")" class="form-select form-select-sm" @bind="_state">
                                <option value="stopped">Stopped</option>
                                <option value="unhealthy">Unhealthy</option>
                                <option value="running">Running</option>
                                <option value="all">All</option>
                            </select>
                        </div>
                        <div class="col-sm-4 tile-meta">From the first Docker connection; add <code>connection="…"</code> for another.</div>
                    }
                    else if (_kind == "countdown")
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("date")">Date</label>
                            <input id="@Id("date")" type="date" class="form-control form-control-sm" @bind="_date" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("label")">Label (optional)</label>
                            <input id="@Id("label")" class="form-control form-control-sm" placeholder="Renewal" @bind="_label" />
                        </div>
                    }
                    else if (_kind == "details")
                    {
                        <div class="col-sm-8">
                            <label class="form-label small mb-1" for="@Id("title")">Title</label>
                            <input id="@Id("title")" class="form-control form-control-sm" placeholder="Full restart procedure" @bind="_title" />
                        </div>
                    }
                    else if (_kind == "callout")
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("callout")">Kind</label>
                            <select id="@Id("callout")" class="form-select form-select-sm" @bind="_callout">
                                @foreach (var (kind, look) in CalloutExtension.Kinds)
                                {
                                    <option value="@kind">@look.Title</option>
                                }
                            </select>
                        </div>
                    }
                    else if (_kind == "note-link")
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("note")">Note</label>
                            <select id="@Id("note")" class="form-select form-select-sm" @bind="_noteId">
                                <option value="">@(_noteGraph is null ? "Loading…" : _noteGraph.Notes.Count == 0 ? "There are no notes yet" : "Choose…")</option>
                                @foreach (var note in (_noteGraph?.Notes ?? []).Where(n => NoteLinks.CanLink(n.Title)))
                                {
                                    <option value="@note.Id">@note.Shown — @note.Place.Describe()</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label small mb-1" for="@Id("note-heading")">Heading</label>
                            <input id="@Id("note-heading")" class="form-control form-control-sm" placeholder="optional" @bind="_noteHeading" />
                        </div>
                        <div class="col-sm-2">
                            <label class="form-label small mb-1" for="@Id("note-text")">Words</label>
                            <input id="@Id("note-text")" class="form-control form-control-sm" placeholder="its title" @bind="_noteText" />
                        </div>
                    }
                    else if (_kind == "widget")
                    {
                        <div class="col-sm-8">
                            <label class="form-label small mb-1" for="@Id("widget")">Card</label>
                            <select id="@Id("widget")" class="form-select form-select-sm" @bind="_widgetTitle">
                                <option value="">Choose…</option>
                                @foreach (var widget in _widgets ?? [])
                                {
                                    <option value="@widget">@widget</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="@Id("connection")">Connection</label>
                            <select id="@Id("connection")" class="form-select form-select-sm" @bind="_connectionName">
                                <option value="">Choose…</option>
                                @foreach (var connection in _connections)
                                {
                                    <option value="@connection.Name">@connection.Name</option>
                                }
                            </select>
                        </div>
                        @if (_kind == "button")
                        {
                            <div class="col-sm-4">
                                <label class="form-label small mb-1" for="@Id("action")">Action</label>
                                <select id="@Id("action")" class="form-select form-select-sm" @bind="_action">
                                    <option value="">@(ActionChoices.Count == 0 && _connectionName.Length > 0 ? "It has none" : "Choose…")</option>
                                    @foreach (var action in ActionChoices)
                                    {
                                        <option value="@action.Id">@action.Label</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_kind == "chart")
                        {
                            <div class="col-sm-2">
                                <label class="form-label small mb-1" for="@Id("chart-window")">Over</label>
                                <select id="@Id("chart-window")" class="form-select form-select-sm" @bind="_window">
                                    <option value="1h">1 hour</option>
                                    <option value="24h">24 hours</option>
                                    <option value="7d">7 days</option>
                                    <option value="30d">30 days</option>
                                    <option value="90d">90 days</option>
                                </select>
                            </div>
                        }
                        @if (_kind == "sparkline")
                        {
                            <div class="col-sm-2">
                                <label class="form-label small mb-1" for="@Id("window")">Over</label>
                                <select id="@Id("window")" class="form-select form-select-sm" @bind="_window">
                                    <option value="1h">1 hour</option>
                                    <option value="24h">24 hours</option>
                                    <option value="7d">7 days</option>
                                    <option value="30d">30 days</option>
                                </select>
                            </div>
                        }
                        @if (_kind is "metric" or "gauge" or "forecast" or "sparkline" or "chart")
                        {
                            <div class="col-sm-4">
                                <label class="form-label small mb-1" for="@Id("metric")">Metric</label>
                                <input id="@Id("metric")" class="form-control form-control-sm" list="@Id("metrics")"
                                       placeholder="@(_kind == "forecast" ? "soonest to fill" : "cpu_percent")" @bind="_metric" />
                                <datalist id="@Id("metrics")">
                                    @foreach (var metric in MetricChoices)
                                    {
                                        <option value="@metric.Key">@metric.Label</option>
                                    }
                                </datalist>
                            </div>
                        }
                    }
                </div>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <code class="text-truncate">@(Preview ?? "")</code>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto flex-none"
                            disabled="@(Preview is null)" @onclick="InsertAsync">Insert at the end</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private IReadOnlyList<MarkdownHints.Hint> _hints = [];
    private IReadOnlyList<Shortcode> _unknown = [];

    private readonly string _id = Guid.NewGuid().ToString("n")[..8];
    private bool _open;
    private IReadOnlyList<Connection>? _connections;
    private IReadOnlyList<string>? _widgets;
    private string _kind = "status";
    private string _connectionName = "";
    private string _metric = "";
    private string _widgetTitle = "";
    private string _action = "";
    private string _state = "stopped";
    private string _window = "24h";
    private DateTime? _date;
    private string _label = "";
    private string _title = "";
    private string _callout = "note";
    private string _changeKind = "";
    private string _incidentShow = "";
    private string _powerSource = "";
    private string _powerPeriod = "month";
    private string _powerShow = "cost";
    private string _backupShow = "";
    private NoteGraph? _noteGraph;
    private string _noteId = "";
    private string _noteHeading = "";
    private string _noteText = "";

    // Recomputed when the text changes rather than in the markup, so a long note is not
    // re-scanned on every unrelated render of the form around it.
    protected override void OnParametersSet()
    {
        _hints = MarkdownHints.For(Value);
        _unknown = Shortcodes.Unknown(Value);
    }

    private string Id(string part) => $"md-insert-{_id}-{part}";

    private IEnumerable<MetricSpec> MetricChoices =>
        _connections?.FirstOrDefault(c => c.Name == _connectionName) is { } connection
            ? Registry.MetricsFor(connection).Where(m => _kind != "forecast" || m.Capacity is not null)
            : [];

    /// <summary>
    /// What the chosen connection can do right now — the same list its Controls card and
    /// the {{button}} it writes will use. In memory: the provider answers from settings.
    /// </summary>
    private IReadOnlyList<ProviderAction> ActionChoices =>
        _connections?.FirstOrDefault(c => c.Name == _connectionName) is { } connection
            ? Runner.ActionsFor(connection)
            : [];

    /// <summary>The shortcode the form describes, or null until it describes one.</summary>
    private string? Preview => _kind switch
    {
        "down" or "alerts" or "renewals" or "today" or "updates" => Shortcodes.Write(_kind, []),
        // The default window is left unwritten, so the note reads {{changes}} rather than {{changes: last="24h"}}.
        "changes" => Shortcodes.Write("changes", [_changeKind], [new("last", _window == "24h" ? "" : _window)]),
        "incidents" => Shortcodes.Write("incidents", [_incidentShow]),
        // The defaults are left unwritten, so the note reads {{power}} rather than {{power: period="month" show="cost"}}.
        "power" => Shortcodes.Write("power", [_powerSource.Trim()],
            [new("period", _powerPeriod == "month" ? "" : _powerPeriod), new("show", _powerShow == "cost" ? "" : _powerShow)]),
        "backups" => Shortcodes.Write("backups", [_backupShow]),
        "widget" => _widgetTitle.Length > 0 ? Shortcodes.Write("widget", [_widgetTitle]) : null,
        "containers" => Shortcodes.Write("containers", [_state]),
        "countdown" => _date is { } date
            ? Shortcodes.Write("countdown", [date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)],
                [new("label", _label.Trim())])
            : null,
        "details" => Details(_title.Trim().Length > 0 ? _title.Trim() : "More"),
        "callout" => $"> [!{_callout.ToUpperInvariant()}]\n> Write it here.",
        "note-link" => NoteLinkPreview(),
        _ when _connectionName.Length == 0 => null,
        "sparkline" => _metric.Trim().Length > 0
            ? Shortcodes.Write("sparkline", [_connectionName, $"{_metric.Trim()} {_window}"])
            : Shortcodes.Write("sparkline", [_connectionName], [new("window", _window)]),
        "metric" => _metric.Trim().Length > 0 ? Shortcodes.Write("metric", [_connectionName, _metric.Trim()]) : null,
        // The default window is left unwritten, as it is for {{changes}}. More lines, a fixed
        // span, height= and min=/max= are typed by hand; the README lists them.
        "chart" => ChartShortcode.Write([new ChartLine(_connectionName, _metric.Trim())],
            [new("last", _window == "24h" ? "" : _window)]),
        "forecast" => Shortcodes.Write("forecast", [_connectionName, _metric.Trim()]),
        "if-down" => IfDown(_connectionName),
        "button" => _action.Length > 0 && ActionChoices.Any(a => a.Id == _action)
            ? Shortcodes.Write("button", [_connectionName, _action])
            : null,
        "gauge" => _metric.Trim().Length > 0
            ? Shortcodes.Write("card", ["gauge"], [new("connection", _connectionName), new("metric", _metric.Trim())])
            : null,
        _ => Shortcodes.Write(_kind, [_connectionName]),
    };

    /// <summary>
    /// The skeleton of a section for when one connection is down: a heading to fill in, a
    /// line that says it is fine otherwise. The name is quoted exactly as the parser wants
    /// it, which is why this is built with Shortcodes.QuoteTarget rather than by hand.
    /// </summary>
    private static string IfDown(string name)
    {
        var quoted = Shortcodes.QuoteTarget(name);
        return $"{{{{if down: {quoted}}}}}\n### {name} is down\n\n1. What to check first…\n{{{{else}}}}\n{name} is fine.\n{{{{end}}}}";
    }

    /// <summary>
    /// A fold with a line inside to replace. The title goes through the shortcode writer,
    /// so one with quotes or slashes in it reads back as written.
    /// </summary>
    private static string Details(string title) =>
        Shortcodes.Write("details", [title]) + "\n1. First step…\n2. Second step…\n{{end}}";

    /// <summary>
    /// <c>[[Title]]</c> for the chosen note, with the page in front only when another note
    /// has the same title — so the link reads as plainly as it can and still finds this one.
    /// </summary>
    private string? NoteLinkPreview()
    {
        if (_noteGraph?.Note(_noteId) is not { } note)
            return null;
        var shared = _noteGraph.Notes.Count(n => string.Equals(NoteLinks.Tidy(n.Title), NoteLinks.Tidy(note.Title), StringComparison.OrdinalIgnoreCase)) > 1;
        return NoteLinks.Write(note.Title, _noteHeading.Trim(), _noteText.Trim(), shared ? note.Place.Section ?? note.Place.Page : null);
    }

    /// <summary>
    /// The lists are read when the helper is opened, not when the editor is, so a form with
    /// three Markdown fields that nobody inserts into costs nothing. Awaited, never waited on.
    /// </summary>
    private async Task ToggleAsync()
    {
        _open = !_open;
        if (_open && _connections is null)
        {
            var connections = await Config.ConnectionsAsync();
            var widgets = await Config.WidgetsAsync();
            _connections = [.. connections.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)];
            _widgets = [.. widgets.Select(w => w.Title.Trim()).Where(t => t.Length > 0)
                .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase)];
        }
        if (_open && _noteGraph is null)
            _noteGraph = await NoteDirectory.GetAsync();
    }

    /// <summary>
    /// Appended rather than put at the cursor: the cursor lives in the browser, and reaching
    /// for it needs script this form otherwise does without. A card goes on a line of its
    /// own with blank lines around it, since that is the only place one is drawn.
    /// </summary>
    private async Task InsertAsync()
    {
        if (Preview is not { } code)
            return;
        var text = (Value ?? "").TrimEnd();
        // A value carries on the last sentence, unless that line is a heading, a list item,
        // a quote or a table row, where it would quietly become part of that instead.
        var last = text[(text.LastIndexOf('\n') + 1)..].TrimStart();
        var structural = last.Length > 0
            && (last[0] is '#' or '-' or '*' or '+' or '>' or '|' || System.Text.RegularExpressions.Regex.IsMatch(last, @"^\d+[.)]\s"));
        var block = _kind is "widget" or "gauge" or "chart" or "down" or "if-down" or "alerts" or "containers" or "updates" or "renewals"
            or "changes" or "incidents" or "backups" or "details" or "callout";
        var joined = text.Length == 0 ? code : text + (block || structural ? "\n\n" : " ") + code;
        Value = joined;
        OnParametersSet();
        await ValueChanged.InvokeAsync(joined);
    }

    private async Task ApplyAsync()
    {
        var fixedUp = MarkdownHints.Fix(Value);
        Value = fixedUp;
        _hints = [];
        await ValueChanged.InvokeAsync(fixedUp);
    }
}
