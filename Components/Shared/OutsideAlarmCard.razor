@inject OutsideAlarm Alarm
@inject Offload Offload
@inject IHostApplicationLifetime Lifetime
@implements IDisposable

@* The dead man's switch. Its own component, like the off-site copies beside it, because
   Settings.razor is long enough — and because this is about LabbyTwo itself rather than
   anything it watches, so it belongs on Settings rather than among the connections. *@

<div class="widget">
    <div class="widget-head">
        <h2 class="widget-title">Outside alarm</h2>
        <span class="tile-meta">@HeadText</span>
    </div>
    <div class="widget-body">
        <p class="tile-meta">
            If the power or the internet goes, LabbyTwo goes with it and cannot tell you. Give it the ping address of a
            service outside the house — Healthchecks.io, an Uptime Kuma push monitor on a cloud server, or any
            heartbeat URL — and it checks in every minute or so. When the check-ins stop, that service alerts you.
            It only checks in while its own monitoring is actually running, so a stuck LabbyTwo sets it off too.
            Nothing is sent until you paste an address in.
        </p>

        <div class="row g-2">
            <div class="col-12 col-lg-8">
                <label class="form-label" for="outside-url">Ping address</label>
                <input id="outside-url" type="password" class="form-control font-monospace" autocomplete="off"
                       @bind="_url" placeholder="@(_saved.IsConfigured ? $"Unchanged — {OutsideAlarm.Mask(_saved.Url)}" : "https://hc-ping.com/…")" />
                <div class="form-text">
                    The address is the password — anybody with it can report the check as fine — so it is stored
                    encrypted and never shown again. Leave blank to keep the one saved.
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <label class="form-label" for="outside-kind">Service</label>
                <select id="outside-kind" class="form-select" @bind="_kind">
                    <option value="@HeartbeatKind.Auto">Work it out from the address</option>
                    <option value="@HeartbeatKind.Healthchecks">Healthchecks (hosted or your own)</option>
                    <option value="@HeartbeatKind.UptimeKuma">Uptime Kuma push monitor</option>
                    <option value="@HeartbeatKind.Plain">Any other heartbeat URL</option>
                </select>
            </div>
            <div class="col-6 col-lg-4">
                <label class="form-label" for="outside-interval">Check in every</label>
                <select id="outside-interval" class="form-select" @bind="_interval">
                    @foreach (var (seconds, label) in Intervals)
                    {
                        <option value="@seconds">@label</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-8 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="outside-summary" @bind="_summary" />
                    <label class="form-check-label" for="outside-summary">
                        Include a count of what is up and down, like “12 up, 1 down”
                    </label>
                </div>
            </div>
        </div>
        <div class="form-text">
            Set the grace period on the other end to at least two or three check-ins, so one missed ping on a busy
            evening is not an alarm. A service that only understands plain pings is simply not pinged while LabbyTwo's
            monitoring is stuck; Healthchecks and Uptime Kuma are told why, straight away.
        </div>

        @if (_formError is { Length: > 0 })
        {
            <div class="alert alert-warning py-2 mt-2 mb-0">@_formError</div>
        }

        <div class="d-flex gap-2 flex-wrap mt-3">
            <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_busy || (!_saved.IsConfigured && _url.Trim().Length == 0))"
                    @onclick="TestAsync">@(_testing ? "Sending…" : "Send test ping")</button>
            @if (_saved.IsConfigured)
            {
                <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="TurnOffAsync">Turn off</button>
            }
        </div>

        @if (_tested is { } tested)
        {
            <div class="small mt-2 @(tested.Ok ? "text-success" : "text-warning")">@tested.Message</div>
        }

        @if (_saved.IsConfigured)
        {
            var status = Alarm.Status;
            <dl class="row mb-0 mt-3 small">
                <dt class="col-5 col-md-3 tile-meta">Sending to</dt>
                <dd class="col-7 col-md-9 font-monospace">@OutsideAlarm.Mask(_saved.Url) · @KindName(_saved.EffectiveKind)</dd>

                <dt class="col-5 col-md-3 tile-meta">Last ping</dt>
                <dd class="col-7 col-md-9">
                    @if (status.LastAttemptAt is not { } at)
                    {
                        <span class="tile-meta">Not yet — the first goes within a minute or two of saving or starting.</span>
                    }
                    else if (status.LastOk)
                    {
                        <span class="text-success">✓ @(status.LastSignal == HeartbeatSignal.Fail ? "Reported a problem" : "Up")</span>
                        <span class="tile-meta"> · @Ago.Since(at) · @status.LastMessage</span>
                    }
                    else
                    {
                        <span class="text-danger">✗ Failed @Ago.Since(at):</span>
                        <span> @status.LastMessage</span>
                        @if (status.ConsecutiveFailures > 1)
                        {
                            <span class="tile-meta"> (@status.ConsecutiveFailures in a row)</span>
                        }
                    }
                </dd>

                @if (status.Verdict.Length > 0)
                {
                    <dt class="col-5 col-md-3 tile-meta">Monitoring</dt>
                    <dd class="col-7 col-md-9">@status.Verdict</dd>
                }

                @if (status.LastError is { } error && status.LastErrorAt is { } errorAt && status.LastOk)
                {
                    <dt class="col-5 col-md-3 tile-meta">Last problem</dt>
                    <dd class="col-7 col-md-9 tile-meta">@Ago.Since(errorAt): @error</dd>
                }
            </dl>
            <div class="form-text">
                Failed pings are written to the log, not sent to your alert channels — when the internet is down those
                could not deliver anyway, and the service outside is already doing the alarming.
            </div>
        }
    </div>
</div>

@code {
    private static readonly (int Seconds, string Label)[] Intervals =
    [
        (60, "minute"),
        (120, "2 minutes"),
        (300, "5 minutes"),
        (600, "10 minutes"),
        (900, "15 minutes"),
        (1800, "30 minutes"),
        (3600, "hour"),
    ];

    private OutsideAlarmSettings _saved = OutsideAlarmSettings.Off;
    private string _url = "";
    private HeartbeatKind _kind = HeartbeatKind.Auto;
    private int _interval = OutsideAlarmSettings.DefaultIntervalSeconds;
    private bool _summary = true;
    private string? _formError;
    private (bool Ok, string Message)? _tested;
    private bool _busy;
    private bool _testing;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        Alarm.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _saved = await Offload.Run(ct => Alarm.SettingsAsync(ct));
        _kind = _saved.Kind;
        _interval = Intervals.Any(i => i.Seconds == _saved.IntervalSeconds)
            ? _saved.IntervalSeconds : OutsideAlarmSettings.DefaultIntervalSeconds;
        _summary = _saved.IncludeSummary;
        _url = "";
    }

    private string HeadText => !_saved.IsConfigured
        ? "Off"
        : Alarm.Status is { LastAttemptAt: not null, LastOk: false } ? "Pings failing"
        : $"On · every {Intervals.FirstOrDefault(i => i.Seconds == _saved.IntervalSeconds).Label ?? "minute"}";

    private static string KindName(HeartbeatKind kind) => kind switch
    {
        HeartbeatKind.Healthchecks => "Healthchecks",
        HeartbeatKind.UptimeKuma => "Uptime Kuma",
        _ => "plain heartbeat",
    };

    /// <summary>The form as settings: a blank address means "the one already saved".</summary>
    private OutsideAlarmSettings FromForm() =>
        new(_url.Trim().Length > 0 ? _url.Trim() : _saved.Url, _kind, _interval, _summary);

    private async Task SaveAsync()
    {
        if (OutsideAlarm.Problem(_url) is { } problem)
        {
            _formError = problem;
            return;
        }

        _busy = true;
        try
        {
            var chosen = FromForm();
            await Offload.Run(async ct => { await Alarm.SaveAsync(chosen, ct); return true; });
            _formError = null;
            _tested = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TurnOffAsync()
    {
        _busy = true;
        try
        {
            var off = FromForm() with { Url = "" };
            await Offload.Run(async ct => { await Alarm.SaveAsync(off, ct); return true; });
            _tested = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync()
    {
        if (OutsideAlarm.Problem(_url) is { } problem)
        {
            _formError = problem;
            return;
        }

        _busy = _testing = true;
        _tested = null;
        _formError = null;
        try
        {
            // On the app's lifetime rather than the circuit's: a ping is quick, and leaving
            // the page half-way should not turn a sent ping into a logged cancellation.
            var chosen = FromForm();
            _tested = await Task.Run(() => Alarm.TestAsync(chosen, Lifetime.ApplicationStopping));
        }
        catch (Exception ex)
        {
            _tested = (false, ex.GetBaseException().Message);
        }
        finally
        {
            _busy = _testing = false;
        }
    }

    private void OnChanged()
    {
        if (!_disposed)
            _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        Alarm.Changed -= OnChanged;
    }
}
