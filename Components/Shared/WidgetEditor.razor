@implements IDisposable
@inject Registry Registry
@inject ConfigStore Config
@inject HistoryStore History
@inject Offload Offload

<Modal Title="@($"Edit {_type?.DisplayName ?? "widget"}")" OnClose="OnClose">
    <ChildContent>
    @if (Widget.Type == PageBlocks.Section)
    {
        @* Which page a section shows. Only the kinds a section may hold are offered, so the
           guard in PageBlocks.CanEmbed is a backstop for imported files rather than
           something a person can walk into from here. *@
        <div class="mb-3">
            <label class="form-label" for="section-kind">Page</label>
            <select id="section-kind" class="form-select" value="@PageBlocks.SectionKind(_settings)"
                    @onchange="e => ChooseKind(e.Value?.ToString())">
                <option value="">— choose —</option>
                @foreach (var kind in PageBlocks.Embeddable(Registry))
                {
                    <option value="@kind.Kind">@kind.Icon @kind.DisplayName</option>
                }
            </select>
        </div>
    }

    @* A heading and a divider are their text; a title over them would be a second one. *@
    @if (Widget.Type is not (PageBlocks.Heading or PageBlocks.Divider))
    {
        <div class="mb-3">
            <label class="form-label" for="widget-title">@(Widget.Type == PageBlocks.Section ? "Heading" : "Title")</label>
            <input id="widget-title" class="form-control" @bind="_title" @bind:event="oninput"
                   placeholder="@(Widget.Type == PageBlocks.Section ? "Leave blank to use the page's own name" : "Leave blank to hide the header")" />
        </div>
    }

    @if (_type?.NeedsConnection == true)
    {
        <div class="mb-3">
            <label class="form-label" for="widget-connection">Connection</label>
            <select id="widget-connection" class="form-select" @bind="_connectionId" @bind:after="LoadMetricsAsync">
                <option value="">— choose —</option>
                @foreach (var connection in _candidates)
                {
                    <option value="@connection.Id">@connection.Name (@ProviderName(connection))</option>
                }
            </select>
            @if (_candidates.Count == 0)
            {
                <div class="form-text text-warning">
                    No compatible connection exists yet. <a href="settings/connections">Add one</a> first.
                </div>
            }
        </div>
    }

    <div class="mb-3">
        <label class="form-label" for="widget-width">Width</label>
        <select id="widget-width" class="form-select" @bind="_width">
            <option value="2">Tiny (1/6)</option>
            <option value="3">Small (1/4)</option>
            <option value="4">Medium (1/3)</option>
            <option value="6">Half</option>
            <option value="8">Two thirds</option>
            <option value="12">Full width</option>
        </select>
    </div>

    @if (PageLayout)
    {
        <div class="mb-3">
            <label class="form-label" for="widget-height">Height</label>
            <select id="widget-height" class="form-select" @bind="_height">
                <option value="0">Fit the content</option>
                @for (var rows = 1; rows <= PageBlocks.MaxRows; rows++)
                {
                    <option value="@rows">@rows row@(rows == 1 ? "" : "s")</option>
                }
            </select>
            <div class="form-text">A fixed height scrolls whatever does not fit. Phones always fit the content.</div>
        </div>
    }

    @if (_type is not null)
    {
        <SettingsForm Fields="_fields" Values="_settings"
                      DynamicOptions="Suggestions"
                      EmptyMessage="@(Widget.Type == PageBlocks.Section ? "That page has nothing to configure." : "This widget has nothing to configure.")" />
    }
    </ChildContent>

    <Footer>
        <button class="btn btn-secondary btn-sm" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public Widget Widget { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Offer a height as well as a width — on a custom page, the only place one means anything.</summary>
    [Parameter] public bool PageLayout { get; set; }

    private IWidgetType? _type;
    private List<Connection> _candidates = [];
    private IReadOnlyList<SelectOption> _metricOptions = [];

    private string _title = "";
    private string _connectionId = "";
    private int _width = 4;
    private int _height;
    private IReadOnlyList<FieldSpec> _fields = [];
    private SettingsBag _settings = new();
    private BackgroundLoad _recorded = default!;

    protected override async Task OnInitializedAsync()
    {
        _recorded = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        _type = Registry.WidgetType(Widget.Type);
        _title = Widget.Title;
        _connectionId = Widget.ConnectionId ?? "";
        _width = Widget.Width;
        _height = PageBlocks.ClampRows(Widget.Height);
        // Edit a copy so cancelling actually cancels.
        _settings = Widget.Settings.Clone();
        _fields = PageBlocks.FieldsFor(Registry, Widget.Type, _settings);

        var connections = await Config.ConnectionsAsync();
        _candidates = _type is null ? [] : [.. connections.Where(c => Registry.Accepts(_type, c.Provider))];
        await LoadMetricsAsync();
    }

    /// <summary>
    /// What to offer for a metric field: everything the provider declares, plus anything
    /// history has actually recorded that it did not. The union matters — a declared
    /// metric is offered before the first probe lands, and an undeclared one a provider
    /// really reports is offered once it has.
    /// </summary>
    private async Task LoadMetricsAsync()
    {
        if (_type?.Fields.All(f => f.Kind != FieldKind.Metric) != false || _connectionId.Length == 0)
        {
            _metricOptions = [];
            _recorded.Cancel();
            return;
        }

        var connectionId = _connectionId;
        var connection = await Config.ConnectionAsync(connectionId);
        if (connectionId != _connectionId)
            return; // Changed again while that was looked up; the newer call has it.
        var declared = Registry.MetricsFor(connection);

        // What the provider declares is offered straight away, so the form is usable at
        // once; what history has recorded is a query, run off the render thread and
        // added when it lands (see BackgroundLoad). Switching connection again before it
        // does makes the older answer stale, and it is dropped rather than shown.
        _metricOptions = Options(declared, []);
        _ = _recorded.Load(
            connectionId,
            ct => Offload.Run(c => History.MetricsAsync(connectionId, c), ct),
            recorded => _metricOptions = Options(declared, recorded));
    }

    private static List<SelectOption> Options(IEnumerable<MetricSpec> declared, IReadOnlyList<string> recorded)
    {
        var options = declared.Select(m => new SelectOption(m.Key, m.Label)).ToList();
        var known = options.Select(o => o.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        options.AddRange(recorded
            .Where(key => !known.Contains(key))
            .Select(key => new SelectOption(key, MetricSpec.Fallback(key).Label + " (recorded)")));
        return options;
    }

    public void Dispose() => _recorded?.Dispose();

    /// <summary>
    /// A section pointed at another page takes that page's form. Settings already typed are
    /// kept rather than cleared: two kinds sharing a key — both have a subtitle — carry it
    /// over, and switching back finds what was there.
    /// </summary>
    private void ChooseKind(string? kind)
    {
        _settings[PageBlocks.KindKey] = kind ?? string.Empty;
        _fields = PageBlocks.FieldsFor(Registry, Widget.Type, _settings);
    }

    private IReadOnlyList<SelectOption> Suggestions(FieldSpec field) =>
        field.Kind == FieldKind.Metric ? _metricOptions : field.Options ?? [];

    private string ProviderName(Connection connection) =>
        Registry.Provider(connection.Provider)?.DisplayName ?? connection.Provider;

    private async Task SaveAsync()
    {
        await Config.SaveWidgetAsync(Widget with
        {
            Title = _title,
            ConnectionId = _connectionId.Length > 0 ? _connectionId : null,
            Width = _width,
            Height = _height,
            Settings = _settings,
        });
        await OnClose.InvokeAsync();
    }
}
