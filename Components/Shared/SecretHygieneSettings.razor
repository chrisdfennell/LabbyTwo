@implements IDisposable
@inject SecretHygiene Hygiene
@inject AppSettingsStore AppSettings
@inject Offload Offload

@* Secrets written in plain text into containers' settings. On the Settings page rather than
   the Containers tab because it is a check somebody runs now and then, like a backup test,
   not something to watch; and it covers every Docker host at once, where a Containers tab
   is one host.

   Nothing here ever has a value to show. The findings it is given carry the container, the
   name, the kind and the length — see SecretFinding — so the page cannot leak what it was
   never handed. *@

<div class="widget">
    <div class="widget-head">
        <h2 class="widget-title">Secrets in containers</h2>
        <span class="tile-meta">@StatusText</span>
    </div>
    <div class="widget-body">
        <p class="tile-meta">
            Looks through every container's environment, command and labels for passwords, tokens and
            keys written in plain text — the kind that end up in a compose file you paste into a chat
            or push to GitHub. It only ever says which variable and what it looks like; the values
            are never shown, logged or stored.
        </p>

        <div class="d-flex gap-2 flex-wrap align-items-center mb-2">
            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="CheckAsync">
                @(_busy ? "Checking…" : _report is null ? "Check now" : "Check again")
            </button>
            @if (_message is { Length: > 0 })
            {
                <span class="tile-meta">@_message</span>
            }
        </div>

        <div class="d-flex flex-wrap gap-3 mb-2">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="secrets-daily"
                       checked="@_daily" @onchange="e => SaveAsync(SecretHygiene.DailyKey, e.Value is true)" />
                <label class="form-check-label" for="secrets-daily">Check once a day</label>
            </div>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="secrets-stopped"
                       checked="@_stopped" @onchange="e => SaveAsync(SecretHygiene.StoppedKey, e.Value is true)" />
                <label class="form-check-label" for="secrets-stopped">Include stopped containers</label>
            </div>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="secrets-notify"
                       checked="@_notify" @onchange="e => SaveAsync(SecretHygiene.NotifyKey, e.Value is true)" />
                <label class="form-check-label" for="secrets-notify">Tell me when a recreated container gains a high-severity one</label>
            </div>
        </div>

        @if (_report is { } report)
        {
            <hr class="my-3" />

            @foreach (var problem in report.Problems)
            {
                <div class="alert alert-warning py-2">@problem</div>
            }

            <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                <strong>@report.Summary</strong>
                @if (report.Findings.Count > 0)
                {
                    <select id="secrets-severity" class="form-select form-select-sm" style="width: auto"
                            value="@_minimum.ToString()" @onchange="e => _minimum = Enum.Parse<SecretSeverity>(e.Value?.ToString() ?? nameof(SecretSeverity.Low))">
                        <option value="@nameof(SecretSeverity.Low)">Every severity</option>
                        <option value="@nameof(SecretSeverity.Medium)">Medium and high</option>
                        <option value="@nameof(SecretSeverity.High)">High only</option>
                    </select>
                }
                @if (report.IgnoredCount > 0)
                {
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="secrets-show-ignored"
                               checked="@_showIgnored" @onchange="e => _showIgnored = e.Value is true" />
                        <label class="form-check-label" for="secrets-show-ignored">Show @report.IgnoredCount ignored</label>
                    </div>
                }
            </div>

            @if (report.Active.Count > 0)
            {
                <p class="tile-meta">
                    LabbyTwo reads what Docker was given, so it cannot tell a value written in the compose
                    file from one that came from an .env file — both end up in the same place. Once you
                    have moved one out, ignore it here.
                </p>
            }

            @foreach (var group in Shown(report).GroupBy(f => f.Container))
            {
                <div class="mb-3" data-container="@group.Key">
                    <div class="fw-semibold mb-1">@group.Key</div>
                    <ul class="list-unstyled mb-0">
                        @foreach (var finding in group)
                        {
                            <li class="mb-2 @(finding.Ignored ? "opacity-50" : "")">
                                <span class="badge @BadgeClass(finding.Severity) me-1">@finding.SeverityText</span>
                                <code>@finding.Name</code>
                                <span class="tile-meta">— @finding.Kind in its @finding.Where, @finding.Fingerprint@(finding.Weak ? ", looks like a placeholder" : "")</span>
                                @if (finding.SameValueAs.Count > 0)
                                {
                                    <span class="tile-meta">. The same value is in @string.Join(", ", finding.SameValueAs).</span>
                                }
                                @if (finding.Ignored)
                                {
                                    <button class="btn btn-link btn-sm py-0" disabled="@_busy" @onclick="() => IgnoreAsync(finding, false)">Stop ignoring</button>
                                }
                                else
                                {
                                    <button class="btn btn-link btn-sm py-0" disabled="@_busy" @onclick="() => IgnoreAsync(finding, true)">Ignore</button>
                                }
                                <details class="small ms-1">
                                    <summary>What to do</summary>
                                    <ul class="mb-0">
                                        @foreach (var line in finding.Advice)
                                        {
                                            <li>@line</li>
                                        }
                                    </ul>
                                </details>
                            </li>
                        }
                    </ul>
                </div>
            }
        }

        <div class="form-text">
            Reading containers' settings through a socket proxy needs <code>CONTAINERS=1</code> on it.
        </div>
    </div>
</div>

@code {
    private SecretReport? _report;
    private bool _daily;
    private bool _stopped;
    private bool _notify;
    private bool _busy;
    private bool _showIgnored;
    private SecretSeverity _minimum = SecretSeverity.Low;
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        _report = Hygiene.Latest;
        Hygiene.Updated += OnUpdated;
        var bag = await AppSettings.AllAsync();
        _daily = bag.GetBool(SecretHygiene.DailyKey);
        _stopped = bag.GetBool(SecretHygiene.StoppedKey);
        _notify = bag.GetBool(SecretHygiene.NotifyKey);
    }

    private void OnUpdated() => _ = InvokeAsync(() =>
    {
        _report = Hygiene.Latest;
        StateHasChanged();
    });

    private string StatusText => _report is { } report
        ? $"Last checked {report.At.ToLocalTime():ddd d MMM HH:mm}."
        : _daily ? "Checks once a day." : "Not checked since LabbyTwo started.";

    private IEnumerable<SecretFinding> Shown(SecretReport report) =>
        report.Findings.Where(f => f.Severity >= _minimum && (_showIgnored || !f.Ignored));

    private static string BadgeClass(SecretSeverity severity) => severity switch
    {
        SecretSeverity.High => "text-bg-danger",
        SecretSeverity.Medium => "text-bg-warning",
        _ => "text-bg-secondary",
    };

    private async Task CheckAsync()
    {
        _busy = true;
        _message = "";
        try
        {
            // Offloaded: a check is a request per container and a settings write, and awaited
            // on the render thread the "Checking…" state would never draw.
            _report = await Offload.Run(Hygiene.CheckAsync);
        }
        catch (Exception ex)
        {
            _message = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task IgnoreAsync(SecretFinding finding, bool ignore)
    {
        _busy = true;
        try
        {
            await Offload.Run(async ct =>
            {
                await Hygiene.SetIgnoredAsync(finding, ignore, ct);
                return true;
            });
            _report = Hygiene.Latest;
        }
        catch (Exception ex)
        {
            _message = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync(string key, bool on)
    {
        await AppSettings.SaveAsync(key, on ? "true" : "false");
        switch (key)
        {
            case SecretHygiene.DailyKey: _daily = on; break;
            case SecretHygiene.StoppedKey: _stopped = on; break;
            case SecretHygiene.NotifyKey: _notify = on; break;
        }

        // Switching notifications on starts from what is there now, so the first recreate
        // after it announces only what is new rather than everything already known.
        if (key == SecretHygiene.NotifyKey && on && _report is null)
            await CheckAsync();
    }

    public void Dispose() => Hygiene.Updated -= OnUpdated;
}
