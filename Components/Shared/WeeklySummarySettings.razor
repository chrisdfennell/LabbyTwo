@inject AppSettingsStore AppSettings
@inject AlertService Alerts
@inject WeeklySummaryJob Summary

@* The weekly summary. Its own component rather than more of Settings.razor, which is long
   enough already; it lives on the Settings page because that is where somebody looks for
   "what does LabbyTwo send me, and when". *@

<div class="widget">
    <div class="widget-head">
        <h2 class="widget-title">Weekly summary</h2>
        <span class="tile-meta">@StatusText</span>
    </div>
    <div class="widget-body">
        <p class="tile-meta">
            A short note once a week through your alert channels: uptime, outages and how long they
            lasted, disks that are filling, certificates and renewals coming up, the slowest and
            least reliable services, internet speed, and what changed. Sections with nothing to say
            are left out.
        </p>

        @if (_channels.Count == 0)
        {
            <div class="alert alert-warning py-2">
                There is no alert channel to send it through yet.
                <a href="settings/connections">Add a webhook, Pushover, email or ntfy channel</a> first.
            </div>
        }

        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="weekly-enabled"
                           checked="@_schedule.Enabled" @onchange="e => ToggleAsync(e.Value is true)" />
                    <label class="form-check-label" for="weekly-enabled">Send it every week</label>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="weekly-day">On</label>
                <select id="weekly-day" class="form-select" value="@_schedule.Day.ToString()"
                        @onchange="e => SaveAsync(_schedule with { Day = Enum.Parse<DayOfWeek>(e.Value?.ToString() ?? nameof(DayOfWeek.Monday)) })">
                    @foreach (var day in Days)
                    {
                        <option value="@day.ToString()">@day</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="weekly-time">At</label>
                <input id="weekly-time" type="time" class="form-control"
                       value="@_schedule.Time.ToString("HH\\:mm")"
                       @onchange="e => SaveTimeAsync(e.Value?.ToString())" />
            </div>
        </div>

        @if (_channels.Count > 1)
        {
            <div class="mt-3">
                <div class="form-label mb-1">Through</div>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var channel in _channels)
                    {
                        var id = $"weekly-channel-{channel.Id}";
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="@id"
                                   checked="@(_schedule.Channels.Contains(channel.Id))"
                                   @onchange="e => ToggleChannelAsync(channel.Id, e.Value is true)" />
                            <label class="form-check-label" for="@id">@channel.Name</label>
                        </div>
                    }
                </div>
                <div class="form-text">None ticked sends it through every channel.</div>
            </div>
        }

        <p class="tile-meta mt-2 mb-0">
            @if (_policy.QuietHoursOn)
            {
                <text>
                    If that falls in your quiet hours (@_policy.QuietFrom.ToString("HH\\:mm")–@_policy.QuietTo.ToString("HH\\:mm")),
                    it waits until they end.
                </text>
            }
            It is never marked urgent. If LabbyTwo was not running at the time, it is sent once when it
            next starts.
        </p>

        <hr class="my-3" />

        <div class="d-flex gap-2 flex-wrap align-items-center">
            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="PreviewAsync">
                @(_busy && !_sending ? "Working it out…" : "Preview")
            </button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_busy || _channels.Count == 0)" @onclick="SendPreviewAsync">
                @(_sending ? "Sending…" : "Send a preview now")
            </button>
            @if (_message is { Length: > 0 })
            {
                <span class="tile-meta">@_message</span>
            }
        </div>
        <div class="form-text">
            A preview covers the last seven days and does not count as this week's summary.
        </div>

        @if (_preview is { } preview)
        {
            <div class="mt-3">
                <div class="fw-semibold mb-1">@preview.Title</div>
                <pre class="mb-0 small" style="white-space: pre-wrap">@preview.Text</pre>
            </div>
        }
    </div>
</div>

@code {
    private static readonly DayOfWeek[] Days =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    private WeeklySchedule _schedule = WeeklySchedule.Default;
    private AlertPolicy _policy = AlertPolicy.Default;
    private DateTimeOffset? _covered;
    private DateTimeOffset? _lastSent;
    private List<Connection> _channels = [];

    private WeeklyDigest? _preview;
    private bool _busy;
    private bool _sending;
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        _channels = [.. (await Alerts.ChannelsAsync()).Select(pair => pair.Connection).OrderBy(c => c.Name)];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var bag = await AppSettings.AllAsync();
        _schedule = WeeklySchedule.From(bag);
        _policy = AlertPolicy.From(bag);
        _covered = WeeklySchedule.ParseInstant(bag.Get(WeeklySchedule.CoveredKey));
        _lastSent = WeeklySchedule.ParseInstant(bag.Get(WeeklySchedule.LastSentKey));
    }

    private string StatusText
    {
        get
        {
            var last = _lastSent is { } sent ? $"Last sent {sent.ToLocalTime():ddd d MMM HH:mm}." : "";
            if (!_schedule.Enabled)
                return $"Off. {last}".Trim();

            var decision = _schedule.Decide(_covered ?? DateTimeOffset.Now, _policy, DateTimeOffset.Now, TimeZoneInfo.Local);
            var next = decision.SendNow
                ? "Sending shortly."
                : decision.NextAt is { } at ? $"Next {at.ToLocalTime():ddd d MMM HH:mm}." : "";
            return $"{next} {last}".Trim();
        }
    }

    private async Task ToggleAsync(bool on)
    {
        var values = (_schedule with { Enabled = on }).ToSettings();

        // Arming from now is what stops "turn it on on Wednesday" from sending the Monday
        // one straight away as a catch-up. Only when it was off: re-saving while it is on
        // must not push back a summary that is already due.
        if (on && !_schedule.Enabled)
            values[WeeklySchedule.CoveredKey] = WeeklySchedule.FormatInstant(DateTimeOffset.Now);

        await AppSettings.SaveAsync(values);
        await LoadAsync();
    }

    private async Task SaveAsync(WeeklySchedule schedule)
    {
        await AppSettings.SaveAsync(schedule.ToSettings());
        await LoadAsync();
    }

    private Task SaveTimeAsync(string? value) =>
        TimeOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var time)
            ? SaveAsync(_schedule with { Time = time })
            : Task.CompletedTask;

    private Task ToggleChannelAsync(string id, bool on)
    {
        var chosen = _schedule.Channels.Where(c => c != id).ToList();
        if (on)
            chosen.Add(id);
        return SaveAsync(_schedule with { Channels = chosen });
    }

    private async Task PreviewAsync()
    {
        _busy = true;
        _message = "";
        try
        {
            _preview = await Summary.PreviewAsync();
        }
        catch (Exception ex)
        {
            _message = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendPreviewAsync()
    {
        _busy = true;
        _sending = true;
        _message = "";
        try
        {
            _preview = await Summary.PreviewAsync();
            var (sent, attempted, errors) = await Summary.SendAsync(_preview, _schedule.Channels, CancellationToken.None);
            _message = errors.Count == 0
                ? $"Sent through {sent} channel{(sent == 1 ? "" : "s")}."
                : $"Sent through {sent} of {attempted}. {string.Join(" ", errors)}";
        }
        catch (Exception ex)
        {
            _message = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
            _sending = false;
        }
    }
}
