@inject ConfigStore Config
@inject HealthMonitor Health
@inject AlertService Alerts
@inject Registry Registry
@inject RemediationStore Remediations
@inject Offload Offload

<Modal Title="@($"{Provider.Icon} {Provider.DisplayName}")" OnClose="OnClose">
    <ChildContent>
    <p class="tile-meta">@Provider.Description</p>

    @* Opened from a suggestion: say where it came from and why that address, so the person
       reviewing it knows what they are agreeing to before they press Save. *@
    @if (Intro is { Length: > 0 })
    {
        <div class="alert alert-info py-2 small" data-discovered>@Intro</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-8">
            <label class="form-label" for="conn-name">Name</label>
            <input id="conn-name" class="form-control" @bind="_name" @bind:event="oninput" />
        </div>
        <div class="col-4">
            <label class="form-label" for="conn-icon">Icon</label>
            @* Provider is EditorRequired and never null here; a ?. would tell the compiler
               otherwise and make every later use of it a nullable warning. *@
            <EmojiPicker Value="@_icon" Placeholder="@Provider.Icon"
                         ValueChanged="value => _icon = value" />
        </div>
    </div>

    <SettingsForm Fields="Provider.Fields" Values="_settings" Changed="() => _result = null" />

    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="conn-enabled" @bind="_enabled" />
        <label class="form-check-label" for="conn-enabled">
            @(IsAlertChannel ? "Use this channel" : "Monitor this connection")
            <span class="form-text d-block">
                @(IsAlertChannel
                    ? "Off keeps the settings but stops sending notifications here."
                    : "Off keeps the settings but stops probing and hides it from status counts.")
            </span>
        </label>
    </div>

    @if (!IsAlertChannel)
    {
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="conn-alerts" @bind="_alerts" />
            <label class="form-check-label" for="conn-alerts">
                Send alerts when this goes down
                <span class="form-text d-block">Off still records uptime — it just stops the notifications for this one thing.</span>
            </label>
        </div>

        @* One fault, one message. Everything behind a VPN container goes quiet together,
           and eleven notifications for one outage is how people mute the whole app. *@
        <div class="mb-3">
            <label class="form-label" for="conn-depends">Sits behind</label>
            <select id="conn-depends" class="form-select" value="@(_dependsOn ?? "")"
                    @onchange="args => _dependsOn = args.Value?.ToString() is { Length: > 0 } id ? id : null">
                <option value="">Nothing — alert on its own</option>
                @foreach (var other in _candidates)
                {
                    <option value="@other.Id">@other.Icon @other.Name</option>
                }
            </select>
            <div class="form-text">
                Optional. While the thing it sits behind is down, this one's alerts are held —
                a VPN gateway, or the NAS its container runs on. The parent still alerts, and that
                is the message that names the cause.
            </div>
        </div>

        @* Self-healing, for this connection going down. Read once the editor opens, saved
           with the connection, so Cancel leaves it as it was. *@
        @if (_fixLoaded)
        {
            <RemediationEditor Value="_fix" ValueChanged="v => _fix = v" Heading="When this is down…"
                               Trigger="@Remediation.DownTrigger(Draft.Id)" Id="conn-fix"
                               SuggestedContainer="@_name.Trim().ToLowerInvariant().Replace(' ', '-')" />
        }
    }

    @if (_result is { } result)
    {
        <div class="alert @(result.Ok ? "alert-success" : "alert-danger") py-2 mb-0">
            <strong>@(result.Ok ? "Connected" : "Failed")</strong> — @result.Message
            <span class="d-block small">@($"{result.Duration.TotalMilliseconds:0} ms")</span>
            @if (result.Metrics is { Count: > 0 })
            {
                <div class="small mt-1">
                    Reporting: @string.Join(", ", result.Metrics.Keys.Where(k => k != "latency_ms"))
                </div>
            }
            @* The facts a provider found that are not numbers — a version, which data
               centres a tunnel reaches. Shown here because the Test button is where
               somebody is checking that what they set up is what they meant. *@
            @if (result.Details is { Count: > 0 })
            {
                @foreach (var (label, text) in result.Details)
                {
                    <div class="small">@label: @text</div>
                }
            }
        </div>
    }
    </ChildContent>

    <Footer>
        @if (IsAlertChannel)
        {
            @* Probing a webhook proves nothing, so the meaningful test is an actual message. *@
            <button class="btn btn-outline-secondary btn-sm me-auto" @onclick="SendTestAsync" disabled="@_testing">
                @(_testing ? "Sending…" : "Send test notification")
            </button>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm me-auto" @onclick="TestAsync" disabled="@_testing">
                @(_testing ? "Testing…" : "Test connection")
            </button>
        }
        <button class="btn btn-secondary btn-sm" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public Connection Draft { get; set; } = default!;
    [Parameter, EditorRequired] public IConnectionProvider Provider { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>A sentence shown above the form — where a suggested connection was found, and why that address.</summary>
    [Parameter] public string? Intro { get; set; }

    /// <summary>
    /// Runs Test once the editor opens, when every required field already has a value. For a
    /// suggestion that needs no key — Uptime Kuma, a Pi-hole summary — the first thing the
    /// person sees is whether the proposed address works; one that needs a key waits for it.
    /// </summary>
    [Parameter] public bool TestOnOpen { get; set; }

    private string _name = "";
    private string _icon = "";
    private bool _enabled = true;
    private bool _alerts = true;
    private string? _dependsOn;
    private IReadOnlyList<Connection> _candidates = [];
    private SettingsBag _settings = new();
    private ProbeResult? _result;
    private bool _testing;
    private Remediation? _fix;
    private bool _fixLoaded;

    private bool IsAlertChannel => Provider is IAlertChannel;

    protected override void OnInitialized()
    {
        _name = Draft.Name;
        _icon = Draft.Icon;
        _enabled = Draft.Enabled;
        _alerts = Draft.AlertsEnabled;
        _dependsOn = Draft.DependsOn;
        _settings = Draft.Settings.Clone();
    }

    protected override async Task OnInitializedAsync()
    {
        // Itself excluded, and alert channels too: a webhook is not something a service can
        // be behind, and offering it only invites a dependency that never clears.
        _candidates =
        [
            .. (await Config.ConnectionsAsync())
                .Where(c => c.Id != Draft.Id && Registry.Provider(c.Provider) is not IAlertChannel),
        ];

        if (!IsAlertChannel)
        {
            _fix = await Offload.Run(ct => Remediations.GetAsync(Remediation.DownTrigger(Draft.Id), ct));
            _fixLoaded = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !TestOnOpen || IsAlertChannel)
            return;
        if (Provider.Fields.Any(f => f.Required && string.IsNullOrWhiteSpace(_settings.Get(f.Key, f.Default ?? ""))))
            return;
        await TestAsync();
        StateHasChanged();
    }

    private Connection Current => Draft with
    {
        Name = _name,
        Icon = _icon,
        Enabled = _enabled,
        AlertsEnabled = _alerts,
        DependsOn = _dependsOn,
        Settings = _settings,
    };

    private async Task SendTestAsync()
    {
        _testing = true;
        _result = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            await Alerts.SendTestAsync(Current, cts.Token);
            _result = ProbeResult.Up(TimeSpan.Zero, "Test notification sent — check the channel.");
        }
        catch (Exception ex)
        {
            _result = ProbeResult.Down(TimeSpan.Zero, ex.GetBaseException().Message);
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task TestAsync()
    {
        _testing = true;
        _result = null;
        try
        {
            // The unsaved draft is probed, so Test says something about what is on screen
            // rather than about what was saved earlier.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            _result = await Health.ProbeAsync(Current, cts.Token);
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task SaveAsync()
    {
        var saved = Current;
        await Config.SaveConnectionAsync(saved);
        if (_fixLoaded)
        {
            var trigger = Remediation.DownTrigger(saved.Id);
            var fix = _fix;
            await Offload.Run(async ct =>
            {
                if (fix is null)
                    await Remediations.DeleteAsync(trigger, ct);
                else
                    await Remediations.SaveAsync(fix with { Trigger = trigger }, ct);
                return true;
            });
        }
        // Probe immediately so the tile is green before the user navigates away, rather
        // than sitting on "checking…" until the next sweep. Alert channels are not probed
        // at all — doing so would write a status event for something that is not a service.
        if (Health.IsMonitored(saved))
            _ = Health.RefreshAsync(saved);
        await OnClose.InvokeAsync();
    }
}
