@inject ConfigStore Config
@inject Registry Registry

@* Renders any list of FieldSpec into a form. Providers, widgets and tab kinds all
   describe themselves with FieldSpec and none of them ship UI — this is the one place
   that knows how a field becomes an input, so a new integration needs no Razor at all. *@

@if (Fields.Count == 0 && EmptyMessage is not null)
{
    <p class="text-secondary small mb-0">@EmptyMessage</p>
}

@foreach (var field in Ordinary)
{
    @Render(field)
}

@* Depth without clutter: the rare settings are still here, one click away, and a form
   that opens with fifteen boxes does not stop anybody adding the thing they came for. A
   field the user has already set opens the section for them, so nothing they configured
   can hide. *@
@if (Advanced.Count > 0)
{
    <details class="mb-3" open="@_advancedOpen">
        <summary class="tile-meta" style="cursor: pointer">
            More settings (@Advanced.Count)
        </summary>
        <div class="mt-2">
            @foreach (var field in Advanced)
            {
                @Render(field)
            }
        </div>
    </details>
}

@* One definition of what a field looks like, used by both lists above — the alternative
   was duplicating a hundred lines of switch to put some of them in a disclosure. *@
@{
    RenderFragment Render(FieldSpec field) => @<div class="mb-3">
        @if (field.Kind != FieldKind.Bool)
        {
            <label class="form-label" for="@FieldId(field)">
                @field.Label
                @if (field.Required)
                {
                    <span class="text-danger" title="Required">*</span>
                }
            </label>
        }

        @switch (field.Kind)
        {
            case FieldKind.Bool:
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="@FieldId(field)"
                           checked="@Values.GetBool(field.Key, field.Default == "true")"
                           @onchange="e => SetBool(field, e.Value)" />
                    <label class="form-check-label" for="@FieldId(field)">@field.Label</label>
                </div>
                break;

            case FieldKind.Select:
                <select class="form-select" id="@FieldId(field)"
                        value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                        @onchange="e => Set(field, e.Value)">
                    @foreach (var option in field.Options ?? [])
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                break;

            case FieldKind.Textarea:
                <textarea class="form-control font-monospace" id="@FieldId(field)" rows="4"
                          placeholder="@field.Placeholder"
                          value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                          @onchange="e => Set(field, e.Value)"></textarea>
                break;

            case FieldKind.Markdown:
                <textarea class="form-control font-monospace" id="@FieldId(field)" rows="6"
                          placeholder="@field.Placeholder"
                          value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                          @onchange="e => Set(field, e.Value)"></textarea>
                <MarkdownHintStrip Value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                                   ValueChanged="value => SetValue(field, value)" />
                break;

            case FieldKind.Password:
                @* Never echo a stored secret back to the browser. An empty box means
                   "keep what is saved", which is also what makes editing safe. *@
                <input type="password" class="form-control" id="@FieldId(field)" autocomplete="new-password"
                       placeholder="@SecretPlaceholder(field)"
                       @onchange="e => SetSecret(field, e.Value)" />
                break;

            case FieldKind.Number:
                <input type="number" class="form-control" id="@FieldId(field)"
                       placeholder="@field.Placeholder"
                       value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                       @onchange="e => Set(field, e.Value)" />
                break;

            case FieldKind.Icon:
                <EmojiPicker Value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                             ValueChanged="value => SetValue(field, value)" />
                break;

            case FieldKind.LinkList:
                <LinkListEditor Value="@Values.Get(field.Key)" ValueChanged="json => SetValue(field, json)" />
                break;

            case FieldKind.Connection:
                @* Picked by name, stored by id. Asking somebody to find an id and type it
                   was the least friendly thing in here, and it was in six places. *@
                <select class="form-select" id="@FieldId(field)"
                        value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                        @onchange="e => Set(field, e.Value)">
                    <option value="">@(Candidates(field).Count == 1
                        ? $"Use {Candidates(field)[0].Name}, the only one"
                        : "Choose…")</option>
                    @foreach (var option in Candidates(field))
                    {
                        <option value="@option.Id">@option.Icon @option.Name</option>
                    }
                </select>
                @if (Candidates(field).Count == 0)
                {
                    <div class="form-text">
                        Nothing suitable is connected yet.
                        <a href="settings/connections">Add one</a> and come back.
                    </div>
                }
                break;

            case FieldKind.Provider:
                <select class="form-select" id="@FieldId(field)"
                        value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                        @onchange="e => Set(field, e.Value)">
                    <option value="">Any</option>
                    @foreach (var provider in Registry.Providers)
                    {
                        <option value="@provider.Type">@provider.Icon @provider.DisplayName</option>
                    }
                </select>
                break;

            case FieldKind.Metric:
                @* A datalist suggests without restricting: the provider's declared metrics
                   and whatever history has recorded are offered, but a name neither knows
                   about can still be typed, which matters for providers that report more
                   than they document. *@
                <input type="text" class="form-control font-monospace" id="@FieldId(field)"
                       list="@($"{FieldId(field)}-options")" placeholder="@field.Placeholder"
                       value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                       @onchange="e => Set(field, e.Value)" />
                <datalist id="@($"{FieldId(field)}-options")">
                    @foreach (var option in Suggestions(field))
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </datalist>
                break;

            default:
                <input type="@(field.Kind == FieldKind.Url ? "url" : "text")" class="form-control" id="@FieldId(field)"
                       placeholder="@field.Placeholder"
                       value="@Values.Get(field.Key, field.Default ?? string.Empty)"
                       @onchange="e => Set(field, e.Value)" />
                break;
        }

        @if (field.Help is { Length: > 0 })
        {
            <div class="form-text">@field.Help</div>
        }
    </div>;
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FieldSpec> Fields { get; set; } = [];

    // Named "spec" rather than "field": inside a property accessor, C# 14 treats "field"
    // as the keyword for a synthesised backing field, and a lambda parameter of that name
    // is a compile error with a genuinely baffling message.
    private IReadOnlyList<FieldSpec> Ordinary => [.. Fields.Where(spec => !spec.Advanced)];
    private IReadOnlyList<FieldSpec> Advanced => [.. Fields.Where(spec => spec.Advanced)];

    /// <summary>
    /// Opened when one of the hidden fields already holds a value, so a setting somebody
    /// deliberately changed can never be invisible on the form that owns it.
    /// </summary>
    private bool _advancedOpen;

    /// <summary>Mutated in place; the parent saves it when the user submits.</summary>
    [Parameter, EditorRequired] public SettingsBag Values { get; set; } = new();

    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>
    /// Options a field can only know at runtime — the metrics of whichever connection is
    /// currently selected, say. The form stays generic; the caller supplies the context.
    /// </summary>
    [Parameter] public Func<FieldSpec, IReadOnlyList<SelectOption>>? DynamicOptions { get; set; }

    private IReadOnlyList<SelectOption> Suggestions(FieldSpec field) =>
        DynamicOptions?.Invoke(field) ?? field.Options ?? [];

    private IReadOnlyList<Connection> _connections = [];

    /// <summary>
    /// What a connection field may point at. Alert channels are never offered: nothing is
    /// "bound to" a webhook, and listing it only invites a choice that cannot work.
    /// </summary>
    private IReadOnlyList<Connection> Candidates(FieldSpec field) =>
    [
        .. _connections
            .Where(c => Registry.Provider(c.Provider) is not IAlertChannel)
            .Where(c => field.ProviderFilter is not { Length: > 0 } wanted
                || c.Provider.Equals(wanted, StringComparison.OrdinalIgnoreCase)),
    ];

    /// <summary>Keys whose stored secret existed when the form opened, for the placeholder text.</summary>
    private HashSet<string> _storedSecrets = new(StringComparer.OrdinalIgnoreCase);

    private readonly string _formId = Ids.New();

    protected override void OnParametersSet()
    {
        _storedSecrets = [.. Fields.Where(f => f.IsSecret && Values.Get(f.Key).Length > 0).Select(f => f.Key)];

        // Seed defaults so what gets saved matches what the form showed.
        foreach (var field in Fields.Where(f => f.Default is { Length: > 0 } && !Values.ContainsKey(f.Key)))
            Values[field.Key] = field.Default!;

        // Compared against the default rather than merely present, since defaults are
        // seeded above and would otherwise open the section on every form that has one.
        _advancedOpen = Advanced.Any(spec =>
            Values.Get(spec.Key) is { Length: > 0 } value && value != (spec.Default ?? ""));
    }

    protected override async Task OnParametersSetAsync()
    {
        // Only when something on this form actually needs them.
        if (Fields.Any(field => field.Kind == FieldKind.Connection))
            _connections = await Config.ConnectionsAsync();
    }

    private string FieldId(FieldSpec field) => $"f-{_formId}-{field.Key}";

    private string? SecretPlaceholder(FieldSpec field) =>
        _storedSecrets.Contains(field.Key) ? "•••••••• saved — type to replace" : field.Placeholder;

    private Task Set(FieldSpec field, object? value) => SetValue(field, value?.ToString() ?? string.Empty);

    private Task SetBool(FieldSpec field, object? value) =>
        SetValue(field, value is bool flag && flag ? "true" : "false");

    private async Task SetValue(FieldSpec field, string value)
    {
        Values[field.Key] = value;
        await Changed.InvokeAsync();
    }

    private async Task SetSecret(FieldSpec field, object? value)
    {
        // Blank means "leave the saved secret alone" — only overwrite on a real entry.
        var text = value?.ToString() ?? string.Empty;
        if (text.Length == 0)
            return;
        await SetValue(field, text);
    }
}
