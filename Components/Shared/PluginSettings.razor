@inject ModuleCatalog Catalog
@inject IHttpClientFactory HttpFactory
@inject AppSettingsStore AppSettings
@inject SelfUpdater Updater

@* The "Plugins" card from the old single Settings page, moved to Settings → System
   unchanged. *@

<div class="widget" id="plugins">
    <div class="widget-head"><h2 class="widget-title">Plugins</h2></div>
    <div class="widget-body">
        <p class="tile-meta">
            Any .NET assembly in this folder is scanned at startup and anything it declares —
            providers, widgets, tab kinds, importers, endpoints — joins the lists above.
            Restart to pick up a change.
        </p>
        <p class="font-monospace small mb-2">@Catalog.PluginDirectory</p>

        @* The folder is inside the container. A DLL copied next to the compose file
           on the host is nowhere near it, which is the usual reason a plugin "does
           nothing" — so say which of the two situations this is. *@
        @if (!Catalog.PluginDirectoryExists)
        {
            <div class="alert alert-warning py-2">
                That folder does not exist, so nothing was scanned. In Docker it lives in the
                data volume, not beside your compose file:
                <pre class="mb-0 mt-2"><code>docker exec @ContainerHint mkdir -p /app/data/plugins
docker cp YourPlugin.dll @(ContainerHint):/app/data/plugins/
docker compose restart labbytwo</code></pre>
            </div>
        }
        else if (Catalog.DllsFound == 0)
        {
            <p class="tile-meta mb-0">
                The folder is there and empty — no .dll files in it. Copy one in and restart.
            </p>
        }
        else if (!Catalog.Plugins.Any() && Catalog.Failures.Count == 0)
        {
            <p class="tile-meta mb-0">
                @Catalog.DllsFound file(s) were scanned, and none declared a provider, widget,
                tab kind, importer or endpoint. A plugin's classes have to be <code>public</code>,
                top level and not abstract to be found.
            </p>
        }

        @foreach (var plugin in Catalog.Plugins)
        {
            <div class="panel p-2 mb-2">
                <div class="d-flex gap-2 align-items-baseline flex-wrap">
                    <strong>@plugin.Name</strong>
                    <span class="tile-meta">@plugin.Version</span>
                    <span class="tile-meta">· @plugin.TypeCount extension(s)</span>
                </div>
                <div class="tile-meta font-monospace" style="word-break: break-all">@plugin.Path</div>

                @* Said here, while everything still works, rather than left for the
                   render that throws. A plugin built against another LabbyTwo often
                   loads perfectly until the one type that moved is touched. *@
                @if (Catalog.BuiltForAnother(plugin))
                {
                    <div class="tile-meta text-warning mt-1">
                        Built for LabbyTwo @plugin.Version, and this is @Catalog.HostVersion.
                        It may work; if part of it is missing or a page fails to open, that is why.
                        Each release publishes a matching copy of every bundled plugin.
                    </div>
                }
            </div>
        }

        @foreach (var failure in Catalog.Failures)
        {
            <div class="alert alert-warning py-2 mb-2">
                <div class="font-monospace small" style="word-break: break-all">@failure.Path</div>
                @failure.Reason
            </div>
        }

        @* Browse what this release publishes, and install without a terminal. The
           catalogue is the release itself: every bundled plugin is attached to it, so
           there is no index to keep in step with what actually ships. *@
        <hr class="my-3" />

        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
            <button class="btn btn-sm btn-outline-secondary" disabled="@_browsing"
                    @onclick="BrowseAsync">
                @(_browsing ? "Looking…" : _available is null ? "Browse available plugins" : "Refresh the list")
            </button>
            @if (_available is not null)
            {
                <span class="tile-meta">@_available.Count published for @Catalog.HostVersion</span>
            }
        </div>

        @if (_browseError is { Length: > 0 })
        {
            <div class="tile-meta text-warning mb-2">@_browseError</div>
        }

        @if (_available is { Count: > 0 })
        {
            <div class="plugin-catalogue mb-2">
                @foreach (var plugin in _available)
                {
                    var installed = IsInstalled(plugin.Name);
                    <div class="plugin-row">
                        <span class="plugin-name text-truncate" title="@plugin.Name">
                            @Short(plugin.Name)
                        </span>
                        <span class="tile-meta flex-none">@Download(plugin.Bytes)</span>

                        @if (installed)
                        {
                            <span class="badge text-bg-secondary flex-none">installed</span>
                            <button class="btn btn-sm btn-outline-danger flex-none"
                                    disabled="@(_workingOn is { Length: > 0 })"
                                    @onclick="() => RemovePluginAsync(plugin.Name)">Remove</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary flex-none ms-auto"
                                    disabled="@(_workingOn is { Length: > 0 })"
                                    @onclick="() => InstallPluginAsync(plugin.Name)">
                                @(_workingOn == plugin.Name ? "Installing…" : "Install")
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="form-text mb-3">
                Installed into your plugins folder and loaded on the next start — assemblies are
                read while LabbyTwo boots, so nothing appears until it restarts. There is a button
                for that under Updates.
            </div>
        }

        @if (Catalog.Plugins.Any())
        {

            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <button class="btn btn-sm btn-outline-secondary" disabled="@_updatingPlugins"
                        @onclick="UpdatePluginsAsync">
                    @(_updatingPlugins ? "Updating…" : "Update plugins now")
                </button>

                <div class="form-check form-switch mb-0 ms-2">
                    <input class="form-check-input" type="checkbox" id="plugin-auto"
                           checked="@_pluginAuto" @onchange="TogglePluginAutoAsync" />
                    <label class="form-check-label" for="plugin-auto">Update them on every restart</label>
                </div>
            </div>

            @if (_pluginResult is { Length: > 0 })
            {
                <div class="tile-meta mt-1">@_pluginResult</div>
            }

            <div class="form-text">
                Downloads the copy of each installed plugin published for
                @(Catalog.HostVersion is { Length: > 0 } v ? v : "this version"), from the same
                release this LabbyTwo came from. A plugin that is not one of the bundled ones has
                nothing published under its name and is left alone. <strong>Restart to load
                them</strong> — a DLL already in memory is not replaced by rewriting the file,
                which is also why the automatic one runs during startup rather than after it.
            </div>
        }
    </div>
</div>

@code {
    // ---- installing plugins ----

    private IReadOnlyList<PluginUpdater.Available>? _available;
    private bool _browsing;
    private string _browseError = "";
    private string _workingOn = "";

    /// <summary>
    /// Every plugin here is called LabbyTwo.SomethingPlugin, and a column of that prefix
    /// repeated fourteen times is fourteen chances to read the wrong row.
    /// </summary>
    private static string Short(string name) =>
        name.StartsWith("LabbyTwo.", StringComparison.Ordinal) ? name["LabbyTwo.".Length..] : name;

    /// <summary>The archive size. Named Download because Size is already the database's.</summary>
    private static string Download(long bytes) =>
        bytes <= 0 ? "" : bytes < 1024 * 1024 ? $"{bytes / 1024} KB" : $"{bytes / 1024d / 1024d:0.#} MB";

    /// <summary>
    /// Matched against what discovery actually loaded rather than against the folder, so a
    /// DLL that is present and broken does not read as installed and working.
    /// </summary>
    private bool IsInstalled(string name) =>
        Catalog.Plugins.Any(plugin => string.Equals(plugin.Name, name, StringComparison.OrdinalIgnoreCase));

    private async Task BrowseAsync()
    {
        _browsing = true;
        _browseError = "";
        try
        {
            _available = await PluginUpdater.AvailableAsync(Catalog.HostVersion, HttpFactory.CreateClient());
        }
        catch (Exception ex)
        {
            _available = null;
            _browseError = ex.GetBaseException().Message;
        }
        finally
        {
            _browsing = false;
        }
    }

    private async Task InstallPluginAsync(string name)
    {
        _workingOn = name;
        _pluginResult = "";
        try
        {
            await PluginUpdater.InstallAsync(
                Catalog.PluginDirectory, Catalog.HostVersion, name, HttpFactory.CreateClient());

            _pluginResult = $"Installed {Short(name)}. Restart LabbyTwo to load it.";
        }
        catch (Exception ex)
        {
            _pluginResult = ex.GetBaseException().Message;
        }
        finally
        {
            _workingOn = "";
        }
    }

    private Task RemovePluginAsync(string name)
    {
        _workingOn = name;
        try
        {
            var removed = PluginUpdater.Remove(Catalog.PluginDirectory, name);

            _pluginResult = removed.Count > 0
                ? $"Removed {removed.Count} file(s) for {Short(name)}. Restart LabbyTwo to unload it."
                : $"Nothing of {Short(name)} left to remove — restart to unload it.";
        }
        catch (Exception ex)
        {
            _pluginResult = ex.GetBaseException().Message;
        }
        finally
        {
            _workingOn = "";
        }
        return Task.CompletedTask;
    }

    // ---- keeping the plugins in step with the host ----

    private bool _updatingPlugins;
    private bool _pluginAuto;
    private string _pluginResult = "";

    private async Task UpdatePluginsAsync()
    {
        _updatingPlugins = true;
        _pluginResult = "";
        try
        {
            var http = HttpFactory.CreateClient();
            var result = await PluginUpdater.UpdateAsync(
                Catalog.PluginDirectory, Catalog.HostVersion, http);

            _pluginResult = result.Updated.Count > 0
                ? $"Updated {string.Join(", ", result.Updated)}. Restart LabbyTwo to load them."
                : result.Reason ?? "Everything was already current.";
        }
        catch (Exception ex)
        {
            _pluginResult = ex.GetBaseException().Message;
        }
        finally
        {
            _updatingPlugins = false;
        }
    }

    private async Task TogglePluginAutoAsync(ChangeEventArgs args)
    {
        _pluginAuto = args.Value is true;
        await AppSettings.SaveAsync(PluginUpdater.EnabledKey, _pluginAuto ? "true" : "false");
    }

    /// <summary>This container's name if we know it, so the copy commands can be pasted as-is.</summary>
    private string ContainerHint => _self?.Self?.Container ?? "labbytwo-labbytwo-1";

    private SelfUpdater.Status? _self;

    protected override async Task OnInitializedAsync()
    {
        _pluginAuto = (await AppSettings.AllAsync()).GetBool(PluginUpdater.EnabledKey);

        // Local only: which container this is, for the copy commands above.
        if (!Catalog.PluginDirectoryExists)
            _self = await Updater.StatusAsync();
    }
}
