@implements IDisposable
@inject HealthMonitor Health
@inject QnapProvider Qnap

@if (Context.Connection is null)
{
    <p class="tile-meta mb-0">Not bound to a NAS.</p>
}
else if (_error is { Length: > 0 })
{
    <p class="tile-meta mb-0 text-danger">@_error</p>
}
else if (_info is null)
{
    <p class="tile-meta mb-0">Loading…</p>
}
else
{
    <div class="d-flex flex-wrap gap-4 mb-3">
        <div>
            <div class="tile-meta">Model</div>
            <div>@(_info.Model ?? "—")</div>
        </div>
        <div>
            <div class="tile-meta">Firmware</div>
            <div>@(_info.Firmware ?? "—")</div>
        </div>
        <div>
            <div class="tile-meta">Uptime</div>
            <div>@(_info.Uptime is { } up ? $"{(int)up.TotalDays}d {up.Hours}h" : "—")</div>
        </div>
        <div>
            <div class="tile-meta">CPU</div>
            <div>@(_info.CpuPercent is { } cpu ? $"{cpu:0}%" : "—")</div>
        </div>
        <div>
            <div class="tile-meta">Memory</div>
            <div>@MemoryText</div>
        </div>
        @if (_info.CpuTempC is { } temp)
        {
            <div>
                <div class="tile-meta">CPU temp</div>
                <div>@($"{temp:0}°C")</div>
            </div>
        }
        @if (_info.Fans.Count > 0)
        {
            <div>
                <div class="tile-meta">@(_info.Fans.Count == 1 ? "Fan" : "Slowest fan")</div>
                @* A stopped fan is the failure worth showing, so the slowest is the one
                   that gets the space — an average would hide it behind the others. *@
                <div class="@(SlowestFan < 200 ? "text-danger" : "")">@($"{SlowestFan:0} rpm")</div>
            </div>
        }
    </div>

    @if (_firmware is { Length: > 0 })
    {
        <div class="tile-meta mb-3">⬆️ Firmware @_firmware is available.</div>
    }

    @foreach (var volume in _volumes)
    {
        <div class="mb-2">
            <div class="d-flex justify-content-between tile-meta">
                <span class="text-truncate">@volume.Label</span>
                <span>@Bytes(volume.UsedBytes) / @Bytes(volume.TotalBytes) · @($"{volume.UsedPercent:0}%")</span>
            </div>
            <div class="usage-bar @(volume.UsedPercent >= 90 ? "is-full" : volume.UsedPercent >= 75 ? "is-warn" : "")">
                <span style="width:@volume.UsedPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
            </div>
        </div>
    }

    @* Physical drives, under the volumes they make up. This is the reading that arrives
       before the array notices, so it is worth the space even when everything is fine —
       a healthy list is how you know the check is actually running. *@
    @if (_disks.Count > 0 && ShowDisks)
    {
        <div class="mt-3">
            <div class="tile-meta mb-1">Disks</div>
            @foreach (var disk in _disks)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="status-dot @(disk.IsFailing ? "status-down" : "status-up")"></span>
                    <span class="text-truncate" title="@disk.Model">@disk.Slot</span>
                    <span class="tile-meta ms-auto flex-none">
                        @if (disk.IsFailing)
                        {
                            <span class="text-danger">@disk.Health</span>
                        }
                        @if (disk.TempC is { } diskTemp)
                        {
                            <span class="ms-2">@($"{diskTemp:0}°C")</span>
                        }
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    private QnapProvider.SystemInfo? _info;
    private IReadOnlyList<QnapProvider.VolumeInfo> _volumes = [];
    private IReadOnlyList<QnapProvider.DiskInfo> _disks = [];
    private string? _firmware;
    private string? _error;

    /// <summary>On by default — a card that hides a failing drive is worse than no card.</summary>
    private bool ShowDisks => Context.Widget.Settings.GetBool("show_disks", true);

    private double SlowestFan => _info is { Fans.Count: > 0 } ? _info.Fans.Min(fan => fan.Rpm) : 0;

    private string MemoryText => _info is { TotalMemoryMb: > 0, FreeMemoryMb: not null }
        ? $"{(_info.TotalMemoryMb.Value - _info.FreeMemoryMb.Value) / 1024:0.0} / {_info.TotalMemoryMb.Value / 1024:0.0} GB"
        : "—";

    protected override async Task OnInitializedAsync()
    {
        Health.Updated += OnUpdated;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (Context.Connection is null)
            return;

        // The monitor already proved reachability; skip the calls when it says the NAS is
        // down so a dead host doesn't stall the page for a timeout on every render.
        if (Health.State(Context.Connection.Id) is { IsUp: false } state)
        {
            _error = state.Message;
            return;
        }

        // What the monitor's last probe saw. Asking QTS again from here meant three round
        // trips per card where one would do, and the extra two are the ones that timed out
        // on a busy NAS and reported "Operation canceled" on a machine that was perfectly
        // fine. The card now redraws from the probe, which it already waits for anyway.
        if (Qnap.LatestSnapshot(Context.Connection) is { } latest)
        {
            _info = latest.Info;
            _volumes = latest.Volumes;
            _disks = latest.Disks;
            _firmware = latest.AvailableFirmware;
            _error = null;
            return;
        }

        // Nothing cached yet — a page opened within seconds of a restart. Fetch once, and
        // say something useful if that fails rather than showing the raw exception.
        try
        {
            _info = await Qnap.SystemInfoAsync(Context.Connection, CancellationToken.None);
            _volumes = await Qnap.VolumesAsync(Context.Connection, CancellationToken.None);
            _error = null;

            // SMART is the slowest of the three and the least urgent to have on a first
            // render, so it is allowed to be missing here rather than costing the card its
            // whole display when a busy NAS takes too long over it.
            try
            {
                _disks = await Qnap.DisksAsync(Context.Connection, CancellationToken.None);
            }
            catch
            {
                _disks = [];
            }
        }
        catch (Exception ex)
        {
            _error = ProbeError.Describe(ex, Context.Connection.Settings.Get("host"));
        }
    }

    private static string Bytes(long value)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB", "PB"];
        double size = value;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.#} {units[unit]}";
    }

    private void OnUpdated() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Health.Updated -= OnUpdated;
}
