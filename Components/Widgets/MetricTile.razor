@implements IDisposable
@inject HealthMonitor Health
@inject SharedSeries Series
@inject Offload Offload
@inject Registry Registry

@if (Context.Connection is null)
{
    <p class="tile-meta mb-0">Not bound to a connection.</p>
}
else
{
    <div class="metric-value">
        @if (_value is { } value)
        {
            @value.ToString($"F{Decimals}")
            <span class="metric-unit">@Unit</span>
        }
        else if (_history.Ready)
        {
            <span class="metric-unit">no data yet</span>
        }
        else
        {
            <span class="metric-unit">…</span>
        }
    </div>
    @* On a page where every tile is the same connection, repeating its name four times is
       noise that also wraps the caption onto a second line. *@
    <div class="tile-meta">@Spec.Label@(ShowConnection ? $" · {Context.Connection.Name}" : "")</div>

    @if (Context.Widget.Settings.GetBool("show_sparkline", true))
    {
        <div class="mt-2">
            <Sparkline Values="_series" Label="@Spec.Label" />
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    private double? _value;
    private IReadOnlyList<double> _series = [];
    private BackgroundLoad _history = default!;

    /// <summary>
    /// The newest stored sample, and which series it came from. Kept with its key so a
    /// tile switched to another metric never shows the old metric's number under the new
    /// one's name while the new history is on its way.
    /// </summary>
    private (object Key, double? Value)? _recorded;

    private string Metric => Context.Widget.Settings.Get("metric", "latency_ms");
    // The provider decides what this metric is called and how it reads; the widget's own
    // settings still win, so a user can override a unit they disagree with.
    private MetricSpec Spec => Registry.Metric(Context.Connection, Metric);
    private int Decimals => Math.Clamp(Context.Widget.Settings.GetInt("decimals", Spec.Decimals), 0, 4);
    private string Unit => Context.Widget.Settings.Get("suffix", Spec.Unit);
    private bool ShowConnection => Context.Widget.Settings.GetBool("show_connection", true);

    protected override void OnInitialized()
    {
        _history = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
    }

    protected override void OnParametersSet() => Load(refresh: false);

    private void Load(bool refresh)
    {
        if (Context.Connection is null)
            return;

        var id = Context.Connection.Id;
        var metric = Metric;
        var key = (id, metric);

        // Prefer the live probe; fall back to the last stored sample so a tile still reads
        // sensibly right after a restart, before the first sweep lands.
        //
        // Worked out afresh every time. It used to be kept between loads, so a metric that
        // stopped reporting showed its last value for ever, and switching the tile to
        // another metric in the editor showed the old metric's number under the new one's
        // name.
        ShowValue(key);
        if (_recorded is not { } shown || !Equals(shown.Key, key))
            _series = [];

        // The sparkline and the stored fallback need history: started, not waited for.
        Task<IReadOnlyList<HistoryStore.Sample>> Fetch(CancellationToken ct) =>
            Series.SamplesAsync(id, metric, TimeSpan.FromHours(6), ct);

        void Apply(IReadOnlyList<HistoryStore.Sample> samples)
        {
            _series = [.. samples.Select(s => s.Value)];
            _recorded = (key, samples.Count > 0 ? samples[^1].Value : null);
            ShowValue(key);
        }

        if (refresh)
            _history.Refresh(key, Fetch, Apply);
        else
            _history.Load(key, Fetch, Apply);
    }

    private void ShowValue(object key)
    {
        double? value = null;
        if (Health.State(Context.Connection!.Id)?.Metrics.TryGetValue(Metric, out var live) == true)
            value = live;
        else if (_recorded is { } recorded && Equals(recorded.Key, key))
            value = recorded.Value;
        _value = value;
    }

    private void OnUpdated() => _ = InvokeAsync(() =>
    {
        Load(refresh: true);
        StateHasChanged();
    });

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        _history?.Dispose();
    }
}
