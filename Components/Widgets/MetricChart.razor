@implements IDisposable
@inject HealthMonitor Health
@inject HistoryStore History
@inject SharedSeries Series
@inject Offload Offload
@inject Registry Registry
@inject AppSettingsStore AppSettings
@inject DisplayUnits DisplayUnits
@using System.Globalization

@if (Context.Connection is null)
{
    <p class="tile-meta mb-0">Not bound to a connection.</p>
}
else if (!_load.Ready)
{
    @* Drawn at once and replaced when the history arrives, rather than the page waiting
       for it. Not "nothing recorded": that is a claim about the database, which has not
       answered yet. *@
    <div class="widget-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
}
else if (_primary.Count < 2)
{
    <p class="tile-meta mb-0">
        Nothing recorded yet for <code>@Metric</code>.
        @if (_available.Count > 0)
        {
            <span>This connection reports: @string.Join(", ", _available).</span>
        }
    </p>
}
else
{
    <div class="d-flex justify-content-between tile-meta mb-1 flex-wrap gap-2">
        <span>
            @if (_comparePath.Length > 0)
            {
                @* Two lines share one axis, so the legend has to say which is which. *@
                <span class="series-key series-primary">@Spec.Label</span>
                <span class="series-key series-compare">@CompareSpec.Label</span>
            }
            else
            {
                @Spec.Label
            }
            <span class="opacity-50">· last @Hours h</span>
        </span>
        <span>now @Reading(_primary[^1].Value) · peak @Reading(_high)</span>
    </div>

    <svg viewBox="0 0 100 40" preserveAspectRatio="none" style="width:100%; height:@(Height)px" role="img"
         aria-label="@Spec.Label over the last @Hours hours" data-chart="@_hover">
        @* Three gridlines are enough to read a level off without becoming graph paper. *@
        @foreach (var fraction in new[] { 0.25, 0.5, 0.75 })
        {
            var y = (40 - fraction * 36 - 2).ToString("0.##", CultureInfo.InvariantCulture);
            <line x1="0" y1="@y" x2="100" y2="@y" stroke="var(--edge)" stroke-width="0.4" vector-effect="non-scaling-stroke" />
        }

        <polygon points="@($"0,40 {_primaryPath} 100,40")" fill="var(--accent)" opacity="0.14" />
        <polyline points="@_primaryPath" fill="none" stroke="var(--accent)" stroke-width="1.5"
                  vector-effect="non-scaling-stroke" stroke-linejoin="round" />

        @if (_comparePath.Length > 0)
        {
            @* No fill on the second series: two translucent areas stacked read as a third
               colour and stop either line being followable. *@
            <polyline points="@_comparePath" fill="none" stroke="var(--warn)" stroke-width="1.5"
                      vector-effect="non-scaling-stroke" stroke-linejoin="round" />
        }
    </svg>

    <div class="d-flex justify-content-between tile-meta">
        <span>@_primary[0].At.ToString("HH:mm")</span>
        <span>@_primary[^1].At.ToString("HH:mm")</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    /// <summary>Set by the weather tab so every chart on that page shares one range control.</summary>
    [Parameter] public int? HoursOverride { get; set; }

    [Parameter] public int Height { get; set; } = 150;

    private BackgroundLoad _load = default!;
    private IReadOnlyList<HistoryStore.Sample> _primary = [];
    private IReadOnlyList<string> _available = [];
    private string _primaryPath = "";
    private string _comparePath = "";
    private double _high;
    private string? _hover;
    private Units.Preferences _units => DisplayUnits.Current;

    private string Metric => Context.Widget.Settings.Get("metric", "latency_ms");
    private string CompareMetric => Context.Widget.Settings.Get("compare");
    private MetricSpec Spec => Registry.Metric(Context.Connection, Metric);
    private MetricSpec CompareSpec => Registry.Metric(Context.Connection, CompareMetric);

    private int Hours => HoursOverride
        ?? Math.Clamp(Context.Widget.Settings.GetInt("hours", 24), 1, 24 * 30);

    // Keep a decimal up to three figures: a temperature of 41.5 reading as "42" looks
    // like a rounding bug, while a latency of 250.4 ms gains nothing from the ".4". Never
    // below what the metric asks for, though — 0.01 in of rain reading as 0.0 is worse.
    private string Reading(double value) =>
        Units.Format(Spec, value, _units, Math.Max(Spec.Decimals, Math.Abs(value) < 100 ? 1 : 0));

    protected override void OnInitialized()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
        DisplayUnits.Changed += OnUpdated;
    }

    protected override void OnParametersSet() => Load(refresh: false);

    private sealed record Loaded(
        IReadOnlyList<HistoryStore.Sample> Primary,
        IReadOnlyList<HistoryStore.Sample> Compare,
        IReadOnlyList<string> Available);

    /// <summary>
    /// Starts the history load without waiting for it; see BackgroundLoad. Everything the
    /// query needs is copied out of the parameters first, because the fetch runs on the
    /// thread pool while the parameters belong to the render thread.
    /// </summary>
    private void Load(bool refresh)
    {
        if (Context.Connection is not { } connection)
            return;

        var id = connection.Id;
        var metric = Metric;
        var compareMetric = CompareMetric;
        var hours = Hours;
        var window = TimeSpan.FromHours(hours);

        async Task<Loaded> Fetch(CancellationToken ct)
        {
            var primary = await Series.SamplesAsync(id, metric, window, ct);
            if (primary.Count < 2)
                return new Loaded(primary, [], await Offload.Run(c => History.MetricsAsync(id, c), ct));

            var compare = compareMetric is { Length: > 0 }
                ? await Series.SamplesAsync(id, compareMetric, window, ct)
                : [];
            return new Loaded(primary, compare, []);
        }

        var key = (id, metric, compareMetric, hours);
        if (refresh)
            _load.Refresh(key, Fetch, Apply);
        else
            _load.Load(key, Fetch, Apply);
    }

    private void Apply(Loaded loaded)
    {
        _primary = loaded.Primary;
        _comparePath = "";

        if (_primary.Count < 2)
        {
            _hover = null;
            _available = loaded.Available;
            return;
        }

        var compare = loaded.Compare;

        // Both series are drawn against one scale, so the extremes must come from both —
        // otherwise the second line runs off the top of the box.
        var values = _primary.Select(s => s.Value).Concat(compare.Select(s => s.Value)).ToList();
        var low = values.Min();
        _high = values.Max();
        var range = _high - low;
        var scale = range > 0 ? range : 1;
        var offset = range > 0 ? low : low - 0.5;

        _primaryPath = Plot(_primary, offset, scale);
        if (compare.Count >= 2)
            _comparePath = Plot(compare, offset, scale);

        // Converted here rather than in the script, because the unit the user reads in is
        // something only the server knows — the tooltip and the "now" figure above the chart
        // are then the same number by construction.
        List<ChartHover.Series> series =
        [
            new(_comparePath.Length > 0 ? Spec.Label : "", "var(--accent)",
                [.. _primary.Select(s => Units.Display(s.Value, Spec.Unit, _units).Value)]),
        ];

        if (compare.Count >= 2)
        {
            series.Add(new(CompareSpec.Label, "var(--warn)",
                [.. compare.Select(s => Units.Display(s.Value, CompareSpec.Unit, _units).Value)]));
        }

        _hover = ChartHover.Attribute(
            series,
            Units.Display(0, Spec.Unit, _units).Unit,
            Math.Max(Spec.Decimals, 1),
            _primary[0].At,
            _primary[^1].At);
    }

    private static string Plot(IReadOnlyList<HistoryStore.Sample> samples, double offset, double scale)
    {
        var step = 100d / Math.Max(1, samples.Count - 1);
        return string.Join(' ', samples.Select((sample, index) =>
        {
            var x = index * step;
            var y = 38 - (sample.Value - offset) / scale * 36;
            return $"{x.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)}";
        }));
    }

    // Back onto the dispatcher only to read the parameters; the load itself goes off it.
    private void OnUpdated() => _ = InvokeAsync(() => Load(refresh: true));

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        DisplayUnits.Changed -= OnUpdated;
        _load?.Dispose();
    }
}
