@* Live values and embedded cards are drawn by LiveMarkdown; the card's own id goes with
   them so a card that embeds itself, directly or through another, stops at once. *@

<div class="markdown-body"><LiveMarkdown Content="@Context.Widget.Settings.Get("content")" OwnerId="@Context.Widget.Id" /></div>

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;
}
