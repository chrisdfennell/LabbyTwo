@implements IDisposable
@inject HealthMonitor Health
@inject HistoryStore History
@using System.Globalization

@if (Context.Connection is null)
{
    <p class="tile-meta mb-0">Not bound to a weather station.</p>
}
else if (_current is null)
{
    <p class="tile-meta mb-0">Waiting for the first reading…</p>
}
else
{
    <div class="d-flex align-items-baseline gap-2 mb-2">
        <div class="metric-value">@FormatTemp(_current.Value)</div>
        <div class="tile-meta">now</div>
    </div>

    @if (_low is { } low && _high is { } high && high > low)
    {
        @* Where the current reading sits between the day's extremes — the thing a bare
           high/low pair does not tell you. *@
        <div class="range-track" role="img"
             aria-label="@($"Low {FormatTemp(low)}, high {FormatTemp(high)}, now {FormatTemp(_current.Value)}")">
            <span class="range-marker" style="left:@Position(_current.Value, low, high)%"></span>
        </div>
        <div class="d-flex justify-content-between tile-meta">
            <span>↓ @FormatTemp(low)</span>
            <span>over @_hours h</span>
            <span>↑ @FormatTemp(high)</span>
        </div>
    }
    else
    {
        <div class="tile-meta">Not enough history yet for a high and low.</div>
    }

    <div class="row g-2 mt-2">
        @if (_rain is { } rain)
        {
            <div class="col-6">
                <div class="tile-meta">Rain today</div>
                <div>@(Metric ? $"{rain * 25.4:0.0} mm" : $"{rain:0.00} in")</div>
            </div>
        }
        @if (_trend is { } trend)
        {
            <div class="col-6">
                <div class="tile-meta">Last hour</div>
                <div>@(trend >= 0 ? "↑" : "↓") @FormatDelta(Math.Abs(trend))</div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    private double? _current, _low, _high, _rain, _trend;
    private int _hours;

    private bool Metric => Context.Widget.Settings.Get("units", "imperial") == "metric";

    private string FormatTemp(double celsius) =>
        Metric ? $"{celsius:0.0}°C" : $"{AmbientWeatherProvider.CToF(celsius):0.0}°F";

    /// <summary>A difference, not a reading — so it is a temperature *interval*, and 0°C is not 32°F.</summary>
    private string FormatDelta(double celsius) =>
        Metric ? $"{celsius:0.0}°C" : $"{celsius * 9 / 5:0.0}°F";

    private static string Position(double value, double low, double high) =>
        (Math.Clamp((value - low) / (high - low), 0, 1) * 100).ToString("0.#", CultureInfo.InvariantCulture);

    protected override void OnInitialized() => Health.Updated += OnUpdated;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (Context.Connection is null)
            return;

        _hours = Math.Clamp(Context.Widget.Settings.GetInt("hours", 24), 1, 24 * 7);
        // TryGetValue, not GetValueOrDefault: a missing key yields 0, which is a real
        // temperature, so the fallback to history below would never have run and the
        // card would confidently report freezing.
        var live = Health.State(Context.Connection.Id)?.Metrics;
        _current = live?.TryGetValue("temp_outdoor_c", out var now) == true ? now : null;
        _rain = live?.TryGetValue("rain_in", out var rain) == true ? rain : null;

        if (_current is null || _rain is null)
        {
            var recorded = await History.LatestAsync(Context.Connection.Id, TimeSpan.FromHours(6));
            _current ??= recorded.TryGetValue("temp_outdoor_c", out var lastTemp) ? lastTemp : null;
            _rain ??= recorded.TryGetValue("rain_in", out var lastRain) ? lastRain : null;
        }

        var samples = await History.SamplesAsync(
            Context.Connection.Id, "temp_outdoor_c", TimeSpan.FromHours(_hours));

        if (samples.Count == 0)
        {
            _low = _high = _trend = null;
            return;
        }

        _low = samples.Min(s => s.Value);
        _high = samples.Max(s => s.Value);
        _current ??= samples[^1].Value;

        // Compared against the oldest reading still inside the last hour, so the arrow
        // means "since an hour ago" rather than "since the previous probe".
        var cutoff = DateTimeOffset.Now.AddHours(-1);
        var anHourAgo = samples.FirstOrDefault(s => s.At >= cutoff) ?? samples[0];
        _trend = samples.Count > 1 ? samples[^1].Value - anHourAgo.Value : null;
    }

    private void OnUpdated() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Health.Updated -= OnUpdated;
}
