@implements IDisposable
@inject DisplayUnits DisplayUnits
@inject ConfigStore Config
@inject HealthMonitor Health
@inject SharedSeries SeriesReads
@inject Offload Offload
@inject Registry Registry

@* The same metric from several connections on one axis. The chart card draws one
   connection and can compare two of *its* metrics; this answers the other question — how
   do the three NASes compare, is one of the four hosts hotter than the rest — which
   previously meant three cards and doing the comparison by eye. *@

@if (!_load.Ready)
{
    <div class="widget-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
}
else if (_series.Count == 0)
{
    <p class="tile-meta mb-0">
        Nothing has recorded @Metric yet@(Provider.Length > 0 ? $" for {Provider}" : "").
    </p>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-1">
        @foreach (var series in _series)
        {
            <span class="series-key" style="color: @series.Colour">
                @series.Name <span class="tile-meta">@Format(series.Last)</span>
            </span>
        }
    </div>

    <svg viewBox="0 0 100 40" preserveAspectRatio="none" style="width:100%; height:@(Height)px"
         role="img" aria-label="@($"{Spec.Label} across {_series.Count} connections over {Hours} hours")"
         data-chart="@_hover">
        @foreach (var series in _series)
        {
            <polyline points="@series.Path" fill="none" stroke="@series.Colour" stroke-width="1.5"
                      vector-effect="non-scaling-stroke" stroke-linejoin="round" />
        }
    </svg>

    <div class="d-flex justify-content-between tile-meta">
        <span>@Hours h ago</span>
        <span>@Format(_low) – @Format(_high)</span>
        <span>now</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    private sealed record Series(string Name, string Path, double Last, string Colour);

    private string? _hover;
    private BackgroundLoad _load = default!;

    private List<Series> _series = [];
    private double _low, _high;

    private string Metric => Context.Widget.Settings.Get("metric", "cpu_percent").Trim();
    private string Provider => Context.Widget.Settings.Get("provider").Trim();
    private string Match => Context.Widget.Settings.Get("match").Trim();
    private int Hours => Math.Clamp(Context.Widget.Settings.GetInt("hours", 24), 1, 24 * 30);
    private int Height => Math.Clamp(Context.Widget.Settings.GetInt("height", 120), 60, 500);
    private int Limit => Math.Clamp(Context.Widget.Settings.GetInt("limit", 6), 1, 12);

    private MetricSpec _spec = MetricSpec.Fallback("value");
    private MetricSpec Spec => _spec;

    /// <summary>
    /// The unit every figure on the card is in. The series are converted once, when they
    /// arrive, so the key, the range, the lines and the tooltip are all in the reader's
    /// units and the formatting after that is only decimals.
    /// </summary>
    private string _unit = "";

    /// <summary>What was last loaded, kept so a change of units can redraw without a query.</summary>
    private List<(Connection Connection, IReadOnlyList<HistoryStore.Sample> Samples)>? _loaded;

    private string Format(double shown) => shown.ToString($"F{_spec.Decimals}") + _unit;

    /// <summary>
    /// Distinct hues rather than the accent colour, since telling the lines apart is the
    /// entire point of the card. Ordered so the first few stay far apart on the wheel.
    /// </summary>
    private static readonly string[] Palette =
    [
        "var(--accent)", "#ffb84d", "#35d07f", "#c792ea", "#ff8a65", "#4dd0e1",
        "#f06292", "#aed581", "#9575cd", "#4db6ac", "#ffd54f", "#90a4ae",
    ];

    protected override void OnInitialized()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
        DisplayUnits.Changed += OnUnitsChanged;
    }

    // The connection list is memory, not history, so it is fine to wait for; the series are
    // not, and are started without waiting (see BackgroundLoad).
    protected override async Task OnParametersSetAsync() => await LoadAsync(refresh: false);

    private async Task LoadAsync(bool refresh)
    {
        var metric = Metric;
        var window = TimeSpan.FromHours(Hours);

        var connections = (await Config.ConnectionsAsync())
            .Where(c => c.Enabled)
            .Where(c => Provider.Length == 0 || c.Provider.Equals(Provider, StringComparison.OrdinalIgnoreCase))
            .Where(c => Match.Length == 0 || c.Name.Contains(Match, StringComparison.OrdinalIgnoreCase))
            .ToList();

        async Task<List<(Connection Connection, IReadOnlyList<HistoryStore.Sample> Samples)>> Fetch(CancellationToken ct)
        {
            // All at once rather than one after another: they are separate queries, the
            // offload gate already bounds how many run together, and the card is only as
            // quick as the whole set.
            var reads = connections.Select(c => SeriesReads.SamplesAsync(c.Id, metric, window, ct)).ToList();
            var results = await Task.WhenAll(reads);
            return [.. connections.Zip(results).Where(pair => pair.Second.Count >= 2)];
        }

        // Names in the key as well as ids: a renamed connection is a different legend.
        var key = $"{metric}|{Hours}|{Limit}|{string.Join(",", connections.Select(c => $"{c.Id}:{c.Name}"))}";
        if (refresh)
            _ = _load.Refresh(key, Fetch, Apply);
        else
            _ = _load.Load(key, Fetch, Apply);
    }

    private void Apply(List<(Connection Connection, IReadOnlyList<HistoryStore.Sample> Samples)> loaded)
    {
        if (loaded.Count == 0)
        {
            _series = [];
            _hover = null;
            return;
        }

        _loaded = loaded;
        _spec = Registry.Metric(loaded[0].Connection, Metric);
        var units = DisplayUnits.Current;
        _unit = Units.Display(0, _spec.Unit, units).Unit;
        loaded = [.. loaded.Select(entry => (entry.Connection,
            (IReadOnlyList<HistoryStore.Sample>)[.. entry.Samples.Select(s => s with { Value = Units.Display(s.Value, _spec.Unit, units).Value })]))];

        // Busiest first, so the line you are looking for is the one at the top of the key.
        loaded = [.. loaded.OrderByDescending(entry => entry.Samples[^1].Value).Take(Limit)];

        // One scale for every line, taken from all of them — the whole point is comparison,
        // and per-series scaling would make two very different machines look identical.
        var values = loaded.SelectMany(entry => entry.Samples.Select(s => s.Value)).ToList();
        _low = values.Min();
        _high = values.Max();

        var range = _high - _low;
        var scale = range > 0 ? range : 1;
        var offset = range > 0 ? _low : _low - 0.5;

        _series =
        [
            .. loaded.Select((entry, index) => new Series(
                entry.Connection.Name,
                Plot(entry.Samples, offset, scale),
                entry.Samples[^1].Value,
                Palette[index % Palette.Length])),
        ];

        // Every line is named after a connection, so the tooltip is the only place you can
        // tell two similar ones apart without counting colours against the key.
        _hover = ChartHover.Attribute(
            [.. loaded.Select((entry, index) => new ChartHover.Series(
                entry.Connection.Name,
                Palette[index % Palette.Length],
                [.. entry.Samples.Select(s => s.Value)]))],
            // Converted with everything else above, so the tooltip and the number beside
            // it agree.
            _unit,
            Math.Max(_spec.Decimals, 1),
            loaded.Min(entry => entry.Samples[0].At),
            loaded.Max(entry => entry.Samples[^1].At));
    }

    /// <summary>
    /// Each series is drawn across the full width regardless of how many samples it has —
    /// a connection added yesterday has fewer points than one running all week, and
    /// stretching it is more honest than starting its line halfway across.
    /// </summary>
    private static string Plot(IReadOnlyList<HistoryStore.Sample> samples, double offset, double scale)
    {
        var step = 100d / Math.Max(1, samples.Count - 1);
        return string.Join(' ', samples.Select((sample, index) =>
        {
            var x = index * step;
            var y = 38 - (sample.Value - offset) / scale * 36;
            return $"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}," +
                   $"{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";
        }));
    }

    private void OnUpdated() => _ = InvokeAsync(() => LoadAsync(refresh: true));

    private void OnUnitsChanged() => _ = InvokeAsync(() =>
    {
        if (_loaded is { } loaded)
            Apply(loaded);
        StateHasChanged();
    });

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        DisplayUnits.Changed -= OnUnitsChanged;
        _load?.Dispose();
    }
}
