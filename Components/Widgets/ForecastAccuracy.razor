@implements IDisposable
@inject HealthMonitor Health
@inject SharedSeries Series
@inject Offload Offload
@inject ConfigStore Config
@inject AppSettingsStore AppSettings
@inject DisplayUnits DisplayUnits

@* Was the forecast right? Nobody else's dashboard can answer this, because answering it
   needs both a prediction and a thermometer in the same garden — and you have both.

   The prediction used is the first one recorded each day, so this scores the forecast you
   read at breakfast rather than the one it quietly corrected to at teatime. *@

@if (Context.Connection is null)
{
    <p class="tile-meta mb-0">Not bound to a forecast connection.</p>
}
else if (_station is null)
{
    <p class="tile-meta mb-0">Edit this widget and pick the weather station to compare against.</p>
}
else if (!_load.Ready)
{
    <div class="widget-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
}
else if (_rows.Count == 0)
{
    <p class="tile-meta mb-0">
        Nothing to compare yet — this needs a full day with both a forecast and station
        readings recorded, so it fills in from tomorrow.
    </p>
}
else
{
    <div class="d-flex align-items-baseline gap-2 mb-2">
        <span class="metric-value">@Degrees(_averageError)</span>
        <span class="tile-meta">average miss over @_rows.Count day(s)</span>
    </div>

    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th>Day</th>
                <th class="text-end">Forecast</th>
                <th class="text-end">Actual</th>
                <th class="text-end">Miss</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td class="tile-meta">@row.Date.ToString("ddd d MMM")</td>
                    <td class="text-end">@Temperature(row.Predicted)</td>
                    <td class="text-end">@Temperature(row.Observed)</td>
                    <td class="text-end @(Math.Abs(row.Error) >= 3 ? "text-warning" : "")">
                        @(row.Error > 0 ? "+" : "")@Degrees(row.Error)
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="tile-meta mb-0 mt-2">A positive miss means the forecast was warmer than the day turned out.</p>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    private sealed record Row(DateOnly Date, double Predicted, double Observed)
    {
        public double Error => Predicted - Observed;
    }

    private Connection? _station;
    private IReadOnlyList<Row> _rows = [];
    private double _averageError;
    private Units.Preferences _units => DisplayUnits.Current;
    private BackgroundLoad _load = default!;

    private int Days => Math.Clamp(Context.Widget.Settings.GetInt("days", 7), 1, 30);

    protected override void OnInitialized()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
        DisplayUnits.Changed += OnUpdated;
    }

    // The station is looked up from the cached connection list, which is fine to wait
    // for; the two series are history, and are started without waiting (BackgroundLoad).
    protected override async Task OnParametersSetAsync() => await LoadAsync(refresh: false);

    private async Task LoadAsync(bool refresh)
    {
        if (Context.Connection is not { } forecast)
            return;

        _station = Context.Widget.Settings.Get("station") is { Length: > 0 } chosen
            ? await Config.ConnectionAsync(chosen)
            : (await Config.ConnectionsAsync()).FirstOrDefault(c => c.Provider == "ambient" && c.Enabled);

        if (_station is null)
            return;

        // A day either side of the window, so the earliest day compared is a whole one.
        var days = Days;
        var window = TimeSpan.FromDays(days + 1);
        var forecastId = forecast.Id;
        var stationId = _station.Id;

        async Task<IReadOnlyList<Row>> Fetch(CancellationToken ct)
        {
            var predicted = await Series.SamplesAsync(forecastId, "temp_high_c", window, ct);
            var observed = await Series.SamplesAsync(stationId, "temp_outdoor_c", window, ct);
            return Compare(predicted, observed, DateOnly.FromDateTime(DateTime.Now), days);
        }

        void Apply(IReadOnlyList<Row> rows)
        {
            _rows = rows;
            _averageError = rows.Count == 0 ? 0 : rows.Average(r => Math.Abs(r.Error));
        }

        var key = (forecastId, stationId, days);
        if (refresh)
            _ = _load.Refresh(key, Fetch, Apply);
        else
            _ = _load.Load(key, Fetch, Apply);
    }

    /// <summary>
    /// Pairs each day's first prediction with what the station actually recorded. Today is
    /// excluded on purpose: its high has not happened yet, and scoring a forecast against
    /// half a day would make every morning look like a triumph.
    /// </summary>
    private static IReadOnlyList<Row> Compare(
        IReadOnlyList<HistoryStore.Sample> predicted,
        IReadOnlyList<HistoryStore.Sample> observed,
        DateOnly today,
        int days)
    {
        var firstForecast = predicted
            .GroupBy(s => DateOnly.FromDateTime(s.At.LocalDateTime))
            .ToDictionary(g => g.Key, g => g.OrderBy(s => s.At).First().Value);

        var observedHigh = observed
            .GroupBy(s => DateOnly.FromDateTime(s.At.LocalDateTime))
            .ToDictionary(g => g.Key, g => g.Max(s => s.Max));

        return
        [
            .. firstForecast
                .Where(entry => entry.Key < today && observedHigh.ContainsKey(entry.Key))
                .OrderByDescending(entry => entry.Key)
                .Take(days)
                .Select(entry => new Row(entry.Key, entry.Value, observedHigh[entry.Key]))
        ];
    }

    private string Temperature(double celsius) =>
        Units.Display(celsius, "°C", _units).Value.ToString("F1") + "°";

    /// <summary>A difference, not a temperature: 3°C of error is 5.4°F of error, not 37.4°F.</summary>
    private string Degrees(double celsiusDifference) =>
        (Units.Display(0, "°C", _units).Unit.Trim() == "°F" ? celsiusDifference * 9 / 5 : celsiusDifference)
            .ToString("F1") + "°";

    private void OnUpdated() => _ = InvokeAsync(async () =>
    {
        await LoadAsync(refresh: true);
        StateHasChanged();
    });

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        DisplayUnits.Changed -= OnUpdated;
        _load?.Dispose();
    }
}
