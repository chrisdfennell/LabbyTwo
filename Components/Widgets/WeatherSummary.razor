@implements IDisposable
@inject HealthMonitor Health
@inject SharedSeries Series
@inject Offload Offload
@inject LatestReadings Latest
@inject Registry Registry
@inject AppSettingsStore AppSettings

@if (Context.Connection is null)
{
    <p class="tile-meta mb-0">Not bound to a weather station.</p>
}
else
{
    <div class="summary-strip">
        @foreach (var cell in _cells)
        {
            <div>
                <div class="tile-meta">@cell.Label</div>
                <div class="tile-name">@cell.Value</div>
            </div>
        }

        @if (_sun is { } sun)
        {
            <div>
                <div class="tile-meta">Sun</div>
                <div class="tile-name">
                    @if (sun.PolarDay)
                    {
                        <text>up all day</text>
                    }
                    else if (sun.PolarNight)
                    {
                        <text>down all day</text>
                    }
                    else
                    {
                        <text>@sun.Sunrise?.ToString("HH:mm") · @sun.Sunset?.ToString("HH:mm")</text>
                    }
                </div>
                @if (sun.Daylight is { } daylight)
                {
                    <div class="tile-meta">@($"{(int)daylight.TotalHours}h {daylight.Minutes}m of light")</div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    /// <summary>Set by the weather tab so the whole page shares one range control.</summary>
    [Parameter] public int? HoursOverride { get; set; }

    private sealed record Cell(string Label, string Value);

    private List<Cell> _cells = [];
    private SunTimes.Day? _sun;
    private Units.Preferences _units = Units.Preferences.Default;
    private BackgroundLoad _history = default!;

    /// <summary>The highest and lowest of each metric over the window, once history has answered.</summary>
    private IReadOnlyDictionary<string, (double Max, double Min)> _extremes =
        new Dictionary<string, (double Max, double Min)>();

    /// <summary>What history is asked for: temperature for the high and low, the rest for a peak.</summary>
    private static readonly string[] FromHistory = ["temp_outdoor_c", "gust_mph", "uv_index", "solar_wm2"];

    private int Hours => HoursOverride ?? Math.Clamp(Context.Widget.Settings.GetInt("hours", 24), 1, 24 * 30);
    private double Latitude => Context.Widget.Settings.GetDouble("latitude");
    private double Longitude => Context.Widget.Settings.GetDouble("longitude");

    protected override async Task OnInitializedAsync()
    {
        _history = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
        Latest.Changed += OnReadingsLoaded;
        _units = Units.Preferences.From(await AppSettings.AllAsync());
    }

    protected override void OnParametersSet() => Load(refresh: false);

    /// <summary>
    /// The live cells are drawn at once; the ones from history are started here and not
    /// waited for (see BackgroundLoad), and join the strip when they land.
    /// </summary>
    private void Load(bool refresh)
    {
        if (Context.Connection is null)
            return;

        Build();

        // Only computable with a position, and a wrong one is worse than none.
        _sun = Latitude is not 0 || Longitude is not 0
            ? SunTimes.For(DateOnly.FromDateTime(DateTime.Now), Latitude, Longitude, DateTimeOffset.Now.Offset)
            : null;

        var id = Context.Connection.Id;
        var hours = Hours;
        var window = TimeSpan.FromHours(hours);

        async Task<IReadOnlyDictionary<string, (double Max, double Min)>> Fetch(CancellationToken ct)
        {
            var found = new Dictionary<string, (double Max, double Min)>();
            foreach (var metric in FromHistory)
            {
                var samples = await Series.SamplesAsync(id, metric, window, ct);
                if (samples.Count > 0)
                    found[metric] = (samples.Max(s => s.Max), samples.Min(s => s.Min));
            }
            return found;
        }

        if (refresh)
            _history.Refresh((id, hours), Fetch, Apply);
        else
            _history.Load((id, hours), Fetch, Apply);
    }

    private void Apply(IReadOnlyDictionary<string, (double Max, double Min)> extremes)
    {
        _extremes = extremes;
        Build();
    }

    private void Build()
    {
        var cells = new List<Cell>();

        // High and low from recorded history rather than from the station: Ambient reports
        // today's extremes only for some fields, and history is true for every metric.
        if (_extremes.TryGetValue("temp_outdoor_c", out var temperature))
        {
            var spec = Registry.Metric(Context.Connection, "temp_outdoor_c");
            cells.Add(new Cell($"High / low ({Hours}h)",
                $"{Units.Format(spec, temperature.Max, _units, 1)} / " +
                $"{Units.Format(spec, temperature.Min, _units, 1)}"));
        }

        AddPeak(cells, "gust_mph", "Peak gust");
        AddLatest(cells, "rain_in", "Rain today");
        AddPeak(cells, "uv_index", "Max UV", decimals: 0);
        AddPeak(cells, "solar_wm2", "Peak solar", decimals: 0);

        _cells = cells;
    }

    private void AddPeak(List<Cell> cells, string metric, string label, int? decimals = null)
    {
        if (!_extremes.TryGetValue(metric, out var extremes))
            return;
        var spec = Registry.Metric(Context.Connection, metric);
        cells.Add(new Cell(label, Units.Format(spec, extremes.Max, _units, decimals)));
    }

    private void AddLatest(List<Cell> cells, string metric, string label)
    {
        var live = Health.State(Context.Connection!.Id)?.Metrics;
        double? value = live?.TryGetValue(metric, out var reading) == true ? reading : null;

        // From memory rather than the database, so this cell never waits on SQLite.
        if (value is null && Latest.Get(Context.Connection.Id, TimeSpan.FromHours(6)).TryGetValue(metric, out var last))
            value = last;

        if (value is { } found)
            cells.Add(new Cell(label, Units.Format(Registry.Metric(Context.Connection, metric), found, _units)));
    }

    private void OnUpdated() => _ = InvokeAsync(() =>
    {
        Load(refresh: true);
        StateHasChanged();
    });

    private void OnReadingsLoaded(string connectionId)
    {
        if (connectionId == Context.Connection?.Id)
            OnUpdated();
    }

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        Latest.Changed -= OnReadingsLoaded;
        _history?.Dispose();
    }
}
