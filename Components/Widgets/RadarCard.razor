@implements IDisposable
@inject AppSettingsStore AppSettings

@if (_url.Length == 0)
{
    <p class="tile-meta mb-0">
        @(_source.IsCustom
            ? "Edit this widget and paste the URL of your radar image or page."
            : "No location — set one in Settings → General, or give this widget its own coordinates.")
    </p>
}
else if (_source.Kind == RadarKind.Image)
{
    @* Cache-busted on a timer: a radar loop keeps the same URL and only the bytes change,
       so without this the browser would show the same picture all day. *@
    <img class="radar-image" src="@($"{_url}{(_url.Contains('?') ? "&" : "?")}_={_tick}")"
         alt="@($"Weather radar from {_source.DisplayName}")" loading="lazy"
         style="height:@(Height)px" />
}
else
{
    <iframe class="radar-frame" src="@_url" style="height:@(Height)px"
            title="@($"Weather radar from {_source.DisplayName}")"
            loading="lazy" referrerpolicy="no-referrer"
            sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
}

@if (ShowAttribution && _source.Attribution is { Length: > 0 })
{
    <div class="tile-meta mt-1">@_source.Attribution</div>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    private RadarSource _source = RadarSource.All[0];
    private string _url = "";
    private long _tick;
    private Timer? _timer;
    private (string Url, int Minutes)? _timerFor;
    private bool _disposed;

    private int Height => Math.Clamp(Context.Widget.Settings.GetInt("height", 320), 120, 1200);
    private bool ShowAttribution => Context.Widget.Settings.GetBool("attribution", true);

    private int RefreshMinutes => Math.Clamp(Context.Widget.Settings.GetInt("refresh_minutes", 5), 1, 120);

    protected override async Task OnParametersSetAsync()
    {
        var settings = Context.Widget.Settings;
        _source = RadarSource.Resolve(settings.Get("source"));

        // Blank coordinates used to mean (0, 0), which is in the Atlantic and radars badly.
        // They now mean "wherever this dashboard says it lives".
        var home = HomeLocation.From(await AppSettings.AllAsync());
        var point = home.Resolve(settings.Get("latitude"), settings.Get("longitude"));

        // Some sources are addressed by radar site or by a URL somebody pasted, and want no
        // coordinates at all — asking those for a location would be a question with no
        // reason behind it.
        var template = _source.IsCustom ? settings.Get("custom_url") : _source.UrlTemplate;
        var needsPoint = template.Contains("{lat}") || template.Contains("{lon}");

        _url = needsPoint && point is null
            ? ""
            : _source.BuildUrl(
                point?.Latitude ?? 0,
                point?.Longitude ?? 0,
                settings.GetInt("zoom", 7),
                settings.Get("station"),
                settings.Get("custom_url"));

        // The await above is long enough for the card to have been taken off the page, and
        // a timer started after Dispose would tick into a dead component for ever.
        if (_disposed)
            return;

        // Only image sources need refreshing; an embedded map animates on its own, and
        // reloading its iframe would just restart somebody else's JavaScript.
        (string Url, int Minutes)? wanted = _source.Kind == RadarKind.Image && _url.Length > 0
            ? (_url, RefreshMinutes)
            : null;

        // Left alone unless what it refreshes has changed. Parents hand over a new context
        // on every render, and the weather tab renders on every sweep — every thirty
        // seconds — so restarting the timer here meant a five-minute refresh was always
        // pushed another five minutes away and the picture never changed at all.
        if (wanted == _timerFor)
            return;

        _timer?.Dispose();
        _timerFor = wanted;
        _timer = wanted is { } due
            ? new Timer(_ => InvokeAsync(() =>
            {
                _tick = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                StateHasChanged();
            }), null, TimeSpan.FromMinutes(due.Minutes), TimeSpan.FromMinutes(due.Minutes))
            : null;
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
    }
}
