@implements IDisposable
@inject HealthMonitor Health
@inject HistoryStore History
@inject SharedSeries Series
@inject Offload Offload
@inject Registry Registry
@inject AppSettingsStore AppSettings
@inject DisplayUnits DisplayUnits

@* Generic on purpose: any connection, any metrics. A weather station is where you most
   want the raw numbers, but "what did this actually record" is a fair question of a UPS
   or a NAS too. *@

@if (Context.Connection is null)
{
    <p class="tile-meta mb-0">Not bound to a connection.</p>
}
else if (!_load.Ready)
{
    <div class="widget-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
}
else if (_rows.Count == 0)
{
    <p class="tile-meta mb-0">Nothing recorded yet.</p>
}
else
{
    <details open="@StartOpen">
        <summary class="readings-summary">
            @_rows.Count reading@(_rows.Count == 1 ? "" : "s") · @string.Join(", ", _columns.Select(c => c.Label))
        </summary>
        <div class="readings-scroll mt-2">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Time</th>
                        @foreach (var column in _columns)
                        {
                            <th class="text-end">@column.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td class="tile-meta">@row.At.ToString("d MMM HH:mm")</td>
                            @foreach (var column in _columns)
                            {
                                <td class="text-end">
                                    @(row.Values.TryGetValue(column.Key, out var value)
                                        ? Units.Format(column.Spec, value, _units, 1)
                                        : "—")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    /// <summary>Set by the weather tab so the whole page shares one range control.</summary>
    [Parameter] public int? HoursOverride { get; set; }

    /// <summary>Comma-separated metric names, overriding the widget's own setting.</summary>
    [Parameter] public string? MetricsOverride { get; set; }

    private sealed record Column(string Key, string Label, MetricSpec Spec);
    private sealed record Row(DateTimeOffset At, Dictionary<string, double> Values);

    private List<Column> _columns = [];
    private List<Row> _rows = [];
    private Units.Preferences _units => DisplayUnits.Current;
    private BackgroundLoad _load = default!;

    private bool StartOpen => Context.Widget.Settings.GetBool("open", false);
    private int Hours => HoursOverride ?? Math.Clamp(Context.Widget.Settings.GetInt("hours", 24), 1, 24 * 30);
    private int Limit => Math.Clamp(Context.Widget.Settings.GetInt("limit", 240), 10, 2000);

    private IEnumerable<string> MetricNames =>
        (MetricsOverride ?? Context.Widget.Settings.Get("metrics"))
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    protected override void OnInitialized()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
        DisplayUnits.Changed += OnUpdated;
    }

    protected override void OnParametersSet() => Load(refresh: false);

    private sealed record Loaded(List<string> Metrics, List<Row> Rows);

    /// <summary>
    /// Started, not waited for — see BackgroundLoad. A table of a week of every metric is
    /// one of the heavier reads on the page, and nothing else should wait behind it.
    /// </summary>
    private void Load(bool refresh)
    {
        if (Context.Connection is null)
            return;

        var id = Context.Connection.Id;
        var named = MetricNames.ToList();
        var hours = Hours;
        var limit = Limit;
        var window = TimeSpan.FromHours(hours);

        async Task<Loaded> Fetch(CancellationToken ct)
        {
            var wanted = named;
            if (wanted.Count == 0)
            {
                // Nothing named: show whatever the connection actually records, minus the
                // probe's own latency, which is about LabbyTwo rather than about the thing.
                wanted = [.. (await Offload.Run(c => History.MetricsAsync(id, c), ct))
                    .Where(m => m != "latency_ms")
                    .Take(8)];
            }

            // Readings arrive per metric; the table wants them per timestamp. Grouping by the
            // instant works because one probe writes every metric with the same stamp.
            var byTime = new SortedDictionary<DateTimeOffset, Dictionary<string, double>>();
            foreach (var metric in wanted)
            {
                foreach (var sample in await Series.SamplesAsync(id, metric, window, ct))
                {
                    if (!byTime.TryGetValue(sample.At, out var row))
                        byTime[sample.At] = row = [];
                    row[metric] = sample.Value;
                }
            }

            return new Loaded(wanted, [.. byTime.Reverse().Take(limit).Select(pair => new Row(pair.Key, pair.Value))]);
        }

        var key = (id, string.Join(",", named), hours, limit);
        if (refresh)
            _load.Refresh(key, Fetch, Apply);
        else
            _load.Load(key, Fetch, Apply);
    }

    private void Apply(Loaded loaded)
    {
        _columns = [.. loaded.Metrics.Select(m => new Column(m, Registry.Metric(Context.Connection, m).Label,
                                                             Registry.Metric(Context.Connection, m)))];
        _rows = loaded.Rows;
    }

    private void OnUpdated() => _ = InvokeAsync(() => Load(refresh: true));

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        DisplayUnits.Changed -= OnUpdated;
        _load?.Dispose();
    }
}
