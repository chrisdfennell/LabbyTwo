@implements IDisposable
@inject ConfigStore Config
@inject HealthMonitor Health
@inject HistoryStore History
@inject Offload Offload

@* What happened while you were out. Every other card says how things are *now*; nothing
   said what changed, so a service that dropped at lunchtime and came back looks identical
   to one that never moved. *@

@if (!_load.Ready)
{
    <div class="widget-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
}
else if (_events.Count == 0)
{
    <p class="tile-meta mb-0">Nothing has changed in the last @Hours hours.</p>
}
else
{
    <div class="d-grid gap-1">
        @foreach (var entry in _events)
        {
            <div class="d-flex justify-content-between gap-2">
                <span class="text-truncate">
                    <span class="status-dot @(entry.Event.IsUp ? "is-up" : "is-down")"></span>
                    @Name(entry.Event.ConnectionId)
                    <span class="tile-meta">@(entry.Event.IsUp ? "came back" : "went down")</span>
                </span>
                <span class="tile-meta flex-none text-nowrap" title="@entry.Event.At.ToString("f")">
                    @Ago.Since(entry.Event.At)
                </span>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public WidgetContext Context { get; set; } = default!;

    private sealed record Entry(HistoryStore.StatusEvent Event);

    private IReadOnlyList<Entry> _events = [];
    private IReadOnlyList<Connection> _connections = [];
    private BackgroundLoad _load = default!;

    private int Hours => Math.Clamp(Context.Widget.Settings.GetInt("hours", 24), 1, 720);
    private int Limit => Math.Clamp(Context.Widget.Settings.GetInt("limit", 8), 1, 50);
    private bool DownOnly => Context.Widget.Settings.GetBool("down_only", false);

    protected override void OnInitialized()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
    }

    // The connection list is cached in memory and fine to wait for; the events are
    // history, started here and not waited for (see BackgroundLoad).
    protected override async Task OnParametersSetAsync() => await LoadAsync(refresh: false);

    private async Task LoadAsync(bool refresh)
    {
        _connections = await Config.ConnectionsAsync();

        var id = Context.Connection?.Id;
        var hours = Hours;
        var limit = Limit;
        var downOnly = DownOnly;

        async Task<IReadOnlyList<Entry>> Fetch(CancellationToken ct)
        {
            // Asked for generously and trimmed here: the store returns the newest events across
            // everything, and the window is what makes this "today" rather than "ever".
            var since = DateTimeOffset.Now.AddHours(-hours);

            // A card bound to a connection shows only that one; unbound shows everything, which
            // is the more useful default on a dashboard.
            var events = await Offload.Run(c => History.RecentEventsAsync(id, limit * 4, c), ct);

            return
            [
                .. events
                    .Where(e => e.At >= since)
                    .Where(e => !downOnly || !e.IsUp)
                    .Take(limit)
                    .Select(e => new Entry(e)),
            ];
        }

        var key = (id, hours, limit, downOnly);
        if (refresh)
            _ = _load.Refresh(key, Fetch, events => _events = events);
        else
            _ = _load.Load(key, Fetch, events => _events = events);
    }

    private string Name(string connectionId) =>
        _connections.FirstOrDefault(c => c.Id == connectionId)?.Name ?? "Something removed";

    private void OnUpdated() => _ = InvokeAsync(async () =>
    {
        await LoadAsync(refresh: true);
        StateHasChanged();
    });

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        _load?.Dispose();
    }
}
