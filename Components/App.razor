@inject AppSettingsStore AppSettings
@inject FontStore Fonts

<!DOCTYPE html>
<html lang="en" data-theme="@_look.ThemeAttribute" data-bs-theme="@BootstrapTheme"
      data-palette="@_look.PaletteAttribute" data-surface="@_look.SurfaceAttribute"
      data-wide="@_look.WideAttribute" style="@_look.StyleAttribute">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["LabbyTwo.styles.css"]" />

    @* A hosted web font, if somebody asked for one. Last of the stylesheets so it cannot be
       overridden by ours, and only ever emitted for an https absolute URL — see
       Appearance.IsValidFontUrl. This is the one thing in the app that makes the dashboard
       reach outside the house to draw itself, which is why it is opt-in and empty by
       default: the page still renders without it, in the fallback. *@
    @if (_look.WebFontUrl is { } webFont)
    {
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="@webFont" />
    }

    @* An uploaded typeface. The rule is built by FontStore from a fixed family name and a
       filename it chose itself, so nothing a user typed reaches this declaration. *@
    @if (_face is { Length: > 0 })
    {
        <style>@_face</style>
    }
    <link rel="icon" type="image/svg+xml" href="icon.svg" />
    <link rel="alternate icon" type="image/png" href="icon-192.png" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    @* Which one is a setting on the phone view: an installed app can open there instead of
       on the dashboard. Both are static files with the same id, so switching is the same
       app opening somewhere else rather than a second one on the home screen. *@
    <link rel="manifest" href="@_manifest" />
    <meta name="theme-color" content="@(_look.Theme == "light" ? "#f2f5f9" : "#0a0e13")" />
    <HeadOutlet />
    @* Bootstrap picks its own palette from data-bs-theme, and on "system" the server has
       no way to know which the browser wants — so the one thing that must happen before
       first paint is copying the OS preference onto that attribute. The app's own colours
       need no script: CSS handles "system" with prefers-color-scheme. *@
    @if (_look.ThemeAttribute is null)
    {
        <script>
            (function () {
                var dark = window.matchMedia('(prefers-color-scheme: dark)');
                var apply = function (m) { document.documentElement.dataset.bsTheme = m.matches ? 'dark' : 'light'; };
                apply(dark);
                dark.addEventListener('change', apply);
            })();
        </script>
    }
</head>

<body>
    <Routes />
    @* Blazor finds this by id and swaps its classes as the connection drops and returns.
       app.css keeps it hidden through a short blip; reconnect.js keeps retrying after
       Blazor gives up. *@
    <div id="components-reconnect-modal" role="status" aria-live="polite">
        <span class="reconnect-dot"></span>
        <span class="reconnect-trying">Reconnecting…</span>
        <span class="reconnect-lost">Server unreachable, still trying</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["reconnect.js"]"></script>
    <script src="@Assets["palette.js"]"></script>
    <script src="@Assets["widget-drag.js"]"></script>
    <script src="@Assets["chart-hover.js"]"></script>
    <script src="@Assets["wall.js"]"></script>
    <script src="@Assets["phone.js"]"></script>
</body>

</html>

@code {
    private Appearance _look = Appearance.Default;
    private string _face = "";
    private string _manifest = "manifest.webmanifest";

    /// <summary>On "system" the script above takes over; this is the pre-script value.</summary>
    private string BootstrapTheme => _look.Theme == "light" ? "light" : "dark";

    protected override async Task OnInitializedAsync()
    {
        var settings = await AppSettings.AllAsync();
        var look = Appearance.From(settings);
        _manifest = PhoneView.Manifest(settings);

        // Whether the file is there is asked of the disk, not of a setting. A setting saying
        // a font exists can be wrong; the file cannot.
        _look = look with { HasUploadedFont = look.Font == "custom" && Fonts.Current() is not null };
        _face = _look.HasUploadedFont ? Fonts.FaceRule() : "";
    }
}
