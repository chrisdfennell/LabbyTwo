@implements IDisposable
@inject ConfigStore Config
@inject HealthMonitor Health
@inject NavigationManager Nav
@inject AppSettingsStore AppSettings
@inject FamilyReportStore FamilyReports
@inject IJSRuntime JS

<nav class="app-nav" aria-label="Main">
    <a class="nav-brand" href="/">
        <span class="nav-brand-mark">◆</span>
        <span class="nav-brand-text">@_brand</span>
    </a>

    @if (_downCount > 0)
    {
        <a class="nav-alert" href="settings/connections">
            @_downCount @(_downCount == 1 ? "service is" : "services are") down
        </a>
    }

    @* Beside the outage count because it is the same kind of news: somebody in the house
       says something is broken, and the place to read what they said is one tap away. *@
    @if (_familyReports > 0)
    {
        <a class="nav-alert" href="settings/integrations#family">
            @FamilyPageSettings.ReportsText(_familyReports) from the family
        </a>
    }

    <div class="nav-links">
        <h2 class="visually-hidden">Tabs</h2>
        @foreach (var tab in _tabs)
        {
            <NavLink class="nav-item-link" href="@($"t/{tab.Slug}")">
                <span class="nav-icon">@(string.IsNullOrWhiteSpace(tab.Icon) ? "▪" : tab.Icon)</span>
                <span class="nav-text">@tab.Name</span>
            </NavLink>
        }

        @if (_tabs.Count == 0)
        {
            <p class="nav-empty">No tabs yet.</p>
        }
    </div>

    @* Everything that is not a tab, in a few groups that fold away (NavMap). Which are folded
       is remembered by this browser only: it is how you like your sidebar, not a setting of
       the lab. *@
    <div class="nav-footer">
        @foreach (var group in _groups)
        {
            var open = !_collapsed.Contains(group.Key);
            var listId = $"nav-group-{group.Key}";
            <div class="nav-group @(open ? "is-open" : null)" @key="group.Key">
                <h2 class="nav-group-heading">
                    <button type="button" class="nav-group-toggle" aria-expanded="@(open ? "true" : "false")"
                            aria-controls="@listId" @onclick="() => ToggleAsync(group.Key)">
                        <span class="nav-group-chevron" aria-hidden="true">▸</span>
                        <span>@group.Label</span>
                    </button>
                </h2>
                <div class="nav-group-items" id="@listId" hidden="@(!open)">
                    @foreach (var item in group.Items)
                    {
                        @if (item.Plain)
                        {
                            @* A plain link, not a NavLink: it has a layout of its own, and while you
                               are on it this sidebar is not there to be highlighted. *@
                            <a class="nav-item-link" href="@item.Href" title="@item.Hint">
                                <span class="nav-icon">@item.Icon</span><span class="nav-text">@item.Label</span>
                            </a>
                        }
                        else
                        {
                            <NavLink class="nav-item-link" href="@item.Href" title="@item.Hint">
                                <span class="nav-icon">@item.Icon</span><span class="nav-text">@item.Label</span>
                            </NavLink>
                        }
                    }
                </div>
            </div>
        }

        <NavLink class="nav-item-link nav-settings" href="settings">
            <span class="nav-icon">⚙️</span><span class="nav-text">Settings</span>
        </NavLink>
    </div>
</nav>

@code {
    private IReadOnlyList<Tab> _tabs = [];
    private IReadOnlyList<NavGroup> _groups = NavMap.Groups;
    private HashSet<string> _collapsed = new(StringComparer.Ordinal);
    private int _downCount;
    private int _familyReports;
    private string _brand = Appearance.Default.BrandName;

    protected override async Task OnInitializedAsync()
    {
        Config.Changed += OnChanged;
        Health.Updated += OnHealthUpdated;
        AppSettings.Changed += OnChanged;
        FamilyReports.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _tabs = [.. (await Config.TabsAsync()).Where(t => t.Enabled)];
        _downCount = Health.Snapshot.Count(s => s.IsUp == false);

        // The same cached settings the name comes from — the pages hidden from the menu add no
        // read of their own. AllAsync answers from memory once anything has asked for it.
        var settings = await AppSettings.AllAsync();
        _brand = settings.Get(Appearance.BrandKey, Appearance.Default.BrandName);
        _groups = NavMap.Visible(NavMap.Hidden(settings));

        // Never awaited while the page is drawn. This menu is on every page, and awaiting the
        // count through Offload put every page load in the same four-at-a-time queue as the
        // chart reads of every open dashboard — on a NAS, seconds to a minute of a page that
        // did not appear while the menu waited to count a table that is usually empty. The
        // store keeps the count in memory once read; until then the badge is simply absent,
        // and appears when the count lands.
        if (FamilyReports.KnownCount is { } known)
            _familyReports = known;
        else
            _ = CountReportsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            // Only once the browser is there to ask: the server's first draw has every group
            // open, and this folds the ones this browser folded last time.
            var folded = await JS.InvokeAsync<string[]?>("labbyNav.folded");
            if (folded is { Length: > 0 })
            {
                _collapsed = new HashSet<string>(folded, StringComparer.Ordinal);
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // No storage (a private window, a blocked site), or no script yet: everything open.
        }
    }

    private async Task ToggleAsync(string key)
    {
        if (!_collapsed.Remove(key))
            _collapsed.Add(key);
        try
        {
            await JS.InvokeVoidAsync("labbyNav.fold", _collapsed.ToArray());
        }
        catch (Exception)
        {
            // Remembering is a courtesy; the group still folds for this visit.
        }
    }

    private async Task CountReportsAsync()
    {
        try
        {
            var count = await Task.Run(() => FamilyReports.CountAsync());
            await InvokeAsync(() =>
            {
                if (count == _familyReports)
                    return;
                _familyReports = count;
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // The badge is a courtesy; a count that could not be read leaves it off.
        }
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void OnHealthUpdated() => _ = InvokeAsync(() =>
    {
        var count = Health.Snapshot.Count(s => s.IsUp == false);
        if (count == _downCount)
            return;
        _downCount = count;
        StateHasChanged();
    });

    public void Dispose()
    {
        Config.Changed -= OnChanged;
        Health.Updated -= OnHealthUpdated;
        AppSettings.Changed -= OnChanged;
        FamilyReports.Changed -= OnChanged;
    }
}
