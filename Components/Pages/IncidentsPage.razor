@page "/incidents"
@rendermode InteractiveServer
@implements IDisposable
@inject IncidentStore Incidents
@inject ChangeStore Changes
@inject ConfigStore Config
@inject HealthMonitor Health
@inject Offload Offload
@inject ProbableCauses Causes
@inject IncidentWriteUps WriteUps
@inject ILogger<IncidentsPage> Log
@inject NavigationManager Nav

<PageTitle>Incidents · LabbyTwo</PageTitle>

@* Outages, one row each however many things they took down: what went first, what
   followed, how long until the last came back — and, opened up, the timeline: everything
   the change feed recorded from half an hour before it started until just after it ended.
   That half hour is usually where the cause is.

   Each one says what probably caused it — worked out by a few rules from the feed and the
   lab's shape, never guessed (see IncidentCauses) — and can be written up as a note in one
   click, which the incident then links to.

   The list is read in the background and again when an incident is written. A timeline is
   read when it is opened, and again while it is open and changes arrive. *@

<div class="page-head">
    <div>
        <h1>🔥 Incidents</h1>
        <p class="subtitle">
            When something goes down, everything else that went with it, and what changed just before.
            <a href="changes">Everything that changed</a>
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <div class="btn-group btn-group-sm" role="group" aria-label="Which incidents">
            <button class="btn @(_openOnly ? "btn-outline-secondary" : "btn-secondary")" aria-pressed="@(!_openOnly)"
                    @onclick="() => Show(false)">All</button>
            <button class="btn @(_openOnly ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@_openOnly"
                    @onclick="() => Show(true)">Open</button>
        </div>
        <select class="form-select form-select-sm w-auto" aria-label="How far back" @bind="_days" @bind:after="Reload" disabled="@_openOnly">
            <option value="7">Last 7 days</option>
            <option value="30">Last 30 days</option>
            <option value="90">Last 90 days</option>
            <option value="365">Last year</option>
        </select>
    </div>
</div>

<details class="panel p-3 mb-3 incident-rules">
    <summary class="tile-meta">How incidents are grouped</summary>
    <ul class="tile-meta mb-0 mt-2">
        <li>A service going down, or an alert rule firing, starts an incident — unless it happens within
            @IncidentRules.JoinWindow.TotalMinutes minutes of the last thing that happened in another one, in which case it joins that.
            So a NAS and everything stored on it going down inside a few minutes is one incident, and something that comes
            back and falls over again soon after reopens the same one.</li>
        <li>An incident ends when everything in it has come back. Its length is from the first failure to the last recovery.</li>
        <li>The timeline shows every change recorded from @IncidentRules.ContextBefore.TotalMinutes minutes before it started
            until @IncidentRules.ContextAfter.TotalMinutes minutes after it ended.</li>
        <li>Anything that happened while alerts were silenced for maintenance is still recorded, and marked
            <span class="badge text-bg-secondary">during maintenance</span>.</li>
        <li>“Probably” is worked out from what was recorded: several things behind one connection that went down first,
            a container given a new image or restarted up to @IncidentCauses.Window.TotalMinutes minutes before its service failed,
            everything on one address failing within a minute, a certificate, DNS answer or LabbyTwo update just before, or a
            disk alert on a disk that has been filling for weeks. When none of those fit it says so, rather than guess.</li>
    </ul>
</details>

@if (!_load.Ready)
{
    <div class="panel p-3"><div class="widget-skeleton" aria-hidden="true"><span></span><span></span><span></span></div></div>
}
else if (_load.Failed && _incidents.Count == 0)
{
    <div class="panel p-3 text-danger">The incidents could not be read. The log says why.</div>
}
else if (_incidents.Count == 0)
{
    <div class="panel p-3">
        <p class="mb-0">@(_openOnly ? "Nothing is down. No incident is open." : $"No incidents in the last {_days} days.")</p>
    </div>
}
else
{
    var now = DateTimeOffset.Now;
    <div class="d-grid gap-2">
        @foreach (var incident in _incidents)
        {
            var open = _expanded.Contains(incident.Id);
            <div class="panel p-3 incident @(incident.IsOpen ? "is-open" : "")" id="@($"incident-{incident.Id}")" @key="incident.Id">
                <div class="d-flex align-items-start gap-2">
                    <span class="status-dot mt-2 @(incident.IsOpen ? "status-down" : "status-unknown")" aria-hidden="true"></span>
                    <div class="min-w-0 flex-grow-1">
                        <div>
                            <strong>@incident.Title</strong>
                            @if (incident.IsOpen)
                            {
                                <span class="badge text-bg-danger ms-1">open</span>
                            }
                            @if (incident.Maintenance)
                            {
                                <span class="badge text-bg-secondary ms-1" title="Maintenance mode was on while this happened">during maintenance</span>
                            }
                        </div>
                        <div class="tile-meta">@ChangeLists.IncidentWhen(incident, now)</div>
                        @if (_causes.GetValueOrDefault(incident.Id) is { } causes)
                        {
                            <div class="incident-cause mt-1">
                                <span class="tile-meta">Probably:</span>
                                <span class="@(causes.Count == 0 ? "tile-meta" : "")">@IncidentCauses.Headline(causes)</span>
                            </div>
                        }
                        <ul class="incident-members tile-meta mb-0 mt-1">
                            @foreach (var member in incident.Members.OrderBy(m => m.DownAt))
                            {
                                <li>
                                    <span class="status-dot @(member.IsRecovered ? "status-up" : "status-down")" aria-hidden="true"></span>
                                    <span>@member.Name</span>
                                    <span>— @(member.Kind == ChangeKinds.Alert ? "fired" : "went down") at @member.DownAt.ToLocalTime().ToString("HH:mm"), @ChangeLists.MemberWhen(member, now)</span>
                                </li>
                            }
                        </ul>
                        @if (_writeUps.GetValueOrDefault(incident.Id) is { } writeUp)
                        {
                            <div class="tile-meta mt-1">
                                Write-up:
                                @if (writeUp.Url is { } url)
                                {
                                    <a href="@url">@writeUp.Title</a>
                                }
                                else
                                {
                                    <span>@writeUp.Title</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="d-flex flex-column gap-1 flex-none">
                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-expanded="@(open ? "true" : "false")"
                                @onclick="() => Toggle(incident)">@(open ? "Hide timeline" : "Timeline")</button>
                        @if (!_writeUps.ContainsKey(incident.Id))
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_writing == incident.Id)"
                                    title="Make a note about this incident with its times, cause and timeline filled in"
                                    @onclick="() => WriteUpAsync(incident)">@(_writing == incident.Id ? "Writing…" : "Write up")</button>
                        }
                    </div>
                </div>
                @if (_writeProblem is { } problem && _writeProblemFor == incident.Id)
                {
                    <div class="text-danger small mt-2" role="alert">@problem</div>
                }

                @if (open && _causes.GetValueOrDefault(incident.Id) is { Count: > 0 } explained)
                {
                    <div class="incident-causes mt-3">
                        <div class="tile-meta mb-1">What probably caused it, surest first</div>
                        <ol class="mb-0 ps-3">
                            @foreach (var cause in explained)
                            {
                                <li>
                                    <span>@cause.Sentence</span>
                                    <span class="badge text-bg-secondary ms-1">@ConfidenceWord(cause.Confidence)</span>
                                    @if (cause.Evidence.Count > 0)
                                    {
                                        <ul class="tile-meta mb-0">
                                            @foreach (var change in cause.Evidence)
                                            {
                                                <li><a href="@($"incidents#incident-{incident.Id}-change-{change.Id}")">@change.At.ToLocalTime().ToString("HH:mm:ss") — @change.Title</a></li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ol>
                    </div>
                }

                @if (open)
                {
                    <div class="incident-timeline mt-3">
                        @if (!_timelines.TryGetValue(incident.Id, out var timeline))
                        {
                            <span class="tile-meta">Reading the changes around it…</span>
                        }
                        else if (timeline.Count == 0)
                        {
                            <span class="tile-meta">Nothing else changed from half an hour before it until it ended.</span>
                        }
                        else
                        {
                            <ol class="change-list">
                                @foreach (var change in timeline)
                                {
                                    var where = ChangeLists.Where(change, _connections);
                                    var offset = change.At - incident.StartedAt;
                                    var evidence = _causes.GetValueOrDefault(incident.Id)?.Any(c => c.Evidence.Any(e => e.Id == change.Id)) == true;
                                    <li class="change-row @(offset < TimeSpan.Zero ? "is-before" : "") @(evidence ? "is-evidence" : "")" @key="change.Id"
                                        id="@($"incident-{incident.Id}-change-{change.Id}")">
                                        <span class="change-time tile-meta" title="@change.At.ToLocalTime().ToString("f")">
                                            @change.At.ToLocalTime().ToString("HH:mm:ss")
                                            <span class="change-offset">@Offset(offset)</span>
                                        </span>
                                        <span class="status-dot @change.Dot" aria-hidden="true"></span>
                                        <div class="min-w-0">
                                            <div>
                                                <span>@change.Title</span>
                                                @if (where is not null)
                                                {
                                                    <span class="tile-meta"> · @where</span>
                                                }
                                                @if (evidence)
                                                {
                                                    <span class="badge text-bg-warning ms-1">probable cause</span>
                                                }
                                            </div>
                                            @if (change.Detail.Length > 0)
                                            {
                                                <div class="tile-meta change-detail">@change.Detail</div>
                                            }
                                        </div>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private const int Limit = 100;
    private const int TimelineLimit = 300;

    private bool _openOnly;
    private int _days = 30;
    private IReadOnlyList<Incident> _incidents = [];
    private IReadOnlyList<Connection> _connections = [];
    private readonly HashSet<long> _expanded = [];
    private readonly Dictionary<long, IReadOnlyList<Change>> _timelines = [];
    private IReadOnlyDictionary<long, IReadOnlyList<ProbableCause>> _causes = new Dictionary<long, IReadOnlyList<ProbableCause>>();
    private IReadOnlyDictionary<long, WriteUpLink> _writeUps = new Dictionary<long, WriteUpLink>();
    private long? _writing;
    private string? _writeProblem;
    private long? _writeProblemFor;
    private BackgroundLoad _load = default!;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Incidents.Changed += OnIncidentChanged;
        Changes.Recorded += OnRecorded;
        Health.Updated += OnSweep;

        // A link from a runbook's {{incidents}} names one; open its timeline straight away.
        var fragment = new Uri(Nav.Uri).Fragment;
        // So does a link to one change on its timeline, #incident-12-change-340, from a cause's evidence.
        if (fragment.StartsWith("#incident-", StringComparison.Ordinal)
            && long.TryParse(fragment["#incident-".Length..].Split('-')[0], out var id))
            _expanded.Add(id);

        _connections = await Config.ConnectionsAsync();
        Load(refresh: false);
    }

    private void Show(bool openOnly)
    {
        _openOnly = openOnly;
        Load(refresh: false);
    }

    private void Reload() => Load(refresh: false);

    private void Load(bool refresh)
    {
        var since = DateTimeOffset.Now.AddDays(-_days);
        var openOnly = _openOnly;

        // The causes and write-ups are read with the list, not after it, so an incident never
        // shows without its "Probably" and then jumps when it arrives. Closed incidents' causes
        // are remembered by the service, so a refresh reads the feed only for open ones.
        Task<Loaded> Fetch(CancellationToken ct) => Offload.Run(async c =>
        {
            var list = await Incidents.RecentAsync(since, Limit, openOnly, c);
            return new Loaded(list, await Causes.ExplainAsync(list, c), await WriteUps.LinksAsync(list, c));
        }, ct);

        void Apply(Loaded loaded)
        {
            var list = loaded.Incidents;
            _incidents = list;
            _causes = loaded.Causes;
            _writeUps = loaded.WriteUps;
            foreach (var incident in list.Where(i => _expanded.Contains(i.Id)))
                LoadTimeline(incident);
        }

        var key = (openOnly, _days);
        if (refresh)
            _ = _load.Refresh(key, Fetch, Apply);
        else
            _ = _load.Load(key, Fetch, Apply);
    }

    private sealed record Loaded(
        IReadOnlyList<Incident> Incidents,
        IReadOnlyDictionary<long, IReadOnlyList<ProbableCause>> Causes,
        IReadOnlyDictionary<long, WriteUpLink> WriteUps);

    private static string ConfidenceWord(CauseConfidence confidence) => confidence switch
    {
        CauseConfidence.High => "likely",
        CauseConfidence.Medium => "possible",
        _ => "worth a look",
    };

    /// <summary>
    /// Writes the incident up as a note and opens it in the editor. Off the render thread:
    /// it reads the incident's half hour of the feed and writes a note, and a tab the first time.
    /// </summary>
    private async Task WriteUpAsync(Incident incident)
    {
        if (_writing is not null)
            return;
        _writing = incident.Id;
        _writeProblem = null;
        try
        {
            var link = await Offload.Run(c => WriteUps.CreateAsync(incident, c));
            if (link.EditUrl is { } edit)
                Nav.NavigateTo(edit);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Could not write up incident {Id}", incident.Id);
            _writeProblem = "The write-up could not be saved. The log says why.";
            _writeProblemFor = incident.Id;
        }
        finally
        {
            _writing = null;
        }
    }

    private void Toggle(Incident incident)
    {
        if (!_expanded.Remove(incident.Id))
        {
            _expanded.Add(incident.Id);
            LoadTimeline(incident);
        }
    }

    /// <summary>
    /// The changes around one incident, oldest first so it reads as a story. Its own loader
    /// is not needed: one query on the time index, started and forgotten, applied only if
    /// the page is still here.
    /// </summary>
    private void LoadTimeline(Incident incident)
    {
        var query = new ChangeQuery(IncidentRules.TimelineFrom(incident), IncidentRules.TimelineTo(incident, DateTimeOffset.Now),
            Limit: TimelineLimit);
        _ = Task.Run(async () =>
        {
            try
            {
                var changes = await Offload.Run(c => Changes.QueryAsync(query, c));
                if (_disposed)
                    return;
                await InvokeAsync(() =>
                {
                    _timelines[incident.Id] = [.. changes.Reverse()];
                    StateHasChanged();
                });
            }
            catch (Exception) when (_disposed)
            {
                // The page went while it was reading. Nobody to tell.
            }
            catch (Exception)
            {
                if (!_disposed)
                    await InvokeAsync(() => { _timelines[incident.Id] = []; StateHasChanged(); });
            }
        });
    }

    /// <summary>"−12m", "+3m", "start" — where a change sits against the incident's first failure.</summary>
    private static string Offset(TimeSpan offset) =>
        Math.Abs(offset.TotalSeconds) < 1 ? "start"
        : offset < TimeSpan.Zero ? $"−{Ago.Duration(-offset)}"
        : $"+{Ago.Duration(offset)}";

    private void OnIncidentChanged(Incident incident) => _ = InvokeAsync(() => Load(refresh: true));

    private void OnRecorded(Change change) => _ = InvokeAsync(() =>
    {
        foreach (var incident in _incidents.Where(i => _expanded.Contains(i.Id) && i.IsOpen))
            LoadTimeline(incident);
    });

    private void OnSweep()
    {
        if (_incidents.Any(i => i.IsOpen))
            _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        Incidents.Changed -= OnIncidentChanged;
        Changes.Recorded -= OnRecorded;
        Health.Updated -= OnSweep;
        _load?.Dispose();
    }
}
