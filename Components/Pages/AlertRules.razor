@page "/settings/alerts"
@layout SettingsLayout
@rendermode InteractiveServer
@implements IDisposable
@inject AlertRuleStore Rules
@inject ConfigStore Config
@inject Registry Registry
@inject HistoryStore History
@inject Offload Offload
@inject MetricAlertService Evaluator
@inject AlertService Alerts
@inject AppSettingsStore AppSettings
@inject CapacityForecasts Forecasts
@inject MetricBaselines Baselines
@inject HealthMonitor Monitor
@inject MuteWindowStore Mutes
@inject RemediationStore Remediations
@inject RemediationService Healing

<PageTitle>Alert rules · LabbyTwo</PageTitle>

<div class="page-head">
    <div>
        <h1>🚨 Alert rules</h1>
        <p class="subtitle">
            Up/down alerting covers a service being unreachable. These cover the numbers —
            a volume filling, a battery draining, a temperature climbing.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="settings/connections">Alert channels</a>
        <a class="btn btn-sm btn-outline-secondary" href="settings/push">📳 Browser push</a>
        <a class="btn btn-sm btn-outline-secondary" href="settings/scheduled">⏰ Scheduled actions</a>
        <button class="btn btn-sm btn-primary" @onclick="StartNew">+ New rule</button>
    </div>
</div>

@if (_channelCount == 0)
{
    <div class="alert alert-warning py-2">
        No alert channel is configured, so nothing will actually be delivered.
        <a href="settings/connections">Add a webhook or Pushover channel</a>, or
        <a href="settings/push">turn on notifications for this device</a>, first.
    </div>
}

@* Quiet hours sit above the rules on purpose: with forty things able to alert, when they
   are allowed to speak matters more than what any one of them says. *@
<div class="widget mb-3" id="quiet-hours">
    <div class="widget-head">
        <h2 class="widget-title">Quiet hours</h2>
        <span class="tile-meta">@_policy.Describe()</span>
    </div>
    <div class="widget-body">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label" for="quiet-from">From</label>
                <input id="quiet-from" type="time" class="form-control"
                       value="@(_policy.QuietHoursOn ? _policy.QuietFrom.ToString("HH\\:mm") : "")"
                       @onchange="e => SaveQuietAsync(e.Value?.ToString(), null, null)" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="quiet-to">Until</label>
                <input id="quiet-to" type="time" class="form-control"
                       value="@(_policy.QuietHoursOn ? _policy.QuietTo.ToString("HH\\:mm") : "")"
                       @onchange="e => SaveQuietAsync(null, e.Value?.ToString(), null)" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="quiet-mode">While quiet</label>
                <select id="quiet-mode" class="form-select" value="@_policy.QuietMode"
                        @onchange="e => SaveQuietAsync(null, null, e.Value?.ToString())">
                    <option value="@AlertPolicy.DownOnly">Only send when something goes down</option>
                    <option value="@AlertPolicy.Nothing">Send nothing at all</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearQuietAsync"
                        disabled="@(!_policy.QuietHoursOn)">Turn off</button>
            </div>
        </div>

        <p class="tile-meta mb-0 mt-2">
            Held alerts are not queued for later — they are simply not sent. The state on this page
            still moves, so a rule that fired overnight is red here in the morning even though nothing
            reached your phone. Recoveries are always held while quiet: being woken to be told
            something came back is the purest kind of pointless alert.
        </p>
    </div>
</div>

@* Mute windows sit with quiet hours because they answer the same question — when — but
   about particular things rather than about you. *@
<div class="widget mb-3" id="mute-windows">
    <div class="widget-head">
        <h2 class="widget-title">Mute windows</h2>
        <button class="btn btn-sm btn-outline-secondary" @onclick="StartNewWindow">+ New window</button>
    </div>
    <div class="widget-body">
        <p class="tile-meta">
            Times when particular alerts are expected — the NAS scrub on Sunday night, the backup at two.
            A muted alert still fires and shows here, marked “muted by” the window; it just is not sent.
            If it is still firing when the window ends, it is sent then, once. If it clears inside the
            window, you hear nothing about it at all.
        </p>
        @if (_windows.Count == 0)
        {
            <p class="tile-meta mb-0">No mute windows yet.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var window in _windows)
                {
                    var current = window;
                    var open = window.OccurrenceAt(DateTimeOffset.Now, Alerts.Zone);
                    <div class="d-flex align-items-start gap-2">
                        <span class="status-dot mt-1 @(!window.Enabled ? "status-unknown" : open is not null ? "status-flapping" : "status-up")"
                              title="@(!window.Enabled ? "Off" : open is not null ? "Muting now" : "Waiting")"></span>
                        <div class="min-w-0 flex-grow-1">
                            <div class="tile-name">
                                @window.Name
                                <span class="tile-meta">@window.Describe()</span>
                            </div>
                            <div class="tile-meta">
                                @ScopeText(window)
                                @if (!window.Enabled)
                                {
                                    <text> · off</text>
                                }
                                else if (open is { } occurrence)
                                {
                                    <strong> · muting now, until @occurrence.End.ToLocalTime().ToString("ddd HH:mm")</strong>
                                }
                                else if (window.NextStart(DateTimeOffset.Now, Alerts.Zone) is { } next)
                                {
                                    <text> · next @next.ToLocalTime().ToString("ddd d MMM, HH:mm")</text>
                                }
                            </div>
                        </div>
                        <div class="text-end flex-none">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditWindow(current)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDeleteWindow = current">✕</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="widget mb-3" id="escalation">
    <div class="widget-head">
        <h2 class="widget-title">Escalation</h2>
        <span class="tile-meta">@_escalation.Describe(ChannelName)</span>
    </div>
    <div class="widget-body">
        <p class="tile-meta">
            When an alert is still firing after a while, send it again somewhere louder — email first,
            then your phone. This is the default for every down alert and every rule that does not set
            its own. Its recovery goes to the escalation channels too, so the loud one does not keep
            saying something is broken. Maintenance, silences, mute windows and quiet hours hold an
            escalation just as they hold an alert, and it goes as soon as they lift if the alert is still
            firing. “Only send when something goes down” lets escalations through, since they are about
            something that is down.
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label" for="escalate-after">After (minutes)</label>
                <input id="escalate-after" type="number" min="0" class="form-control" value="@_escalation.AfterMinutes"
                       @onchange="e => SaveEscalationAsync(_escalation with { AfterMinutes = Math.Max(0, (int)Parse(e.Value, 0)) })" />
                <div class="form-text">0 is off.</div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="escalate-repeat">Repeat every (minutes)</label>
                <input id="escalate-repeat" type="number" min="0" class="form-control" value="@_escalation.RepeatMinutes"
                       disabled="@(!_escalation.On)"
                       @onchange="e => SaveEscalationAsync(_escalation with { RepeatMinutes = Math.Max(0, (int)Parse(e.Value, 0)) })" />
                <div class="form-text">0 sends it once.</div>
            </div>
            <div class="col-12 col-md-6">
                <div class="form-label">Send to</div>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var channel in _channels)
                    {
                        var id = channel.Id;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@($"escalate-to-{id}")"
                                   checked="@_escalation.Channels.Contains(id)" disabled="@(!_escalation.On)"
                                   @onchange="e => SaveEscalationAsync(_escalation with { Channels = Toggle(_escalation.Channels, id, e.Value is true) })" />
                            <label class="form-check-label" for="@($"escalate-to-{id}")">@channel.Icon @channel.Name</label>
                        </div>
                    }
                </div>
                <div class="form-text">None ticked sends to every channel.</div>
            </div>
        </div>
    </div>
</div>

@* Self-healing sits with escalation because it is the other half of the same question —
   what happens when an alert is not dealt with — and because the switch that stops all of
   it has to be somewhere obvious. *@
<div class="widget mb-3" id="self-healing">
    <div class="widget-head">
        <h2 class="widget-title">Self-healing</h2>
        <span class="tile-meta">
            @(!_healing.Enabled ? "Switched off." : _fixCount == 0 ? "Nothing set up yet." : $"{_fixCount} automatic action{(_fixCount == 1 ? "" : "s")} set up.")
        </span>
    </div>
    <div class="widget-body">
        <p class="tile-meta">
            Let LabbyTwo try the obvious fix before it wakes you: restart the container, run a
            connection's action. Set one up in a rule's editor under “When this fires…”, or on a
            connection under “When this is down…”. The alert says what it will try, and you hear
            whether it worked. It never acts during maintenance, a silence or a mute window, never on
            LabbyTwo's own container, and never on a protected container unless that remediation says so.
            To run an action on a timetable instead — restart a container every Sunday, trigger a backup
            nightly — use <a href="settings/scheduled">scheduled actions</a>.
        </p>
        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="healing-enabled"
                           checked="@_healing.Enabled"
                           @onchange="e => SaveHealingAsync(_healing with { Enabled = e.Value is true })" />
                    <label class="form-check-label" for="healing-enabled">
                        Allow automatic actions
                        <span class="form-text d-block">Off stops every one of them at once, without losing how they are set up.</span>
                    </label>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="healing-cap">At most, per hour</label>
                <input id="healing-cap" type="number" min="0" class="form-control" value="@_healing.MaxPerHour"
                       @onchange="e => SaveHealingAsync(_healing with { MaxPerHour = Math.Max(0, (int)Parse(e.Value, RemediationSettings.DefaultMaxPerHour)) })" />
                <div class="form-text">Across everything. A backstop against two fixes fighting.</div>
            </div>
        </div>

        <div class="form-label">Recent automatic actions</div>
        @if (_recentFixes.Count == 0)
        {
            <div class="tile-meta">None in the last two weeks.</div>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var change in _recentFixes)
                {
                    <li class="d-flex align-items-start gap-2 mb-1">
                        <span class="status-dot @change.Dot mt-1" aria-hidden="true"></span>
                        <div class="min-w-0">
                            <div>@change.Title <span class="tile-meta">· @Ago.Since(change.At)</span></div>
                            @if (change.Detail.Length > 0)
                            {
                                <div class="tile-meta">@change.Detail</div>
                            }
                        </div>
                    </li>
                }
            </ul>
            <a class="small" href="changes?kind=remediation">All of them in the change feed</a>
        }
    </div>
</div>

@if (_suggestions.Count > 0)
{
    <div class="widget mb-3">
        <div class="widget-head">
            <h2 class="widget-title">Suggested for what you have connected</h2>
            <button class="btn btn-sm btn-outline-secondary" @onclick="AddAllSuggestionsAsync"
                    disabled="@_adding">Add all @_suggestions.Count</button>
        </div>
        <div class="widget-body">
            <p class="tile-meta">
                Sensible starting points from each integration. Nothing is created until you say so,
                and each one is an ordinary rule you can edit or delete afterwards.
            </p>
            <div class="d-flex flex-column gap-2">
                @foreach (var offer in _suggestions)
                {
                    var current = offer;
                    <div class="d-flex align-items-start gap-2">
                        <button class="btn btn-sm btn-outline-primary flex-none" disabled="@_adding"
                                @onclick="() => AddSuggestionAsync(current)">+ Add</button>
                        <div class="min-w-0">
                            <div class="tile-name">
                                @offer.Connection.Name · @offer.Rule.Name
                                <span class="tile-meta">
                                    @OfferCondition(offer)
                                    @if (offer.Rule.ForMinutes > 0)
                                    {
                                        <text> for @offer.Rule.ForMinutes min</text>
                                    }
                                </span>
                            </div>
                            @if (offer.Rule.Why is { Length: > 0 })
                            {
                                <div class="tile-meta">@offer.Rule.Why</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_rules.Count == 0)
{
    <div class="empty-state">
        <p class="mb-3">No rules yet.</p>
        <button class="btn btn-primary btn-sm" @onclick="StartNew">Add the first rule</button>
        <div class="form-text mt-3">
            A good first one: <code>disk_percent</code> above <code>90</code> on any connection.
        </div>
    </div>
}
else
{
    <div class="widget">
        <div class="widget-body p-0">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr class="tile-meta">
                        <th style="width: 2.5rem"></th>
                        <th>Rule</th>
                        <th>Condition</th>
                        <th>Now</th>
                        <th style="width: 10rem"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in _rules)
                    {
                        var firing = Evaluator.IsFiring(rule.Id);
                        var spec = SpecFor(rule);
                        <tr>
                            <td>
                                <span class="status-dot @(!rule.Enabled ? "status-unknown" : firing ? "status-down" : "status-up")"
                                      title="@(!rule.Enabled ? "Disabled" : firing ? "Firing" : "OK")"></span>
                            </td>
                            <td>
                                <div class="tile-name">@rule.Describe(spec, NameOf(rule.ConnectionId), _units)</div>
                                <div class="tile-meta">
                                    @(rule.ConnectionId is null ? "Any connection reporting this metric" : NameOf(rule.ConnectionId))
                                    @if (rule.ForMinutes > 0)
                                    {
                                        <text> · sustained @rule.ForMinutes min</text>
                                    }
                                    @if (FixNote(rule) is { } fixNote)
                                    {
                                        <text> · 🩹 @fixNote</text>
                                    }
                                </div>
                            </td>
                            <td class="tile-meta">
                                @if (rule.IsUnusual)
                                {
                                    <code>@rule.Metric</code> @rule.UnusualPhrase()
                                    <div>@UnusualDetail(rule)</div>
                                }
                                else
                                {
                                    <code>@rule.Metric</code> @rule.ComparisonWord @Units.Format(spec, rule.Threshold, _units)
                                    @if (rule.ClearThreshold is { } clear && Math.Abs(clear - rule.Threshold) > double.Epsilon)
                                    {
                                        <div>clears past @Units.Format(spec, clear, _units)</div>
                                    }
                                }
                            </td>
                            <td>
                                @foreach (var breach in Readings(rule))
                                {
                                    <div class="@(breach.Firing ? "text-danger" : "tile-meta")">
                                        @Reading(rule, breach)
                                        <span class="tile-meta">@NameOf(breach.ConnectionId)</span>
                                        @if (breach.Usual is { } usual)
                                        {
                                            <div class="tile-meta">usually about @MetricAlertService.About(SpecFor(rule, breach.ConnectionId), usual.Median, _units) @usual.When</div>
                                        }
                                        @if (breach.Firing && DeliveryNote(rule, breach) is { } note)
                                        {
                                            <div class="tile-meta">@note</div>
                                        }
                                    </div>
                                }
                                @if (Readings(rule).Count == 0)
                                {
                                    <span class="tile-meta">@(rule.IsUnusual ? LearningNote(rule) : "no data yet")</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(rule)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = rule">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_draft is { } draft)
{
    <Modal Title="@(_isNew ? "New alert rule" : "Edit alert rule")" OnClose="() => _draft = null">
        <ChildContent>
            <div class="mb-3">
                <label class="form-label" for="rule-connection">Watch</label>
                <select id="rule-connection" class="form-select" value="@(draft.ConnectionId ?? "")"
                        @onchange="e => OnConnectionChangedAsync(e.Value?.ToString())">
                    <option value="">Any connection reporting the metric</option>
                    @foreach (var connection in _connections)
                    {
                        <option value="@connection.Id">@connection.Name</option>
                    }
                </select>
                <div class="form-text">
                    “Any” means a NAS you add next month is covered by this rule with no edit.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="rule-metric">Metric</label>
                <input id="rule-metric" class="form-control font-monospace" list="rule-metric-options"
                       value="@draft.Metric" placeholder="disk_percent"
                       @onchange="e => SetMetricAsync(e.Value?.ToString())" />
                <datalist id="rule-metric-options">
                    @foreach (var option in _metricOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </datalist>
            </div>

            <div class="mb-3">
                <label class="form-label" for="rule-kind">Alert on</label>
                <select id="rule-kind" class="form-select" value="@draft.Kind.ToString()" @onchange="SetKindAsync">
                    <option value="Threshold">a fixed limit</option>
                    <option value="Unusual">what is unusual for the time of day</option>
                </select>
                <div class="form-text">
                    For numbers with no single right line — a connection that is quick at 4am and slow at
                    8pm, a NAS that runs warm in the afternoon. It learns what each hour usually looks like
                    from the last four weeks, weekdays and weekends apart.
                </div>
            </div>

            @if (draft.IsUnusual)
            {
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="rule-direction">When it is</label>
                        <select id="rule-direction" class="form-select" value="@draft.Comparison.ToString()"
                                @onchange="SetComparison">
                            <option value="Below">lower than usual</option>
                            <option value="Above">higher than usual</option>
                            <option value="Either">either way</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="rule-by">Measured</label>
                        <select id="rule-by" class="form-select" value="@draft.UnusualBy.ToString()"
                                @onchange="SetUnusualBy">
                            <option value="Percent">as a share of usual</option>
                            <option value="Spread">against its normal ups and downs</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="rule-threshold">
                        @(draft.UnusualBy == UnusualBy.Percent ? "Percent of usual" : "How far outside its normal range")
                    </label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var (value, label) in Presets(draft))
                        {
                            var chosen = value;
                            <button type="button"
                                    class="btn btn-sm @(Math.Abs(draft.Threshold - chosen) < 1e-9 ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => SetUnusualThreshold(chosen)">@label</button>
                        }
                    </div>
                    <input id="rule-threshold" type="number" step="any" class="form-control"
                           value="@draft.Threshold.ToString("0.####")"
                           @onchange="e => SetUnusualThreshold(Parse(e.Value, draft.Threshold))" />
                    <div class="form-text">
                        @if (draft.UnusualBy == UnusualBy.Percent)
                        {
                            <text>
                                Now reads “@draft.UnusualPhrase()”. Best for things counted from zero — speeds,
                                streams, watts. A metric that is usually zero at some hour cannot be judged
                                this way then; use its normal range instead.
                            </text>
                        }
                        else
                        {
                            <text>
                                Now reads “@draft.UnusualPhrase()”: @draft.Threshold.ToString("0.#") times further
                                out than it normally strays at that hour. Best for temperatures and anything
                                steady, where 10% off is already a lot.
                            </text>
                        }
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="rule-for">For (minutes)</label>
                        <input id="rule-for" type="number" min="0" class="form-control" value="@draft.ForMinutes"
                               @onchange="e => _draft = draft with { ForMinutes = (int)Parse(e.Value, 0) }" />
                        <div class="form-text">Half an hour stops one odd reading alerting.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="rule-clear">
                            @(draft.UnusualBy == UnusualBy.Percent ? "Clears at (% of usual)" : "Clears within")
                        </label>
                        <input id="rule-clear" type="number" step="any" class="form-control"
                               value="@(draft.ClearThreshold is { } band ? band.ToString("0.####") : "")"
                               placeholder="@draft.UnusualClearsAt.ToString("0.#")"
                               @onchange="e => _draft = draft with { ClearThreshold = ParseOptional(e.Value) }" />
                        <div class="form-text">
                            Blank clears two thirds of the way back to usual, so a reading wobbling on the
                            line does not alert over and over.
                        </div>
                    </div>
                </div>

                <div class="alert alert-secondary py-2 mb-3">
                    @if (_preview is null)
                    {
                        <span class="tile-meta">Working out what is usual…</span>
                    }
                    else
                    {
                        @_preview
                    }
                </div>
            }
            else
            {
                <div class="row g-2 mb-3">
                    <div class="col-5">
                        <label class="form-label" for="rule-comparison">When it is</label>
                        @* The handler is a method rather than a lambda because a string
                           literal inside a quoted Razor attribute ends the attribute. *@
                        <select id="rule-comparison" class="form-select" value="@draft.Comparison.ToString()"
                                @onchange="SetComparison">
                            <option value="Above">above</option>
                            <option value="Below">below</option>
                        </select>
                    </div>
                    <div class="col-7">
                        <label class="form-label" for="rule-threshold">Threshold @UnitSuffix(draft)</label>
                        <input id="rule-threshold" type="number" step="any" class="form-control"
                               value="@ToDisplay(draft, draft.Threshold)"
                               @onchange="e => SetThreshold(e.Value)" />
                    </div>
                </div>
    
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="rule-for">For (minutes)</label>
                        <input id="rule-for" type="number" min="0" class="form-control" value="@draft.ForMinutes"
                               @onchange="e => _draft = draft with { ForMinutes = (int)Parse(e.Value, 0) }" />
                        <div class="form-text">0 fires immediately. A few minutes ignores the nightly backup spike.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="rule-clear">Clears at @UnitSuffix(draft)</label>
                        <input id="rule-clear" type="number" step="any" class="form-control"
                               value="@(draft.ClearThreshold is { } c ? ToDisplay(draft, c) : "")"
                               placeholder="@ToDisplay(draft, draft.Threshold)"
                               @onchange="e => SetClearThreshold(e.Value)" />
                        <div class="form-text">
                            Blank uses the threshold. Setting it slightly back stops a metric sitting on the
                            line from alerting over and over.
                        </div>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="rule-channel">Send through</label>
                <select id="rule-channel" class="form-select" value="@(draft.ChannelId ?? "")"
                        @onchange="e => _draft = draft with { ChannelId = e.Value?.ToString() is { Length: > 0 } id ? id : null }">
                    <option value="">Every channel</option>
                    @foreach (var channel in _channels)
                    {
                        <option value="@channel.Id">@channel.Icon @channel.Name</option>
                    }
                </select>
                <div class="form-text">
                    Pick one to keep a noisy rule out of the others — the disk-space one to email,
                    the front door to your phone.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="rule-escalate">If it is still firing</label>
                <select id="rule-escalate" class="form-select" value="@EscalationMode(draft)" @onchange="SetEscalationMode">
                    <option value="default">@(_escalation.On ? $"Use the default — escalate after {_escalation.AfterMinutes} min" : "Use the default — which is off")</option>
                    <option value="never">Never escalate this rule</option>
                    <option value="custom">Escalate it my own way</option>
                </select>
                @if (draft.EscalateAfterMinutes is > 0)
                {
                    <div class="row g-2 mt-1">
                        <div class="col-6">
                            <label class="form-label" for="rule-escalate-after">After (minutes)</label>
                            <input id="rule-escalate-after" type="number" min="1" class="form-control" value="@draft.EscalateAfterMinutes"
                                   @onchange="e => _draft = draft with { EscalateAfterMinutes = Math.Max(1, (int)Parse(e.Value, 15)) }" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="rule-escalate-repeat">Repeat every (minutes)</label>
                            <input id="rule-escalate-repeat" type="number" min="0" class="form-control" value="@draft.EscalateRepeatMinutes"
                                   @onchange="e => _draft = draft with { EscalateRepeatMinutes = Math.Max(0, (int)Parse(e.Value, 0)) }" />
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-3 mt-2">
                        @foreach (var channel in _channels)
                        {
                            var id = channel.Id;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@($"rule-escalate-to-{id}")"
                                       checked="@EscalationPolicy.ParseChannels(draft.EscalateTo).Contains(id)"
                                       @onchange="e => _draft = draft with { EscalateTo = string.Join(',', Toggle(EscalationPolicy.ParseChannels(draft.EscalateTo), id, e.Value is true)) }" />
                                <label class="form-check-label" for="@($"rule-escalate-to-{id}")">@channel.Icon @channel.Name</label>
                            </div>
                        }
                    </div>
                    <div class="form-text">
                        None ticked sends to every channel. Repeat 0 escalates once. The recovery goes to
                        these channels too.
                    </div>
                }
            </div>

            <RemediationEditor Value="_draftFix" ValueChanged="v => _draftFix = v" Heading="When this fires…"
                               Trigger="@Remediation.RuleTrigger(draft.Id)" Id="rule-fix"
                               SuggestedContainer="@SuggestedContainer(draft)" />

            <div class="mb-3">
                <label class="form-label" for="rule-name">Name</label>
                <input id="rule-name" class="form-control" value="@draft.Name" placeholder="@Preview(draft)"
                       @onchange="e => _draft = draft with { Name = e.Value?.ToString() ?? string.Empty }" />
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="rule-enabled"
                       checked="@draft.Enabled"
                       @onchange="e => _draft = draft with { Enabled = e.Value is true }" />
                <label class="form-check-label" for="rule-enabled">Enabled</label>
            </div>

            @if (_validation is { Length: > 0 })
            {
                <div class="alert alert-warning py-2 mt-3 mb-0">@_validation</div>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-secondary btn-sm" @onclick="() => _draft = null">Cancel</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
        </Footer>
    </Modal>
}

@if (_confirmDelete is { } deleting)
{
    <ConfirmDialog Title="Delete this rule?"
                   Message="@($"“{deleting.Describe(SpecFor(deleting), NameOf(deleting.ConnectionId), _units)}” will stop being checked.")"
                   ConfirmText="Delete"
                   OnCancel="() => _confirmDelete = null"
                   OnConfirm="DeleteConfirmedAsync" />
}

@if (_windowDraft is { } win)
{
    <Modal Title="@(_windowIsNew ? "New mute window" : "Edit mute window")" OnClose="() => _windowDraft = null">
        <ChildContent>
            <div class="mb-3">
                <label class="form-label" for="window-name">Name</label>
                <input id="window-name" class="form-control" value="@win.Name" placeholder="NAS scrub"
                       @onchange="e => _windowDraft = win with { Name = e.Value?.ToString() ?? string.Empty }" />
                <div class="form-text">What an alert is shown as “muted by”.</div>
            </div>

            <div class="mb-3">
                <div class="form-label">Starts on</div>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var day in MuteWindow.Week)
                    {
                        var chosen = day;
                        var on = win.Days.Contains(day);
                        <button type="button" class="btn btn-sm @(on ? "btn-primary" : "btn-outline-secondary")"
                                aria-pressed="@(on ? "true" : "false")"
                                @onclick="() => _windowDraft = win with { Days = Toggle(win.Days, chosen, !on) }">@(day.ToString()[..3])</button>
                    }
                </div>
                <div class="d-flex flex-wrap gap-1">
                    <button type="button" class="btn btn-sm btn-link px-1" @onclick="() => _windowDraft = win with { Days = MuteWindow.Week }">Every day</button>
                    <button type="button" class="btn btn-sm btn-link px-1" @onclick="() => _windowDraft = win with { Days = MuteWindow.Weekdays }">Weekdays</button>
                    <button type="button" class="btn btn-sm btn-link px-1" @onclick="() => _windowDraft = win with { Days = [DayOfWeek.Saturday, DayOfWeek.Sunday] }">Weekends</button>
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" for="window-start">From</label>
                    <input id="window-start" type="time" class="form-control" value="@win.Start.ToString("HH\\:mm")"
                           @onchange="e => _windowDraft = win with { Start = MuteWindow.ParseTime(e.Value?.ToString()) }" />
                </div>
                <div class="col-6">
                    <label class="form-label" for="window-end">Until</label>
                    <input id="window-end" type="time" class="form-control" value="@win.End.ToString("HH\\:mm")"
                           @onchange="e => _windowDraft = win with { End = MuteWindow.ParseTime(e.Value?.ToString()) }" />
                </div>
                <div class="col-12 form-text">
                    Now reads “@win.Describe()”. An end at or before the start runs into the next morning, and
                    counts as the day it started; the same time at both ends is a whole day.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="window-scope">Mutes</label>
                <select id="window-scope" class="form-select" value="@win.Scope.ToString()" @onchange="SetWindowScope">
                    <option value="Everything">every alert</option>
                    <option value="Connections">everything about some connections — their rules and them going down</option>
                    <option value="Rules">some alert rules</option>
                </select>
            </div>

            @if (win.Scope == MuteScope.Connections)
            {
                <div class="mb-3 d-flex flex-column gap-1">
                    @foreach (var connection in _connections)
                    {
                        var id = connection.Id;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@($"window-conn-{id}")"
                                   checked="@win.Targets.Contains(id)"
                                   @onchange="e => _windowDraft = win with { Targets = Toggle(win.Targets, id, e.Value is true) }" />
                            <label class="form-check-label" for="@($"window-conn-{id}")">@connection.Name</label>
                        </div>
                    }
                </div>
            }
            else if (win.Scope == MuteScope.Rules)
            {
                <div class="mb-3 d-flex flex-column gap-1">
                    @foreach (var rule in _rules)
                    {
                        var id = rule.Id;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@($"window-rule-{id}")"
                                   checked="@win.Targets.Contains(id)"
                                   @onchange="e => _windowDraft = win with { Targets = Toggle(win.Targets, id, e.Value is true) }" />
                            <label class="form-check-label" for="@($"window-rule-{id}")">@rule.Describe(SpecFor(rule), NameOf(rule.ConnectionId), _units)</label>
                        </div>
                    }
                    @if (_rules.Count == 0)
                    {
                        <span class="tile-meta">There are no rules yet.</span>
                    }
                </div>
            }

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="window-enabled"
                       checked="@win.Enabled"
                       @onchange="e => _windowDraft = win with { Enabled = e.Value is true }" />
                <label class="form-check-label" for="window-enabled">On</label>
            </div>

            @if (_windowValidation is { Length: > 0 })
            {
                <div class="alert alert-warning py-2 mt-3 mb-0">@_windowValidation</div>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-secondary btn-sm" @onclick="() => _windowDraft = null">Cancel</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveWindowAsync">Save</button>
        </Footer>
    </Modal>
}

@if (_confirmDeleteWindow is { } deletingWindow)
{
    <ConfirmDialog Title="Delete this mute window?"
                   Message="@($"“{deletingWindow.Name}” will stop muting anything. An alert it is holding right now is sent on the next check if it is still firing.")"
                   ConfirmText="Delete"
                   OnCancel="() => _confirmDeleteWindow = null"
                   OnConfirm="DeleteWindowConfirmedAsync" />
}

@code {
    private IReadOnlyList<AlertRule> _rules = [];
    private IReadOnlyList<Connection> _connections = [];
    private IReadOnlyList<SelectOption> _metricOptions = [];
    private BackgroundLoad _recordedMetrics = default!;
    private IReadOnlyList<Connection> _channels = [];
    private int _channelCount;
    private AlertPolicy _policy = AlertPolicy.Default;
    private List<Offer> _suggestions = [];
    private Units.Preferences _units = Units.Preferences.Default;
    private bool _adding;

    private sealed record Offer(Connection Connection, SuggestedRule Rule);

    private AlertRule? _draft;
    private AlertRule? _confirmDelete;

    /// <summary>The self-healing part of the rule being edited; null for none. Saved with the rule.</summary>
    private Remediation? _draftFix;
    private RemediationSettings _healing = new(true, RemediationSettings.DefaultMaxPerHour);
    private IReadOnlyList<Change> _recentFixes = [];
    private int _fixCount;
    private bool _isNew;
    private string? _validation;

    private IReadOnlyList<MuteWindow> _windows = [];
    private MuteWindow? _windowDraft;
    private MuteWindow? _confirmDeleteWindow;
    private bool _windowIsNew;
    private string? _windowValidation;
    private EscalationPolicy _escalation = EscalationPolicy.Off;

    /// <summary>
    /// "Now 180 Mbps; usually about 520 at this hour", for the unusual rule being drawn up.
    /// Null while it is being worked out.
    /// </summary>
    private string? _preview;

    /// <summary>Which preview is current, so a slow one finishing after a faster one does not overwrite it.</summary>
    private int _previewVersion;

    protected override async Task OnInitializedAsync()
    {
        _recordedMetrics = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Rules.Changed += OnChanged;
        Mutes.Changed += OnChanged;
        Remediations.Changed += OnChanged;
        Evaluator.Updated += OnChanged;
        await LoadAsync();
    }

    /// <summary>
    /// Saved whole, from the one control that changed, as the quiet hours are. Through
    /// <see cref="Offload"/> because a save is a database write, and the circuit should not
    /// wait on one.
    /// </summary>
    private async Task SaveEscalationAsync(EscalationPolicy next)
    {
        _escalation = next;
        await Offload.Run(async ct =>
        {
            await AppSettings.SaveAsync(next.ToSettings(), ct);
            return true;
        });
    }

    private async Task SaveHealingAsync(RemediationSettings next)
    {
        _healing = next;
        await Offload.Run(async ct =>
        {
            await AppSettings.SaveAsync(next.ToSettings(), ct);
            return true;
        });
    }

    /// <summary>Saves or removes the self-healing part of a rule, with the rule.</summary>
    private async Task SaveFixAsync(string trigger, Remediation? fix)
    {
        await Offload.Run(async ct =>
        {
            if (fix is null)
                await Remediations.DeleteAsync(trigger, ct);
            else
                await Remediations.SaveAsync(fix with { Trigger = trigger }, ct);
            return true;
        });
    }

    /// <summary>A rule on one connection suggests a container named after it — Plex, plex.</summary>
    private string? SuggestedContainer(AlertRule rule) =>
        rule.ConnectionId is { } id ? _connections.FirstOrDefault(c => c.Id == id)?.Name.ToLowerInvariant().Replace(' ', '-') : null;

    /// <summary>"self-healing: restart plex" under a rule that has one.</summary>
    private string? FixNote(AlertRule rule) =>
        Remediations.Current.FirstOrDefault(f => f.Trigger == Remediation.RuleTrigger(rule.Id)) is { Enabled: true, IsComplete: true } fix
            ? fix.IsContainer ? $"self-healing: {Remediation.StoredKind(fix.Kind)} {Remediation.Describe(fix.Container)}" : "self-healing: runs an action"
            : null;

    private string ChannelName(string id) => _channels.FirstOrDefault(c => c.Id == id)?.Name ?? "a deleted channel";

    private static IReadOnlyList<T> Toggle<T>(IReadOnlyList<T> list, T item, bool on) =>
        on ? [.. list.Append(item).Distinct()] : [.. list.Where(x => !EqualityComparer<T>.Default.Equals(x, item))];

    /// <summary>
    /// What a firing breach's notification is doing, beside its reading: held by a window,
    /// or escalated. Null when it simply went out, which is the ordinary case and needs no note.
    /// </summary>
    private string? DeliveryNote(AlertRule rule, MetricAlertService.Breach breach)
    {
        if (Alerts.MutedBy(rule.Id, breach.ConnectionId, DateTimeOffset.Now) is { } window)
            return $"muted by {window.Name}";
        if (Alerts.Delivery(FiringAlert.RuleKey(rule.Id, breach.ConnectionId)) is { Escalations: > 0 } entry)
            return entry.Escalations == 1
                ? $"escalated at {entry.EscalatedAt?.ToLocalTime():HH:mm}"
                : $"escalated {entry.Escalations} times, last at {entry.EscalatedAt?.ToLocalTime():HH:mm}";
        return null;
    }

    private static string EscalationMode(AlertRule rule) => rule.EscalateAfterMinutes switch
    {
        null => "default",
        <= 0 => "never",
        _ => "custom",
    };

    /// <summary>
    /// Choosing "my own way" starts from the default's numbers where there are any, so
    /// somebody tweaking one rule does not have to re-enter the rest.
    /// </summary>
    private void SetEscalationMode(ChangeEventArgs args)
    {
        var draft = _draft!;
        _draft = args.Value?.ToString() switch
        {
            "never" => draft with { EscalateAfterMinutes = 0 },
            "custom" => draft with
            {
                EscalateAfterMinutes = _escalation.On ? _escalation.AfterMinutes : 15,
                EscalateTo = string.Join(',', _escalation.Channels),
                EscalateRepeatMinutes = _escalation.RepeatMinutes,
            },
            _ => draft with { EscalateAfterMinutes = null },
        };
    }

    /// <summary>"Mutes everything", "Mutes NAS, Router", "Mutes CPU above 90%".</summary>
    private string ScopeText(MuteWindow window) => window.Scope switch
    {
        MuteScope.Everything => "Mutes every alert",
        MuteScope.Connections => "Mutes " + Names(window.Targets.Select(id => _connections.FirstOrDefault(c => c.Id == id)?.Name)),
        _ => "Mutes " + Names(window.Targets.Select(id => _rules.FirstOrDefault(r => r.Id == id) is { } rule
            ? rule.Describe(SpecFor(rule), NameOf(rule.ConnectionId), _units)
            : null)),
    };

    private static string Names(IEnumerable<string?> names)
    {
        var known = names.OfType<string>().ToList();
        return known.Count == 0 ? "nothing that still exists" : string.Join(", ", known);
    }

    private void StartNewWindow()
    {
        _windowIsNew = true;
        _windowValidation = null;
        _windowDraft = new MuteWindow
        {
            Days = [DayOfWeek.Sunday],
            Start = new TimeOnly(1, 0),
            End = new TimeOnly(5, 0),
        };
    }

    private void EditWindow(MuteWindow window)
    {
        _windowIsNew = false;
        _windowValidation = null;
        _windowDraft = window;
    }

    /// <summary>Switching what it mutes clears the ticks, which were ids of the other kind.</summary>
    private void SetWindowScope(ChangeEventArgs args)
    {
        var scope = Enum.TryParse<MuteScope>(args.Value?.ToString(), out var parsed) ? parsed : MuteScope.Everything;
        if (_windowDraft is { } draft && draft.Scope != scope)
            _windowDraft = draft with { Scope = scope, Targets = [] };
    }

    private async Task SaveWindowAsync()
    {
        if (_windowDraft is not { } window)
            return;

        if (window.Problem() is { } problem)
        {
            _windowValidation = problem;
            return;
        }

        await Offload.Run(async ct =>
        {
            await Mutes.SaveAsync(window with { Name = window.Name.Trim() }, ct);
            return true;
        });
        _windowDraft = null;
    }

    private async Task DeleteWindowConfirmedAsync()
    {
        if (_confirmDeleteWindow is { } window)
        {
            await Offload.Run(async ct =>
            {
                await Mutes.DeleteAsync(window.Id, ct);
                return true;
            });
        }
        _confirmDeleteWindow = null;
    }

    /// <summary>
    /// Each control saves the one thing it changed, so a half-typed time cannot wipe the
    /// other end of the window. A blank on either side turns quiet hours off, which is what
    /// clearing the box looks like it should do.
    /// </summary>
    private async Task SaveQuietAsync(string? from, string? to, string? mode)
    {
        var next = _policy with
        {
            QuietFrom = from is null ? _policy.QuietFrom : Parse(from),
            QuietTo = to is null ? _policy.QuietTo : Parse(to),
            QuietMode = mode ?? _policy.QuietMode,
        };

        await AppSettings.SaveAsync(new Dictionary<string, string>
        {
            [AlertPolicy.FromKey] = next.QuietFrom.ToString("HH\\:mm"),
            [AlertPolicy.ToKey] = next.QuietTo.ToString("HH\\:mm"),
            [AlertPolicy.ModeKey] = next.QuietMode,
        });

        _policy = next;

        static TimeOnly Parse(string value) => TimeOnly.TryParse(value, out var parsed) ? parsed : default;
    }

    private async Task ClearQuietAsync() => await SaveQuietAsync("", "", null);

    private async Task LoadAsync()
    {
        _rules = await Rules.AllAsync();
        _connections = [.. (await Config.ConnectionsAsync()).Where(c => Registry.Provider(c.Provider)?.IsMonitored != false)];
        _channels = [.. (await Alerts.ChannelsAsync()).Select(pair => pair.Connection)];
        _channelCount = _channels.Count;
        _policy = AlertPolicy.From(await AppSettings.AllAsync());
        _escalation = EscalationPolicy.From(await AppSettings.AllAsync());
        _units = Units.Preferences.From(await AppSettings.AllAsync());
        _windows = await Offload.Run(ct => Mutes.AllAsync(ct));
        _healing = RemediationSettings.From(await AppSettings.AllAsync());
        var fixes = await Offload.Run(ct => Remediations.AllAsync(ct));
        _fixCount = fixes.Count(f => f.Enabled);
        _recentFixes = await Offload.Run(ct => Healing.RecentAsync(14, 10, DateTimeOffset.Now, ct));
        LoadSuggestions();
        LoadMetrics(_draft?.ConnectionId);
    }

    /// <summary>
    /// What each connected provider recommends, minus anything an existing rule already
    /// covers — including a rule that watches every connection, since that covers this
    /// one too.
    /// </summary>
    private void LoadSuggestions()
    {
        _suggestions = [.. _connections
            .SelectMany(connection => (Registry.Provider(connection.Provider)?.SuggestedRules ?? [])
                .Where(rule => !_rules.Any(existing => rule.IsCoveredBy(existing, connection.Id)))
                .Select(rule => new Offer(connection, rule)))];
    }

    private async Task AddSuggestionAsync(Offer offer)
    {
        _adding = true;
        try
        {
            await Rules.SaveAsync(offer.Rule.ForConnection(offer.Connection.Id));
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task AddAllSuggestionsAsync()
    {
        _adding = true;
        try
        {
            // Snapshot first: saving raises Changed, which reloads and rewrites the list
            // being iterated.
            foreach (var offer in _suggestions.ToList())
                await Rules.SaveAsync(offer.Rule.ForConnection(offer.Connection.Id));
        }
        finally
        {
            _adding = false;
        }
    }

    /// <summary>
    /// Suggestions come from the whole install when the rule is not pinned to one
    /// connection, because that is exactly the case where the user cannot know which
    /// names are available.
    ///
    /// Two halves. What the providers declare is known without asking anything, and is
    /// offered straight away. What history has recorded is a query per connection — every
    /// connection, for a rule not pinned to one — so it runs off the render thread and is
    /// added when it lands (see BackgroundLoad); the form is usable in the meantime. It
    /// used to be awaited here, which on a busy install kept the page from opening, and
    /// ran again on every evaluator pass.
    /// </summary>
    private void LoadMetrics(string? connectionId)
    {
        var connections = (connectionId is null ? _connections : _connections.Where(c => c.Id == connectionId)).ToList();

        _metricOptions = MetricOptions(connections, new Dictionary<string, IReadOnlyList<string>>());

        async Task<Dictionary<string, IReadOnlyList<string>>> Fetch(CancellationToken ct) =>
            await Offload.Run(async c =>
            {
                var recorded = new Dictionary<string, IReadOnlyList<string>>();
                foreach (var connection in connections)
                    recorded[connection.Id] = await History.MetricsAsync(connection.Id, c);
                return recorded;
            }, ct);

        // Keyed on the connections as well as the choice, so adding one reloads, while the
        // evaluator's regular passes — which reload everything else here — do not.
        var key = $"{connectionId}|{string.Join(",", connections.Select(c => c.Id))}";
        _ = _recordedMetrics.Load(key, Fetch, recorded => _metricOptions = MetricOptions(connections, recorded));
    }

    private IReadOnlyList<SelectOption> MetricOptions(
        IReadOnlyList<Connection> connections, IReadOnlyDictionary<string, IReadOnlyList<string>> recorded)
    {
        var declared = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var connection in connections)
        {
            var keys = new List<string>();
            foreach (var metric in Registry.MetricsFor(connection))
            {
                declared.TryAdd(metric.Key, metric.Label);
                keys.Add(metric.Key);
            }
            foreach (var key in recorded.GetValueOrDefault(connection.Id) ?? [])
            {
                // Through the registry rather than the bare fallback, so a volume recorded
                // before this page's provider has probed is still labelled after its metric.
                declared.TryAdd(key, Registry.Metric(connection, key).Label);
                keys.Add(key);
            }

            // Anything that fills towards a limit can also be watched by when it will get
            // there — "warn me a month before the volume is full" — which is often the more
            // useful rule, since 90% on a slow-filling volume is a year of notice and on a
            // fast one is an evening.
            foreach (var key in keys.Where(key => Registry.CapacityOf(connection, key) is not null))
            {
                var derived = Registry.Metric(connection, CapacityMetric.KeyFor(key));
                declared.TryAdd(derived.Key, derived.Label);
            }
        }

        return [.. declared.OrderBy(pair => pair.Key).Select(pair => new SelectOption(pair.Key, pair.Value))];
    }

    private async Task OnConnectionChangedAsync(string? id)
    {
        var connectionId = string.IsNullOrEmpty(id) ? null : id;
        _draft = _draft! with { ConnectionId = connectionId };
        LoadMetrics(connectionId);
        await RefreshPreviewAsync();
    }

    private async Task SetMetricAsync(string? metric)
    {
        _draft = _draft! with { Metric = metric?.Trim() ?? string.Empty };
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Switching kind resets the numbers to a sensible start for that kind: a threshold of
    /// 90 means "90%" on one and "90% of usual" on the other, and carrying it across would
    /// quietly make a rule that fires most evenings.
    /// </summary>
    private async Task SetKindAsync(ChangeEventArgs args)
    {
        var unusual = string.Equals(args.Value?.ToString(), nameof(RuleKind.Unusual), StringComparison.Ordinal);
        var draft = _draft!;
        if (unusual == draft.IsUnusual)
            return;

        _draft = unusual
            ? draft with
            {
                Kind = RuleKind.Unusual,
                UnusualBy = UnusualBy.Percent,
                Comparison = Comparison.Below,
                Threshold = 50,
                ClearThreshold = null,
                ForMinutes = Math.Max(draft.ForMinutes, 30),
            }
            : draft with
            {
                Kind = RuleKind.Threshold,
                Comparison = draft.Comparison == Comparison.Either ? Comparison.Above : draft.Comparison,
                Threshold = 90,
                ClearThreshold = null,
            };
        await RefreshPreviewAsync();
    }

    private void SetUnusualBy(ChangeEventArgs args)
    {
        var spread = string.Equals(args.Value?.ToString(), nameof(UnusualBy.Spread), StringComparison.Ordinal);
        var draft = _draft!;
        _draft = draft with
        {
            UnusualBy = spread ? UnusualBy.Spread : UnusualBy.Percent,
            Threshold = spread ? 4 : draft.Comparison == Comparison.Below ? 50 : 200,
            ClearThreshold = null,
        };
    }

    private void SetUnusualThreshold(double value) =>
        _draft = _draft! with { Threshold = value, ClearThreshold = null };

    /// <summary>The quick picks, in words, for what the threshold box means under the current choices.</summary>
    private static IReadOnlyList<(double Value, string Label)> Presets(AlertRule draft) =>
        (draft.UnusualBy, draft.Comparison) switch
        {
            (UnusualBy.Spread, _) => [(3, "noticeably"), (4, "well"), (6, "far")],
            (_, Comparison.Below) => [(75, "under three quarters"), (50, "under half"), (25, "under a quarter")],
            (_, Comparison.Above) => [(150, "half as much again"), (200, "double"), (300, "triple")],
            _ => [(150, "1.5× either way"), (200, "double or half"), (300, "triple or a third")],
        };

    /// <summary>
    /// What is usual for the metric being drawn up, next to what it reads now, and what the
    /// rule would make of it — so somebody choosing "less than half" can see that tonight's
    /// 180 against a usual 520 would already count. Worked out off the circuit: it reads four
    /// weeks of history, and the page should not freeze while it does.
    /// </summary>
    private async Task RefreshPreviewAsync()
    {
        var version = ++_previewVersion;
        if (_draft is not { IsUnusual: true } draft)
            return;

        if (draft.ConnectionId is not { } connectionId || draft.Metric.Length == 0)
        {
            _preview = "Pick a connection to see what is usual for it. A rule on any connection learns each one separately.";
            return;
        }

        _preview = null;
        var metric = draft.Metric;
        MetricBaseline baseline;
        try
        {
            baseline = Baselines.Get(connectionId, metric)
                ?? await Task.Run(() => Baselines.RefreshAsync(connectionId, metric, CancellationToken.None));
        }
        catch (Exception)
        {
            if (version == _previewVersion)
                _preview = "Could not read this metric's history just now.";
            return;
        }

        if (version != _previewVersion || _draft is not { } current)
            return;

        var spec = SpecFor(current);
        if (baseline.At(DateTimeOffset.Now, Baselines.Zone) is not { } usual)
        {
            _preview = baseline.Days == 0
                ? $"No history for this metric yet. It needs {Days(MetricBaseline.MinDays)} before it can say what is usual."
                : $"Learning — needs {Days(baseline.DaysNeeded)} more of history before it can say what is usual. " +
                  "Until then this rule neither fires nor clears.";
            return;
        }

        var expected = $"usually about {MetricAlertService.About(spec, usual.Median, _units)} {usual.When}".TrimEnd();
        if (Monitor.State(connectionId)?.Metrics.TryGetValue(metric, out var value) != true)
        {
            _preview = $"No reading right now; {expected}.";
            return;
        }

        var reading = Units.Format(spec, value, _units, 1);
        var verdict = current.Judge(value, usual) switch
        {
            Verdict.Breaching => "That would count as unusual.",
            null => "A share of a usual zero cannot be judged — try measuring against its normal range.",
            _ => "That is within what this rule allows.",
        };
        _preview = $"Now {reading}; {expected}. {verdict}";
    }

    private static string Days(int count) => count == 1 ? "1 day" : $"{count} days";

    private string OfferCondition(Offer offer) =>
        offer.Rule.Kind == RuleKind.Unusual
            ? $"{offer.Rule.Metric} {offer.Rule.ForConnection(offer.Connection.Id).UnusualPhrase()}"
            : $"{offer.Rule.Metric} {offer.Rule.ComparisonWord} {Units.Format(Registry.Metric(offer.Connection, offer.Rule.Metric), offer.Rule.Threshold, _units)}";

    /// <summary>The numbers behind an unusual rule's phrase, for somebody who wants to know what "well above" means.</summary>
    private static string UnusualDetail(AlertRule rule) =>
        rule.UnusualBy == UnusualBy.Percent
            ? $"{rule.Threshold:0.##}% of usual, clears at {rule.UnusualClearsAt:0.#}%"
            : $"{rule.Threshold:0.#}× its normal range, clears within {rule.UnusualClearsAt:0.#}×";

    /// <summary>
    /// The Now column for an unusual rule with nothing to show: still learning, or not yet
    /// asked. Only a rule on one connection can say how long it has to go; one on every
    /// connection learns each separately.
    /// </summary>
    private string LearningNote(AlertRule rule)
    {
        if (rule.ConnectionId is not { } connectionId)
            return "learning what is usual";
        return Baselines.Get(connectionId, rule.Metric) switch
        {
            null => "no data yet",
            { IsLearning: true } baseline => $"learning — needs {Days(baseline.DaysNeeded)} more",
            _ => "no reading right now",
        };
    }

    private MetricSpec SpecFor(AlertRule rule, string? connectionId = null)
    {
        var connection = _connections.FirstOrDefault(c => c.Id == (connectionId ?? rule.ConnectionId));
        return Registry.Metric(connection, rule.Metric);
    }

    /// <summary>
    /// A reading as the Now column shows it. A forecast is shown in words — "full in about
    /// 6 weeks", "not filling" — since the number behind it is days to a precision it does
    /// not have, and infinity for a volume that is not filling at all.
    /// </summary>
    private string Reading(AlertRule rule, MetricAlertService.Breach breach) =>
        CapacityMetric.TryParse(rule.Metric, out var measured)
        && Forecasts.Soonest(breach.ConnectionId, measured) is { } soonest
            ? SoonestText(rule, breach.ConnectionId, soonest)
            : Units.Format(SpecFor(rule, breach.ConnectionId), breach.LastValue, _units, 1);

    /// <summary>
    /// "full in about 3 weeks", and which volume when a rule on the aggregate is answering
    /// for one of them — otherwise the Now column would show a date for the fullest volume's
    /// name that is really Volume 2's.
    /// </summary>
    private string SoonestText(AlertRule rule, string connectionId, CapacityForecasts.Entry soonest)
    {
        var text = soonest.Forecast.Describe();
        if (!CapacityMetric.TryParse(rule.Metric, out var measured)
            || string.Equals(measured, soonest.Metric, StringComparison.OrdinalIgnoreCase))
            return text;

        var connection = _connections.FirstOrDefault(c => c.Id == connectionId);
        return $"{Registry.Metric(connection, soonest.Metric).Label} {text}";
    }

    private string NameOf(string? connectionId) =>
        _connections.FirstOrDefault(c => c.Id == connectionId)?.Name ?? "";

    // Firing ones first: on an "any connection" rule watching a dozen boxes, the one
    // that is actually in trouble should not be somewhere down the list.
    private List<MetricAlertService.Breach> Readings(AlertRule rule) =>
        [.. Evaluator.All.Where(b => b.RuleId == rule.Id).OrderByDescending(b => b.Firing).ThenBy(b => NameOf(b.ConnectionId))];

    private string Preview(AlertRule rule) =>
        rule.Describe(SpecFor(rule), NameOf(rule.ConnectionId) is { Length: > 0 } n ? n : null, _units);

    private void SetComparison(ChangeEventArgs args)
    {
        var comparison = Enum.TryParse<Comparison>(args.Value?.ToString(), out var parsed) ? parsed : Comparison.Above;
        var draft = _draft!;

        // A percentage that made sense one way round is nonsense the other — "50% of usual"
        // is lower, and cannot be higher — so an unusual rule's number follows the direction.
        var threshold = draft is { IsUnusual: true, UnusualBy: UnusualBy.Percent }
            && (comparison == Comparison.Below) != (draft.Comparison == Comparison.Below)
                ? comparison == Comparison.Below ? 50 : 200
                : draft.Threshold;

        _draft = draft with
        {
            Comparison = comparison,
            Threshold = threshold,
            ClearThreshold = threshold == draft.Threshold ? draft.ClearThreshold : null,
        };
    }

    /// <summary>
    /// The editor works in whatever units the user reads in, but stores canonical values —
    /// otherwise someone shown °F would type 90 and save a 90°C threshold.
    /// </summary>
    private string UnitSuffix(AlertRule draft)
    {
        var unit = Units.LabelFor(SpecFor(draft), _units);
        return unit.Length > 0 ? $"({unit})" : "";
    }

    private string ToDisplay(AlertRule draft, double stored) =>
        Units.Display(stored, SpecFor(draft).Unit, _units).Value.ToString("0.####");

    private void SetThreshold(object? entered)
    {
        if (_draft is not { } draft)
            return;
        var typed = Parse(entered, Units.Display(draft.Threshold, SpecFor(draft).Unit, _units).Value);
        _draft = draft with { Threshold = Units.Store(typed, SpecFor(draft).Unit, _units) };
    }

    private void SetClearThreshold(object? entered)
    {
        if (_draft is not { } draft)
            return;
        var typed = ParseOptional(entered);
        _draft = draft with
        {
            ClearThreshold = typed is { } value ? Units.Store(value, SpecFor(draft).Unit, _units) : null,
        };
    }

    private static double Parse(object? value, double fallback) =>
        double.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;

    private static double? ParseOptional(object? value) =>
        double.TryParse(value?.ToString(), out var parsed) ? parsed : null;

    private void StartNew()
    {
        _isNew = true;
        _validation = null;
        _draft = new AlertRule { Metric = "disk_percent", Comparison = Comparison.Above, Threshold = 90, ForMinutes = 5 };
        _draftFix = null;
    }

    private async Task Edit(AlertRule rule)
    {
        _isNew = false;
        _validation = null;
        _draft = rule;
        _draftFix = Remediations.Current.FirstOrDefault(f => f.Trigger == Remediation.RuleTrigger(rule.Id));
        await RefreshPreviewAsync();
    }

    private async Task SaveAsync()
    {
        if (_draft is not { } rule)
            return;

        if (rule.Metric.Trim().Length == 0)
        {
            _validation = "Pick a metric — that is the number being watched.";
            return;
        }

        // A rule that can fire and never clear, or never fire, is worse than no rule at all.
        if (rule.Problem() is { } problem)
        {
            _validation = problem;
            return;
        }

        await Rules.SaveAsync(rule with { Metric = rule.Metric.Trim(), Name = rule.Name.Trim() });
        await SaveFixAsync(Remediation.RuleTrigger(rule.Id), _draftFix);
        _draft = null;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_confirmDelete is { } rule)
        {
            await Rules.DeleteAsync(rule.Id);
            await SaveFixAsync(Remediation.RuleTrigger(rule.Id), null);
        }
        _confirmDelete = null;
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Rules.Changed -= OnChanged;
        Mutes.Changed -= OnChanged;
        Remediations.Changed -= OnChanged;
        Evaluator.Updated -= OnChanged;
        _recordedMetrics?.Dispose();
    }
}
