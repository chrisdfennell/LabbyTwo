@page "/settings/alerts"
@rendermode InteractiveServer
@implements IDisposable
@inject AlertRuleStore Rules
@inject ConfigStore Config
@inject Registry Registry
@inject HistoryStore History
@inject MetricAlertService Evaluator
@inject AlertService Alerts
@inject AppSettingsStore AppSettings
@inject CapacityForecasts Forecasts
@inject MetricBaselines Baselines
@inject HealthMonitor Monitor

<PageTitle>Alert rules · LabbyTwo</PageTitle>

<div class="page-head">
    <div>
        <h1>🚨 Alert rules</h1>
        <p class="subtitle">
            Up/down alerting covers a service being unreachable. These cover the numbers —
            a volume filling, a battery draining, a temperature climbing.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="settings/connections">Alert channels</a>
        <button class="btn btn-sm btn-primary" @onclick="StartNew">+ New rule</button>
    </div>
</div>

@if (_channelCount == 0)
{
    <div class="alert alert-warning py-2">
        No alert channel is configured, so nothing will actually be delivered.
        <a href="settings/connections">Add a webhook or Pushover channel</a> first.
    </div>
}

@* Quiet hours sit above the rules on purpose: with forty things able to alert, when they
   are allowed to speak matters more than what any one of them says. *@
<div class="widget mb-3">
    <div class="widget-head">
        <h2 class="widget-title">Quiet hours</h2>
        <span class="tile-meta">@_policy.Describe()</span>
    </div>
    <div class="widget-body">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label" for="quiet-from">From</label>
                <input id="quiet-from" type="time" class="form-control"
                       value="@(_policy.QuietHoursOn ? _policy.QuietFrom.ToString("HH\\:mm") : "")"
                       @onchange="e => SaveQuietAsync(e.Value?.ToString(), null, null)" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="quiet-to">Until</label>
                <input id="quiet-to" type="time" class="form-control"
                       value="@(_policy.QuietHoursOn ? _policy.QuietTo.ToString("HH\\:mm") : "")"
                       @onchange="e => SaveQuietAsync(null, e.Value?.ToString(), null)" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="quiet-mode">While quiet</label>
                <select id="quiet-mode" class="form-select" value="@_policy.QuietMode"
                        @onchange="e => SaveQuietAsync(null, null, e.Value?.ToString())">
                    <option value="@AlertPolicy.DownOnly">Only send when something goes down</option>
                    <option value="@AlertPolicy.Nothing">Send nothing at all</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearQuietAsync"
                        disabled="@(!_policy.QuietHoursOn)">Turn off</button>
            </div>
        </div>

        <p class="tile-meta mb-0 mt-2">
            Held alerts are not queued for later — they are simply not sent. The state on this page
            still moves, so a rule that fired overnight is red here in the morning even though nothing
            reached your phone. Recoveries are always held while quiet: being woken to be told
            something came back is the purest kind of pointless alert.
        </p>
    </div>
</div>

@if (_suggestions.Count > 0)
{
    <div class="widget mb-3">
        <div class="widget-head">
            <h2 class="widget-title">Suggested for what you have connected</h2>
            <button class="btn btn-sm btn-outline-secondary" @onclick="AddAllSuggestionsAsync"
                    disabled="@_adding">Add all @_suggestions.Count</button>
        </div>
        <div class="widget-body">
            <p class="tile-meta">
                Sensible starting points from each integration. Nothing is created until you say so,
                and each one is an ordinary rule you can edit or delete afterwards.
            </p>
            <div class="d-flex flex-column gap-2">
                @foreach (var offer in _suggestions)
                {
                    var current = offer;
                    <div class="d-flex align-items-start gap-2">
                        <button class="btn btn-sm btn-outline-primary flex-none" disabled="@_adding"
                                @onclick="() => AddSuggestionAsync(current)">+ Add</button>
                        <div class="min-w-0">
                            <div class="tile-name">
                                @offer.Connection.Name · @offer.Rule.Name
                                <span class="tile-meta">
                                    @OfferCondition(offer)
                                    @if (offer.Rule.ForMinutes > 0)
                                    {
                                        <text> for @offer.Rule.ForMinutes min</text>
                                    }
                                </span>
                            </div>
                            @if (offer.Rule.Why is { Length: > 0 })
                            {
                                <div class="tile-meta">@offer.Rule.Why</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_rules.Count == 0)
{
    <div class="empty-state">
        <p class="mb-3">No rules yet.</p>
        <button class="btn btn-primary btn-sm" @onclick="StartNew">Add the first rule</button>
        <div class="form-text mt-3">
            A good first one: <code>disk_percent</code> above <code>90</code> on any connection.
        </div>
    </div>
}
else
{
    <div class="widget">
        <div class="widget-body p-0">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr class="tile-meta">
                        <th style="width: 2.5rem"></th>
                        <th>Rule</th>
                        <th>Condition</th>
                        <th>Now</th>
                        <th style="width: 10rem"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in _rules)
                    {
                        var firing = Evaluator.IsFiring(rule.Id);
                        var spec = SpecFor(rule);
                        <tr>
                            <td>
                                <span class="status-dot @(!rule.Enabled ? "status-unknown" : firing ? "status-down" : "status-up")"
                                      title="@(!rule.Enabled ? "Disabled" : firing ? "Firing" : "OK")"></span>
                            </td>
                            <td>
                                <div class="tile-name">@rule.Describe(spec.Label, NameOf(rule.ConnectionId))</div>
                                <div class="tile-meta">
                                    @(rule.ConnectionId is null ? "Any connection reporting this metric" : NameOf(rule.ConnectionId))
                                    @if (rule.ForMinutes > 0)
                                    {
                                        <text> · sustained @rule.ForMinutes min</text>
                                    }
                                </div>
                            </td>
                            <td class="tile-meta">
                                @if (rule.IsUnusual)
                                {
                                    <code>@rule.Metric</code> @rule.UnusualPhrase()
                                    <div>@UnusualDetail(rule)</div>
                                }
                                else
                                {
                                    <code>@rule.Metric</code> @rule.ComparisonWord @Units.Format(spec, rule.Threshold, _units)
                                    @if (rule.ClearThreshold is { } clear && Math.Abs(clear - rule.Threshold) > double.Epsilon)
                                    {
                                        <div>clears past @Units.Format(spec, clear, _units)</div>
                                    }
                                }
                            </td>
                            <td>
                                @foreach (var breach in Readings(rule))
                                {
                                    <div class="@(breach.Firing ? "text-danger" : "tile-meta")">
                                        @Reading(rule, breach)
                                        <span class="tile-meta">@NameOf(breach.ConnectionId)</span>
                                        @if (breach.Usual is { } usual)
                                        {
                                            <div class="tile-meta">usually about @MetricAlertService.About(SpecFor(rule, breach.ConnectionId), usual.Median, _units) @usual.When</div>
                                        }
                                    </div>
                                }
                                @if (Readings(rule).Count == 0)
                                {
                                    <span class="tile-meta">@(rule.IsUnusual ? LearningNote(rule) : "no data yet")</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(rule)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = rule">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_draft is { } draft)
{
    <Modal Title="@(_isNew ? "New alert rule" : "Edit alert rule")" OnClose="() => _draft = null">
        <ChildContent>
            <div class="mb-3">
                <label class="form-label" for="rule-connection">Watch</label>
                <select id="rule-connection" class="form-select" value="@(draft.ConnectionId ?? "")"
                        @onchange="e => OnConnectionChangedAsync(e.Value?.ToString())">
                    <option value="">Any connection reporting the metric</option>
                    @foreach (var connection in _connections)
                    {
                        <option value="@connection.Id">@connection.Name</option>
                    }
                </select>
                <div class="form-text">
                    “Any” means a NAS you add next month is covered by this rule with no edit.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="rule-metric">Metric</label>
                <input id="rule-metric" class="form-control font-monospace" list="rule-metric-options"
                       value="@draft.Metric" placeholder="disk_percent"
                       @onchange="e => SetMetricAsync(e.Value?.ToString())" />
                <datalist id="rule-metric-options">
                    @foreach (var option in _metricOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </datalist>
            </div>

            <div class="mb-3">
                <label class="form-label" for="rule-kind">Alert on</label>
                <select id="rule-kind" class="form-select" value="@draft.Kind.ToString()" @onchange="SetKindAsync">
                    <option value="Threshold">a fixed limit</option>
                    <option value="Unusual">what is unusual for the time of day</option>
                </select>
                <div class="form-text">
                    For numbers with no single right line — a connection that is quick at 4am and slow at
                    8pm, a NAS that runs warm in the afternoon. It learns what each hour usually looks like
                    from the last four weeks, weekdays and weekends apart.
                </div>
            </div>

            @if (draft.IsUnusual)
            {
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="rule-direction">When it is</label>
                        <select id="rule-direction" class="form-select" value="@draft.Comparison.ToString()"
                                @onchange="SetComparison">
                            <option value="Below">lower than usual</option>
                            <option value="Above">higher than usual</option>
                            <option value="Either">either way</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="rule-by">Measured</label>
                        <select id="rule-by" class="form-select" value="@draft.UnusualBy.ToString()"
                                @onchange="SetUnusualBy">
                            <option value="Percent">as a share of usual</option>
                            <option value="Spread">against its normal ups and downs</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="rule-threshold">
                        @(draft.UnusualBy == UnusualBy.Percent ? "Percent of usual" : "How far outside its normal range")
                    </label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var (value, label) in Presets(draft))
                        {
                            var chosen = value;
                            <button type="button"
                                    class="btn btn-sm @(Math.Abs(draft.Threshold - chosen) < 1e-9 ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => SetUnusualThreshold(chosen)">@label</button>
                        }
                    </div>
                    <input id="rule-threshold" type="number" step="any" class="form-control"
                           value="@draft.Threshold.ToString("0.####")"
                           @onchange="e => SetUnusualThreshold(Parse(e.Value, draft.Threshold))" />
                    <div class="form-text">
                        @if (draft.UnusualBy == UnusualBy.Percent)
                        {
                            <text>
                                Now reads “@draft.UnusualPhrase()”. Best for things counted from zero — speeds,
                                streams, watts. A metric that is usually zero at some hour cannot be judged
                                this way then; use its normal range instead.
                            </text>
                        }
                        else
                        {
                            <text>
                                Now reads “@draft.UnusualPhrase()”: @draft.Threshold.ToString("0.#") times further
                                out than it normally strays at that hour. Best for temperatures and anything
                                steady, where 10% off is already a lot.
                            </text>
                        }
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="rule-for">For (minutes)</label>
                        <input id="rule-for" type="number" min="0" class="form-control" value="@draft.ForMinutes"
                               @onchange="e => _draft = draft with { ForMinutes = (int)Parse(e.Value, 0) }" />
                        <div class="form-text">Half an hour stops one odd reading alerting.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="rule-clear">
                            @(draft.UnusualBy == UnusualBy.Percent ? "Clears at (% of usual)" : "Clears within")
                        </label>
                        <input id="rule-clear" type="number" step="any" class="form-control"
                               value="@(draft.ClearThreshold is { } band ? band.ToString("0.####") : "")"
                               placeholder="@draft.UnusualClearsAt.ToString("0.#")"
                               @onchange="e => _draft = draft with { ClearThreshold = ParseOptional(e.Value) }" />
                        <div class="form-text">
                            Blank clears two thirds of the way back to usual, so a reading wobbling on the
                            line does not alert over and over.
                        </div>
                    </div>
                </div>

                <div class="alert alert-secondary py-2 mb-3">
                    @if (_preview is null)
                    {
                        <span class="tile-meta">Working out what is usual…</span>
                    }
                    else
                    {
                        @_preview
                    }
                </div>
            }
            else
            {
                <div class="row g-2 mb-3">
                    <div class="col-5">
                        <label class="form-label" for="rule-comparison">When it is</label>
                        @* The handler is a method rather than a lambda because a string
                           literal inside a quoted Razor attribute ends the attribute. *@
                        <select id="rule-comparison" class="form-select" value="@draft.Comparison.ToString()"
                                @onchange="SetComparison">
                            <option value="Above">above</option>
                            <option value="Below">below</option>
                        </select>
                    </div>
                    <div class="col-7">
                        <label class="form-label" for="rule-threshold">Threshold @UnitSuffix(draft)</label>
                        <input id="rule-threshold" type="number" step="any" class="form-control"
                               value="@ToDisplay(draft, draft.Threshold)"
                               @onchange="e => SetThreshold(e.Value)" />
                    </div>
                </div>
    
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="rule-for">For (minutes)</label>
                        <input id="rule-for" type="number" min="0" class="form-control" value="@draft.ForMinutes"
                               @onchange="e => _draft = draft with { ForMinutes = (int)Parse(e.Value, 0) }" />
                        <div class="form-text">0 fires immediately. A few minutes ignores the nightly backup spike.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="rule-clear">Clears at @UnitSuffix(draft)</label>
                        <input id="rule-clear" type="number" step="any" class="form-control"
                               value="@(draft.ClearThreshold is { } c ? ToDisplay(draft, c) : "")"
                               placeholder="@ToDisplay(draft, draft.Threshold)"
                               @onchange="e => SetClearThreshold(e.Value)" />
                        <div class="form-text">
                            Blank uses the threshold. Setting it slightly back stops a metric sitting on the
                            line from alerting over and over.
                        </div>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="rule-channel">Send through</label>
                <select id="rule-channel" class="form-select" value="@(draft.ChannelId ?? "")"
                        @onchange="e => _draft = draft with { ChannelId = e.Value?.ToString() is { Length: > 0 } id ? id : null }">
                    <option value="">Every channel</option>
                    @foreach (var channel in _channels)
                    {
                        <option value="@channel.Id">@channel.Icon @channel.Name</option>
                    }
                </select>
                <div class="form-text">
                    Pick one to keep a noisy rule out of the others — the disk-space one to email,
                    the front door to your phone.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="rule-name">Name</label>
                <input id="rule-name" class="form-control" value="@draft.Name" placeholder="@Preview(draft)"
                       @onchange="e => _draft = draft with { Name = e.Value?.ToString() ?? string.Empty }" />
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="rule-enabled"
                       checked="@draft.Enabled"
                       @onchange="e => _draft = draft with { Enabled = e.Value is true }" />
                <label class="form-check-label" for="rule-enabled">Enabled</label>
            </div>

            @if (_validation is { Length: > 0 })
            {
                <div class="alert alert-warning py-2 mt-3 mb-0">@_validation</div>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-secondary btn-sm" @onclick="() => _draft = null">Cancel</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
        </Footer>
    </Modal>
}

@if (_confirmDelete is { } deleting)
{
    <ConfirmDialog Title="Delete this rule?"
                   Message="@($"“{deleting.Describe(SpecFor(deleting).Label, NameOf(deleting.ConnectionId))}” will stop being checked.")"
                   ConfirmText="Delete"
                   OnCancel="() => _confirmDelete = null"
                   OnConfirm="DeleteConfirmedAsync" />
}

@code {
    private IReadOnlyList<AlertRule> _rules = [];
    private IReadOnlyList<Connection> _connections = [];
    private IReadOnlyList<SelectOption> _metricOptions = [];
    private IReadOnlyList<Connection> _channels = [];
    private int _channelCount;
    private AlertPolicy _policy = AlertPolicy.Default;
    private List<Offer> _suggestions = [];
    private Units.Preferences _units = Units.Preferences.Default;
    private bool _adding;

    private sealed record Offer(Connection Connection, SuggestedRule Rule);

    private AlertRule? _draft;
    private AlertRule? _confirmDelete;
    private bool _isNew;
    private string? _validation;

    /// <summary>
    /// "Now 180 Mbps; usually about 520 at this hour", for the unusual rule being drawn up.
    /// Null while it is being worked out.
    /// </summary>
    private string? _preview;

    /// <summary>Which preview is current, so a slow one finishing after a faster one does not overwrite it.</summary>
    private int _previewVersion;

    protected override async Task OnInitializedAsync()
    {
        Rules.Changed += OnChanged;
        Evaluator.Updated += OnChanged;
        await LoadAsync();
    }

    /// <summary>
    /// Each control saves the one thing it changed, so a half-typed time cannot wipe the
    /// other end of the window. A blank on either side turns quiet hours off, which is what
    /// clearing the box looks like it should do.
    /// </summary>
    private async Task SaveQuietAsync(string? from, string? to, string? mode)
    {
        var next = _policy with
        {
            QuietFrom = from is null ? _policy.QuietFrom : Parse(from),
            QuietTo = to is null ? _policy.QuietTo : Parse(to),
            QuietMode = mode ?? _policy.QuietMode,
        };

        await AppSettings.SaveAsync(new Dictionary<string, string>
        {
            [AlertPolicy.FromKey] = next.QuietFrom.ToString("HH\\:mm"),
            [AlertPolicy.ToKey] = next.QuietTo.ToString("HH\\:mm"),
            [AlertPolicy.ModeKey] = next.QuietMode,
        });

        _policy = next;

        static TimeOnly Parse(string value) => TimeOnly.TryParse(value, out var parsed) ? parsed : default;
    }

    private async Task ClearQuietAsync() => await SaveQuietAsync("", "", null);

    private async Task LoadAsync()
    {
        _rules = await Rules.AllAsync();
        _connections = [.. (await Config.ConnectionsAsync()).Where(c => Registry.Provider(c.Provider)?.IsMonitored != false)];
        _channels = [.. (await Alerts.ChannelsAsync()).Select(pair => pair.Connection)];
        _channelCount = _channels.Count;
        _policy = AlertPolicy.From(await AppSettings.AllAsync());
        _units = Units.Preferences.From(await AppSettings.AllAsync());
        LoadSuggestions();
        await LoadMetricsAsync(_draft?.ConnectionId);
    }

    /// <summary>
    /// What each connected provider recommends, minus anything an existing rule already
    /// covers — including a rule that watches every connection, since that covers this
    /// one too.
    /// </summary>
    private void LoadSuggestions()
    {
        _suggestions = [.. _connections
            .SelectMany(connection => (Registry.Provider(connection.Provider)?.SuggestedRules ?? [])
                .Where(rule => !_rules.Any(existing => rule.IsCoveredBy(existing, connection.Id)))
                .Select(rule => new Offer(connection, rule)))];
    }

    private async Task AddSuggestionAsync(Offer offer)
    {
        _adding = true;
        try
        {
            await Rules.SaveAsync(offer.Rule.ForConnection(offer.Connection.Id));
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task AddAllSuggestionsAsync()
    {
        _adding = true;
        try
        {
            // Snapshot first: saving raises Changed, which reloads and rewrites the list
            // being iterated.
            foreach (var offer in _suggestions.ToList())
                await Rules.SaveAsync(offer.Rule.ForConnection(offer.Connection.Id));
        }
        finally
        {
            _adding = false;
        }
    }

    /// <summary>
    /// Suggestions come from the whole install when the rule is not pinned to one
    /// connection, because that is exactly the case where the user cannot know which
    /// names are available.
    /// </summary>
    private async Task LoadMetricsAsync(string? connectionId)
    {
        var declared = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var connection in connectionId is null ? _connections : _connections.Where(c => c.Id == connectionId))
        {
            var keys = new List<string>();
            foreach (var metric in Registry.MetricsFor(connection))
            {
                declared.TryAdd(metric.Key, metric.Label);
                keys.Add(metric.Key);
            }
            foreach (var key in await History.MetricsAsync(connection.Id))
            {
                declared.TryAdd(key, MetricSpec.Fallback(key).Label);
                keys.Add(key);
            }

            // Anything that fills towards a limit can also be watched by when it will get
            // there — "warn me a month before the volume is full" — which is often the more
            // useful rule, since 90% on a slow-filling volume is a year of notice and on a
            // fast one is an evening.
            foreach (var key in keys.Where(key => Registry.CapacityOf(connection, key) is not null))
            {
                var derived = Registry.Metric(connection, CapacityMetric.KeyFor(key));
                declared.TryAdd(derived.Key, derived.Label);
            }
        }

        _metricOptions = [.. declared.OrderBy(pair => pair.Key).Select(pair => new SelectOption(pair.Key, pair.Value))];
    }

    private async Task OnConnectionChangedAsync(string? id)
    {
        var connectionId = string.IsNullOrEmpty(id) ? null : id;
        _draft = _draft! with { ConnectionId = connectionId };
        await LoadMetricsAsync(connectionId);
        await RefreshPreviewAsync();
    }

    private async Task SetMetricAsync(string? metric)
    {
        _draft = _draft! with { Metric = metric?.Trim() ?? string.Empty };
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Switching kind resets the numbers to a sensible start for that kind: a threshold of
    /// 90 means "90%" on one and "90% of usual" on the other, and carrying it across would
    /// quietly make a rule that fires most evenings.
    /// </summary>
    private async Task SetKindAsync(ChangeEventArgs args)
    {
        var unusual = string.Equals(args.Value?.ToString(), nameof(RuleKind.Unusual), StringComparison.Ordinal);
        var draft = _draft!;
        if (unusual == draft.IsUnusual)
            return;

        _draft = unusual
            ? draft with
            {
                Kind = RuleKind.Unusual,
                UnusualBy = UnusualBy.Percent,
                Comparison = Comparison.Below,
                Threshold = 50,
                ClearThreshold = null,
                ForMinutes = Math.Max(draft.ForMinutes, 30),
            }
            : draft with
            {
                Kind = RuleKind.Threshold,
                Comparison = draft.Comparison == Comparison.Either ? Comparison.Above : draft.Comparison,
                Threshold = 90,
                ClearThreshold = null,
            };
        await RefreshPreviewAsync();
    }

    private void SetUnusualBy(ChangeEventArgs args)
    {
        var spread = string.Equals(args.Value?.ToString(), nameof(UnusualBy.Spread), StringComparison.Ordinal);
        var draft = _draft!;
        _draft = draft with
        {
            UnusualBy = spread ? UnusualBy.Spread : UnusualBy.Percent,
            Threshold = spread ? 4 : draft.Comparison == Comparison.Below ? 50 : 200,
            ClearThreshold = null,
        };
    }

    private void SetUnusualThreshold(double value) =>
        _draft = _draft! with { Threshold = value, ClearThreshold = null };

    /// <summary>The quick picks, in words, for what the threshold box means under the current choices.</summary>
    private static IReadOnlyList<(double Value, string Label)> Presets(AlertRule draft) =>
        (draft.UnusualBy, draft.Comparison) switch
        {
            (UnusualBy.Spread, _) => [(3, "noticeably"), (4, "well"), (6, "far")],
            (_, Comparison.Below) => [(75, "under three quarters"), (50, "under half"), (25, "under a quarter")],
            (_, Comparison.Above) => [(150, "half as much again"), (200, "double"), (300, "triple")],
            _ => [(150, "1.5× either way"), (200, "double or half"), (300, "triple or a third")],
        };

    /// <summary>
    /// What is usual for the metric being drawn up, next to what it reads now, and what the
    /// rule would make of it — so somebody choosing "less than half" can see that tonight's
    /// 180 against a usual 520 would already count. Worked out off the circuit: it reads four
    /// weeks of history, and the page should not freeze while it does.
    /// </summary>
    private async Task RefreshPreviewAsync()
    {
        var version = ++_previewVersion;
        if (_draft is not { IsUnusual: true } draft)
            return;

        if (draft.ConnectionId is not { } connectionId || draft.Metric.Length == 0)
        {
            _preview = "Pick a connection to see what is usual for it. A rule on any connection learns each one separately.";
            return;
        }

        _preview = null;
        var metric = draft.Metric;
        MetricBaseline baseline;
        try
        {
            baseline = Baselines.Get(connectionId, metric)
                ?? await Task.Run(() => Baselines.RefreshAsync(connectionId, metric, CancellationToken.None));
        }
        catch (Exception)
        {
            if (version == _previewVersion)
                _preview = "Could not read this metric's history just now.";
            return;
        }

        if (version != _previewVersion || _draft is not { } current)
            return;

        var spec = SpecFor(current);
        if (baseline.At(DateTimeOffset.Now, Baselines.Zone) is not { } usual)
        {
            _preview = baseline.Days == 0
                ? $"No history for this metric yet. It needs {Days(MetricBaseline.MinDays)} before it can say what is usual."
                : $"Learning — needs {Days(baseline.DaysNeeded)} more of history before it can say what is usual. " +
                  "Until then this rule neither fires nor clears.";
            return;
        }

        var expected = $"usually about {MetricAlertService.About(spec, usual.Median, _units)} {usual.When}".TrimEnd();
        if (Monitor.State(connectionId)?.Metrics.TryGetValue(metric, out var value) != true)
        {
            _preview = $"No reading right now; {expected}.";
            return;
        }

        var reading = Units.Format(spec, value, _units, 1);
        var verdict = current.Judge(value, usual) switch
        {
            Verdict.Breaching => "That would count as unusual.",
            null => "A share of a usual zero cannot be judged — try measuring against its normal range.",
            _ => "That is within what this rule allows.",
        };
        _preview = $"Now {reading}; {expected}. {verdict}";
    }

    private static string Days(int count) => count == 1 ? "1 day" : $"{count} days";

    private string OfferCondition(Offer offer) =>
        offer.Rule.Kind == RuleKind.Unusual
            ? $"{offer.Rule.Metric} {offer.Rule.ForConnection(offer.Connection.Id).UnusualPhrase()}"
            : $"{offer.Rule.Metric} {offer.Rule.ComparisonWord} {Units.Format(Registry.Metric(offer.Connection, offer.Rule.Metric), offer.Rule.Threshold, _units)}";

    /// <summary>The numbers behind an unusual rule's phrase, for somebody who wants to know what "well above" means.</summary>
    private static string UnusualDetail(AlertRule rule) =>
        rule.UnusualBy == UnusualBy.Percent
            ? $"{rule.Threshold:0.##}% of usual, clears at {rule.UnusualClearsAt:0.#}%"
            : $"{rule.Threshold:0.#}× its normal range, clears within {rule.UnusualClearsAt:0.#}×";

    /// <summary>
    /// The Now column for an unusual rule with nothing to show: still learning, or not yet
    /// asked. Only a rule on one connection can say how long it has to go; one on every
    /// connection learns each separately.
    /// </summary>
    private string LearningNote(AlertRule rule)
    {
        if (rule.ConnectionId is not { } connectionId)
            return "learning what is usual";
        return Baselines.Get(connectionId, rule.Metric) switch
        {
            null => "no data yet",
            { IsLearning: true } baseline => $"learning — needs {Days(baseline.DaysNeeded)} more",
            _ => "no reading right now",
        };
    }

    private MetricSpec SpecFor(AlertRule rule, string? connectionId = null)
    {
        var connection = _connections.FirstOrDefault(c => c.Id == (connectionId ?? rule.ConnectionId));
        return Registry.Metric(connection, rule.Metric);
    }

    /// <summary>
    /// A reading as the Now column shows it. A forecast is shown in words — "full in about
    /// 6 weeks", "not filling" — since the number behind it is days to a precision it does
    /// not have, and infinity for a volume that is not filling at all.
    /// </summary>
    private string Reading(AlertRule rule, MetricAlertService.Breach breach) =>
        CapacityMetric.TryParse(rule.Metric, out var measured)
        && Forecasts.Get(breach.ConnectionId, measured) is { } forecast
            ? forecast.Describe()
            : Units.Format(SpecFor(rule, breach.ConnectionId), breach.LastValue, _units, 1);

    private string NameOf(string? connectionId) =>
        _connections.FirstOrDefault(c => c.Id == connectionId)?.Name ?? "";

    // Firing ones first: on an "any connection" rule watching a dozen boxes, the one
    // that is actually in trouble should not be somewhere down the list.
    private List<MetricAlertService.Breach> Readings(AlertRule rule) =>
        [.. Evaluator.All.Where(b => b.RuleId == rule.Id).OrderByDescending(b => b.Firing).ThenBy(b => NameOf(b.ConnectionId))];

    private string Preview(AlertRule rule) =>
        rule.Describe(SpecFor(rule).Label, NameOf(rule.ConnectionId) is { Length: > 0 } n ? n : null);

    private void SetComparison(ChangeEventArgs args)
    {
        var comparison = Enum.TryParse<Comparison>(args.Value?.ToString(), out var parsed) ? parsed : Comparison.Above;
        var draft = _draft!;

        // A percentage that made sense one way round is nonsense the other — "50% of usual"
        // is lower, and cannot be higher — so an unusual rule's number follows the direction.
        var threshold = draft is { IsUnusual: true, UnusualBy: UnusualBy.Percent }
            && (comparison == Comparison.Below) != (draft.Comparison == Comparison.Below)
                ? comparison == Comparison.Below ? 50 : 200
                : draft.Threshold;

        _draft = draft with
        {
            Comparison = comparison,
            Threshold = threshold,
            ClearThreshold = threshold == draft.Threshold ? draft.ClearThreshold : null,
        };
    }

    /// <summary>
    /// The editor works in whatever units the user reads in, but stores canonical values —
    /// otherwise someone shown °F would type 90 and save a 90°C threshold.
    /// </summary>
    private string UnitSuffix(AlertRule draft)
    {
        var unit = Units.LabelFor(SpecFor(draft), _units);
        return unit.Length > 0 ? $"({unit})" : "";
    }

    private string ToDisplay(AlertRule draft, double stored) =>
        Units.Display(stored, SpecFor(draft).Unit, _units).Value.ToString("0.####");

    private void SetThreshold(object? entered)
    {
        if (_draft is not { } draft)
            return;
        var typed = Parse(entered, Units.Display(draft.Threshold, SpecFor(draft).Unit, _units).Value);
        _draft = draft with { Threshold = Units.Store(typed, SpecFor(draft).Unit, _units) };
    }

    private void SetClearThreshold(object? entered)
    {
        if (_draft is not { } draft)
            return;
        var typed = ParseOptional(entered);
        _draft = draft with
        {
            ClearThreshold = typed is { } value ? Units.Store(value, SpecFor(draft).Unit, _units) : null,
        };
    }

    private static double Parse(object? value, double fallback) =>
        double.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;

    private static double? ParseOptional(object? value) =>
        double.TryParse(value?.ToString(), out var parsed) ? parsed : null;

    private void StartNew()
    {
        _isNew = true;
        _validation = null;
        _draft = new AlertRule { Metric = "disk_percent", Comparison = Comparison.Above, Threshold = 90, ForMinutes = 5 };
    }

    private async Task Edit(AlertRule rule)
    {
        _isNew = false;
        _validation = null;
        _draft = rule;
        await RefreshPreviewAsync();
    }

    private async Task SaveAsync()
    {
        if (_draft is not { } rule)
            return;

        if (rule.Metric.Trim().Length == 0)
        {
            _validation = "Pick a metric — that is the number being watched.";
            return;
        }

        // A rule that can fire and never clear, or never fire, is worse than no rule at all.
        if (rule.Problem() is { } problem)
        {
            _validation = problem;
            return;
        }

        await Rules.SaveAsync(rule with { Metric = rule.Metric.Trim(), Name = rule.Name.Trim() });
        _draft = null;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_confirmDelete is { } rule)
            await Rules.DeleteAsync(rule.Id);
        _confirmDelete = null;
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Rules.Changed -= OnChanged;
        Evaluator.Updated -= OnChanged;
    }
}
