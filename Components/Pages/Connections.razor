@page "/settings/connections"
@rendermode InteractiveServer
@implements IDisposable
@inject ConfigStore Config
@inject Deletions Deletions
@inject Registry Registry
@inject HealthMonitor Health
@inject AppSettingsStore AppSettings

<PageTitle>Connections · LabbyTwo</PageTitle>

<div class="page-head">
    <div>
        <h1>🔌 Connections</h1>
        <p class="subtitle">Everything LabbyTwo talks to. Widgets bind to these.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @* This page is the longest in the app and only ever grows. Twenty connections in,
           finding one means reading the whole table. *@
        @if (_connections.Count > 6)
        {
            <input type="search" class="form-control form-control-sm" style="width: 12rem"
                   placeholder="Filter…" aria-label="Filter connections"
                   @bind="_filter" @bind:event="oninput" />

            <button class="btn btn-sm @(_downOnly ? "btn-warning" : "btn-outline-secondary")"
                    title="Only the ones that are down" @onclick="() => _downOnly = !_downOnly">Down only</button>

            <button class="btn btn-sm btn-outline-secondary" disabled="@_testing" @onclick="TestAllAsync">
                @(_testing ? $"Testing… {_tested}/{_toTest}" : "Test all")
            </button>

            @* The whole-installation version of the per-row Silence below. Rebooting the
               NAS takes everything down at once, and silencing fifteen rows one at a time
               is not something anybody does while the reboot is already running. Lifting
               it lives on the banner instead, which is on every page. *@
            @if (!_maintenance.On)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            title="Hold every alert while you work on something"
                            @onclick="() => _silencingAll = !_silencingAll">
                        Silence all
                    </button>
                    @if (_silencingAll)
                    {
                        <div class="dropdown-menu dropdown-menu-end show" style="position:absolute; z-index:5">
                            @foreach (var (label, span) in MaintenanceOptions)
                            {
                                <button class="dropdown-item" type="button"
                                        @onclick="() => SilenceAllAsync(span)">@label</button>
                            }
                        </div>
                    }
                </div>
            }
        }
        <button class="btn btn-sm btn-primary" @onclick="() => _picking = true">+ Add connection</button>
    </div>
</div>

@if (_connections.Count == 0)
{
    <div class="empty-state">
        <p class="mb-3">Nothing connected yet.</p>
        <button class="btn btn-primary btn-sm" @onclick="() => _picking = true">Add the first one</button>
    </div>
}
else
{
    @if (Shown.Count == 0)
    {
        <div class="empty-state">
            <p class="mb-2">Nothing matches that.</p>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilter">Clear the filter</button>
        </div>
    }
    else
    {
    <div class="panel">
        @* The bulk bar takes the place of the count when there is a selection, rather than
           appearing under it. Two lines of chrome above a table both saying something about
           how many rows there are is one line too many. *@
        @if (Selected.Count > 0)
        {
            <div class="bulk-bar">
                <span><strong>@Selected.Count</strong> selected</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetEnabledAsync(true)">Enable</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetEnabledAsync(false)">Disable</button>

                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            @onclick="() => _silencingSelected = !_silencingSelected">Silence</button>
                    @if (_silencingSelected)
                    {
                        <div class="dropdown-menu show" style="position:absolute; z-index:5">
                            @foreach (var (label, span) in SilenceOptions)
                            {
                                <button class="dropdown-item" type="button"
                                        @onclick="() => SilenceSelectedAsync(DateTimeOffset.Now + span)">@label</button>
                            }
                            <button class="dropdown-item" type="button"
                                    @onclick="() => SilenceSelectedAsync(null)">Resume alerts</button>
                        </div>
                    }
                </div>

                <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDeleteSelected = true">Delete</button>
                <button class="btn btn-sm btn-link ms-auto" @onclick="() => _selected.Clear()">Clear selection</button>
            </div>
        }
        else if (Shown.Count != _connections.Count)
        {
            <div class="tile-meta px-3 pt-2">Showing @Shown.Count of @_connections.Count.</div>
        }
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    @if (Selectable)
                    {
                        @* Selects what is *shown*, not everything. The filter is the thing
                           that makes a selection worth having — "Down only" then select-all
                           then Silence is the whole point — and a box that quietly picked up
                           rows scrolled out of sight by a filter would be a trap. *@
                        <th style="width:2.25rem">
                            <input type="checkbox" class="form-check-input" aria-label="Select all shown"
                                   checked="@AllShownSelected" @onchange="ToggleAllShown" />
                        </th>
                    }
                    <th style="width:2.5rem"></th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Last probe</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var connection in Shown)
                {
                    var state = Health.State(connection.Id);
                    <tr class="@(_selected.Contains(connection.Id) ? "is-selected" : "")">
                        @if (Selectable)
                        {
                            <td>
                                <input type="checkbox" class="form-check-input"
                                       aria-label="@($"Select {connection.Name}")"
                                       checked="@_selected.Contains(connection.Id)"
                                       @onchange="() => Toggle(connection.Id)" />
                            </td>
                        }
                        <td><span class="status-dot @DotClass(connection, state)"></span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span>@(string.IsNullOrWhiteSpace(connection.Icon) ? "" : connection.Icon)</span>
                                <span>@connection.Name</span>
                                @if (!connection.Enabled)
                                {
                                    <span class="badge text-bg-secondary">paused</span>
                                }
                                @if (connection.IsSilenced(_now))
                                {
                                    <span class="badge text-bg-warning" title="@($"Alerts held until {connection.SilencedUntil:HH:mm}")">
                                        silenced until @connection.SilencedUntil?.ToString("HH:mm")
                                    </span>
                                }
                                @if (connection.DependsOn is { Length: > 0 } parent && Name(parent) is { Length: > 0 } behind)
                                {
                                    <span class="tile-meta">behind @behind</span>
                                }
                            </div>
                        </td>
                        <td class="tile-meta">@ProviderName(connection)</td>
                        <td class="tile-meta">
                            @if (IsAlertChannel(connection))
                            {
                                @* Nothing to poll — the meaningful test is sending a message, which lives in the editor. *@
                                <span>@(connection.Enabled ? "alert channel" : "disabled")</span>
                            }
                            else if (!connection.Enabled)
                            {
                                <span>not monitored</span>
                            }
                            else if (state is null)
                            {
                                <span>checking…</span>
                            }
                            else
                            {
                                <span>@state.Message</span>
                                <span class="ms-2">@state.At.ToString("HH:mm:ss")</span>
                            }
                        </td>
                        @* text-nowrap so the table gives this column the width its buttons
                           need rather than the message column taking it, and align-items
                           so nothing here stretches to match a taller neighbour. *@
                        <td class="text-end text-nowrap">
                            <div class="d-flex gap-1 justify-content-end align-items-center">
                                @if (!IsAlertChannel(connection))
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RefreshAsync(connection)">Test</button>

                                    @* Silencing is something you do in a hurry, while the thing
                                       is already making noise — so it lives on the list, not
                                       three clicks into an editor. *@
                                    @if (connection.IsSilenced(_now))
                                    {
                                        <button class="btn btn-sm btn-outline-warning" title="Alerts are held — click to resume"
                                                @onclick="() => SilenceAsync(connection, null)">Unsilence</button>
                                    }
                                    else
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                    @onclick="() => _silencing = _silencing == connection.Id ? string.Empty : connection.Id">
                                                Silence
                                            </button>
                                            @if (_silencing == connection.Id)
                                            {
                                                <div class="dropdown-menu show" style="position:absolute; z-index:5">
                                                    @foreach (var (label, span) in SilenceOptions)
                                                    {
                                                        <button class="dropdown-item" type="button"
                                                                @onclick="() => SilenceAsync(connection, DateTimeOffset.Now + span)">
                                                            @label
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                @* Controls sit next to Test rather than inside the editor:
                                   restarting the NAS is something you do while looking at
                                   the list that just told you it needed restarting. *@
                                <ProviderActions Connection="connection" Compact="true" Ran="LoadAsync" />

                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(connection)">Edit</button>
                                @* An icon rather than the word, unlike the Duplicate on the
                                   Tabs page. This actions cell is already the widest thing
                                   on the page and must not wrap, so a sixth worded button
                                   is paid for by every other column. *@
                                <button class="btn btn-sm btn-outline-secondary" title="Duplicate"
                                        aria-label="Duplicate @connection.Name"
                                        @onclick="() => Duplicate(connection)">⧉</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = connection">✕</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
}

@if (_picking)
{
    <Modal Title="What are you connecting?" Size="xl" OnClose="() => _picking = false">
        @* Fifty-odd integrations is a wall to scroll rather than a list to read. Search
           first, categories underneath — the same shape the widget picker got. *@
        <input class="form-control mb-3" placeholder="Search — sonarr, nas, weather…" autofocus
               @bind="_providerSearch" @bind:event="oninput" />

        @foreach (var category in MatchingProviders.GroupBy(p => p.Category))
        {
            <h6 class="text-uppercase tile-meta mt-3 mb-2">@category.Key</h6>
            <div class="card-picker">
                @foreach (var provider in category)
                {
                    <button type="button" @onclick="() => StartNew(provider)">
                        <span class="picker-title">@provider.Icon @provider.DisplayName</span>
                        <span class="picker-desc">@provider.Description</span>
                    </button>
                }
            </div>
        }
    </Modal>
}

@if (_draft is not null && _draftProvider is not null)
{
    <ConnectionEditor Draft="_draft" Provider="_draftProvider" OnClose="CloseEditor" />
}

@if (_confirmDelete is not null)
{
    <ConfirmDialog Title="Delete this connection?"
                   Message="@($"“{_confirmDelete.Name}” and its recorded history will be removed. Widgets using it will ask for a new one.")"
                   OnCancel="() => _confirmDelete = null"
                   OnConfirm="DeleteAsync" />
}

@if (_confirmDeleteSelected)
{
    @* Still confirmed, even though it can be undone. Undo covers the misclick; this covers
       not having noticed that "select all" picked up nineteen rows rather than the two you
       could see. *@
    <ConfirmDialog Title="@($"Delete {Selected.Count} connections?")"
                   Message="@($"{Names(Selected)} — and the history recorded against them — will be removed. Widgets using them will ask for a new one.")"
                   OnCancel="() => _confirmDeleteSelected = false"
                   OnConfirm="DeleteSelectedAsync" />
}

@code {
    private IReadOnlyList<Connection> _connections = [];
    private DateTimeOffset _now = DateTimeOffset.Now;
    private string _silencing = "";
    private string _providerSearch = "";

    /// <summary>
    /// Matched on the description as well as the name, so "torrent" finds qBittorrent,
    /// Transmission and Deluge without anybody knowing which of them you own.
    /// </summary>
    private IEnumerable<IConnectionProvider> MatchingProviders =>
        _providerSearch.Trim() is not { Length: > 0 } needle
            ? Registry.Providers
            : Registry.Providers.Where(provider =>
                provider.DisplayName.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || provider.Description.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || provider.Category.Contains(needle, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Deliberately short. A silence you forget to lift is worse than no silence at all,
    /// so there is no "forever" here — the longest is one night's work.
    /// </summary>
    private static readonly (string Label, TimeSpan Span)[] SilenceOptions =
    [
        ("For 30 minutes", TimeSpan.FromMinutes(30)),
        ("For an hour", TimeSpan.FromHours(1)),
        ("For 4 hours", TimeSpan.FromHours(4)),
        ("Until tomorrow", TimeSpan.FromHours(12)),
    ];

    private async Task SilenceAsync(Connection connection, DateTimeOffset? until)
    {
        _silencing = "";
        await Config.SilenceAsync(connection.Id, until);
        _now = DateTimeOffset.Now;
        await LoadAsync();
    }

    /// <summary>
    /// The same durations, plus the one the list above deliberately refuses. That refusal
    /// is right for a single connection: a row silenced for ever is invisible, and you
    /// find out months later that the thing you most wanted to hear about was the thing
    /// you muted. A maintenance window is not invisible — it puts a banner on every page
    /// with the way out on it — and the honest length of "I am replacing a drive" is not
    /// known when you start. The banner is what earns this option; without it this list
    /// would end at four hours too.
    /// </summary>
    private static readonly (string Label, TimeSpan? Span)[] MaintenanceOptions =
    [
        ("For 30 minutes", TimeSpan.FromMinutes(30)),
        ("For an hour", TimeSpan.FromHours(1)),
        ("For 4 hours", TimeSpan.FromHours(4)),
        ("Until I resume", null),
    ];

    private async Task SilenceAllAsync(TimeSpan? span)
    {
        _silencingAll = false;
        await AppSettings.SaveAsync(Maintenance.Key, Maintenance.Value(span, DateTimeOffset.Now));
        await LoadMaintenanceAsync();
    }

    private async Task LoadMaintenanceAsync() =>
        _maintenance = Maintenance.From(await AppSettings.AllAsync());

    // ---------- acting on several at once ----------

    private readonly HashSet<string> _selected = [];
    private bool _silencingSelected;
    private bool _confirmDeleteSelected;

    /// <summary>
    /// Same threshold as the filter, because these solve the same problem: a page long
    /// enough that doing something to it a row at a time stops being reasonable. Below it,
    /// a checkbox column is a column of chrome earning nothing.
    /// </summary>
    private bool Selectable => _connections.Count > 6;

    /// <summary>
    /// The selection, less anything that has since been filtered away or deleted. Kept as
    /// a view rather than pruned on every change: a row hidden by a filter and then shown
    /// again should come back still ticked, but must not be acted on while it is out of
    /// sight — "Down only, select all, Delete" has to mean the rows on screen.
    /// </summary>
    private IReadOnlyList<Connection> Selected =>
        [.. Shown.Where(connection => _selected.Contains(connection.Id))];

    private bool AllShownSelected => Shown.Count > 0 && Shown.All(c => _selected.Contains(c.Id));

    private void Toggle(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleAllShown()
    {
        // Reading the current state rather than the event argument: the header box is also
        // driven by the rows, so "are they all on" is the only thing worth asking.
        if (AllShownSelected)
            foreach (var connection in Shown)
                _selected.Remove(connection.Id);
        else
            foreach (var connection in Shown)
                _selected.Add(connection.Id);
    }

    private static string Names(IReadOnlyList<Connection> connections) =>
        connections.Count <= 3
            ? string.Join(", ", connections.Select(c => $"“{c.Name}”"))
            : $"“{connections[0].Name}”, “{connections[1].Name}” and {connections.Count - 2} more";

    private async Task SetEnabledAsync(bool enabled)
    {
        foreach (var connection in Selected.Where(c => c.Enabled != enabled))
            await Config.SaveConnectionAsync(connection with { Enabled = enabled });

        _selected.Clear();
        await LoadAsync();
    }

    private async Task SilenceSelectedAsync(DateTimeOffset? until)
    {
        _silencingSelected = false;
        foreach (var connection in Selected)
            await Config.SilenceAsync(connection.Id, until);

        _now = DateTimeOffset.Now;
        _selected.Clear();
        await LoadAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        _confirmDeleteSelected = false;
        // One call, so twenty deletions are one row on the undo bar rather than nineteen
        // that have already scrolled past.
        await Deletions.ConnectionsAsync(Selected);
        _selected.Clear();
        await LoadAsync();
    }

    private string Name(string id) =>
        _connections.FirstOrDefault(c => c.Id == id)?.Name ?? "";
    private bool _picking;
    private Connection? _draft;
    private IConnectionProvider? _draftProvider;
    private Connection? _confirmDelete;
    private Maintenance _maintenance = Maintenance.Off;
    private bool _silencingAll;

    protected override async Task OnInitializedAsync()
    {
        Config.Changed += OnChanged;
        Health.Updated += OnChanged;
        // So "Silence all" comes back the moment the banner is used to resume, wherever
        // that happened.
        AppSettings.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _connections = await Config.ConnectionsAsync();
        await LoadMaintenanceAsync();
    }

    private string ProviderName(Connection connection) =>
        Registry.Provider(connection.Provider)?.DisplayName ?? $"{connection.Provider} (not installed)";

    private bool IsAlertChannel(Connection connection) => Registry.Provider(connection.Provider) is IAlertChannel;

    private string DotClass(Connection connection, HealthMonitor.ProbeState? state) =>
        !connection.Enabled || IsAlertChannel(connection) ? "status-unknown"
        : state?.IsUp switch { true => "status-up", false => "status-down", _ => "status-unknown" };

    private void StartNew(IConnectionProvider provider)
    {
        _picking = false;
        _draftProvider = provider;
        _draft = new Connection { Provider = provider.Type, Name = provider.DisplayName, Icon = provider.Icon };
    }

    private void Edit(Connection connection)
    {
        _draftProvider = Registry.Provider(connection.Provider);
        // Editing a clone means Cancel leaves the stored connection untouched.
        _draft = connection with { Settings = connection.Settings.Clone() };
    }

    /// <summary>
    /// A second one of something you already set up — another Sonarr, a second NAS, the
    /// same Git server with a different token. Everything but the identity comes across,
    /// credentials included, which is the whole point: a copy that loses the API key has
    /// saved you the easy half of the typing.
    ///
    /// It opens the editor rather than writing the copy and telling you about it. Nothing
    /// is stored until Save, so Cancel leaves nothing behind — and duplicating is always
    /// followed by changing the one field that differs, so this is the same number of
    /// clicks with none of the litter. Sort is inherited on purpose: the list orders by
    /// sort then name, so "Sonarr (copy)" lands directly under "Sonarr".
    /// </summary>
    private void Duplicate(Connection connection)
    {
        _draftProvider = Registry.Provider(connection.Provider);
        _draft = connection with
        {
            Id = Ids.New(),
            Name = $"{connection.Name} (copy)",
            Settings = connection.Settings.Clone(),
            // A hold belongs to the thing that was making noise, not to its copy.
            SilencedUntil = null,
        };
    }

    private async Task CloseEditor()
    {
        _draft = null;
        _draftProvider = null;
        await LoadAsync();
    }

    private async Task RefreshAsync(Connection connection) => await Health.RefreshAsync(connection);

    private string _filter = "";
    private bool _downOnly;
    private bool _testing;
    private int _tested, _toTest;

    /// <summary>
    /// Name, provider and what the last probe said — all three, because you look for a
    /// connection by whichever of them you happen to remember, and "qnap" should find the
    /// NAS whether that is its name or its type.
    /// </summary>
    private IReadOnlyList<Connection> Shown
    {
        get
        {
            var rows = _connections.AsEnumerable();

            if (_downOnly)
                rows = rows.Where(c => Health.State(c.Id) is { IsUp: false });

            if (_filter.Trim() is { Length: > 0 } needle)
            {
                rows = rows.Where(c =>
                    c.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || ProviderName(c).Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || c.Provider.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || (Health.State(c.Id)?.Message ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase));
            }

            return [.. rows];
        }
    }

    private void ClearFilter()
    {
        _filter = "";
        _downOnly = false;
    }

    /// <summary>
    /// Re-probe the lot. Worth a button for the moment after a NAS reboot or a network
    /// change, when the question is "what came back" and the alternative is twenty clicks.
    ///
    /// Sequential on purpose. The monitor's own sweep runs these in parallel because it is
    /// a background job nobody is watching; this one is a person waiting, and twenty
    /// simultaneous probes at a NAS that has just come up is how you get twenty timeouts.
    /// </summary>
    private async Task TestAllAsync()
    {
        var targets = Shown.Where(c => c.Enabled && Registry.Provider(c.Provider) is { IsMonitored: true }).ToList();
        if (targets.Count == 0)
            return;

        _testing = true;
        _tested = 0;
        _toTest = targets.Count;

        try
        {
            foreach (var connection in targets)
            {
                await Health.RefreshAsync(connection);
                _tested++;
                StateHasChanged();
            }
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_confirmDelete is not null)
            await Deletions.ConnectionAsync(_confirmDelete);
        _confirmDelete = null;
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Config.Changed -= OnChanged;
        Health.Updated -= OnChanged;
        AppSettings.Changed -= OnChanged;
    }
}
