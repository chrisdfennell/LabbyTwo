@page "/t/{Slug}"
@rendermode InteractiveServer
@implements IDisposable
@inject ConfigStore Config
@inject Registry Registry
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>@(_tab?.Name ?? "LabbyTwo")</PageTitle>

@if (_tab is null)
{
    <div class="empty-state">
        <h1 class="h5">No tab called “@Slug”</h1>
        <p class="mb-3">It may have been renamed or deleted.</p>
        <a class="btn btn-outline-secondary btn-sm" href="settings/tabs">Manage tabs</a>
    </div>
}
else if (_kind is null)
{
    <div class="empty-state">
        <h1 class="h5">Unknown tab kind “@_tab.Kind”</h1>
        <p class="mb-0">This tab was made by a newer version of LabbyTwo, or by a plugin that is no longer installed.</p>
    </div>
}
else
{
    @* The page knows nothing about grids, embeds or notes — it renders whatever the
       registered kind points at, which is what lets a new kind be one more class. *@
    @* The last line of defence, behind each card's own. A tab kind that throws — a
       plugin's, say — should cost that tab, not the sidebar and every other page the
       circuit would take with it. Keyed on the tab so moving to another one starts clean. *@
    <CardBoundary Name="@($"The “{_tab.Name}” tab")" Version="@($"{_tab.Kind}|{_tab.Settings.ToJson()}")" @key="_tab.Id">
        <DynamicComponent Type="_kind.Component" Parameters="_parameters" />
    </CardBoundary>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    /// <summary>
    /// ?wall=1 puts this one tab on a wall screen. Handled by sending the browser to the wall
    /// page rather than by hiding the chrome here, so there is one wall and not two that
    /// drift apart.
    /// </summary>
    [SupplyParameterFromQuery(Name = "wall")] public string? Wall { get; set; }

    private Tab? _tab;
    private ITabKind? _kind;
    private Dictionary<string, object> _parameters = [];

    protected override void OnInitialized() => Config.Changed += OnChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (WallOptions.IsOn(Wall))
        {
            var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query)
                .ToDictionary(pair => pair.Key, pair => pair.Value.LastOrDefault() ?? "");
            Nav.NavigateTo(WallOptions.UrlForTab(Slug, query), replace: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _tab = await Config.TabBySlugAsync(Slug);
        _kind = _tab is null ? null : Registry.TabKind(_tab.Kind);
        _parameters = _tab is null ? [] : new Dictionary<string, object> { ["Tab"] = _tab };
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Config.Changed -= OnChanged;
}
