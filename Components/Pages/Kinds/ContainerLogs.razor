@implements IAsyncDisposable
@inject IJSRuntime JS
@using Microsoft.Extensions.Logging
@inject ILogger<ContainerLogs> Log

@* A container's logs: the last few hundred lines, or those and everything after for as
   long as the panel is open. Closing the panel is what stops the stream — this component is
   disposed with the dialog, and disposal cancels the request — so a forgotten panel cannot
   keep a connection to Docker open once it is gone from the page. *@

<div class="ct-logs">
    <div class="ct-logs-bar">
        <input type="search" class="form-control form-control-sm ct-logs-search" placeholder="Search the log"
               aria-label="Search the log" @bind="_search" @bind:event="oninput" />
        <label class="form-check form-check-inline mb-0 tile-meta">
            <input type="checkbox" class="form-check-input" @bind="_matchesOnly" />
            Only matching lines
        </label>

        <div class="ms-auto d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-sm @(_follow ? "btn-primary" : "btn-outline-secondary")"
                    data-action="follow" aria-pressed="@_follow" @onclick="ToggleFollowAsync">
                @(_follow ? "● Following" : "Follow")
            </button>
            @if (_follow)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="pause" aria-pressed="@_paused"
                        @onclick="TogglePause">
                    @(_paused ? $"Resume{(_missed > 0 ? $" (+{_missed})" : "")}" : "Pause")
                </button>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="reload" disabled="@_loading"
                    @onclick="ReloadAsync">Reload</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="download"
                    disabled="@(_shown.Count == 0)" @onclick="DownloadAsync">Download</button>
        </div>
    </div>

    @if (_error is { Length: > 0 })
    {
        <div class="alert alert-warning py-2 mt-2 mb-0">@_error</div>
    }

    <div class="ct-logs-body" @ref="_body" role="log" aria-live="off">
        @if (_loading && _shown.Count == 0)
        {
            <div class="tile-meta p-2">Loading…</div>
        }
        else if (_shown.Count == 0)
        {
            <div class="tile-meta p-2">@(_ended ? "No output." : "Nothing yet.")</div>
        }
        else
        {
            var visible = Visible();
            @if (visible.Hidden > 0)
            {
                <div class="tile-meta ct-logs-note">
                    @visible.Hidden earlier lines not drawn — download to see everything held (@_shown.Count lines).
                </div>
            }
            @foreach (var line in visible.Lines)
            {
                <div class="ct-log-line @(line.Stream == LogStream.Stderr ? "ct-log-err" : "")">
                    @if (line.Time is { } time)
                    {
                        <span class="ct-log-time">@time.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                    }
                    <span class="ct-log-text">@Highlight(line.Text)</span>
                </div>
            }
        }
    </div>

    <div class="tile-meta mt-1">
        @StatusLine
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Endpoint { get; set; } = "";
    [Parameter] public TimeSpan Timeout { get; set; } = TimeSpan.FromSeconds(10);
    [Parameter, EditorRequired] public ContainerRow Container { get; set; } = default!;
    [Parameter] public int Tail { get; set; } = 200;

    /// <summary>
    /// How many lines are drawn at most. The buffer holds more — the download has all of it
    /// — but redrawing thousands of rows several times a second over a phone's connection
    /// is how a logs panel makes the whole page stutter.
    /// </summary>
    private const int DrawLimit = 1000;

    private readonly LogBuffer _buffer = new();
    private IReadOnlyList<LogLine> _shown = [];
    private string _search = "";
    private bool _matchesOnly;
    private bool _follow;
    private bool _paused;
    private int _missed;
    private bool _loading;
    private bool _ended;
    private string? _error;
    private bool? _tty;

    private ElementReference _body;
    private IJSObjectReference? _module;
    private CancellationTokenSource? _stream;
    private CancellationTokenSource? _flusher;
    private volatile bool _dirty;
    private bool _disposed;

    private string StatusLine
    {
        get
        {
            var parts = new List<string> { $"{_shown.Count} lines" };
            if (_buffer.Dropped > 0)
                parts.Add($"{_buffer.Dropped} older dropped to stay under {LogBuffer.DefaultCapacity}");
            if (_follow)
                parts.Add(_paused ? "paused — still receiving" : "following");
            else if (_ended)
                parts.Add($"last {Tail} lines");
            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
            return;
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || _disposed)
            return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./containers.js");
            if (_follow && !_paused)
                await _module.InvokeVoidAsync("stickToEnd", _body);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }

    /// <summary>
    /// Whether the log has eight-byte frame headers depends on how the container was
    /// created, so it is read from the inspect — once, since it cannot change without the
    /// container being recreated. A proxy that forbids inspect gets the common case.
    /// </summary>
    private async Task<bool> TtyAsync(CancellationToken ct)
    {
        if (_tty is { } known)
            return known;
        try
        {
            var details = await DockerContainers.InspectAsync(Endpoint, Timeout, Container.Id, ct);
            _tty = details.Tty;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _tty = false;
        }
        return _tty.Value;
    }

    private async Task ReloadAsync()
    {
        if (_follow)
        {
            await StartFollowingAsync();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        var endpoint = Endpoint;
        var id = Container.Id;
        var tail = Tail;
        var timeout = Timeout;
        try
        {
            var lines = await Task.Run(async () =>
            {
                var tty = await TtyAsync(CancellationToken.None);
                return await DockerLogs.TailAsync(endpoint, timeout, id, tty, tail, CancellationToken.None);
            });
            _buffer.Clear();
            _buffer.Add(lines);
            _shown = _buffer.Snapshot();
            _ended = true;
        }
        catch (Exception ex)
        {
            _error = ex.GetBaseException().Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleFollowAsync()
    {
        if (_follow)
        {
            StopFollowing();
            _follow = false;
            _paused = false;
            _missed = 0;
            return;
        }

        _follow = true;
        await StartFollowingAsync();
    }

    /// <summary>
    /// One request does both halves: tail=N gives the recent lines and follow=1 keeps the
    /// response open for the rest, so nothing written between two requests can fall in the
    /// gap. Lines arrive on the reading thread and go into the buffer there; the page is
    /// redrawn from it a few times a second rather than once per line, which for a chatty
    /// container is the difference between a panel and a denial of service on the browser.
    /// </summary>
    private Task StartFollowingAsync()
    {
        StopFollowing();
        _buffer.Clear();
        _shown = [];
        _error = null;
        _ended = false;
        _paused = false;
        _missed = 0;
        _loading = true;

        var stream = _stream = new CancellationTokenSource();
        var flusher = _flusher = new CancellationTokenSource();
        var endpoint = Endpoint;
        var id = Container.Id;
        var tail = Tail;
        var timeout = Timeout;

        _ = Task.Run(async () =>
        {
            try
            {
                var tty = await TtyAsync(stream.Token);
                await DockerLogs.FollowAsync(endpoint, timeout, id, tty, tail, lines =>
                {
                    _buffer.Add(lines);
                    if (_paused)
                        Interlocked.Add(ref _missed, lines.Count);
                    _dirty = true;
                }, stream.Token);

                // The response ended by itself: the container stopped.
                await SafeInvokeAsync(() =>
                {
                    if (stream.IsCancellationRequested)
                        return;
                    _ended = true;
                    _error = $"{Container.Name} stopped — the log ends here.";
                    _dirty = true;
                });
            }
            catch (OperationCanceledException) when (stream.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                if (!stream.IsCancellationRequested)
                    await SafeInvokeAsync(() =>
                    {
                        _error = ex.GetBaseException().Message;
                        _dirty = true;
                    });
            }
            finally
            {
                await SafeInvokeAsync(() =>
                {
                    _loading = false;
                    _dirty = true;
                });
            }
        });

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(300));
            try
            {
                while (await timer.WaitForNextTickAsync(flusher.Token))
                {
                    if (!_dirty || _disposed)
                        continue;
                    await SafeInvokeAsync(() =>
                    {
                        _dirty = false;
                        _loading = false;
                        if (!_paused)
                            _shown = _buffer.Snapshot();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
        });

        return Task.CompletedTask;
    }

    private async Task SafeInvokeAsync(Action work)
    {
        if (_disposed)
            return;
        try
        {
            await InvokeAsync(work);
        }
        catch (Exception ex)
        {
            // The circuit went away between the check and the call; nobody is left to tell.
            Log.LogDebug(ex, "Could not update the logs panel");
        }
    }

    private void StopFollowing()
    {
        _stream?.Cancel();
        _stream?.Dispose();
        _stream = null;
        _flusher?.Cancel();
        _flusher?.Dispose();
        _flusher = null;
    }

    private void TogglePause()
    {
        _paused = !_paused;
        if (!_paused)
        {
            _missed = 0;
            _shown = _buffer.Snapshot();
        }
    }

    private bool IsMatch(LogLine line) =>
        _search.Length == 0 || line.Text.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private (IReadOnlyList<LogLine> Lines, int Hidden) Visible()
    {
        IReadOnlyList<LogLine> lines = _matchesOnly && _search.Length > 0 ? [.. _shown.Where(IsMatch)] : _shown;
        return lines.Count > DrawLimit ? ([.. lines.Skip(lines.Count - DrawLimit)], lines.Count - DrawLimit) : (lines, 0);
    }

    private RenderFragment Highlight(string text) => builder =>
    {
        if (_search.Length == 0)
        {
            builder.AddContent(0, text);
            return;
        }

        var at = 0;
        var seq = 1;
        while (at < text.Length)
        {
            var hit = text.IndexOf(_search, at, StringComparison.OrdinalIgnoreCase);
            if (hit < 0)
            {
                builder.AddContent(seq++, text[at..]);
                break;
            }
            if (hit > at)
                builder.AddContent(seq++, text[at..hit]);
            builder.OpenElement(seq++, "mark");
            builder.AddContent(seq++, text.Substring(hit, _search.Length));
            builder.CloseElement();
            at = hit + _search.Length;
        }
    };

    private async Task DownloadAsync()
    {
        var text = string.Join('\n', _buffer.Snapshot().Select(line =>
            (line.Time is { } time ? time.ToString("yyyy-MM-ddTHH:mm:ss.fffK") + " " : "") +
            (line.Stream == LogStream.Stderr ? "[err] " : "") + line.Text));
        var name = $"{Container.Name}-{DateTime.Now:yyyyMMdd-HHmmss}.log";
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./containers.js");
            await _module.InvokeVoidAsync("download", name, text);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            _error = "The browser would not save the file: " + ex.Message;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopFollowing();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
            }
        }
    }
}
