@implements IDisposable
@inject ConfigStore Config
@inject HealthMonitor Health
@inject HistoryStore History
@inject Offload Offload

<div class="page-head">
    <div>
        <h1>@(string.IsNullOrWhiteSpace(Tab.Icon) ? "" : Tab.Icon + " ")@Tab.Name</h1>
        <p class="subtitle">Uptime for everything being monitored, from recorded history.</p>
    </div>
</div>

@if (!_load.Ready && _monitored > 0)
{
    @* The page, its heading and a placeholder at once; the uptime figures are four
       history queries per connection, and arrive when they arrive. *@
    <div class="panel p-3 mb-4">
        <div class="widget-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="empty-state">
        <p class="mb-3">Nothing is being monitored yet.</p>
        <a class="btn btn-primary btn-sm" href="settings/connections">Add a connection</a>
    </div>
}
else
{
    <div class="panel p-3 mb-4">
        @foreach (var row in _rows)
        {
            <div class="status-row">
                <div class="status-row-head">
                    <span class="status-dot @DotClass(row)"></span>
                    <span class="tile-name text-truncate">
                        @(string.IsNullOrWhiteSpace(row.Connection.Icon) ? "" : row.Connection.Icon + " ")@row.Connection.Name
                    </span>
                    <span class="tile-meta ms-auto flex-none" title="@PartialNote(row)">
                        @Percent(row.Day) <span class="opacity-50">24h</span>
                        &nbsp;·&nbsp;
                        @Percent(row.Week) <span class="opacity-50">7d</span>
                        &nbsp;·&nbsp;
                        @Percent(row.Month) <span class="opacity-50">30d</span>
                        @if (row.Month.IsPartial)
                        {
                            @* Percentages measured over less than the stated window would
                               otherwise look like a service with a suspiciously round score. *@
                            <span class="opacity-50">*</span>
                        }
                    </span>
                </div>

                @* One bar per day, oldest on the left. A day with no history is drawn hollow
                   rather than red so a new install doesn't look like a month of outages. *@
                <div class="uptime-strip" role="img" aria-label="@($"Daily uptime for {row.Connection.Name} over {row.Days.Count} days")">
                    @foreach (var day in row.Days)
                    {
                        <span class="uptime-day @DayClass(day.Percent)"
                              title="@($"{day.Date:ddd d MMM} — {(day.Percent is { } p ? $"{p:0.0}% up" : "no data")}")"></span>
                    }
                </div>

                <div class="tile-meta d-flex justify-content-between">
                    <span>@(row.Days.Count) days ago</span>
                    <span>@StateLine(row)</span>
                    <span>today</span>
                </div>
            </div>
        }
    </div>

    <h2 class="h6 text-uppercase tile-meta mb-2">Recent changes</h2>
    @if (_events.Count == 0)
    {
        <p class="tile-meta">Nothing has changed state yet.</p>
    }
    else
    {
        <div class="panel">
            <table class="table table-sm mb-0">
                <tbody>
                    @foreach (var entry in _events)
                    {
                        <tr>
                            <td style="width:2rem"><span class="status-dot @(entry.IsUp ? "status-up" : "status-down")"></span></td>
                            <td>@NameOf(entry.ConnectionId)</td>
                            <td class="tile-meta">@(entry.IsUp ? "recovered" : "went down")</td>
                            <td class="tile-meta text-truncate" style="max-width:26rem">@entry.Message</td>
                            <td class="tile-meta text-end">@entry.At.ToString("d MMM HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Tab Tab { get; set; } = default!;

    private sealed record Row(
        Connection Connection,
        HealthMonitor.ProbeState? State,
        HistoryStore.Uptime Day,
        HistoryStore.Uptime Week,
        HistoryStore.Uptime Month,
        IReadOnlyList<HistoryStore.Day> Days);

    private List<Row> _rows = [];
    private IReadOnlyList<HistoryStore.StatusEvent> _events = [];
    private Dictionary<string, string> _names = [];
    private BackgroundLoad _load = default!;

    /// <summary>How many connections are monitored, known before their history is.</summary>
    private int _monitored;

    private int WindowDays => Math.Clamp(Tab.Settings.GetInt("days", 30), 7, 90);

    protected override void OnInitialized()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Health.Updated += OnUpdated;
    }

    // The connection list is cached and fine to wait for. The uptime is history, and is
    // started here and not waited for — see BackgroundLoad.
    protected override async Task OnParametersSetAsync() => await LoadAsync(refresh: false);

    private async Task LoadAsync(bool refresh)
    {
        var all = await Config.ConnectionsAsync();
        var connections = all.Where(Health.IsMonitored).ToList();
        // Name every connection, not just the monitored ones, so an old event from
        // something since unmonitored still reads as itself rather than "(deleted)".
        _names = all.ToDictionary(c => c.Id, c => c.Name);
        _monitored = connections.Count;

        var windowDays = WindowDays;

        async Task<(List<Row> Rows, IReadOnlyList<HistoryStore.StatusEvent> Events)> Fetch(CancellationToken ct)
        {
            // All in one offloaded read rather than one per figure: it is one page's worth,
            // and taking a gate slot four times per connection would let a dashboard's
            // charts overtake it at every step.
            return await Offload.Run(async c =>
            {
                var rows = new List<Row>();
                foreach (var connection in connections)
                {
                    rows.Add(new Row(
                        connection,
                        null,
                        await History.UptimeAsync(connection.Id, TimeSpan.FromHours(24), c),
                        await History.UptimeAsync(connection.Id, TimeSpan.FromDays(7), c),
                        await History.UptimeAsync(connection.Id, TimeSpan.FromDays(30), c),
                        await History.DailyUptimeAsync(connection.Id, windowDays, c)));
                }

                // Only events for things currently monitored — an alert channel is not an outage.
                var monitored = connections.Select(x => x.Id).ToHashSet();
                IReadOnlyList<HistoryStore.StatusEvent> events =
                    [.. (await History.RecentEventsAsync(null, 60, c)).Where(e => monitored.Contains(e.ConnectionId)).Take(25)];
                return (rows, events);
            }, ct);
        }

        // The probe state is live, so it is read when the rows are shown rather than when
        // their history was fetched.
        void Apply((List<Row> Rows, IReadOnlyList<HistoryStore.StatusEvent> Events) loaded)
        {
            _rows = [.. loaded.Rows.Select(row => row with { State = Health.State(row.Connection.Id) })];
            _events = loaded.Events;
        }

        var key = $"{windowDays}|{string.Join(",", connections.Select(c => $"{c.Id}:{c.Name}:{c.Icon}"))}";
        if (refresh)
            _ = _load.Refresh(key, Fetch, Apply);
        else
            _ = _load.Load(key, Fetch, Apply);

        // A sweep changes the dots before it changes any history worth waiting for.
        _rows = [.. _rows.Select(row => row with { State = Health.State(row.Connection.Id) })];
    }

    private string NameOf(string id) => _names.TryGetValue(id, out var name) ? name : "(deleted)";

    private static string Percent(HistoryStore.Uptime uptime) => $"{uptime.Percent:0.0}%";

    private static string PartialNote(Row row) => row.Month.Since is { } since
        ? $"Measured from when monitoring started, {since:d MMM HH:mm} — not the full window."
        : "";

    private static string DotClass(Row row) => row.State?.IsUp switch
    {
        true => "status-up",
        false => "status-down",
        _ => "status-unknown",
    };

    private static string DayClass(double? percent) => UptimeStrip.DayClass(percent);

    private static string StateLine(Row row)
    {
        if (row.State is null)
            return "checking…";
        var since = row.State.ChangedAt is { } at ? $" since {at:d MMM HH:mm}" : "";
        return row.State.IsUp switch
        {
            true => $"up{since}",
            false => $"down{since} — {row.State.Message}",
            _ => "checking…",
        };
    }

    private void OnUpdated() => _ = InvokeAsync(async () =>
    {
        await LoadAsync(refresh: true);
        StateHasChanged();
    });

    public void Dispose()
    {
        Health.Updated -= OnUpdated;
        _load?.Dispose();
    }
}
