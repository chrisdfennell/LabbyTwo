@implements IDisposable
@inject NotesStore Notes
@inject ChecklistStore Ticks
@inject NoteChecklists NoteChecklists
@inject Offload Offload
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities

<div class="page-head">
    <div>
        <h1>@(string.IsNullOrWhiteSpace(Tab.Icon) ? "" : Tab.Icon + " ")@Tab.Name</h1>
        <p class="subtitle">Markdown notes and runbooks.</p>
    </div>
    <div class="d-flex gap-1">
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showDeleted = true">Recently deleted</button>
        <button class="btn btn-sm btn-primary" @onclick="NewNote">+ New note</button>
    </div>
</div>

@if (_notes.Count == 0)
{
    <div class="empty-state">Nothing written down yet.</div>
}
else
{
    <div class="row g-3">
        @foreach (var note in _notes)
        {
            var ticked = TickCount(note);
            <div class="col-12 col-lg-6" id="@($"note-{note.Id}")">
                <div class="widget h-100">
                    <div class="widget-head">
                        <h2 class="widget-title text-truncate">@Describe(note)</h2>
                        <div class="d-flex gap-1 flex-none">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(note)">Edit</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _history = note">History</button>
                            <button class="btn btn-sm btn-outline-danger" aria-label="@($"Delete {Describe(note)}")" @onclick="() => _confirmDelete = note">✕</button>
                        </div>
                    </div>
                    <div class="widget-body markdown-body"><LiveMarkdown Content="@note.Content" OwnerId="@note.Id" Checklist="true" /></div>
                    <div class="tile-meta mt-2 d-flex flex-wrap align-items-center gap-2">
                        <span>Updated @note.UpdatedAt.ToString("d MMM yyyy HH:mm")@(note.UpdatedBy.Length > 0 ? $" by {note.UpdatedBy}" : "")</span>
                        @if (ticked > 0)
                        {
                            <button class="btn btn-link btn-sm p-0 ms-auto" @onclick="() => _confirmReset = note">
                                Reset checklist (@ticked ticked)
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_editing is not null)
{
    <Modal Title="@(_editingId is null ? "New note" : "Edit note")" Size="xl" OnClose="() => _editing = null">
        <ChildContent>
        <div class="mb-3">
            <label class="form-label" for="note-title">Title</label>
            <input id="note-title" class="form-control" @bind="_editing.Title" @bind:event="oninput" />
        </div>
        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label" for="note-body">Markdown</label>
                <textarea id="note-body" class="form-control font-monospace" rows="16"
                          @bind="_editing.Content" @bind:event="oninput"></textarea>
                <MarkdownHintStrip Value="@_editing.Content" ValueChanged="v => _editing.Content = v" />
            </div>
            <div class="col-lg-6">
                <label class="form-label">Preview</label>
                <div class="panel p-3 markdown-body" style="min-height: 20rem">
                    <LiveMarkdown Content="@_editing.Content" OwnerId="@_editingId" />
                </div>
                @if (Checklists.MayHaveItems(_editing.Content))
                {
                    <p class="tile-meta mt-1 mb-0">
                        The preview shows the boxes as written. Ticks made on the note are kept separately and stay on their items when you save.
                    </p>
                }
            </div>
        </div>
        </ChildContent>
        <Footer>
            <button class="btn btn-secondary btn-sm" @onclick="() => _editing = null">Cancel</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save</button>
        </Footer>
    </Modal>
}

@if (_confirmDelete is not null)
{
    <ConfirmDialog Title="Delete this note?"
                   Message="@($"“{Describe(_confirmDelete)}” can be brought back from Recently deleted for {(int)NotesStore.DeletedFor.TotalDays} days.")"
                   OnCancel="() => _confirmDelete = null"
                   OnConfirm="DeleteAsync" />
}

@if (_confirmReset is not null)
{
    <ConfirmDialog Title="Reset this checklist?"
                   Message="@($"Every box in “{Describe(_confirmReset)}” will be unticked, for everyone. The note's text is not changed, and the reset is recorded in What changed.")"
                   ConfirmText="Reset"
                   OnCancel="() => _confirmReset = null"
                   OnConfirm="ResetAsync" />
}

@if (_history is not null)
{
    <NoteHistory Note="_history" OnClose="() => _history = null" OnRestored="RestoredAsync" />
}

@if (_showDeleted)
{
    <RecentlyDeletedNotes TabId="@Tab.Id" OnClose="() => _showDeleted = false" OnRestored="LoadAsync" />
}

@code {
    [Parameter, EditorRequired] public Tab Tab { get; set; } = default!;

    [CascadingParameter] private Task<AuthenticationState>? Auth { get; set; }

    private IReadOnlyList<NotesStore.Note> _notes = [];
    private Draft? _editing;
    private string? _editingId;
    private NotesStore.Note? _confirmDelete;
    private NotesStore.Note? _confirmReset;
    private NotesStore.Note? _history;
    private bool _showDeleted;
    private bool _disposed;

    private sealed class Draft
    {
        public string Title { get; set; } = "";
        public string Content { get; set; } = "";
    }

    private static string Describe(NotesStore.Note note) => note.Title is { Length: > 0 } ? note.Title : "Untitled";

    protected override void OnInitialized() => Ticks.Changed += OnTicksChanged;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        OpenAsked();
    }

    /// <summary>
    /// ?edit=&lt;id&gt; opens that note in the editor — where an incident's "Write up" sends
    /// you, so the note it just wrote is ready to finish. Taken off the address once opened,
    /// so closing the editor and reloading does not open it again.
    /// </summary>
    private void OpenAsked()
    {
        // Not while prerendering: a navigation there is a redirect, which would lose the
        // question before the interactive render could answer it.
        if (!RendererInfo.IsInteractive)
            return;
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("edit", out var asked))
            return;
        if (_notes.FirstOrDefault(n => n.Id == asked.ToString()) is { } note)
            Edit(note);
        Nav.NavigateTo(uri.GetLeftPart(UriPartial.Path) + $"#note-{asked}", replace: true);
    }

    private async Task LoadAsync()
    {
        var tab = Tab.Id;
        _notes = await Offload.Run(ct => Notes.ForTabAsync(tab, ct));
        LoadTicks();
    }

    /// <summary>
    /// Reads the ticks of every note with a checklist, on the pool, so the "Reset checklist"
    /// button knows whether there is anything to reset. The boxes ask for the same notes at
    /// the same moment, and the store makes each note one query for all of them.
    /// </summary>
    private void LoadTicks()
    {
        if (!RendererInfo.IsInteractive)
            return;
        foreach (var note in _notes)
        {
            if (!Checklists.MayHaveItems(note.Content) || Ticks.TryCached(note.Id, out _))
                continue;
            _ = LoadTicksAsync(note.Id);
        }
    }

    private async Task LoadTicksAsync(string noteId)
    {
        try
        {
            await Offload.Run(ct => Ticks.TicksAsync(noteId, ct));
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // The boxes say so themselves; the button simply stays hidden.
        }
    }

    /// <summary>How many of the note's items are ticked, from memory; zero until read.</summary>
    private int TickCount(NotesStore.Note note) =>
        Checklists.MayHaveItems(note.Content) && Ticks.TryCached(note.Id, out var ticks) ? ticks.Count : 0;

    private void OnTicksChanged(string noteId)
    {
        if (_disposed || _notes.All(n => n.Id != noteId))
            return;
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
                StateHasChanged();
        });
    }

    private async Task<string> WhoAsync() =>
        Auth is not null && (await Auth).User.Identity is { IsAuthenticated: true, Name: { Length: > 0 } name } ? name : "";

    private void NewNote()
    {
        _editingId = null;
        _editing = new Draft();
    }

    private void Edit(NotesStore.Note note)
    {
        _editingId = note.Id;
        _editing = new Draft { Title = note.Title, Content = note.Content };
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
            return;
        var draft = _editing;
        var by = await WhoAsync();
        var (editingId, tab) = (_editingId, Tab.Id);
        await Offload.Run(async ct =>
        {
            var id = await Notes.SaveAsync(editingId, tab, draft.Title, draft.Content, by, ct);
            // Ticks follow their items to the new text (Checklists.Reconcile).
            await NoteChecklists.ReconcileAsync(id, draft.Content, ct);
            return id;
        });
        _editing = null;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_confirmDelete is { } note)
        {
            var by = await WhoAsync();
            await Offload.Run(async ct =>
            {
                await Notes.DeleteAsync(note.Id, by, ct);
                return true;
            });
        }
        _confirmDelete = null;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        if (_confirmReset is { } note)
        {
            var by = await WhoAsync();
            await Offload.Run(ct => NoteChecklists.ResetAsync(note.Id, note.Title, by, ct));
        }
        _confirmReset = null;
    }

    private async Task RestoredAsync()
    {
        _history = null;
        await LoadAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        Ticks.Changed -= OnTicksChanged;
    }
}
