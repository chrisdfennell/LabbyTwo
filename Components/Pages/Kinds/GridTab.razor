@implements IDisposable
@inject ConfigStore Config
@inject Registry Registry

<div class="page-head">
    <div>
        <h1>@(string.IsNullOrWhiteSpace(Tab.Icon) ? "" : Tab.Icon + " ")@Tab.Name</h1>
        @if (Tab.Settings.Get("subtitle") is { Length: > 0 } subtitle)
        {
            <p class="subtitle">@subtitle</p>
        }
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm @(_editing ? "btn-primary" : "btn-outline-secondary")"
                @onclick="ToggleEditing">
            @(_editing ? "Done" : "Edit layout")
        </button>
        @if (_editing)
        {
            <button class="btn btn-sm btn-primary" @onclick="() => _picking = true">+ Add widget</button>
        }
    </div>
</div>

@if (_moving is { } moving)
{
    <div class="alert alert-info d-flex align-items-center gap-2 py-2">
        <span>Moving <strong>@Describe(moving)</strong> — choose where it goes.</span>
        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => _moving = null">Cancel</button>
    </div>
}

@if (_widgets.Count == 0)
{
    <div class="empty-state">
        <p class="mb-3">This tab is empty.</p>
        <button class="btn btn-primary btn-sm" @onclick="() => { _editing = true; _picking = true; }">
            Add the first widget
        </button>
    </div>
}
else
{
    <div class="widget-grid" @ondragover:preventDefault @ondragover="() => { }">
        @foreach (var widget in _widgets)
        {
            var type = Registry.WidgetType(widget.Type);
            var connection = _connections.FirstOrDefault(c => c.Id == widget.ConnectionId);
            var current = widget;
            <div class="widget @DragClass(current)" style="grid-column: span @Math.Clamp(widget.Width, 1, 12)"
                 draggable="@(_editing ? "true" : null)"
                 @ondragstart="() => _dragging = current"
                 @ondragend="() => { _dragging = null; _dragOver = null; }"
                 @ondragover:preventDefault
                 @ondragover="() => _dragOver = current"
                 @ondrop="() => DropOnAsync(current)">
                @if (widget.Title is { Length: > 0 } || _editing)
                {
                    <div class="widget-head">
                        @if (_editing)
                        {
                            <span class="drag-handle flex-none" title="Drag to rearrange">⠿</span>
                        }
                        <h2 class="widget-title text-truncate">@widget.Title</h2>
                        @if (_editing)
                        {
                            <span class="tile-meta flex-none">@(type?.DisplayName ?? widget.Type)</span>
                        }
                    </div>
                }

                <div class="widget-body">
                    @if (type is null)
                    {
                        <p class="tile-meta mb-0">Unknown widget type “@widget.Type”.</p>
                    }
                    else if (type.NeedsConnection && connection is null)
                    {
                        <p class="tile-meta mb-0">
                            The connection this widget used is gone. Edit it to pick another.
                        </p>
                    }
                    else if (!RendererInfo.IsInteractive)
                    {
                        @* The page is being prerendered, and prerendering waits for every
                           component on it to finish its work before a single byte is sent.
                           A dozen cards each calling out to Plex, the NAS and the database
                           therefore cost the *whole page* seconds before anything appears.

                           So the prerender draws the grid — real sizes, real titles — with
                           a placeholder in each card. The page is on screen at once, and
                           each widget fills itself in as its own data arrives, which is
                           also why one slow service can no longer hold up the other
                           eleven. *@
                        <div class="widget-skeleton" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </div>
                    }
                    else
                    {
                        <DynamicComponent Type="type.Component"
                                          Parameters="@(new Dictionary<string, object> { ["Context"] = new WidgetContext(widget, connection) })"
                                          @key="widget.Id" />
                    }
                </div>

                @if (_editing && _moving is not null)
                {
                    @* Move mode. HTML drag and drop is mouse-only — it does not exist on
                       a touchscreen and cannot be reached from a keyboard — so picking a
                       card up and choosing a destination is the path that works
                       everywhere, and the only one on a wall tablet. *@
                    <div class="widget-edit-bar">
                        @if (_moving.Id == widget.Id)
                        {
                            <span class="tile-meta">Moving this card…</span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary w-100"
                                    @onclick="() => PlaceBeforeAsync(current)">
                                ↳ Place before this
                            </button>
                        }
                    </div>
                }
                else if (_editing)
                {
                    <div class="widget-edit-bar">
                        <button class="btn btn-sm btn-outline-secondary" title="Move this card"
                                @onclick="() => _moving = current">⠿</button>
                        <button class="btn btn-sm btn-outline-secondary" title="Move up"
                                @onclick="() => MoveAsync(widget, -1)">↑</button>
                        <button class="btn btn-sm btn-outline-secondary" title="Move down"
                                @onclick="() => MoveAsync(widget, 1)">↓</button>
                        <button class="btn btn-sm btn-outline-secondary" title="Narrower"
                                @onclick="() => ResizeAsync(widget, -1)">−</button>
                        <button class="btn btn-sm btn-outline-secondary" title="Wider"
                                @onclick="() => ResizeAsync(widget, 1)">+</button>
                        <button class="btn btn-sm btn-outline-secondary ms-auto"
                                @onclick="() => _editingWidget = widget">Edit</button>
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => _confirmDelete = widget">✕</button>
                    </div>
                }
            </div>
        }

        @if (_moving is not null)
        {
            <div class="widget place-at-end" style="grid-column: span 12">
                <button class="btn btn-sm btn-outline-primary w-100" @onclick="() => PlaceBeforeAsync(null)">
                    ↳ Place at the end
                </button>
            </div>
        }
    </div>
}

@if (_picking)
{
    @* The @ prefix is load-bearing: TabId is a string parameter, so an unprefixed
       value would be passed as the literal text "Tab.Id" instead of the tab's id. *@
    <WidgetPicker TabId="@Tab.Id" OnClose="() => _picking = false"
                  OnPicked="widget => { _picking = false; _editingWidget = widget; }" />
}

@if (_editingWidget is { } editing)
{
    <WidgetEditor Widget="editing" OnClose="() => _editingWidget = null" />
}

@if (_confirmDelete is not null)
{
    <ConfirmDialog Title="Remove this widget?"
                   Message="@($"“{Describe(_confirmDelete)}” will be removed from this tab.")"
                   ConfirmText="Remove"
                   OnCancel="() => _confirmDelete = null"
                   OnConfirm="DeleteConfirmedAsync" />
}

@code {
    [Parameter, EditorRequired] public Tab Tab { get; set; } = default!;

    private IReadOnlyList<Widget> _widgets = [];
    private IReadOnlyList<Connection> _connections = [];
    private bool _editing;
    private bool _picking;
    private Widget? _editingWidget;
    private Widget? _confirmDelete;
    private Widget? _dragging;
    private Widget? _dragOver;
    private Widget? _moving;

    /// <summary>
    /// Shows where the card would land. Which side depends on the direction of travel —
    /// dragging a later card upwards inserts before the target, dragging an earlier one
    /// down inserts after it, which is what a drag feels like it should do.
    /// </summary>
    private string DragClass(Widget widget)
    {
        if (!_editing)
            return "";
        if (_dragging?.Id == widget.Id)
            return "is-dragging";
        if (_dragOver?.Id != widget.Id || _dragging is null)
            return "is-draggable";
        return _dragging.Sort > widget.Sort ? "is-draggable is-drop-before" : "is-draggable is-drop-after";
    }

    /// <summary>Move mode's drop: put the held card immediately before this one.</summary>
    private async Task PlaceBeforeAsync(Widget? target)
    {
        var source = _moving;
        _moving = null;
        if (source is null || source.Id == target?.Id)
            return;
        await Config.MoveWidgetAsync(source.Id, target?.Id);
    }

    private async Task DropOnAsync(Widget target)
    {
        var source = _dragging;
        _dragging = null;
        _dragOver = null;
        if (source is null || source.Id == target.Id)
            return;

        // Dropping onto a card that is already later in the order means "go after it", so
        // the widget after the target is the insertion point.
        string? before = target.Id;
        if (source.Sort < target.Sort)
        {
            var index = _widgets.ToList().FindIndex(w => w.Id == target.Id);
            before = index >= 0 && index + 1 < _widgets.Count ? _widgets[index + 1].Id : null;
        }

        await Config.MoveWidgetAsync(source.Id, before);
    }

    protected override void OnInitialized() => Config.Changed += OnChanged;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _widgets = await Config.WidgetsForTabAsync(Tab.Id);
        _connections = await Config.ConnectionsAsync();
    }

    private void ToggleEditing()
    {
        _editing = !_editing;
        _moving = null;
    }

    private async Task MoveAsync(Widget widget, int direction) => await Config.ReorderWidgetAsync(widget.Id, direction);

    private async Task ResizeAsync(Widget widget, int step)
    {
        // Widths step through the sizes that tile evenly into a 12-column grid, so a
        // dashboard cannot end up with a 5-wide card leaving a ragged gap.
        int[] steps = [2, 3, 4, 6, 8, 12];
        var index = Array.FindIndex(steps, w => w >= widget.Width);
        var next = Math.Clamp((index < 0 ? 2 : index) + step, 0, steps.Length - 1);
        await Config.SaveWidgetAsync(widget with { Width = steps[next] });
    }

    private string Describe(Widget widget) => widget.Title is { Length: > 0 }
        ? widget.Title
        : Registry.WidgetType(widget.Type)?.DisplayName ?? widget.Type;

    private async Task DeleteConfirmedAsync()
    {
        if (_confirmDelete is { } widget)
            await Config.DeleteWidgetAsync(widget.Id);
        _confirmDelete = null;
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Config.Changed -= OnChanged;
}
