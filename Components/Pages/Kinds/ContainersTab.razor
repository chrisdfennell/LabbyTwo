@implements IAsyncDisposable
@inject ConfigStore Config
@inject Registry Registry
@inject Offload Offload
@inject IJSRuntime JS
@inject IOptions<LabbyOptions> Options
@inject ContainerUpdates Updates
@inject SelfUpdater Updater
@inject SafeUpdates Safe
@inject ContainerConfigStore ConfigHistory
@using Microsoft.Extensions.Options

@* Every container on one Docker host. Written to stand on its own or inside another page:
   nothing here reads the address bar, owns the document, or assumes it is the only thing
   drawn — the heading is the tab's, the dialogs are its own, and everything it starts it
   stops when it is disposed. *@

<div class="ct-page">
    <div class="page-head">
        <div>
            <h1>@(string.IsNullOrWhiteSpace(Tab.Icon) ? "🐳" : Tab.Icon) @Tab.Name</h1>
            <p class="subtitle">@Subtitle</p>
        </div>
        @if (_docker is not null)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="refresh"
                    disabled="@_load.Loading" @onclick="() => RefreshAsync(freshCapabilities: true)">
                @(_load.Loading ? "Refreshing…" : "↻ Refresh")
            </button>
        }
    </div>

    @if (_docker is null)
    {
        <div class="empty-state">
            <p class="mb-3">This tab needs a Docker connection — the local socket, a named pipe, or a socket proxy.</p>
            <a class="btn btn-primary btn-sm" href="settings/connections">Add one</a>
        </div>
    }
    else
    {
        @if (!Options.Value.Auth.Enabled && AllowActions)
        {
            <div class="alert alert-warning py-2">
                <strong>LabbyTwo has no login,</strong> so anyone who can reach this dashboard can stop and remove
                every container on @_docker.Name and read their environment variables. Set
                <code>LABBY_AUTH_PASSWORD</code> in your <code>.env</code>, or turn off
                <em>Allow start, stop and restart</em> in this tab's settings.
            </div>
        }

        <details class="ct-help mb-2">
            <summary class="tile-meta">What this page can do, and to what</summary>
            <p class="tile-meta mb-1">
                This page controls every container on <strong>@_docker.Name</strong>: anyone who can open it can
                stop, restart and remove them, and read their configuration. Environment values are hidden until
                revealed one at a time, but they are only hidden, not protected.
            </p>
            <p class="tile-meta mb-1">
                LabbyTwo's own container@(_protected.Count > 0 ? $" and the protected list ({string.Join(", ", _protected)})" : "")
                need their name typed before being stopped, paused or removed, and project-wide buttons skip them.
            </p>
            <p class="tile-meta mb-0">
                Through linuxserver/socket-proxy: the list, stats and inspect need <code>CONTAINERS=1</code>; logs
                <code>ALLOW_LOGS=1</code>; restart <code>ALLOW_RESTARTS=1</code>; stop <code>ALLOW_STOP=1</code> (or
                <code>ALLOW_RESTARTS=1</code>); start <code>ALLOW_START=1</code>; pause and unpause
                <code>ALLOW_PAUSE=1</code> and <code>ALLOW_UNPAUSE=1</code>; the newer-image hint, image ages and
                <em>Check for updates</em> <code>IMAGES=1</code>.
                All of those work with <code>POST=0</code>. Remove needs <code>POST=1</code>, which also allows
                creating containers — root on the host — so it is usually better left refused. <em>Update</em> needs
                the same unless <code>Labby__Watchtower__Url</code> points at a Watchtower that does it instead.
                Keeping the previous image before an update needs <code>IMAGES=1</code> and <code>POST=1</code>, and
                rolling back to it — which recreates the container — <code>CONTAINERS=1</code>, <code>IMAGES=1</code>,
                <code>NETWORKS=1</code> and <code>POST=1</code>.
            </p>
        </details>

        @if (_capabilities.Denied.Count > 0)
        {
            <details class="ct-denied mb-2">
                <summary class="tile-meta">
                    The socket proxy refuses @_capabilities.Denied.Count @(_capabilities.Denied.Count == 1 ? "thing" : "things")
                    here — those buttons are greyed out.
                </summary>
                <ul class="tile-meta mb-1">
                    @foreach (var denied in _capabilities.Denied.OrderBy(d => d.Key))
                    {
                        <li>@denied.Value</li>
                    }
                </ul>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="() => RefreshAsync(freshCapabilities: true)">Check again</button>
            </details>
        }

        <div class="ct-toolbar">
            <input type="search" class="form-control form-control-sm" placeholder="Search name, image or project"
                   aria-label="Search containers" @bind="_search" @bind:event="oninput" />
            <select class="form-select form-select-sm" aria-label="Show" @bind="_state">
                <option value="all">All</option>
                <option value="running">Running</option>
                <option value="stopped">Stopped</option>
                <option value="paused">Paused</option>
                <option value="restarting">Restarting</option>
                <option value="unhealthy">Unhealthy</option>
            </select>
            <select class="form-select form-select-sm" aria-label="Sort by" @bind="_sort">
                <option value="@DockerContainers.SortBy.Name">By name</option>
                <option value="@DockerContainers.SortBy.State">Trouble first</option>
                @if (ShowStats)
                {
                    <option value="@DockerContainers.SortBy.Cpu">By CPU</option>
                    <option value="@DockerContainers.SortBy.Memory">By memory</option>
                }
                <option value="@DockerContainers.SortBy.Created">Newest first</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleAll">
                @(_collapsed.Count > 0 ? "Expand all" : "Collapse all")
            </button>
        </div>

        @if (RegistryCheck)
        {
            <div class="ct-updates">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="check-updates"
                        disabled="@Checking" @onclick="CheckForUpdatesAsync"
                        title="Asks each image's registry which image its tag points at now. Nothing is asked until you press this.">
                    @(Checking ? "Checking…" : "Check for updates")
                </button>
                <span class="tile-meta" data-updates-summary>@UpdateSummary</span>
                @if (AllowActions && _review is { } behind && behind.Behind.Any(b => b.CanUpdate))
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" data-action="update-all"
                            disabled="@(_busy is not null)" @onclick="AskUpdateAll">
                        Update all that are behind
                    </button>
                }
            </div>
            @if (_review is { } checkedReview && checkedReview.Containers.Where(c => c.State == UpdateState.Unknown).ToList() is { Count: > 0 } unknown)
            {
                <details class="ct-denied mb-2">
                    <summary class="tile-meta">@unknown.Count could not be checked</summary>
                    <ul class="tile-meta mb-1">
                        @foreach (var line in unknown)
                        {
                            <li><strong>@line.Name</strong> — @line.Note</li>
                        }
                    </ul>
                </details>
            }
        }

        @if (_result is { Length: > 0 })
        {
            <div class="ct-result @(_resultFailed ? "text-danger" : "text-success")" role="status">@_result</div>
        }

        @if (_error is { Length: > 0 })
        {
            <div class="alert alert-warning py-2 ct-error">@_error</div>
        }
        else if (!_load.Ready)
        {
            <div class="widget-skeleton" aria-label="Loading containers"><span></span><span></span><span></span></div>
        }
        else if (_rows.Count == 0)
        {
            <p class="tile-meta">No containers on @_docker.Name.</p>
        }
        else
        {
            var groups = Groups();
            @if (groups.Count == 0)
            {
                <p class="tile-meta">Nothing matches.</p>
            }
            @foreach (var group in groups)
            {
                <ContainerGroupCard @key="group.Key"
                                    Group="group"
                                    Collapsed="_collapsed.Contains(group.Key)"
                                    OnToggle="() => Toggle(group.Key)"
                                    Stats="_stats"
                                    Stale="_stale"
                                    Updates="UpdateView"
                                    Checked="_review is { Error: null }"
                                    OnUpdate="AskUpdate"
                                    Safe="_safe"
                                    OnRollback="AskRollback"
                                    Capabilities="_capabilities"
                                    AllowActions="AllowActions"
                                    ShowStats="ShowStats && _capabilities.Allows(DockerCapabilities.Stats)"
                                    Busy="@_busy"
                                    IsSelf="IsSelf"
                                    IsListed="IsListed"
                                    ShellLink="ShellLink"
                                    OnAction="args => Ask(args.Row, args.Action)"
                                    OnBulk="args => AskBulk(args.Group, args.Action)"
                                    OnLogs="row => _logsFor = row"
                                    OnInspect="InspectAsync" />
            }

            @if (_terminalInstalled && _terminalTab is null)
            {
                <p class="tile-meta mt-2">The Terminal plugin is installed — add a Terminal tab and each running container gets a shell button here.</p>
            }
        }
    }
</div>

@if (_pending is { } pending)
{
    <Modal Title="@pending.Title" Size="@(pending.Plan.Count > 0 ? "" : "sm")" OnClose="() => _pending = null">
        <ChildContent>
            <p>@pending.Message</p>
            @if (pending.Plan.Count > 0)
            {
                <ul class="ct-plan">
                    @foreach (var line in pending.Plan)
                    {
                        <li class="@(line.Acts ? "" : "tile-meta")">
                            <strong>@line.Name</strong> — @line.What
                        </li>
                    }
                </ul>
            }
            @if (pending.TypeName is { } name)
            {
                <label class="form-label mb-1" for="ct-typed-@Tab.Id">Type <code>@name</code> to confirm</label>
                <input id="ct-typed-@Tab.Id" class="form-control form-control-sm" autocomplete="off" spellcheck="false"
                       @bind="_typed" @bind:event="oninput" />
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-secondary btn-sm" @onclick="() => _pending = null">Cancel</button>
            <button class="btn btn-sm @(pending.Dangerous ? "btn-danger" : "btn-primary")" data-action="confirm"
                    disabled="@(!CanConfirm(pending))" @onclick="() => ConfirmAsync(pending)">
                @pending.ConfirmText
            </button>
        </Footer>
    </Modal>
}

@if (_logsFor is { } logs && _docker is not null)
{
    <Modal Title="@($"📜 {logs.Name}")" Size="xl" OnClose="() => _logsFor = null">
        <ContainerLogs Endpoint="@Endpoint" Timeout="Timeout" Container="logs" Tail="LogLines" @key="logs.Id" />
    </Modal>
}

@if (_inspectFor is { } inspected)
{
    <Modal Title="@($"🔍 {inspected.Name}")" Size="lg" OnClose="CloseInspect">
        @if (_inspectError is { Length: > 0 })
        {
            <div class="alert alert-warning py-2 mb-0">@_inspectError</div>
        }
        else if (_details is null)
        {
            <p class="tile-meta mb-0">Loading…</p>
        }
        else
        {
            <ContainerInspect Details="_details" History="_history" />
        }
    </Modal>
}

@code {
    [Parameter, EditorRequired] public Tab Tab { get; set; } = default!;

    /// <summary>How often stats are read while the page is visible, and the list every other time.</summary>
    public static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(10);

    /// <summary>
    /// How long a connection that points at a restarted container is silenced for. Long
    /// enough for a slow image to come back up; short enough that a container that never
    /// does is still reported.
    /// </summary>
    private static readonly TimeSpan RestartSilence = TimeSpan.FromMinutes(2);

    private Connection? _docker;
    private string _loadedFor = "";
    private BackgroundLoad _load = default!;

    private IReadOnlyList<ContainerRow> _rows = [];
    private DockerCapabilities _capabilities = DockerCapabilities.All;
    private IReadOnlyDictionary<string, ContainerStats> _stats = new Dictionary<string, ContainerStats>();
    private IReadOnlyDictionary<string, string> _stale = new Dictionary<string, string>();
    private string? _error;

    /// <summary>Image ages, local builds and the exclusion label: what Docker alone says, by container id.</summary>
    private IReadOnlyDictionary<string, ContainerUpdate> _local = new Dictionary<string, ContainerUpdate>();

    /// <summary>The last registry check of this connection — pressed here, in Settings, or by the schedule.</summary>
    private UpdateReview? _review;
    private bool _checking;

    /// <summary>The newest update started from here for each container, by name, and how its watch is going.</summary>
    private IReadOnlyDictionary<string, SafeUpdate> _safe = new Dictionary<string, SafeUpdate>();

    /// <summary>Whether an update from this tab is watched, and for how long — this tab's setting over Settings'.</summary>
    private SafeUpdates.Choice _choice = new(true, TimeSpan.FromMinutes(SafeUpdateRules.DefaultMinutes));

    private IReadOnlyList<string> _protected = [];
    private bool _terminalInstalled;
    private Tab? _terminalTab;

    private string _search = "";
    private string _state = "all";
    private DockerContainers.SortBy _sort = DockerContainers.SortBy.Name;
    private readonly HashSet<string> _collapsed = [];

    private string? _busy;
    private string _result = "";
    private bool _resultFailed;

    private Pending? _pending;
    private string _typed = "";

    private ContainerRow? _logsFor;
    private ContainerRow? _inspectFor;
    private ContainerDetails? _details;
    private IReadOnlyList<ContainerConfigVersion>? _history;
    private string? _inspectError;

    private bool _visible = true;
    private int _tick;
    private CancellationTokenSource? _poll;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watcher;
    private DotNetObjectReference<ContainersTab>? _self;
    private bool _disposed;

    /// <param name="Acts">False for a line saying what will be left alone.</param>
    private sealed record PlanLine(string Name, string What, bool Acts);

    /// <param name="TypeName">The name that has to be typed, or null for a plain confirmation.</param>
    private sealed record Pending(
        string Title, string Message, string ConfirmText, bool Dangerous, string? TypeName,
        IReadOnlyList<PlanLine> Plan, Func<Task> Run);

    private string Endpoint => _docker?.Settings.Get("endpoint", DockerSocket.EnvironmentEndpoint) ?? DockerSocket.EnvironmentEndpoint;
    private TimeSpan Timeout => TimeSpan.FromSeconds(Math.Clamp(_docker?.Settings.GetInt("timeout", 10) ?? 10, 1, 120));
    private bool AllowActions => Tab.Settings.GetBool("allow_actions", true);
    private bool ShowStats => Tab.Settings.GetBool("stats", true);
    private bool UpdateHint => Tab.Settings.GetBool("update_hint", true);
    private bool RegistryCheck => Tab.Settings.GetBool("registry_check", true);
    private bool Checking => _checking || (_docker is not null && Updates.IsChecking(_docker.Id));
    private int LogLines => Math.Clamp(Tab.Settings.GetInt("log_lines", 200), 10, 5000);

    private string Subtitle
    {
        get
        {
            if (_docker is null)
                return "No Docker connection";
            if (!_load.Ready)
                return _docker.Name;
            var running = _rows.Count(r => r.IsRunning);
            var unhealthy = _rows.Count(r => r.Health == ContainerHealth.Unhealthy);
            var text = $"{_docker.Name} · {running} of {_rows.Count} running";
            if (unhealthy > 0)
                text += $" · {unhealthy} unhealthy";
            if (_stale.Count > 0)
                text += $" · {_stale.Count} on an older image";
            if (_review is { Error: null } review && review.Behind.Count > 0)
                text += $" · {review.Behind.Count} with an update";
            return text;
        }
    }

    protected override void OnInitialized()
    {
        _load = Offload.Loader(InvokeAsync, StateHasChanged, RendererInfo.IsInteractive);
        Config.Changed += OnConfigChanged;
        Updates.Changed += OnUpdatesChanged;
        Safe.Changed += OnSafeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var connections = await Config.ConnectionsAsync();
        var chosen = Tab.Settings.Get("connection");

        // Nothing chosen: the first Docker connection is almost always the only one.
        _docker = chosen.Length > 0
            ? connections.FirstOrDefault(c => c.Id == chosen && c.Provider == "docker")
            : connections.FirstOrDefault(c => c.Provider == "docker" && c.Enabled);

        _protected = ContainerSafety.ParseList(Tab.Settings.Get("protected"));

        // Only what is already known: a check made elsewhere is shown, none is started.
        _review = _docker is null ? null : Updates.Last(_docker.Id);

        var tabChoice = Tab.Settings.Get(SafeUpdates.TabKey);
        _choice = await Offload.Run(ct => Safe.ChoiceAsync(tabChoice, ct));

        // The Terminal plugin is linked to, never depended on: if it is installed and a
        // Terminal tab exists, a running container gets a button that opens a shell there.
        _terminalInstalled = Registry.TabKind("terminal") is not null;
        _terminalTab = null;
        if (_terminalInstalled)
        {
            var tabs = await Config.TabsAsync();
            _terminalTab = tabs.FirstOrDefault(t => t.Kind == "terminal" && t.Enabled);
        }

        var key = _docker is null ? "" : $"{_docker.Id}|{Endpoint}";
        if (key != _loadedFor)
        {
            _loadedFor = key;
            _rows = [];
            _stats = new Dictionary<string, ContainerStats>();
            _stale = new Dictionary<string, string>();
            _local = new Dictionary<string, ContainerUpdate>();
            _safe = new Dictionary<string, SafeUpdate>();
            _error = null;
            if (_docker is null)
                _load.Cancel();
            else
                _ = Load(freshCapabilities: false, refresh: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
            return;

        _poll = new CancellationTokenSource();
        _ = PollAsync(_poll.Token);

        try
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./containers.js");
            _watcher = await _module.InvokeAsync<IJSObjectReference>("watchVisibility", _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // Without the script the page still works; it just keeps polling in a hidden tab.
        }
    }

    /// <summary>Called by the browser when the page is hidden or shown again.</summary>
    [JSInvokable]
    public Task SetVisible(bool visible)
    {
        var wasHidden = !_visible;
        _visible = visible;

        // Back from the background: whatever is on screen is minutes old, so catch up now
        // rather than at the next tick.
        return visible && wasHidden && _docker is not null
            ? InvokeAsync(async () =>
            {
                await RefreshAsync(freshCapabilities: false);
                await PollStatsAsync(CancellationToken.None);
            })
            : Task.CompletedTask;
    }

    private sealed record Snapshot(
        IReadOnlyList<ContainerRow> Rows, DockerCapabilities Capabilities, IReadOnlyDictionary<string, string> Stale, string? Error,
        IReadOnlyDictionary<string, ContainerUpdate>? Local = null, IReadOnlyDictionary<string, SafeUpdate>? Safe = null);

    private Task RefreshAsync(bool freshCapabilities) => Load(freshCapabilities, refresh: true);

    /// <summary>
    /// The list, what the endpoint allows, and the newer-image hint — everything that is not
    /// per-second. Captures its inputs before it starts, because it runs on the thread pool.
    /// </summary>
    private Task Load(bool freshCapabilities, bool refresh)
    {
        if (_docker is null)
            return Task.CompletedTask;

        var endpoint = Endpoint;
        var timeout = Timeout;
        var hint = UpdateHint;
        var key = _loadedFor;
        var dockerId = _docker.Id;

        async Task<Snapshot> Fetch(CancellationToken ct)
        {
            var capabilities = await DockerContainers.CapabilitiesAsync(endpoint, timeout, freshCapabilities, ct);
            IReadOnlyList<ContainerRow> rows;
            try
            {
                rows = await DockerContainers.ListAsync(endpoint, timeout, ct);
            }
            catch (Exception ex) when (ex is not OperationCanceledException || !ct.IsCancellationRequested)
            {
                return new Snapshot([], capabilities, new Dictionary<string, string>(), Explain(ex, endpoint));
            }

            IReadOnlyDictionary<string, string> stale = new Dictionary<string, string>();
            IReadOnlyDictionary<string, ContainerUpdate> local = new Dictionary<string, ContainerUpdate>();
            if (hint && capabilities.Allows(DockerCapabilities.Images))
            {
                try
                {
                    stale = await DockerContainers.StaleImagesAsync(endpoint, timeout, rows, ct);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Only a hint. A proxy without IMAGES=1 costs the hint, not the page.
                }

                try
                {
                    // Docker only — no registry. An image id names content that cannot
                    // change, so after the first load this is answered from memory.
                    var images = await ContainerUpdates.LocalAsync(endpoint, timeout, rows, ct);
                    local = rows.Where(r => images.ContainsKey(r.Id))
                        .ToDictionary(r => r.Id, r => ContainerUpdates.Classify(r, images[r.Id], null, checkedRegistry: false));
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Ages are a nicety too; "Check for updates" says what the proxy refuses.
                }
            }
            // A few rows at most — one per container ever updated from here — read on the loader's thread.
            IReadOnlyDictionary<string, SafeUpdate> safe = new Dictionary<string, SafeUpdate>();
            try
            {
                safe = await Safe.LatestAsync(dockerId, ct);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Badges and the roll-back button are extras; the list is the page.
            }
            return new Snapshot(rows, capabilities, stale, null, local, safe);
        }

        void Apply(Snapshot snapshot)
        {
            _error = snapshot.Error;
            _capabilities = snapshot.Capabilities;
            if (snapshot.Error is null)
            {
                _rows = snapshot.Rows;
                _stale = snapshot.Stale;
                _local = snapshot.Local ?? new Dictionary<string, ContainerUpdate>();
                _safe = snapshot.Safe ?? new Dictionary<string, SafeUpdate>();
                var ids = snapshot.Rows.Where(r => r.IsRunning).Select(r => r.Id).ToHashSet();
                var first = _stats.Count == 0;
                _stats = _stats.Where(s => ids.Contains(s.Key)).ToDictionary();

                // The first list is the moment stats become possible; waiting ten seconds
                // for the timer would show a page of dots for no reason.
                if (first && _poll is { IsCancellationRequested: false } poll)
                    _ = PollStatsAsync(poll.Token);
            }
        }

        return refresh ? _load.Refresh(key, Fetch, Apply) : _load.Load(key, Fetch, Apply);
    }

    private static string Explain(Exception ex, string endpoint) => DockerContainers.Explain(ex, endpoint);

    /// <summary>
    /// Stats every tick and the list every other, only while the page can be seen. One
    /// loop per page, and a tick that is still running when the next comes is not doubled up.
    /// </summary>
    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            await InvokeAsync(() => PollStatsAsync(ct));
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!_visible || _docker is null || _disposed)
                    continue;

                _tick++;
                await InvokeAsync(async () =>
                {
                    if (_tick % 2 == 0)
                        await RefreshAsync(freshCapabilities: false);
                    await PollStatsAsync(ct);
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    /// <summary>
    /// Stats for the running containers that are actually drawn — filtered out or in a
    /// collapsed project means nobody is looking, so nobody asks.
    /// </summary>
    private async Task PollStatsAsync(CancellationToken ct)
    {
        if (!ShowStats || _docker is null || !_capabilities.Allows(DockerCapabilities.Stats) || _rows.Count == 0)
            return;

        var ids = Groups()
            .Where(g => !_collapsed.Contains(g.Key))
            .SelectMany(g => g.Containers)
            .Where(r => r.IsRunning)
            .Select(r => r.Id)
            .ToList();
        if (ids.Count == 0)
            return;

        var endpoint = Endpoint;
        var timeout = Timeout;
        IReadOnlyDictionary<string, ContainerStats> fresh;
        try
        {
            fresh = await Task.Run(() => DockerContainers.StatsAsync(endpoint, timeout, ids, ct), ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed)
            return;

        var merged = new Dictionary<string, ContainerStats>(_stats);
        foreach (var (id, stats) in fresh)
            merged[id] = stats;
        _stats = merged;

        // A proxy that refused stats is remembered by the call; pick that up for the page.
        if (!DockerContainers.CachedCapabilities(endpoint).Allows(DockerCapabilities.Stats))
            _capabilities = DockerContainers.CachedCapabilities(endpoint);
        StateHasChanged();
    }

    private IReadOnlyList<ContainerGroup> Groups()
    {
        var stats = _stats;
        return DockerContainers.Group(
            _rows.Where(r => DockerContainers.Matches(r, _search, _state)),
            _sort,
            id => stats.TryGetValue(id, out var s) ? s : null);
    }

    private void Toggle(string key)
    {
        if (!_collapsed.Remove(key))
            _collapsed.Add(key);
    }

    private void ToggleAll()
    {
        if (_collapsed.Count > 0)
            _collapsed.Clear();
        else
            foreach (var group in Groups())
                _collapsed.Add(group.Key);
    }

    private bool IsSelf(ContainerRow row) => ContainerSafety.IsSelf(row, SelfContainer.Hint);

    private bool IsListed(ContainerRow row) => ContainerSafety.IsListed(row, _protected);

    private string? ShellLink(ContainerRow row) =>
        _terminalTab is null || _docker is null
            ? null
            : $"t/{Uri.EscapeDataString(_terminalTab.Slug)}?target={Uri.EscapeDataString($"docker:{_docker.Id}:{row.Name}")}";

    // ---- actions ------------------------------------------------------------------

    private void Ask(ContainerRow row, ContainerAction action)
    {
        var self = IsSelf(row);
        var listed = IsListed(row);
        _typed = "";
        _result = "";
        _pending = new Pending(
            $"{DockerContainers.Verb(action)} {row.Name}?",
            ContainerSafety.Warning(action, row, self, listed),
            DockerContainers.Verb(action),
            action is ContainerAction.Stop or ContainerAction.Remove or ContainerAction.Pause || self,
            ContainerSafety.NeedsTypedName(action, self, listed) ? row.Name : null,
            [],
            () => RunOneAsync(row, action));
    }

    private void AskBulk(ContainerGroup group, ContainerAction action)
    {
        var (act, skip) = ContainerSafety.PlanBulk(action, group.Containers, SelfContainer.Hint, _protected);
        var verb = DockerContainers.Verb(action).ToLowerInvariant();
        var plan = act.Select(c => new PlanLine(c.Name, verb, true))
            .Concat(skip.Select(s => new PlanLine(s.Container.Name, "left alone: " + s.Why, false)))
            .ToList();

        _typed = "";
        _result = "";
        _pending = new Pending(
            $"{DockerContainers.Verb(action)} {group.Title}?",
            act.Count == 0
                ? "Nothing in this project needs it."
                : $"{act.Count} container{(act.Count == 1 ? "" : "s")} in {group.Title}, one at a time:",
            act.Count == 0 ? "Nothing to do" : $"{DockerContainers.Verb(action)} {act.Count}",
            action != ContainerAction.Start,
            null,
            plan,
            () => RunBulkAsync(group, action, act));
    }

    private bool CanConfirm(Pending pending) =>
        pending.Plan.Count > 0 && !pending.Plan.Any(p => p.Acts)
            ? false
            : pending.TypeName is null || string.Equals(_typed.Trim(), pending.TypeName, StringComparison.Ordinal);

    private async Task ConfirmAsync(Pending pending)
    {
        if (!CanConfirm(pending))
            return;
        _pending = null;
        await pending.Run();
    }

    private async Task RunOneAsync(ContainerRow row, ContainerAction action)
    {
        _busy = row.Id;
        StateHasChanged();

        var failure = await ActAsync(row, action);
        _busy = null;
        if (failure is null)
        {
            _resultFailed = false;
            _result = $"{DockerContainers.PastTense(action)} {row.Name}.";
        }
        else if (IsSelf(row) && action is ContainerAction.Restart or ContainerAction.Stop)
        {
            // Acting on LabbyTwo's own container ends this circuit mid-call, so the failure
            // that arrives is the connection dropping, not anything Docker said.
            _resultFailed = false;
            _result = action == ContainerAction.Restart
                ? "Restarting — this page will reconnect on its own."
                : "Stopping LabbyTwo — this page is about to go away.";
        }
        else
        {
            _resultFailed = true;
            _result = $"{DockerContainers.Verb(action)} {row.Name}: {failure}";
        }

        await RefreshAsync(freshCapabilities: false);
    }

    private async Task RunBulkAsync(ContainerGroup group, ContainerAction action, IReadOnlyList<ContainerRow> containers)
    {
        var failures = new List<string>();
        var done = 0;
        foreach (var row in containers)
        {
            _busy = row.Id;
            _result = $"{DockerContainers.Verb(action)} {row.Name} ({done + failures.Count + 1} of {containers.Count})…";
            _resultFailed = false;
            StateHasChanged();

            if (await ActAsync(row, action) is { } failure)
                failures.Add($"{row.Name}: {failure}");
            else
                done++;
        }

        _busy = null;
        _resultFailed = failures.Count > 0;
        _result = $"{DockerContainers.PastTense(action)} {done} of {containers.Count} in {group.Title}." +
                  (failures.Count > 0 ? " " + string.Join("; ", failures) : "");
        await RefreshAsync(freshCapabilities: false);
    }

    /// <summary>One action, off the render thread. Returns why it failed, or null.</summary>
    private async Task<string?> ActAsync(ContainerRow row, ContainerAction action)
    {
        var endpoint = Endpoint;
        if (action == ContainerAction.Restart)
            await SilenceDependentsAsync(row);

        try
        {
            await Task.Run(() => DockerContainers.RunAsync(endpoint, action, row.Id, CancellationToken.None));
            // A runbook listing stopped containers should not go on listing this one for
            // the few seconds a shared list is otherwise reused.
            DockerContainers.ForgetSharedLists();
            return null;
        }
        catch (Exception ex)
        {
            if (ex is DockerProxyDeniedException)
                _capabilities = DockerContainers.CachedCapabilities(endpoint);
            return ex.GetBaseException().Message;
        }
    }

    /// <summary>
    /// A restart you asked for is not an outage, so the connections that reach this
    /// container by name — http://sonarr:8989, as the README recommends writing them — are
    /// silenced while it comes back, the way a provider action's reboot is. Only a restart:
    /// a container you stopped is down, and saying so is correct.
    /// </summary>
    private async Task SilenceDependentsAsync(ContainerRow row)
    {
        try
        {
            var connections = await Config.ConnectionsAsync();
            foreach (var connection in ContainerSafety.ConnectionsReaching(row, connections))
                await Config.SilenceAsync(connection.Id, DateTimeOffset.Now + RestartSilence);
        }
        catch (Exception)
        {
            // Worth an alert you did not want; not worth refusing to restart.
        }
    }

    // ---- updates ------------------------------------------------------------------

    /// <summary>
    /// What each row shows: the registry's verdict where a check has one for that container
    /// id, what Docker alone says otherwise. A container recreated since the check has a new
    /// id, so it falls back to local facts rather than wearing its predecessor's verdict.
    /// </summary>
    private IReadOnlyDictionary<string, ContainerUpdate> UpdateView
    {
        get
        {
            if (_review is not { Error: null } review)
                return _local;

            var merged = new Dictionary<string, ContainerUpdate>(_local);
            foreach (var line in review.Containers)
                merged[line.Id] = line;
            return merged;
        }
    }

    private ContainerUpdate? UpdateFor(ContainerRow row) => UpdateView.TryGetValue(row.Id, out var update) ? update : null;

    private string UpdateSummary =>
        _review is null
            ? "Nothing is asked of any registry until you press this."
            : _review.Error is { Length: > 0 } error
                ? error
                : $"Checked {Ago.Since(_review.CheckedAt)}: {_review.Summary}.";

    private async Task CheckForUpdatesAsync()
    {
        if (_docker is not { } docker)
            return;

        _checking = true;
        _result = "";
        try
        {
            // On the pool inside CheckAsync; two presses, or a press and the schedule, share one check.
            _review = await Updates.CheckAsync(docker);
        }
        catch (Exception ex)
        {
            _resultFailed = true;
            _result = $"Check for updates: {ex.GetBaseException().Message}";
        }
        finally
        {
            _checking = false;
        }
    }

    private string HowUpdatesRun => Updater.ContainerMode == SelfUpdater.UpdateMode.WatchtowerApi
        ? "Your Watchtower is asked to update just these images, through its HTTP API."
        : "A one-shot Watchtower is started through the Docker API, told just these names.";

    private void AskUpdate(ContainerRow row)
    {
        if (UpdateFor(row) is not { CanUpdate: true } update)
            return;

        var self = IsSelf(row);
        var listed = IsListed(row);
        _typed = "";
        _result = "";
        _pending = new Pending(
            $"Update {row.Name}?",
            ContainerSafety.UpdateWarning(row, self, listed, Updater.ContainerMode) + " " + SafeNote(self),
            "Update",
            self || listed,
            ContainerSafety.NeedsTypedNameToUpdate(self, listed) ? row.Name : null,
            [],
            () => RunUpdateAsync([(row, update)]));
    }

    private void AskUpdateAll()
    {
        var behind = _rows
            .Select(row => (Row: row, Update: UpdateFor(row)))
            .Where(pair => pair.Update is { IsBehind: true })
            .Select(pair => (pair.Row, pair.Update!))
            .ToList();

        var (act, skip) = ContainerSafety.PlanUpdates(behind, SelfContainer.Hint, _protected);
        var plan = act.Select(c => new PlanLine(c.Name, "update to the newer image", true))
            .Concat(skip.Select(s => new PlanLine(s.Container.Name, "left alone: " + s.Why, false)))
            .ToList();
        var targets = act.Select(update => (_rows.First(r => r.Id == update.Id), update)).ToList();

        _typed = "";
        _result = "";
        _pending = new Pending(
            "Update everything that is behind?",
            act.Count == 0
                ? "Nothing that is behind can be updated in one go."
                : $"{act.Count} container{(act.Count == 1 ? "" : "s")} on {_docker?.Name}, each down for a moment while it is " +
                  $"recreated. {HowUpdatesRun} {SafeNote(self: false)}",
            act.Count == 0 ? "Nothing to do" : $"Update {act.Count}",
            true,
            null,
            plan,
            () => RunUpdateAsync(targets));
    }

    /// <summary>
    /// What the update confirmation adds about safe update: that it is on and what it
    /// watches for, that it is off but the old image is still kept — or, for LabbyTwo's own
    /// container, that it cannot apply, and why.
    /// </summary>
    private string SafeNote(bool self) =>
        self
            ? "Safe update does not apply to LabbyTwo's own container: once it has been replaced there is no LabbyTwo left " +
              "running the old version to watch the new one, or to put the old one back if it fails."
            : _choice.Watch
                ? $"Safe update is on: the image it runs now is kept, and after the update LabbyTwo watches it for " +
                  $"{_choice.For.TotalMinutes:0} minutes. If it stops, restarts, turns unhealthy, or a connection pointing at it " +
                  "goes down or fires an alert, the previous image is put back by itself."
                : "Safe update is off for this tab, so nothing is watched afterwards — but the image it runs now is kept, " +
                  "and ↶ on its row puts it back.";

    private async Task RunUpdateAsync(IReadOnlyList<(ContainerRow Row, ContainerUpdate Update)> targets)
    {
        if (_docker is not { } docker || targets.Count == 0)
            return;

        var endpoint = Endpoint;
        var names = string.Join(", ", targets.Select(t => t.Row.Name));
        var includesSelf = targets.Any(t => IsSelf(t.Row));
        var list = targets.Select(t => new SelfUpdater.Target(t.Row.Name, t.Update.WatchtowerImage)).ToList();

        _busy = targets.Count == 1 ? targets[0].Row.Id : "updates";
        _resultFailed = false;
        _result = $"Starting the update of {names}…";
        StateHasChanged();

        // Recreating is a restart as far as anything watching it can tell.
        foreach (var (row, _) in targets)
            await SilenceDependentsAsync(row);

        // What each one runs now, written down before anything replaces it — LabbyTwo's own
        // excepted, which nothing would be left to watch or roll back.
        var keep = targets.Where(t => !IsSelf(t.Row)).Select(t => t.Row).ToList();
        IReadOnlyList<SafeUpdate> prepared = [];
        IReadOnlyList<string> notes = [];
        var choice = _choice;
        if (keep.Count > 0)
        {
            try
            {
                var tabChoice = Tab.Settings.Get(SafeUpdates.TabKey);
                choice = await Offload.Run(ct => Safe.ChoiceAsync(tabChoice, ct));
                (prepared, notes) = await Task.Run(() => Safe.PrepareAsync(docker, endpoint, keep, choice));
            }
            catch (Exception ex)
            {
                notes = [$"The previous images could not be recorded, so these cannot be rolled back: {ex.GetBaseException().Message}"];
            }
        }

        try
        {
            var answer = await Task.Run(() => Updater.UpdateContainersAsync(endpoint, list, keepPrevious: prepared.Count > 0));
            Updates.MarkStarted(docker.Id, targets.Select(t => t.Row.Id).ToList());
            _resultFailed = false;
            _result = includesSelf
                ? "Updating LabbyTwo — this page will go away and reconnect on its own."
                : answer ?? $"Watchtower is updating {names} in the background; each is down for a moment while it is " +
                  "recreated. Check for updates again in a minute or two to see it done.";
            if (!includesSelf && prepared.Count > 0 && choice.Watch)
                _result += $" Once each is on its new image it is watched for {choice.For.TotalMinutes:0} minutes, and put back " +
                           "on its previous image if it fails.";
        }
        catch (Exception ex)
        {
            _resultFailed = true;
            _result = $"Update {names}: {ex.GetBaseException().Message}";
            if (prepared.Count > 0)
                await Task.Run(() => Safe.AbandonAsync(prepared, "the update could not be started"));
        }
        finally
        {
            _busy = null;
        }

        if (notes.Count > 0)
            _result += " " + string.Join(" ", notes);

        DockerContainers.ForgetSharedLists();
        await RefreshAsync(freshCapabilities: false);
    }

    // ---- rolling back -------------------------------------------------------------

    private void AskRollback(ContainerRow row)
    {
        if (!_safe.TryGetValue(row.Name, out var safe) || !safe.CanRollBack || IsSelf(row))
            return;

        var listed = IsListed(row);
        _typed = "";
        _result = "";
        _pending = new Pending(
            $"Roll {row.Name} back?",
            $"“{row.Name}” is recreated from the image it ran before it was updated {Ago.Since(safe.RequestedAt)} " +
            $"({ContainerChanges.ShortImage(safe.PreviousImage)}), with the settings, volumes and networks it has now, and is " +
            "down for a moment while that happens. " +
            (safe.State == SafeUpdateState.Watching ? "Its watch ends here. " : "") +
            "The newer image stays published, so the next update will offer it again." +
            (listed ? " It is on this tab's protected list — if it carries your tunnel or reverse proxy, you may lose the way back in." : ""),
            "Roll back",
            true,
            listed ? row.Name : null,
            [],
            () => RunRollbackAsync(row, safe));
    }

    private async Task RunRollbackAsync(ContainerRow row, SafeUpdate safe)
    {
        _busy = row.Id;
        _resultFailed = false;
        _result = $"Rolling {row.Name} back…";
        StateHasChanged();

        string? failure;
        try
        {
            failure = await Task.Run(() => Safe.RollBackAsync(safe.Id));
        }
        catch (Exception ex)
        {
            failure = ex.GetBaseException().Message;
        }

        _busy = null;
        _resultFailed = failure is not null;
        _result = failure is null
            ? $"Rolled {row.Name} back to image {ContainerChanges.ShortImage(safe.PreviousImage)}."
            : $"Roll back {row.Name}: {failure}";

        DockerContainers.ForgetSharedLists();
        await RefreshAsync(freshCapabilities: false);
    }

    private void OnSafeChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed || _docker is null)
            return;
        var id = _docker.Id;
        try
        {
            _safe = await Offload.Run(ct => Safe.LatestAsync(id, ct));
            StateHasChanged();
        }
        catch (Exception)
        {
            // The next refresh reads it again.
        }
    });

    private void OnUpdatesChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed || _docker is null)
            return;
        _review = Updates.Last(_docker.Id);
        StateHasChanged();
    });

    // ---- inspect ------------------------------------------------------------------

    private async Task InspectAsync(ContainerRow row)
    {
        _inspectFor = row;
        _details = null;
        _history = null;
        _inspectError = null;
        StateHasChanged();

        var endpoint = Endpoint;
        var timeout = Timeout;
        _ = LoadHistoryAsync(row);
        try
        {
            var details = await Task.Run(() => DockerContainers.InspectAsync(endpoint, timeout, row.Id, CancellationToken.None));
            if (_inspectFor?.Id == row.Id)
                _details = details;
        }
        catch (Exception ex)
        {
            if (_inspectFor?.Id == row.Id)
                _inspectError = Explain(ex, endpoint);
        }
    }

    /// <summary>The container's config history, beside the inspect rather than after it: it comes from the database, not Docker.</summary>
    private async Task LoadHistoryAsync(ContainerRow row)
    {
        if (_docker is not { } docker)
            return;
        IReadOnlyList<ContainerConfigVersion> history;
        try
        {
            history = await Offload.Run(ct => ConfigHistory.HistoryAsync(docker.Id, row.Name, ContainerConfigStore.Keep, ct));
        }
        catch (Exception)
        {
            history = [];
        }

        await InvokeAsync(() =>
        {
            if (_disposed || _inspectFor?.Id != row.Id)
                return;
            _history = history;
            StateHasChanged();
        });
    }

    private void CloseInspect()
    {
        _inspectFor = null;
        _details = null;
        _history = null;
        _inspectError = null;
    }

    private void OnConfigChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed)
            return;
        await OnParametersSetAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Config.Changed -= OnConfigChanged;
        Updates.Changed -= OnUpdatesChanged;
        Safe.Changed -= OnSafeChanged;
        _poll?.Cancel();
        _poll?.Dispose();
        _load.Dispose();

        try
        {
            if (_watcher is not null)
            {
                await _watcher.InvokeVoidAsync("dispose");
                await _watcher.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
        _self?.Dispose();
    }
}
