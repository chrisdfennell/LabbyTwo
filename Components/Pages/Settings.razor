@page "/settings"
@layout SettingsLayout
@rendermode InteractiveServer
@inject NavigationManager Nav

@* The settings hub. This used to be one page of twenty cards, from the version number to
   plugin installs; each card now lives in the section it belongs to (SettingsMap), and this
   page is the list of sections. Interactive for one reason: an old link to a card here —
   settings#family — carries the card's name after a #, which the browser never sends, so
   only the open page can read it and send it on to where the card is now. *@

<PageTitle>Settings · LabbyTwo</PageTitle>

<div class="page-head">
    <div>
        <h1>⚙️ Settings</h1>
        <p class="subtitle">Everything else lives in the database — this is the app itself. Search, or pick a section.</p>
    </div>
</div>

<ul class="settings-hub">
    @foreach (var section in SettingsMap.Sections)
    {
        <li class="settings-hub-card widget" @key="section.Key">
            <h2 class="widget-title">
                <a href="@section.Route"><span aria-hidden="true">@section.Icon</span> @section.Title</a>
            </h2>
            <p class="tile-meta mb-0">@section.Summary</p>
            @if (section.Pages.Count > 0)
            {
                <p class="settings-hub-pages mb-0">
                    @foreach (var sub in section.Pages)
                    {
                        <a href="@sub.Route">@sub.Title</a>
                    }
                </p>
            }
        </li>
    }
</ul>

@code {
    protected override void OnInitialized()
    {
        // Absent while the page is first drawn on the server, present once the browser has
        // connected and said where it really is.
        var fragment = new Uri(Nav.Uri).Fragment;
        if (SettingsMap.MovedAnchor(fragment) is { } target)
            Nav.NavigateTo(target, replace: true);
    }
}
