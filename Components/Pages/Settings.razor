@page "/settings"
@rendermode InteractiveServer
@inject ConfigStore Config
@inject Registry Registry
@inject HealthMonitor Health
@inject AlertService Alerts
@inject ConfigTransfer Transfer
@inject Db Database
@inject AppSettingsStore AppSettings
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject UpdateChecker Updates
@inject SelfUpdater Updater
@inject ModuleCatalog Catalog
@inject DashboardImportService Imports
@inject ShareTransfer Share
@inject Geocoder Places
@inject IEnumerable<IEndpointExtension> Endpoints
@inject BackgroundJobRunner Jobs
@inject Microsoft.Extensions.Options.IOptions<LabbyOptions> Options
@using System.Reflection

<PageTitle>Settings · LabbyTwo</PageTitle>

<div class="page-head">
    <div>
        <h1>⚙️ Settings</h1>
        <p class="subtitle">Everything else lives in the database — this is the app itself.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="widget h-100">
            <div class="widget-head"><h2 class="widget-title">This install</h2></div>
            <div class="widget-body">
                <dl class="row mb-0 small">
                    <dt class="col-6 tile-meta">Version</dt>
                    <dd class="col-6">
                        @if (Version == "dev")
                        {
                            <span title="@($"Assembly reports: “{UpdateChecker.Raw}”")">not stamped</span>
                        }
                        else
                        {
                            <span class="font-monospace">@Version</span>
                        }
                        @if (_update is { Known: true, Behind: false })
                        {
                            <span class="text-success"> · up to date</span>
                        }
                        else if (_update is { Behind: true })
                        {
                            <span class="text-warning"> · update available</span>
                        }
                    </dd>
                    <dt class="col-6 tile-meta">Probe interval</dt><dd class="col-6">@Options.Value.ProbeSeconds s</dd>
                    <dt class="col-6 tile-meta">Failures before down</dt><dd class="col-6">@Options.Value.FailuresBeforeDown</dd>
                    <dt class="col-6 tile-meta">History retention</dt><dd class="col-6">@Options.Value.RetentionDays days</dd>
                    <dt class="col-6 tile-meta">Login</dt>
                    <dd class="col-6">@(Options.Value.Auth.Enabled ? $"on ({Options.Value.Auth.Username})" : "off — open on this network")</dd>
                    <dt class="col-6 tile-meta">Database</dt><dd class="col-6">@Size</dd>
                    <dt class="col-6 tile-meta">Contents</dt>
                    <dd class="col-6">@_connectionCount connections · @_tabCount tabs · @_widgetCount widgets</dd>
                    <dt class="col-6 tile-meta">Alert channels</dt>
                    <dd class="col-6">
                        @if (_channelCount == 0)
                        {
                            <a href="settings/connections">none configured</a>
                        }
                        else
                        {
                            @($"{_channelCount} configured")
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="widget h-100">
            <div class="widget-head"><h2 class="widget-title">Backup</h2></div>
            <div class="widget-body">
                <p class="tile-meta">
                    The database holds every connection, tab, widget, note and metric. Download a
                    consistent copy without stopping the app.
                </p>
                <a class="btn btn-sm btn-outline-secondary" href="api/backup">Download database</a>

                <hr class="my-3" />

                <p class="tile-meta">
                    Or export just the configuration as JSON — useful for moving to another machine,
                    keeping a copy in version control, or sharing a dashboard with somebody else.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-sm btn-outline-secondary" href="api/export">Export (no secrets)</a>
                    <a class="btn btn-sm btn-outline-danger" href="api/export?secrets=true">Export with secrets</a>
                </div>
                <div class="form-text">
                    “With secrets” writes every stored password and API key into the file in plain text.
                    Only use it for a backup you keep somewhere safe.
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="widget">
            <div class="widget-head"><h2 class="widget-title">Where you are</h2></div>
            <div class="widget-body">
                @* One location, because three things wanted the same two numbers and each
                   asked separately. Searched rather than typed: nobody knows their own
                   coordinates, and a wrong digit does not fail — it shows you somebody
                   else's weather. *@
                <p class="tile-meta">
                    Used by the forecast, the weather warnings, air quality and the radar, unless one of
                    them is given its own. Nothing else is sent anywhere — the search asks Open-Meteo for
                    the coordinates of a place name, and that is the end of it.
                </p>

                <p class="mb-2"><strong>@_home.Describe()</strong></p>

                <div class="d-flex gap-2 flex-wrap mb-2" style="max-width: 34rem">
                    <input class="form-control" style="flex: 1 1 14rem" placeholder="Town, city or postcode"
                           @bind="_placeQuery" @bind:event="oninput"
                           @onkeydown="@(e => { if (e.Key == "Enter") return SearchPlacesAsync(); return Task.CompletedTask; })" />
                    <button class="btn btn-outline-secondary" disabled="@_searching" @onclick="SearchPlacesAsync">
                        @(_searching ? "Searching…" : "Search")
                    </button>
                    @if (_home.IsSet)
                    {
                        <button class="btn btn-outline-danger" @onclick="ClearLocationAsync">Clear</button>
                    }
                </div>

                @if (_placeError is { Length: > 0 } placeError)
                {
                    <div class="alert alert-warning py-2">@placeError</div>
                }

                @if (_places.Count > 0)
                {
                    <div class="list-group" style="max-width: 34rem">
                        @foreach (var place in _places)
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between"
                                    @onclick="() => ChooseAsync(place)">
                                <span>@place.Label</span>
                                <span class="tile-meta">@Geocoder.Format(place.Latitude), @Geocoder.Format(place.Longitude)</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="widget">
            <div class="widget-head">
                <h2 class="widget-title">Updates</h2>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CheckForUpdatesAsync"
                        disabled="@_checking">
                    @(_checking ? "Checking…" : "Check GitHub")
                </button>
            </div>
            <div class="widget-body">
                @if (_update is null)
                {
                    <p class="tile-meta mb-0">
                        Nothing is contacted until you press the button — LabbyTwo does not phone home on
                        its own.
                        @if (Channel == UpdateChecker.Channel.Release)
                        {
                            <text>
                                This install is on a release, so the check asks GitHub for the newest
                                published release and compares it with this one.
                            </text>
                        }
                        else
                        {
                            <text>
                                This install tracks <code>main</code>, so the check asks GitHub for the
                                newest commit and compares it with the one this image was built from.
                            </text>
                        }
                    </p>
                }
                else if (_update.Error is { Length: > 0 } error)
                {
                    <div class="alert alert-warning py-2 mb-0">@error</div>
                }
                else if (_update.Behind == false)
                {
                    <p class="mb-0"><span class="text-success">Up to date.</span>
                        <span class="tile-meta">
                            @(Channel == UpdateChecker.Channel.Release
                                ? "Running the newest release."
                                : "Running the newest commit on main.")
                        </span></p>
                }
                else
                {
                    <p class="mb-1">
                        <strong class="text-warning">An update is available.</strong>
                        <span class="tile-meta">
                            newest is <span class="font-monospace">@_update.Latest</span>
                            @if (_update.Released is { } released)
                            {
                                <text>, from @released.ToLocalTime().ToString("d MMM HH:mm")</text>
                            }
                        </span>
                    </p>
                    @if (_update.Summary is { Length: > 0 } summary)
                    {
                        <p class="tile-meta mb-2">Latest change: @summary</p>
                    }
                    <p class="tile-meta mb-1">Run this where LabbyTwo is installed:</p>
                    <pre class="mb-2"><code>bash install.sh</code></pre>
                    <p class="tile-meta mb-2">
                        Or, if this install pulls a published image rather than building from source,
                        <code>docker compose pull &amp;&amp; docker compose up -d</code>.
                    </p>
                    <a class="btn btn-sm btn-outline-secondary" href="@_update.CompareUrl"
                       target="_blank" rel="noreferrer">See what changed</a>
                }

                <hr class="my-3" />

                @if (_self is { Ready: true, Self: not null } ready)
                {
                    <p class="mb-1">
                        <strong>Update from here.</strong>
                        <span class="tile-meta">
                            @ready.Self.Container, running <span class="font-monospace">@ready.Self.Image</span>
                        </span>
                    </p>
                    <p class="tile-meta mb-2">
                        A container cannot replace itself, so this starts a throwaway
                        <span class="font-monospace">watchtower --run-once</span> over the Docker socket and
                        lets it pull the new image and recreate this one. LabbyTwo goes away mid-click and
                        comes back a few seconds later — reload the page then.
                    </p>

                    @if (!Options.Value.Auth.Enabled)
                    {
                        <div class="alert alert-warning py-2 mb-2">
                            Login is off, so anyone who can reach this page can press this button — and
                            through it, start a container as root on the host. Set a password before
                            leaving this switched on.
                        </div>
                    }

                    @if (_updateError is { Length: > 0 } failed)
                    {
                        <div class="alert alert-danger py-2 mb-2">@failed</div>
                    }

                    <button class="btn btn-sm btn-warning" disabled="@_updating" @onclick="() => _confirmUpdate = true">
                        @(_updating ? "Starting…" : "Update now")
                    </button>
                    @if (ready.Reason is { Length: > 0 } caveat)
                    {
                        <p class="tile-meta mb-0 mt-2">@caveat</p>
                    }
                }
                else
                {
                    <p class="tile-meta mb-0">
                        There is no button that does the update here.
                        @(_self?.Reason ?? "Checking what this container can do…")
                    </p>
                    <p class="tile-meta mb-0 mt-2">
                        LabbyTwo runs inside the container an update replaces, and nothing can rebuild and
                        restart itself — so updating from in here means handing this app the Docker socket,
                        which is root on the host. Mount it and the button appears. Leave it out and
                        <a href="https://containrrr.dev/watchtower/" target="_blank" rel="noreferrer">Watchtower</a>
                        does the same job without the dashboard holding the keys.
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="widget">
            <div class="widget-head"><h2 class="widget-title">Public status page</h2></div>
            <div class="widget-body">
                <p class="tile-meta">
                    A read-only page anyone with the link can open without signing in — names,
                    uptime percentages and the daily bars. Deliberately not the probe messages,
                    which carry internal hostnames and API errors.
                </p>

                @if (_statusToken is { Length: > 0 })
                {
                    <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                        <input class="form-control font-monospace" readonly value="@StatusUrl" style="max-width: 34rem" />
                        <a class="btn btn-sm btn-outline-secondary" href="@StatusUrl" target="_blank" rel="noreferrer">Open</a>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="RotateStatusTokenAsync">
                            Rotate link
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="DisableStatusPageAsync">
                            Turn off
                        </button>
                    </div>
                    <div class="form-text">
                        Anyone with the link can read it — that is the point, so treat it as public.
                        Rotating breaks the old link immediately.
                    </div>
                }
                else
                {
                    <button class="btn btn-sm btn-primary" @onclick="RotateStatusTokenAsync">
                        Create a share link
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        @* A tab or a card somebody sent you. Separate from the whole-config import above
           because the two do opposite things: that one restores your install by id, this
           one takes a copy of somebody else's page and gives it new ids, so importing the
           same file twice gives you two rather than silently overwriting the first. *@
        <div class="widget mb-3">
            <div class="widget-head">
                <h2 class="widget-title">Import a tab or a card</h2>
            </div>
            <div class="widget-body">
                <p class="tile-meta">
                    A file somebody exported from their dashboard. Export your own from
                    <a href="settings/tabs">Tabs</a>, or from <strong>Edit layout</strong> on any dashboard
                    for a single card. Credentials never travel — a card that watched something gets
                    matched to the equivalent connection here, and says so when it cannot.
                </p>

                <InputFile class="form-control mb-2" accept=".json" OnChange="OnShareChosenAsync" disabled="@_sharing" />

                @if (_shareError is { Length: > 0 })
                {
                    <div class="alert alert-danger py-2 mb-0">@_shareError</div>
                }

                @if (_sharePlan is { } plan)
                {
                    <div class="panel p-3">
                        <div class="d-flex align-items-baseline gap-2 flex-wrap mb-2">
                            <strong>@plan.Summary</strong>
                            @if (plan.Share.From is { Length: > 0 } from)
                            {
                                <span class="tile-meta">from @from</span>
                            }
                        </div>

                        @* Everything it will do, before it does any of it. *@
                        @if (plan.Notes.Count > 0)
                        {
                            <ul class="small mb-2">
                                @foreach (var note in plan.Notes)
                                {
                                    <li>@note</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="tile-meta">Everything it needs is here. Nothing to sort out afterwards.</p>
                        }

                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-primary" @onclick="ApplyShareAsync" disabled="@_sharing">
                                @(_sharing ? "Importing…" : "Import it")
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _sharePlan = null"
                                    disabled="@_sharing">Cancel</button>
                        </div>
                    </div>
                }

                @if (_shareResult is { } done)
                {
                    <div class="alert alert-success py-2 mb-0">
                        @if (done.TabSlug is { Length: > 0 } slug)
                        {
                            <text>Added, with @done.Widgets card@(done.Widgets == 1 ? "" : "s").</text>
                            <a href="@($"t/{slug}")">Open it</a>
                        }
                        else
                        {
                            <text>Card added.</text>
                        }
                        @if (done.Notes.Count > 0)
                        {
                            <ul class="mb-0 mt-2 small">
                                @foreach (var note in done.Notes)
                                {
                                    <li>@note</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="widget">
            <div class="widget-head">
                <h2 class="widget-title">Import configuration</h2>
                <a class="btn btn-sm btn-outline-secondary" href="settings/import">
                    Coming from Homer, Homepage or Heimdall?
                </a>
            </div>
            <div class="widget-body">
                <p class="tile-meta">
                    Paste an export below. Anything with a matching id is overwritten; everything else
                    is left alone, so this adds a dashboard rather than replacing your setup.
                </p>
                <textarea class="form-control font-monospace mb-2" rows="6" placeholder='{ "version": 1, … }'
                          @bind="_importJson" @bind:event="oninput"></textarea>
                <button class="btn btn-sm btn-primary" @onclick="ImportAsync"
                        disabled="@(_importing || string.IsNullOrWhiteSpace(_importJson))">
                    @(_importing ? "Importing…" : "Import")
                </button>

                @if (_importError is { Length: > 0 })
                {
                    <div class="alert alert-danger py-2 mt-3 mb-0">@_importError</div>
                }
                @if (_importResult is { } result)
                {
                    <div class="alert alert-success py-2 mt-3 mb-0">
                        Imported @result.Connections connections, @result.Tabs tabs, @result.Widgets widgets and @result.Rules alert rules.
                        @if (result.Warnings.Count > 0)
                        {
                            <ul class="mb-0 mt-2 small">
                                @foreach (var warning in result.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="widget">
            <div class="widget-head"><h2 class="widget-title">Installed extensions</h2></div>
            <div class="widget-body">
                <p class="tile-meta">
                    What this build can talk to and display. Everything here was found by scanning for
                    classes, not from a list — adding to it is one file.
                </p>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="tile-meta mb-1">Providers (@Registry.Providers.Count)</div>
                        <ul class="small mb-0 ps-3">
                            @foreach (var provider in Registry.Providers)
                            {
                                <li>@provider.Icon @provider.DisplayName <span class="tile-meta">— @provider.Category</span></li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-3">
                        <div class="tile-meta mb-1">Widgets (@Registry.Widgets.Count)</div>
                        <ul class="small mb-0 ps-3">
                            @foreach (var widget in Registry.Widgets)
                            {
                                <li>@widget.Icon @widget.DisplayName</li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-3">
                        <div class="tile-meta mb-1">Tab kinds (@Registry.TabKinds.Count)</div>
                        <ul class="small mb-0 ps-3">
                            @foreach (var kind in Registry.TabKinds)
                            {
                                <li>@kind.Icon @kind.DisplayName</li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-3">
                        <div class="tile-meta mb-1">Importers (@Imports.Importers.Count)</div>
                        <ul class="small mb-0 ps-3">
                            @foreach (var importer in Imports.Importers)
                            {
                                <li>@importer.Icon @importer.DisplayName</li>
                            }
                        </ul>
                    </div>

                    @* Only shown when something contributed one, because the app itself
                       ships none — an empty column would read as a missing feature. *@
                    @if (Endpoints.Any())
                    {
                        <div class="col-md-3">
                            <div class="tile-meta mb-1">Endpoints (@Endpoints.Count())</div>
                            <ul class="small mb-0 ps-3 font-monospace">
                                @foreach (var endpoint in Endpoints.OrderBy(e => e.Key))
                                {
                                    <li>@ExtensionRoutes.PathFor(endpoint.Key)</li>
                                }
                            </ul>
                        </div>
                    }

                    @* Jobs run with nobody watching, so when each last ran — and whether it
                       worked — is the only way anyone would ever know it had stopped. *@
                    @if (Jobs.Runs.Count > 0)
                    {
                        <div class="col-md-3">
                            <div class="tile-meta mb-1">Background jobs (@Jobs.Runs.Count)</div>
                            <ul class="small mb-0 ps-3">
                                @foreach (var run in Jobs.Runs)
                                {
                                    <li class="@(run.Ok ? null : "text-danger")">
                                        @run.Name
                                        <span class="tile-meta">
                                            — @(run.At is { } at ? Ago.Since(at) : "not run yet")
                                        </span>
                                        @if (!run.Ok)
                                        {
                                            <div class="tile-meta text-danger">@run.Message</div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="widget">
            <div class="widget-head"><h2 class="widget-title">Plugins</h2></div>
            <div class="widget-body">
                <p class="tile-meta">
                    Any .NET assembly in this folder is scanned at startup and anything it declares —
                    providers, widgets, tab kinds, importers, endpoints — joins the lists above.
                    Restart to pick up a change.
                </p>
                <p class="font-monospace small mb-2">@Catalog.PluginDirectory</p>

                @* The folder is inside the container. A DLL copied next to the compose file
                   on the host is nowhere near it, which is the usual reason a plugin "does
                   nothing" — so say which of the two situations this is. *@
                @if (!Catalog.PluginDirectoryExists)
                {
                    <div class="alert alert-warning py-2">
                        That folder does not exist, so nothing was scanned. In Docker it lives in the
                        data volume, not beside your compose file:
                        <pre class="mb-0 mt-2"><code>docker exec @ContainerHint mkdir -p /app/data/plugins
docker cp YourPlugin.dll @(ContainerHint):/app/data/plugins/
docker compose restart labbytwo</code></pre>
                    </div>
                }
                else if (Catalog.DllsFound == 0)
                {
                    <p class="tile-meta mb-0">
                        The folder is there and empty — no .dll files in it. Copy one in and restart.
                    </p>
                }
                else if (!Catalog.Plugins.Any() && Catalog.Failures.Count == 0)
                {
                    <p class="tile-meta mb-0">
                        @Catalog.DllsFound file(s) were scanned, and none declared a provider, widget,
                        tab kind, importer or endpoint. A plugin's classes have to be <code>public</code>,
                        top level and not abstract to be found.
                    </p>
                }

                @foreach (var plugin in Catalog.Plugins)
                {
                    <div class="panel p-2 mb-2">
                        <div class="d-flex gap-2 align-items-baseline flex-wrap">
                            <strong>@plugin.Name</strong>
                            <span class="tile-meta">@plugin.Version</span>
                            <span class="tile-meta">· @plugin.TypeCount extension(s)</span>
                        </div>
                        <div class="tile-meta font-monospace" style="word-break: break-all">@plugin.Path</div>

                        @* Said here, while everything still works, rather than left for the
                           render that throws. A plugin built against another LabbyTwo often
                           loads perfectly until the one type that moved is touched. *@
                        @if (Catalog.BuiltForAnother(plugin))
                        {
                            <div class="tile-meta text-warning mt-1">
                                Built for LabbyTwo @plugin.Version, and this is @Catalog.HostVersion.
                                It may work; if part of it is missing or a page fails to open, that is why.
                                Each release publishes a matching copy of every bundled plugin.
                            </div>
                        }
                    </div>
                }

                @foreach (var failure in Catalog.Failures)
                {
                    <div class="alert alert-warning py-2 mb-2">
                        <div class="font-monospace small" style="word-break: break-all">@failure.Path</div>
                        @failure.Reason
                    </div>
                }

                @* Keeping thirteen plugins in step with the host by hand is thirteen downloads
                   after every update, which is why the warning above used to be the end of the
                   story. *@
                @if (Catalog.Plugins.Any())
                {
                    <hr class="my-3" />

                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <button class="btn btn-sm btn-outline-secondary" disabled="@_updatingPlugins"
                                @onclick="UpdatePluginsAsync">
                            @(_updatingPlugins ? "Updating…" : "Update plugins now")
                        </button>

                        <div class="form-check form-switch mb-0 ms-2">
                            <input class="form-check-input" type="checkbox" id="plugin-auto"
                                   checked="@_pluginAuto" @onchange="TogglePluginAutoAsync" />
                            <label class="form-check-label" for="plugin-auto">Update them on every restart</label>
                        </div>
                    </div>

                    @if (_pluginResult is { Length: > 0 })
                    {
                        <div class="tile-meta mt-1">@_pluginResult</div>
                    }

                    <div class="form-text">
                        Downloads the copy of each installed plugin published for
                        @(Catalog.HostVersion is { Length: > 0 } v ? v : "this version"), from the same
                        release this LabbyTwo came from. A plugin that is not one of the bundled ones has
                        nothing published under its name and is left alone. <strong>Restart to load
                        them</strong> — a DLL already in memory is not replaced by rewriting the file,
                        which is also why the automatic one runs during startup rather than after it.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_confirmUpdate)
{
    <ConfirmDialog Title="Update LabbyTwo now?"
                   Message="@($"A one-off Watchtower container will pull the newest image and recreate {_self?.Self?.Container}. LabbyTwo will disappear for a few seconds. Nothing in the database is touched.")"
                   ConfirmText="Update now"
                   OnCancel="() => _confirmUpdate = false"
                   OnConfirm="StartUpdateAsync" />
}

@code {
    // ---- keeping the plugins in step with the host ----

    private bool _updatingPlugins;
    private bool _pluginAuto;
    private string _pluginResult = "";

    private async Task UpdatePluginsAsync()
    {
        _updatingPlugins = true;
        _pluginResult = "";
        try
        {
            var http = HttpFactory.CreateClient();
            var result = await PluginUpdater.UpdateAsync(
                Catalog.PluginDirectory, Catalog.HostVersion, http);

            _pluginResult = result.Updated.Count > 0
                ? $"Updated {string.Join(", ", result.Updated)}. Restart LabbyTwo to load them."
                : result.Reason ?? "Everything was already current.";
        }
        catch (Exception ex)
        {
            _pluginResult = ex.GetBaseException().Message;
        }
        finally
        {
            _updatingPlugins = false;
        }
    }

    private async Task TogglePluginAutoAsync(ChangeEventArgs args)
    {
        _pluginAuto = args.Value is true;
        await AppSettings.SaveAsync(PluginUpdater.EnabledKey, _pluginAuto ? "true" : "false");
    }

    private int _connectionCount, _tabCount, _widgetCount, _channelCount;
    private string _statusToken = "";
    private UpdateChecker.Result? _update;
    private bool _checking;

    private HomeLocation _home = HomeLocation.None;
    private string _placeQuery = "";
    private string? _placeError;
    private bool _searching;
    private IReadOnlyList<Geocoder.Place> _places = [];

    /// <summary>This container's name if we know it, so the copy commands can be pasted as-is.</summary>
    private string ContainerHint => _self?.Self?.Container ?? "labbytwo-labbytwo-1";

    private SelfUpdater.Status? _self;
    private bool _updating, _confirmUpdate;
    private string? _updateError;

    private async Task CheckForUpdatesAsync()
    {
        _checking = true;
        try
        {
            _update = await Updates.CheckAsync();

            // Only now is contacting a registry in scope, so the digest comparison happens
            // on the same press rather than on page load.
            _self = await Updater.StatusAsync(checkRegistry: true);
        }
        finally
        {
            _checking = false;
        }
    }

    private string StatusUrl => $"{Nav.BaseUri.TrimEnd('/')}/status/{_statusToken}";
    private string _importJson = "";
    private bool _importing;
    private string? _importError;
    private ConfigTransfer.ImportResult? _importResult;

    private static string Version => UpdateChecker.Installed;

    /// <summary>Whether this build came from a release or from main, which changes what
    /// "up to date" is measured against and so what the page should say.</summary>
    private static UpdateChecker.Channel Channel => UpdateChecker.ChannelOf(Version);

    private string Size
    {
        get
        {
            double bytes = Database.SizeBytes;
            string[] units = ["B", "KB", "MB", "GB"];
            var unit = 0;
            while (bytes >= 1024 && unit < units.Length - 1)
            {
                bytes /= 1024;
                unit++;
            }
            return $"{bytes:0.#} {units[unit]}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pluginAuto = (await AppSettings.AllAsync()).GetBool(PluginUpdater.EnabledKey);

        await LoadAsync();

        // Local only: which container this is and whether the socket is there. Nothing
        // leaves the machine until the user asks for a check.
        _self = await Updater.StatusAsync();
    }

    private async Task StartUpdateAsync()
    {
        _confirmUpdate = false;
        _updating = true;
        _updateError = null;

        try
        {
            await Updater.StartUpdateAsync();

            // No success path to render: if that worked, this process is killed within
            // seconds. Leaving _updating set keeps the button disabled until it happens.
        }
        catch (Exception ex)
        {
            _updateError = ex.GetBaseException().Message;
            _updating = false;
        }
    }

    private async Task LoadAsync()
    {
        _connectionCount = (await Config.ConnectionsAsync()).Count;
        _tabCount = (await Config.TabsAsync()).Count;
        _widgetCount = (await Config.WidgetsAsync()).Count;
        _channelCount = (await Alerts.ChannelsAsync()).Count;
        _statusToken = await AppSettings.GetAsync(PublicStatus.PublicStatusToken);
        _home = HomeLocation.From(await AppSettings.AllAsync());

        // Show a previous result if one was fetched this session, without checking again.
        _update ??= Updates.Last;
    }

    private async Task SearchPlacesAsync()
    {
        _placeError = null;
        _searching = true;
        try
        {
            _places = await Places.SearchAsync(_placeQuery);
            if (_places.Count == 0)
                _placeError = $"Nothing found for “{_placeQuery}”. Try the nearest town, or add the country.";
        }
        catch (Exception ex)
        {
            _placeError = $"Could not reach the geocoding service: {ex.GetBaseException().Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task ChooseAsync(Geocoder.Place place)
    {
        await AppSettings.SaveAsync(new Dictionary<string, string>
        {
            [HomeLocation.LatitudeKey] = Geocoder.Format(place.Latitude),
            [HomeLocation.LongitudeKey] = Geocoder.Format(place.Longitude),
            [HomeLocation.PlaceKey] = place.Label,
        });

        _places = [];
        _placeQuery = "";
        await LoadAsync();
    }

    private async Task ClearLocationAsync()
    {
        // Cleared rather than deleted: connections that set their own coordinates carry on,
        // and the ones relying on this say so on the Connections page instead of guessing.
        await AppSettings.SaveAsync(new Dictionary<string, string>
        {
            [HomeLocation.LatitudeKey] = "",
            [HomeLocation.LongitudeKey] = "",
            [HomeLocation.PlaceKey] = "",
        });

        await LoadAsync();
    }

    /// <summary>
    /// A fresh random token. Url-safe base64 of 24 bytes — long enough that guessing it
    /// is not a strategy, short enough to paste into a chat.
    /// </summary>
    private async Task RotateStatusTokenAsync()
    {
        var bytes = System.Security.Cryptography.RandomNumberGenerator.GetBytes(24);
        var token = Convert.ToBase64String(bytes).Replace('+', '-').Replace('/', '_').TrimEnd('=');
        await AppSettings.SaveAsync(PublicStatus.PublicStatusToken, token);
        await LoadAsync();
    }

    private async Task DisableStatusPageAsync()
    {
        await AppSettings.SaveAsync(PublicStatus.PublicStatusToken, "");
        await LoadAsync();
    }

    private ShareTransfer.Plan? _sharePlan;
    private ShareTransfer.Result? _shareResult;
    private string? _shareError;
    private bool _sharing;

    /// <summary>
    /// Reads the file and works out what it would do. Nothing is written here — the plan
    /// is shown first, because "adds a tab whose six cards are pointed at nothing" is
    /// worth knowing while it is still a decision.
    /// </summary>
    private async Task OnShareChosenAsync(InputFileChangeEventArgs e)
    {
        _shareError = null;
        _sharePlan = null;
        _shareResult = null;

        try
        {
            // A shared tab is small. The cap is a guard against a mistaken drag, not a
            // real limit.
            await using var stream = e.File.OpenReadStream(2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            _sharePlan = await Share.PlanAsync(ShareTransfer.Read(json));
        }
        catch (Exception ex)
        {
            _shareError = ex.GetBaseException().Message;
        }
    }

    private async Task ApplyShareAsync()
    {
        if (_sharePlan is not { } plan)
            return;

        _sharing = true;
        try
        {
            _shareResult = await Share.ApplyAsync(plan);
            _sharePlan = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _shareError = ex.GetBaseException().Message;
        }
        finally
        {
            _sharing = false;
        }
    }

    private async Task ImportAsync()
    {
        _importing = true;
        _importError = null;
        _importResult = null;
        try
        {
            _importResult = await Transfer.ImportAsync(_importJson);
            _importJson = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _importError = ex.GetBaseException().Message;
        }
        finally
        {
            _importing = false;
        }
    }
}
