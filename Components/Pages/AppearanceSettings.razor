@page "/settings/appearance"
@rendermode InteractiveServer
@inject AppSettingsStore AppSettings
@inject NavigationManager Nav
@inject FontStore Fonts
@inject ConfigStore Config
@inject Offload Offload

<PageTitle>Appearance · LabbyTwo</PageTitle>

<div class="page-head">
    <div>
        <h1>🎨 Appearance</h1>
        <p class="subtitle">Applies to every browser that opens this dashboard — it is stored with the rest of your setup, not per-device.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmReset = true">Reset to defaults</button>
        <a class="btn btn-sm btn-outline-secondary" href="settings">Back to settings</a>
    </div>
</div>

@* The gallery first: picking a theme is the biggest change on this page and the one most
   people come here for. *@
<div class="widget mb-3" id="themes">
    <div class="widget-head">
        <h2 class="widget-title">Themes</h2>
    </div>
    <div class="widget-body">
        <p class="tile-meta mt-0">
            Click one to use it — every open screen changes straight away. “Customise” starts a
            theme of your own from any of them.
        </p>
        <ThemeGallery />

        <hr class="my-3" />
        <ThemeModePicker />

        <hr class="my-3" />
        <h3 class="theme-section-title" id="screen-themes">Per screen</h3>
        <p class="tile-meta mt-0">
            The wall, the phone view and the family page wear the dashboard's theme unless you
            give them their own here — and each can have its own light or dark too.
        </p>
        <ScreenThemes />
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="widget h-100">
            <div class="widget-head"><h2 class="widget-title">Colour</h2></div>
            <div class="widget-body">
                <div class="form-text mt-0 mb-3">
                    Light, dark, or switching with the sun or the clock: <a href="settings/appearance#day-night">Day and night</a>, under Themes.
                </div>

                <label class="form-label" for="accent">Accent colour</label>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <button class="btn btn-sm @(_look.AccentOverride is null ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="ClearAccentAsync">The theme's own</button>
                </div>
                <div class="swatches mb-2">
                    @foreach (var (value, name) in Appearance.AccentPresets)
                    {
                        <button class="color-swatch @(SameColour(_look.Accent, value) ? "is-active" : "")"
                                style="background: @value" title="@name"
                                aria-label="@name" @onclick="() => SetAccentAsync(value)"></button>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="color" id="accent" class="form-control form-control-color"
                           value="@(_look.AccentOverride ?? BuiltInThemes.LabbyTwo.Accent.Hex6)" @onchange="e => SetAccentAsync(e.Value?.ToString())" />
                    <span class="tile-meta">or pick your own</span>
                </div>
                <div class="form-text">
                    Used for links, buttons, the active tab and the first line of every chart. Picking
                    one here overrides the theme's; choosing a theme puts its own back.
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="widget h-100">
            <div class="widget-head"><h2 class="widget-title">Shape and type</h2></div>
            <div class="widget-body">
                <label class="form-label" for="radius">Corners</label>
                <select id="radius" class="form-select mb-1" value="@_look.Radius"
                        @onchange="e => SetAsync(Appearance.RadiusKey, e.Value?.ToString(), Appearance.Radii)">
                    @foreach (var (value, label, hint) in Appearance.Radii)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <div class="form-text mb-3">@Hint(Appearance.Radii, _look.Radius)</div>

                <label class="form-label" for="surface">Cards</label>
                <select id="surface" class="form-select mb-1" value="@_look.Surface"
                        @onchange="e => SetAsync(Appearance.SurfaceKey, e.Value?.ToString(), Appearance.Surfaces)">
                    @foreach (var (value, label, hint) in Appearance.Surfaces)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <div class="form-text mb-3">
                    @Hint(Appearance.Surfaces, _look.Surface)
                    On a pure-black theme a raised card keeps its border, because nothing is darker
                    than black for a shadow to fall on.
                </div>

                <label class="form-label" for="density">Density</label>
                <select id="density" class="form-select mb-3" value="@_look.Density"
                        @onchange="e => SetDensityAsync(e.Value?.ToString())">
                    <option value="compact">Compact — more on screen</option>
                    <option value="comfortable">Comfortable</option>
                    <option value="roomy">Roomy — easier across a room</option>
                </select>

                <label class="form-label" for="wide">On wide screens</label>
                <select id="wide" class="form-select mb-1" value="@_look.WideScreens"
                        @onchange="e => SetAsync(Appearance.WideScreensKey, e.Value?.ToString(), Appearance.WideScreenModes)">
                    @foreach (var (value, label, hint) in Appearance.WideScreenModes)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <div class="form-text mb-3">
                    @Hint(Appearance.WideScreenModes, _look.WideScreens)
                    Dashboards only — settings pages and anything mostly text stay a readable width.
                </div>

                <label class="form-label" for="text">Text size</label>
                <select id="text" class="form-select mb-1" value="@_look.TextScale"
                        @onchange="e => SetAsync(Appearance.TextScaleKey, e.Value?.ToString(), Appearance.TextScales)">
                    @foreach (var (value, label, hint) in Appearance.TextScales)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <div class="form-text mb-3">
                    Separate from density on purpose: density is how much air there is, this is how
                    big the words are. Compact and huge together is a dense wall display you can read
                    from the hallway.
                </div>

                <label class="form-label" for="font">Typeface</label>
                <select id="font" class="form-select mb-1" value="@_look.Font"
                        @onchange="e => SetAsync(Appearance.FontKey, e.Value?.ToString(), Appearance.Fonts)">
                    @foreach (var (value, label, hint) in Appearance.Fonts)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                @if (_look.Font != "custom")
                {
                    <div class="form-text">
                        The system's own fonts, so nothing is downloaded and this still works with no
                        internet.
                    </div>
                }
                else
                {
                    <div class="form-text mb-2">Three ways, and they stack in this order.</div>

                    <label class="form-label" for="family">Font family</label>
                    <input id="family" class="form-control" value="@_look.FontFamily" maxlength="200"
                           placeholder="Inter, Segoe UI, sans-serif"
                           @onchange="e => SetFamilyAsync(e.Value?.ToString())" />
                    <div class="form-text mb-3">
                        Used as-is. On its own this only works where the font is already installed —
                        which is not the wall tablet.
                    </div>

                    <label class="form-label" for="fontfile">Font file</label>
                    @if (_uploaded is { Length: > 0 })
                    {
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <code>@_uploaded</code>
                            <button class="btn btn-sm btn-outline-danger" @onclick="RemoveFontAsync">Remove</button>
                        </div>
                    }
                    <InputFile id="fontfile" class="form-control" accept=".woff2,.woff,.ttf,.otf"
                               OnChange="OnFontChosenAsync" disabled="@_uploading" />
                    <div class="form-text mb-3">
                        @if (_fontError is { Length: > 0 })
                        {
                            <span class="text-warning">@_fontError</span>
                        }
                        else
                        {
                            <text>
                                woff2, woff, ttf or otf, up to 8&nbsp;MB. Served by LabbyTwo itself and
                                stored in your data volume, so it looks the same on every device and
                                still nothing leaves your network. This wins over the family above.
                            </text>
                        }
                    </div>

                    <label class="form-label" for="fonturl">Web font stylesheet</label>
                    <input id="fonturl" class="form-control" value="@_look.FontUrl" maxlength="500"
                           placeholder="https://fonts.googleapis.com/css2?family=Inter&display=swap"
                           @onchange="e => SetFontUrlAsync(e.Value?.ToString())" />
                    <div class="form-text">
                        @if (_urlError is { Length: > 0 })
                        {
                            <span class="text-warning">@_urlError</span>
                        }
                        else
                        {
                            <text>
                                A Google Fonts link, or any https stylesheet. Put the family name in the
                                box above as well — the link loads the font, the family selects it.
                                <strong>This is the one setting that makes the dashboard fetch something
                                from outside your network to draw itself</strong>, so it needs internet
                                and the viewer's address reaches whoever hosts it. Uploading the file
                                instead does the same job without either.
                            </text>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="widget h-100">
            <div class="widget-head"><h2 class="widget-title">Preview</h2></div>
            <div class="widget-body">
                @* A real card rather than a picture of one, so it is styled by the same rules
                   as the dashboard and cannot drift from it. *@
                <div class="widget mb-3">
                    <div class="widget-head">
                        <span style="color: var(--accent)">◆</span>
                        <h2 class="widget-title">@Brand</h2>
                    </div>
                    <div class="metric-value">457<span class="metric-unit">Mbps</span></div>
                    <div class="d-flex gap-2 align-items-center mt-2 mb-2">
                        <span class="status-dot status-up"></span><span class="tile-meta">Something that is up</span>
                    </div>
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <span class="status-dot status-down"></span><span class="tile-meta">Something that is not</span>
                    </div>
                    <div class="usage-bar mb-3"><span style="width: 62%"></span></div>
                    <button class="btn btn-primary btn-sm">A button</button>
                    <a class="ms-2" href="settings/appearance">and a link</a>
                </div>

                <div class="panel p-3">
                    <div class="tile-meta mb-1">And a panel, which tables sit in</div>
                    <code>cert_days_left = 45</code>
                </div>

                <hr class="my-3" />

                <label class="form-label" for="brand">What this dashboard is called</label>
                <input id="brand" class="form-control" value="@_look.BrandName" maxlength="40"
                       placeholder="LabbyTwo" @onchange="e => SetBrandAsync(e.Value?.ToString())" />
                <div class="form-text mb-3">Shown in the sidebar.</div>

                <label class="form-label" for="units">Units</label>
                <div class="d-flex gap-2 flex-wrap mb-1">
                    @foreach (var option in Units.Options)
                    {
                        <button class="btn btn-sm @(_units.MatchingPreset == option.Value ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => SetUnitsAsync(option.Value)">@option.Label</button>
                    }
                    @if (_units.MatchingPreset is null)
                    {
                        @* Not a button: there is nothing to *choose* here, it is what the four
                           below already add up to. A third button would imply you could pick it. *@
                        <span class="btn btn-sm btn-primary disabled">Mixed</span>
                    }
                </div>
                <div class="form-text mb-3">
                    A starting point — each of the four below can then be changed on its own.
                </div>

                <div class="unit-grid mb-1">
                    <label class="form-label" for="unit-temp">Temperature</label>
                    <select id="unit-temp" class="form-select form-select-sm" value="@_units.Temperature"
                            @onchange="e => SetUnitAsync(Units.Preferences.TemperatureKey, e.Value?.ToString(), Units.TemperatureUnits)">
                        @foreach (var (value, label) in Units.TemperatureUnits)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>

                    <label class="form-label" for="unit-wind">Wind</label>
                    <select id="unit-wind" class="form-select form-select-sm" value="@_units.Wind"
                            @onchange="e => SetUnitAsync(Units.Preferences.WindKey, e.Value?.ToString(), Units.WindUnits)">
                        @foreach (var (value, label) in Units.WindUnits)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>

                    <label class="form-label" for="unit-pressure">Pressure</label>
                    <select id="unit-pressure" class="form-select form-select-sm" value="@_units.Pressure"
                            @onchange="e => SetUnitAsync(Units.Preferences.PressureKey, e.Value?.ToString(), Units.PressureUnits)">
                        @foreach (var (value, label) in Units.PressureUnits)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>

                    <label class="form-label" for="unit-rain">Rain</label>
                    <select id="unit-rain" class="form-select form-select-sm" value="@_units.Rain"
                            @onchange="e => SetUnitAsync(Units.Preferences.RainKey, e.Value?.ToString(), Units.RainUnits)">
                        @foreach (var (value, label) in Units.RainUnits)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>
                </div>
                <div class="form-text">
                    Readings are always recorded in one unit so history stays comparable — this
                    changes what you are shown, and existing alert thresholds keep meaning the same
                    thing. Knots with inHg, or Kelvin with millimetres, are combinations the old
                    single switch could not express.
                </div>
            </div>
        </div>
    </div>
</div>

@* Here rather than on the settings page because it is about how the dashboard is shown,
   and like everything else on this page it applies to every device that opens it — each
   of which can still override any of it in the address it bookmarks. *@
<div class="widget mt-3" id="wall-mode">
    <div class="widget-head">
        <h2 class="widget-title">📺 Wall mode</h2>
        <a class="btn btn-sm btn-primary" href="wall">Open wall mode</a>
    </div>
    <div class="widget-body">
        <p class="tile-meta mb-3">
            Full screen, no sidebar, one tab after another — for a tablet or a TV on the wall.
            Bookmark <code>/wall</code> on the device. Touching the screen pauses it, with
            buttons to step through by hand; the arrow keys step and Escape leaves. The pointer
            hides itself, and the screen is kept awake where the browser allows it, which
            needs https or localhost.
        </p>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Tabs to show</label>
                @if (_tabs.Count == 0)
                {
                    <div class="form-text">There are no enabled tabs yet.</div>
                }
                @foreach (var tab in _tabs)
                {
                    var slug = tab.Slug;
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@($"wall-tab-{slug}")"
                               checked="@_wall.Tabs.Contains(slug, StringComparer.OrdinalIgnoreCase)"
                               @onchange="e => ToggleWallTabAsync(slug, e.Value is true)" />
                        <label class="form-check-label" for="@($"wall-tab-{slug}")">
                            @(string.IsNullOrWhiteSpace(tab.Icon) ? "" : tab.Icon + " ")@tab.Name
                        </label>
                    </div>
                }
                <div class="form-text">
                    @(_wall.Tabs.Count == 0
                        ? "None ticked means every enabled tab, including ones you add later."
                        : "Shown in the order of the sidebar. Disabled tabs are skipped.")
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="wall-seconds">Seconds on each tab</label>
                <input id="wall-seconds" type="number" class="form-control mb-3" style="max-width: 10rem"
                       min="@WallOptions.MinSeconds" max="@WallOptions.MaxSeconds" value="@_wall.Seconds"
                       @onchange="e => SetWallNumberAsync(WallOptions.SecondsKey, e.Value?.ToString(), WallOptions.ClampSeconds)" />

                <label class="form-label" for="wall-resume">After a touch, carry on once left alone for (seconds)</label>
                <input id="wall-resume" type="number" class="form-control mb-1" style="max-width: 10rem"
                       min="0" max="@WallOptions.MaxResumeSeconds" value="@_wall.ResumeSeconds"
                       @onchange="e => SetWallNumberAsync(WallOptions.ResumeKey, e.Value?.ToString(), WallOptions.ClampResume)" />
                <div class="form-text mb-3">0 means a touch never pauses it.</div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="wall-overlay"
                           checked="@_wall.Overlay" @onchange="e => SetWallFlagAsync(WallOptions.OverlayKey, e.Value is true)" />
                    <label class="form-check-label" for="wall-overlay">Clock and service status in a corner</label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="wall-nav"
                           checked="@_wall.Nav" @onchange="e => SetWallFlagAsync(WallOptions.NavKey, e.Value is true)" />
                    <label class="form-check-label" for="wall-nav">Keep the sidebar</label>
                </div>
            </div>
        </div>

        <hr class="my-3" />
        <div class="tile-meta">
            Walls already open pick these up straight away. To give one screen its own rotation
            whatever is set here, bookmark the whole address:
            <a href="@_wall.ToUrl()"><code>/@_wall.ToUrl()</code></a>.
            Any part of it can be left out, and <code>/t/<em>tab</em>?wall=1</code> puts a single tab up.
        </div>
    </div>
</div>

@* Advanced, so last: the owner's own stylesheet, with safe mode and a history. *@
<CustomCssEditor />

@if (_confirmReset)
{
    <ConfirmDialog Title="Reset the appearance?"
                   Message="Theme, light and dark, accent, corners, cards, density, text size and typeface all go back to their defaults, and every screen goes back to wearing the dashboard's theme. The dashboard's name, your units and any themes you made are left alone."
                   ConfirmText="Reset it"
                   OnCancel="() => _confirmReset = false"
                   OnConfirm="ResetAsync" />
}

@code {
    private Appearance _look = Appearance.Default;
    private bool _confirmReset;

    private Units.Preferences _units = Units.Preferences.Default;
    private string? _uploaded;
    private bool _uploading;
    private string _fontError = "";
    private string _urlError = "";

    private string Brand => _look.BrandName is { Length: > 0 } name ? name : Appearance.Default.BrandName;

    /// <summary>
    /// The note for whichever option is chosen. It lives under the box rather than inside the
    /// option, because a select is as wide as its own box and not as wide as its longest
    /// choice — "Outlined — A hairline border and no sha…" is what that costs.
    /// </summary>
    private static string Hint((string Value, string Label, string Hint)[] options, string value) =>
        options.FirstOrDefault(option => option.Value == value).Hint ?? "";

    private WallOptions _wall = WallOptions.Default;
    private IReadOnlyList<Tab> _tabs = [];

    protected override async Task OnInitializedAsync()
    {
        var settings = await AppSettings.AllAsync();
        _look = Appearance.From(settings);
        _wall = WallOptions.From(settings);
        _tabs = [.. (await Config.TabsAsync()).Where(t => t.Enabled)];
        _units = Units.Preferences.From(settings);
        _uploaded = Fonts.Current();
    }

    /// <summary>
    /// Rejected quietly rather than stored, and the box keeps its old value — the same rule
    /// the accent picker follows. A family with a semicolon in it is not a family.
    /// </summary>
    private async Task SetFamilyAsync(string? value)
    {
        var typed = value?.Trim() ?? "";

        if (typed.Length == 0)
        {
            await SaveAsync(Appearance.FontFamilyKey, "");
            return;
        }

        if (!Appearance.IsValidFontFamily(typed))
        {
            _urlError = "";
            _fontError = "A font family is names, commas and quotes — that had something else in it.";
            return;
        }

        await SaveAsync(Appearance.FontFamilyKey, typed);
    }

    private async Task SetFontUrlAsync(string? value)
    {
        var typed = value?.Trim() ?? "";

        if (typed.Length == 0)
        {
            await SaveAsync(Appearance.FontUrlKey, "");
            return;
        }

        if (!Appearance.IsValidFontUrl(typed))
        {
            _urlError = "That has to be a full https:// address to a stylesheet.";
            return;
        }

        await SaveAsync(Appearance.FontUrlKey, typed);
    }

    private async Task OnFontChosenAsync(InputFileChangeEventArgs args)
    {
        _fontError = "";
        _uploading = true;
        try
        {
            var file = args.File;
            if (file.Size > FontStore.MaxBytes)
            {
                _fontError = $"That is {file.Size / 1024 / 1024} MB — the limit is {FontStore.MaxBytes / 1024 / 1024} MB.";
                return;
            }

            await using var stream = file.OpenReadStream(FontStore.MaxBytes);
            _uploaded = await Fonts.SaveAsync(stream, file.Name);

            // Nothing to store: whether a font exists is asked of the disk. But the page has
            // to be rebuilt for the @font-face rule to appear in its head.
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            _fontError = ex.GetBaseException().Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private Task RemoveFontAsync()
    {
        Fonts.Clear();
        _uploaded = null;
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    /// <summary>
    /// The look is read while the page is server-rendered, so a change only shows once the
    /// document is rebuilt — a reload of the current page is the honest way to apply it.
    /// </summary>
    private async Task SaveAsync(string key, string value)
    {
        await AppSettings.SaveAsync(key, value);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    /// <summary>
    /// One setter for every choice that comes from a fixed list. The list is the same one the
    /// options were rendered from, so a value that is not in it came from something other than
    /// this page and is ignored rather than stored.
    /// </summary>
    private async Task SetAsync(string key, string? value, (string Value, string Label, string Hint)[] allowed)
    {
        if (value is null || !allowed.Any(option => option.Value == value))
            return;

        await SaveAsync(key, value);
    }

    private Task SetAsync(string key, string value) => SaveAsync(key, value);

    private async Task SetAccentAsync(string? value)
    {
        if (!Appearance.IsValidColor(value))
            return;

        await SaveLiveAsync(Appearance.AccentKey, value!);
    }

    private Task ClearAccentAsync() => SaveLiveAsync(Appearance.AccentKey, "");

    /// <summary>
    /// For the colour choices — the dark/light mode and the accent — which need no reload:
    /// ThemeSync pushes them to this page and every other open one as soon as they are saved.
    /// The rest of this page still reloads, because what it changes (the font, the density)
    /// is drawn into the document itself.
    /// </summary>
    private async Task SaveLiveAsync(string key, string value)
    {
        await Offload.Run(async ct => { await AppSettings.SaveAsync(key, value, ct); return true; });
        _look = Appearance.From(await AppSettings.AllAsync());
    }

    /// <summary>A picker returns "#4DA3FF" for the swatch that stored "#4da3ff".</summary>
    private static bool SameColour(string a, string b) =>
        string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private async Task SetDensityAsync(string? value) =>
        await SaveAsync(Appearance.DensityKey, value is "compact" or "roomy" ? value : "comfortable");

    /// <summary>
    /// The preset. It clears the four finer keys rather than only writing its own, because
    /// "Metric" has to actually mean metric — leaving a stored "knots" behind would give you
    /// a preset that visibly does not take.
    /// </summary>
    private async Task SetUnitsAsync(string? value)
    {
        var preset = value == Units.Metric ? Units.Metric : Units.Imperial;

        await AppSettings.SaveAsync(new Dictionary<string, string>
        {
            [Appearance.UnitsKey] = preset,
            [Units.Preferences.TemperatureKey] = "",
            [Units.Preferences.WindKey] = "",
            [Units.Preferences.PressureKey] = "",
            [Units.Preferences.RainKey] = "",
        });

        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task SetUnitAsync(string key, string? value, (string Value, string Label)[] allowed)
    {
        if (value is null || !allowed.Any(option => option.Value == value))
            return;

        await SaveAsync(key, value);
    }

    private async Task SetBrandAsync(string? value) =>
        await SaveAsync(Appearance.BrandKey,
            value?.Trim() is { Length: > 0 } name ? name : Appearance.Default.BrandName);

    /// <summary>
    /// Wall settings are saved without the reload the rest of this page does: nothing about
    /// them is drawn into the document head, and the walls that are open listen for the
    /// change themselves.
    /// </summary>
    private async Task SaveWallAsync(string key, string value)
    {
        await AppSettings.SaveAsync(key, value);
        _wall = WallOptions.From(await AppSettings.AllAsync());
    }

    /// <summary>
    /// Kept in sidebar order whatever order the boxes were ticked in — the order somebody
    /// clicks checkboxes is not a decision about the order they want to see tabs.
    /// </summary>
    private Task ToggleWallTabAsync(string slug, bool on)
    {
        var chosen = new HashSet<string>(_wall.Tabs, StringComparer.OrdinalIgnoreCase);
        if (on)
            chosen.Add(slug);
        else
            chosen.Remove(slug);

        var ordered = _tabs.Where(t => chosen.Contains(t.Slug)).Select(t => t.Slug);
        return SaveWallAsync(WallOptions.TabsKey, string.Join(',', ordered));
    }

    private async Task SetWallNumberAsync(string key, string? value, Func<int, int> clamp)
    {
        if (!int.TryParse(value, out var number))
            return;
        await SaveWallAsync(key, clamp(number).ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private Task SetWallFlagAsync(string key, bool on) => SaveWallAsync(key, on ? "true" : "false");

    /// <summary>
    /// The look only. The dashboard's name and the unit system are settings that live on this
    /// page for convenience rather than parts of the theme, and somebody clicking "reset the
    /// appearance" is not asking to be renamed or to have their temperatures change scale.
    /// </summary>
    private async Task ResetAsync()
    {
        _confirmReset = false;
        var defaults = Appearance.Default;

        await AppSettings.SaveAsync(new Dictionary<string, string>
        {
            [Appearance.ThemeKey] = defaults.Theme,
            [ThemeService.ThemeIdKey] = BuiltInThemes.DefaultId,
            [Appearance.AccentKey] = defaults.Accent,
            [Appearance.DensityKey] = defaults.Density,
            [Appearance.RadiusKey] = defaults.Radius,
            [Appearance.SurfaceKey] = defaults.Surface,
            [Appearance.DarkPaletteKey] = defaults.DarkPalette,
            [Appearance.TextScaleKey] = defaults.TextScale,
            [Appearance.FontKey] = defaults.Font,
            [Appearance.WideScreensKey] = defaults.WideScreens,
            // Every screen back to wearing the dashboard's theme and mode.
            [ThemeService.WallThemeKey] = "",
            [ThemeService.WallModeKey] = "",
            [ThemeService.PhoneThemeKey] = "",
            [ThemeService.PhoneModeKey] = "",
            [ThemeService.FamilyThemeKey] = "",
            [ThemeService.FamilyModeKey] = "",
        });

        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
