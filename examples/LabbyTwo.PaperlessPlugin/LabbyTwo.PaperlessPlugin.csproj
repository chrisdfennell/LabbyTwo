<!-- The Razor SDK, not the plain one: this plugin ships a .razor component, and only this
     SDK compiles one into the assembly. A provider-only plugin does not need it. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private="false" and ExcludeAssets="runtime" are load-bearing: the host already
         has LabbyTwo at runtime, and a plugin shipping its own copy would define types
         that look identical to the host's and satisfy none of its interface checks. -->
    <ProjectReference Include="../../LabbyTwo.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
