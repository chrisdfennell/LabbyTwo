<!-- Plain SDK. No widget here on purpose — the built-in Controls and Action button cards
     already render whatever actions a provider declares, so a wake button of its own would
     only be a second thing in the picker doing the same job. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../LabbyTwo.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
