<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Razor components need the web SDK's component tooling even in a plain library. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private="false" and ExcludeAssets="runtime" are load-bearing: the host already
         has LabbyTwo at runtime, and a plugin shipping its own copy would define types
         that look identical to the host's and satisfy none of its interface checks. -->
    <ProjectReference Include="../../LabbyTwo.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
