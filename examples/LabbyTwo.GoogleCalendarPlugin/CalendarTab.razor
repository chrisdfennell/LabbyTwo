@inject ConfigStore Config
@inject GoogleCalendarProvider Google
@inject NavigationManager Nav

@* A calendar page rather than an agenda list: the same events in whichever shape suits —
   a month to plan against, a week to read at a glance, a list to scan — and editable,
   because a calendar you can only look at sends you to your phone anyway. *@

<div class="page-head">
    <div>
        <h1>@(string.IsNullOrWhiteSpace(Tab.Icon) ? "📆" : Tab.Icon) @Tab.Name</h1>
        <p class="subtitle">
            @if (_calendar is null)
            {
                <text>No calendar chosen — edit this tab and pick one.</text>
            }
            else
            {
                @(_calendarName.Length > 0 ? _calendarName : _calendar.Name)
                @if (ReadOnly)
                {
                    <text> — read only</text>
                }
            }
        </p>
    </div>

    @if (_calendar is not null && _connected)
    {
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div class="btn-group btn-group-sm" role="group" aria-label="View">
                @foreach (var (key, label) in Views)
                {
                    <button type="button" class="btn @(_view == key ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SwitchAsync(key)">@label</button>
                }
            </div>

            <div class="btn-group btn-group-sm" role="group" aria-label="Move">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => StepAsync(-1)" title="Back">‹</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="TodayAsync">Today</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => StepAsync(1)" title="Forward">›</button>
            </div>

            @if (!ReadOnly)
            {
                <button class="btn btn-sm btn-primary" @onclick="() => BeginNew(_today)">+ Add event</button>
            }
        </div>
    }
</div>

@if (_calendar is null)
{
    <div class="empty-state">
        <p class="mb-3">This tab needs a Google Calendar connection.</p>
        <a class="btn btn-primary btn-sm" href="settings/connections">Add one</a>
    </div>
}
else if (!_connected)
{
    @* Not connected: the one-time OAuth dance. Deliberately spelled out on the page rather
       than in the docs, because it is a sequence nobody does twice. *@
    <div class="widget">
        <div class="widget-head"><h2 class="widget-title">Connect to Google</h2></div>
        <div class="widget-body">
            <p>
                LabbyTwo needs permission from Google once. Nothing is stored until you finish
                this, and the token it ends up with is kept encrypted like any password here.
            </p>
            <ol class="mb-3">
                <li>
                    <a href="@_authorizationUrl" target="_blank" rel="noopener">Open Google's consent page</a>
                    and approve the calendar access.
                </li>
                <li>
                    Google then sends your browser to
                    <code>@_redirectUri</code>, which normally goes nowhere and shows an error page.
                    That is expected — Google refuses to redirect to a LAN address.
                </li>
                <li>
                    Copy the whole address from that page's address bar and paste it below. The
                    <code>code=…</code> part is the bit that matters; pasting the lot is fine.
                </li>
            </ol>

            <div class="d-flex flex-wrap gap-2 align-items-end">
                <div class="flex-grow-1">
                    <label class="form-label" for="oauth-code">Address, or just the code</label>
                    <input id="oauth-code" class="form-control" @bind="_code" @bind:event="oninput"
                           placeholder="http://127.0.0.1:5150/oauth2callback?state=…&amp;code=4/0Ab…" />
                </div>
                <button class="btn btn-primary" @onclick="ConnectAsync" disabled="@(_busy || _code.Trim().Length == 0)">
                    @(_busy ? "Connecting…" : "Connect")
                </button>
            </div>

            @if (_error.Length > 0)
            {
                <div class="alert alert-warning py-2 mt-3 mb-0">@_error</div>
            }

            <p class="tile-meta mt-3 mb-0">
                Codes expire in a couple of minutes and work once. If it fails, open the consent
                page again rather than reusing the old address.
            </p>
        </div>
    </div>
}
else
{
    @if (_error.Length > 0)
    {
        <div class="alert alert-warning py-2">@_error</div>
    }

    <div class="widget">
        <div class="widget-head">
            <h2 class="widget-title">@RangeLabel</h2>
            <span class="tile-meta">
                @(_busy ? "Loading…" : $"{_events.Count} event{(_events.Count == 1 ? "" : "s")}")
            </span>
        </div>
        <div class="widget-body @(_view == "list" ? "" : "p-2")">

            @if (_view == "month")
            {
                <table class="table table-bordered mb-0" style="table-layout:fixed">
                    <thead>
                        <tr>
                            @foreach (var day in WeekHeadings)
                            {
                                <th class="tile-meta text-center">@day</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var week = 0; week < 6; week++)
                        {
                            <tr>
                                @for (var weekday = 0; weekday < 7; weekday++)
                                {
                                    var day = GridStart.AddDays(week * 7 + weekday);
                                    var inMonth = day.Month == _anchor.Month;
                                    <td class="align-top p-1 @(inMonth ? null : "opacity-50")"
                                        style="height:7.5rem; vertical-align:top; cursor:@(ReadOnly ? "default" : "pointer")"
                                        @onclick="() => BeginNew(day)">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="@(day == _today ? "badge bg-primary" : "tile-meta")">@day.Day</span>
                                        </div>
                                        @foreach (var item in OnDay(day).Take(3))
                                        {
                                            <div class="text-truncate small rounded px-1 mt-1"
                                                 style="background:rgba(125,125,255,.18); cursor:pointer"
                                                 title="@item.Summary"
                                                 @onclick:stopPropagation="true"
                                                 @onclick="() => BeginEdit(item)">
                                                @if (!item.AllDay)
                                                {
                                                    <span class="tile-meta">@item.Start.ToString("HH:mm")</span>
                                                    <text> </text>
                                                }
                                                @item.Summary
                                            </div>
                                        }
                                        @if (OnDay(day).Count > 3)
                                        {
                                            <div class="tile-meta small mt-1"
                                                 @onclick:stopPropagation="true"
                                                 @onclick="() => ShowDayAsync(day)">
                                                +@(OnDay(day).Count - 3) more
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (_view == "week")
            {
                <div class="row g-2">
                    @for (var offset = 0; offset < 7; offset++)
                    {
                        var day = GridStart.AddDays(offset);
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="panel p-2 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="@(day == _today ? "fw-semibold" : null)">@day.ToString("ddd d MMM")</span>
                                    @if (!ReadOnly)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                title="Add on this day" @onclick="() => BeginNew(day)">+</button>
                                    }
                                </div>
                                @if (OnDay(day).Count == 0)
                                {
                                    <div class="tile-meta small">—</div>
                                }
                                @foreach (var item in OnDay(day))
                                {
                                    <div class="d-flex justify-content-between gap-2 small"
                                         style="cursor:pointer" @onclick="() => BeginEdit(item)">
                                        <span class="text-truncate">@item.Summary</span>
                                        <span class="tile-meta flex-none text-nowrap">@item.TimeLabel</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                @if (_events.Count == 0)
                {
                    <div class="empty-state m-0">Nothing in this window.</div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <tbody>
                            @foreach (var day in _events.GroupBy(e => DateOnly.FromDateTime(e.Start.LocalDateTime)))
                            {
                                <tr>
                                    <td colspan="3" class="tile-meta">@day.Key.ToString("dddd d MMMM")</td>
                                </tr>
                                @foreach (var item in day)
                                {
                                    <tr style="cursor:pointer" @onclick="() => BeginEdit(item)">
                                        <td style="width:9rem" class="tile-meta">@item.TimeLabel</td>
                                        <td>
                                            @item.Summary
                                            @if (item.Location.Length > 0)
                                            {
                                                <div class="tile-meta">@item.Location</div>
                                            }
                                        </td>
                                        <td class="text-end tile-meta">@(item.IsNow(_now) ? "now" : "")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </div>
}

@if (_editing is not null)
{
    <Modal Title="@(_isNew ? "New event" : "Edit event")" Size="lg" OnClose="Cancel">
        <ChildContent>
            <div class="mb-3">
                <label class="form-label" for="event-title">Title</label>
                <input id="event-title" class="form-control" @bind="_formTitle" @bind:event="oninput" />
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="event-allday" @bind="_formAllDay" />
                <label class="form-check-label" for="event-allday">All day</label>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3">
                    <label class="form-label" for="event-start-date">Starts</label>
                    <input id="event-start-date" type="date" class="form-control" @bind="_formStartDate" />
                </div>
                @if (!_formAllDay)
                {
                    <div class="col-6 col-md-2">
                        <label class="form-label" for="event-start-time">at</label>
                        <input id="event-start-time" type="time" class="form-control" @bind="_formStartTime" />
                    </div>
                }
                <div class="col-6 col-md-3">
                    <label class="form-label" for="event-end-date">Ends</label>
                    <input id="event-end-date" type="date" class="form-control" @bind="_formEndDate" />
                </div>
                @if (!_formAllDay)
                {
                    <div class="col-6 col-md-2">
                        <label class="form-label" for="event-end-time">at</label>
                        <input id="event-end-time" type="time" class="form-control" @bind="_formEndTime" />
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label" for="event-location">Location</label>
                <input id="event-location" class="form-control" @bind="_formLocation" />
            </div>

            <div class="mb-0">
                <label class="form-label" for="event-notes">Notes</label>
                <textarea id="event-notes" class="form-control" rows="3" @bind="_formNotes"></textarea>
            </div>

            @if (_formError.Length > 0)
            {
                <div class="alert alert-warning py-2 mt-3 mb-0">@_formError</div>
            }
        </ChildContent>
        <Footer>
            @if (!_isNew)
            {
                <button class="btn btn-outline-danger btn-sm me-auto" @onclick="() => _confirmDelete = true"
                        disabled="@_busy">Delete</button>
            }
            <button class="btn btn-secondary btn-sm" @onclick="Cancel">Cancel</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync"
                    disabled="@(_busy || _formTitle.Trim().Length == 0)">
                @(_busy ? "Saving…" : "Save")
            </button>
        </Footer>
    </Modal>
}

@if (_confirmDelete && _editing is { } doomed)
{
    <ConfirmDialog Title="Delete this event?"
                   Message="@($"\"{doomed.Summary}\" will be removed from the calendar for everyone it is shared with.")"
                   OnCancel="() => _confirmDelete = false"
                   OnConfirm="DeleteAsync" />
}

@code {
    [Parameter, EditorRequired] public Tab Tab { get; set; } = default!;

    private static readonly (string Key, string Label)[] Views =
        [("month", "Month"), ("week", "Week"), ("list", "List")];

    private Connection? _calendar;
    private string _calendarName = "";
    private bool _connected;
    private string _loadedTab = "";

    private string _view = "month";
    private DateOnly _anchor = DateOnly.FromDateTime(DateTime.Today);
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private DateTimeOffset _now = DateTimeOffset.Now;

    private IReadOnlyList<CalEvent> _events = [];
    private string _error = "";
    private bool _busy;

    // Connecting
    private string _authorizationUrl = "";
    private string _redirectUri = "";
    private string _code = "";

    // The editor
    private CalEvent? _editing;
    private bool _isNew;
    private bool _confirmDelete;
    private string _formTitle = "", _formLocation = "", _formNotes = "", _formError = "";
    private bool _formAllDay;
    private DateOnly _formStartDate, _formEndDate;
    private TimeOnly _formStartTime, _formEndTime;

    private bool ReadOnly => Tab.Settings.GetBool("read_only", false);
    private bool WeekStartsMonday => Tab.Settings.Get("week_starts", "sunday") == "monday";

    // ---- the window each view shows ----------------------------------------------------

    /// <summary>
    /// First cell of the grid. Month shows six whole weeks, so the days either side of the
    /// month are there — a Monday the 1st with nothing before it reads as a broken page.
    /// </summary>
    private DateOnly GridStart => _view switch
    {
        "month" => StartOfWeek(new DateOnly(_anchor.Year, _anchor.Month, 1)),
        "week" => StartOfWeek(_anchor),
        _ => _anchor,
    };

    private DateOnly GridEnd => _view switch
    {
        "month" => GridStart.AddDays(42),
        "week" => GridStart.AddDays(7),
        _ => _anchor.AddDays(30),
    };

    private DateOnly StartOfWeek(DateOnly day)
    {
        var shift = WeekStartsMonday
            ? ((int)day.DayOfWeek + 6) % 7
            : (int)day.DayOfWeek;
        return day.AddDays(-shift);
    }

    private IReadOnlyList<string> WeekHeadings =>
        [.. Enumerable.Range(0, 7).Select(offset => GridStart.AddDays(offset).ToString("ddd"))];

    private string RangeLabel => _view switch
    {
        "month" => _anchor.ToString("MMMM yyyy"),
        "week" => $"{GridStart:d MMM} – {GridStart.AddDays(6):d MMM yyyy}",
        _ => $"{_anchor:d MMM} onwards",
    };

    private IReadOnlyList<CalEvent> OnDay(DateOnly day) => [.. _events.Where(e => e.OnDay(day))];

    // ---- loading ------------------------------------------------------------------------

    protected override async Task OnParametersSetAsync()
    {
        // Only re-resolve when the tab changes, or every re-render would throw the user
        // back to this month mid-browse.
        if (_loadedTab == Tab.Id)
            return;

        _loadedTab = Tab.Id;
        _view = Tab.Settings.Get("view", "month");

        var connections = await Config.ConnectionsAsync();
        var chosen = Tab.Settings.Get("connection");
        _calendar = chosen.Length > 0
            ? connections.FirstOrDefault(c => c.Id == chosen)
            : connections.FirstOrDefault(c => c.Provider == "google-calendar");

        if (_calendar is null)
            return;

        _connected = GoogleCalendarProvider.IsConnected(_calendar);
        _redirectUri = GoogleCalendarProvider.RedirectUri(_calendar);
        _authorizationUrl = GoogleCalendarProvider.AuthorizationUrl(_calendar);

        if (_connected)
        {
            _calendarName = await Google.CalendarNameAsync(_calendar, CancellationToken.None);
            await LoadAsync();
        }
    }

    private async Task LoadAsync(bool fresh = false)
    {
        if (_calendar is not { } calendar)
            return;

        _busy = true;
        _now = DateTimeOffset.Now;
        try
        {
            var from = new DateTimeOffset(GridStart.ToDateTime(TimeOnly.MinValue), _now.Offset);
            var to = new DateTimeOffset(GridEnd.ToDateTime(TimeOnly.MinValue), _now.Offset);
            _events = await Google.EventsAsync(calendar, from, to, fresh, CancellationToken.None);
            _error = "";
        }
        catch (Exception ex)
        {
            _events = [];
            _error = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SwitchAsync(string view)
    {
        _view = view;
        if (view == "list")
            _anchor = _today;
        await LoadAsync();
    }

    private async Task StepAsync(int direction)
    {
        _anchor = _view switch
        {
            "month" => _anchor.AddMonths(direction),
            "week" => _anchor.AddDays(7 * direction),
            _ => _anchor.AddDays(30 * direction),
        };
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        _anchor = _today;
        await LoadAsync(fresh: true);
    }

    private async Task ShowDayAsync(DateOnly day)
    {
        _view = "list";
        _anchor = day;
        await LoadAsync();
    }

    // ---- connecting ----------------------------------------------------------------------

    private async Task ConnectAsync()
    {
        if (_calendar is not { } calendar)
            return;

        _busy = true;
        _error = "";
        try
        {
            var refresh = await Google.ExchangeAsync(calendar, CodeFrom(_code), CancellationToken.None);

            var settings = calendar.Settings.Clone();
            settings["refresh_token"] = refresh;
            var saved = calendar with { Settings = settings };
            await Config.SaveConnectionAsync(saved, CancellationToken.None);

            // Re-read rather than trusting the local copy: the store encrypts on the way in
            // and hands back what everything else will see.
            _calendar = await Config.ConnectionAsync(saved.Id) ?? saved;
            _connected = true;
            _code = "";

            _calendarName = await Google.CalendarNameAsync(_calendar, CancellationToken.None);
            await LoadAsync(fresh: true);
        }
        catch (Exception ex)
        {
            _error = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Accepts the whole redirect address or a bare code, because "copy the address bar" is
    /// the instruction people can actually follow.
    /// </summary>
    private static string CodeFrom(string pasted)
    {
        var text = pasted.Trim();
        var start = text.IndexOf("code=", StringComparison.OrdinalIgnoreCase);
        if (start < 0)
            return text;

        var value = text[(start + 5)..];
        var end = value.IndexOf('&');
        if (end >= 0)
            value = value[..end];
        return Uri.UnescapeDataString(value);
    }

    // ---- editing --------------------------------------------------------------------------

    private void BeginNew(DateOnly day)
    {
        if (ReadOnly)
            return;

        _isNew = true;
        _editing = new CalEvent("", "", DateTimeOffset.Now, DateTimeOffset.Now, false);
        _formTitle = "";
        _formLocation = "";
        _formNotes = "";
        _formError = "";
        _formAllDay = false;
        _formStartDate = day;
        _formEndDate = day;

        // The next whole hour, an hour long: the guess that needs the least correcting.
        var next = DateTime.Now.AddHours(1);
        _formStartTime = new TimeOnly(next.Hour, 0);
        _formEndTime = _formStartTime.AddHours(1);
    }

    private void BeginEdit(CalEvent item)
    {
        _isNew = false;
        _editing = item;
        _formTitle = item.Summary;
        _formLocation = item.Location;
        _formNotes = item.Description;
        _formError = "";
        _formAllDay = item.AllDay;
        _formStartDate = DateOnly.FromDateTime(item.Start.LocalDateTime);
        _formStartTime = TimeOnly.FromDateTime(item.Start.LocalDateTime);

        // All-day ends are exclusive in Google's model; show the last day it covers.
        var end = item.AllDay ? item.End.AddDays(-1) : item.End;
        _formEndDate = DateOnly.FromDateTime(end.LocalDateTime);
        _formEndTime = TimeOnly.FromDateTime(end.LocalDateTime);
    }

    private void Cancel()
    {
        _editing = null;
        _confirmDelete = false;
    }

    private async Task SaveAsync()
    {
        if (_calendar is not { } calendar || _editing is not { } editing || ReadOnly)
            return;

        var start = _formAllDay
            ? new DateTimeOffset(_formStartDate.ToDateTime(TimeOnly.MinValue), _now.Offset)
            : new DateTimeOffset(_formStartDate.ToDateTime(_formStartTime), _now.Offset);

        var end = _formAllDay
            ? new DateTimeOffset(_formEndDate.ToDateTime(TimeOnly.MinValue), _now.Offset)
            : new DateTimeOffset(_formEndDate.ToDateTime(_formEndTime), _now.Offset);

        if (end < start)
        {
            _formError = "That ends before it starts.";
            return;
        }

        var draft = editing with
        {
            Summary = _formTitle.Trim(),
            Location = _formLocation.Trim(),
            Description = _formNotes.Trim(),
            Start = start,
            End = end,
            AllDay = _formAllDay,
        };

        _busy = true;
        _formError = "";
        try
        {
            if (_isNew)
                await Google.AddAsync(calendar, draft, CancellationToken.None);
            else
                await Google.UpdateAsync(calendar, draft, CancellationToken.None);

            _editing = null;
            await LoadAsync(fresh: true);
        }
        catch (Exception ex)
        {
            _formError = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_calendar is not { } calendar || _editing is not { } doomed)
            return;

        _confirmDelete = false;
        _busy = true;
        try
        {
            await Google.DeleteAsync(calendar, doomed.Id, CancellationToken.None);
            _editing = null;
            await LoadAsync(fresh: true);
        }
        catch (Exception ex)
        {
            _formError = ex.GetBaseException().Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
